---
import Icon from '../icons/Icon.astro'
import { resolveIcon } from '../icons/iconMappings'
import { parseBold } from '../../utils/markup'
import type { Lang } from '../../types'
import { t } from '../../lib/i18n'

interface Props {
  features: Array<{ icon: string; pretitle: string; title: string; text: string }>
  lang?: Lang
}

const { features, lang = 'en' } = Astro.props

// Each capability card links to the live services index page.
// The /services/ route renders the same capability grid from
// ServicesBento.astro + the process timeline + the CTA card.
import { localizeHref } from '../../lib/localize-href'
const servicesHref = localizeHref(lang, '/services/')
---

<section class="features" data-scroll-anchor="home-features" data-scroll-anchor-progress="0.50" data-animate="fade-slide-up">
  <div class="features__intro">
    <h2 class="features__heading">{t('home_services_intro_title', lang)}</h2>
    <p class="features__lead">{t('home_services_intro_lead', lang)}</p>
    <a href={servicesHref} class="features__intro-link">
      <span class="features__cta-label">{t('home_services_intro_link', lang)}</span>
      <Icon name="arrow-right" size={14} color="currentColor" class="icon-chevron" />
    </a>
  </div>
  <div class="features__grid">
    {features.map((feature) => {
      const icon = resolveIcon(feature.icon)
      return (
      <a
        href={servicesHref}
        class="features__card glass glass-card"
        data-animate="fade-slide-up"
        aria-label={`Learn more about ${feature.pretitle}`}
      >
        <div class="features__icon-wrap">
          <Icon name={icon.name} variant={icon.variant} size={32} color="var(--text-primary)" />
        </div>
        <p class="features__pretitle">{feature.pretitle}</p>
        <h3 class="features__title" set:html={parseBold(feature.title)} />
        <p class="features__text">{feature.text}</p>
        <span class="features__cta" aria-hidden="true">
          <span class="features__cta-label">{t('home_services_cta', lang)}</span>
          <Icon name="arrow-right" size={14} color="currentColor" class="icon-chevron" />
        </span>
      </a>
    )})}
  </div>
</section>

<style>
  .features {
    padding: 80px 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .features__intro {
    max-width: 680px;
    margin: 0 auto 52px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .features__lead {
    font-family: var(--font-body);
    font-size: var(--type-lead);
    font-weight: 400;
    color: var(--muted-text);
    line-height: 1.55;
    margin: 0;
  }

  .features__intro-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: var(--type-body);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .features__intro-link:hover {
    text-decoration: underline;
  }

  .features__heading {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--heading-text);
    text-align: center;
    margin: 0 0 52px;
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .features__card {
    display: flex;
    flex-direction: column;
    padding: 28px 22px;
    border-radius: 16px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .features__card:hover {
    transform: translateY(-6px);
    box-shadow: var(--card-shadow-hover);
  }

  .features__icon-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    margin: 0 auto 16px;
  }

  .features__pretitle {
    font-family: var(--font-display);
    font-size: var(--type-eyebrow);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--text-secondary);
    margin: 0 0 8px;
  }

  .features__title {
    font-family: var(--font-display);
    font-size: var(--type-body);
    font-weight: 700;
    color: var(--heading-text);
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .features__title :global(strong) {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: normal;
    color: var(--text-primary);
  }

  .features__text {
    font-family: var(--font-body);
    font-size: var(--type-body-sm);
    font-weight: 400;
    color: var(--muted-text);
    margin: 0;
    line-height: 1.6;
  }

  .features__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 16px;
    font-family: var(--font-display);
    font-size: var(--type-caption);
    font-weight: 600;
    color: var(--color-primary);
    transition: transform 0.2s ease;
  }

  .features__card:hover .features__cta {
    transform: translateX(4px);
  }

  [dir="rtl"] .features__card:hover .features__cta {
    transform: translateX(-4px);
  }

  [dir="rtl"] .features__intro-link,
  [dir="rtl"] .features__cta {
    flex-direction: row;
    direction: ltr;
  }

  [dir="rtl"] .features__cta-label {
    direction: rtl;
    unicode-bidi: isolate;
  }

  [dir="rtl"] .features .icon-chevron :global(svg) {
    transform: scaleX(-1);
  }

  @media (max-width: 900px) {
    .features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .features__grid {
      grid-template-columns: 1fr;
    }

    .features {
      padding: 60px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .features__card,
    .features__cta {
      transition: none;
    }
    .features__card:hover,
    .features__card:hover .features__cta {
      transform: none;
    }
  }
</style>
