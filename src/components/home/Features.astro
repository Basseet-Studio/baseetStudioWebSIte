---
import Icon from '../icons/Icon.astro'
import { resolveIcon } from '../icons/iconMappings'
import { parseBold } from '../../utils/markup'
import type { Lang } from '../../types'
import { t } from '../../lib/i18n'

interface Props {
  features: Array<{ icon: string; pretitle: string; title: string; text: string }>
  lang?: Lang
}

const { features, lang = 'en' } = Astro.props

// Each capability card links to the live services index page.
// The /services/ route renders the same capability grid from
// ServicesBento.astro + the process timeline + the CTA card.
const servicesHref = '/services/'
---

<section class="features" data-scroll-anchor="home-features" data-scroll-anchor-progress="0.30" data-animate="fade-slide-up">
  <h2 class="features__heading">{t('home_services_title', lang)}</h2>
  <div class="features__grid">
    {features.map((feature) => {
      const icon = resolveIcon(feature.icon)
      return (
      <a
        href={servicesHref}
        class="features__card glass glass-card"
        data-animate="fade-slide-up"
        aria-label={`Learn more about ${feature.pretitle}`}
      >
        <div class="features__icon-wrap">
          <Icon name={icon.name} variant={icon.variant} size={32} color="var(--text-primary)" />
        </div>
        <p class="features__pretitle">{feature.pretitle}</p>
        <h3 class="features__title" set:html={parseBold(feature.title)} />
        <p class="features__text">{feature.text}</p>
        <span class="features__cta" aria-hidden="true">
          {t('home_services_cta', lang)}
          <Icon name="arrow-right" size={14} color="currentColor" />
        </span>
      </a>
    )})}
  </div>
</section>

<style>
  .features {
    padding: 80px 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .features__heading {
    font-size: 2rem;
    font-weight: 700;
    color: var(--heading-text);
    text-align: center;
    margin: 0 0 48px;
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .features__card {
    display: flex;
    flex-direction: column;
    padding: 28px 22px;
    border-radius: 16px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .features__card:hover {
    transform: translateY(-6px);
    box-shadow: var(--card-shadow-hover);
  }

  .features__icon-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    margin: 0 auto 16px;
  }

  .features__pretitle {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin: 0 0 8px;
  }

  .features__title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--heading-text);
    margin: 0 0 10px;
  }

  .features__title :global(strong) {
    color: var(--text-primary);
  }

  .features__text {
    font-size: 0.85rem;
    color: var(--muted-text);
    margin: 0;
    line-height: 1.55;
  }

  .features__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 16px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: transform 0.2s ease;
  }

  .features__card:hover .features__cta {
    transform: translateX(4px);
  }

  [dir="rtl"] .features__card:hover .features__cta {
    transform: translateX(-4px);
  }

  @media (max-width: 900px) {
    .features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .features__grid {
      grid-template-columns: 1fr;
    }

    .features {
      padding: 60px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .features__card,
    .features__cta {
      transition: none;
    }
    .features__card:hover,
    .features__card:hover .features__cta {
      transform: none;
    }
  }
</style>
