---
import Icon from '../icons/Icon.astro'
import { parseBold } from '../../utils/markup'
import type { Lang } from '../../types'
import { t } from '../../lib/i18n'

interface Props {
  data: {
    title: string
    text: string
  }
  lang?: Lang
}

const { data, lang = 'en' } = Astro.props
const titleHtml = parseBold(data.title)
---

<section class="hero" data-scroll-anchor="home-hero" data-scroll-anchor-progress="0" data-animate="fade-slide-up">
  <div class="hero__inner">
    <span class="hero__eyebrow">
      {/* TODO: localise this later */}
      {t('home_hero_eyebrow', lang)}
    </span>
    <h1 class="hero__title" set:html={titleHtml} />

    <p class="hero__subtitle">{data.text}</p>

    <div class="hero__cta">
      <a href="/projects/" class="hero__btn">
        <Icon name="rocket" size={18} color="currentColor" />
        {t('home_hero_cta_work', lang)}
        <Icon name="arrow-right" size={16} color="currentColor" />
      </a>
      <a href="/services/" class="hero__btn-label-mono">
        {t('home_hero_cta_services', lang)}
      </a>
    </div>
  </div>
</section>

<style>
  /* Hero — font + layout borrowed from
     docs/refrences/stitch stuff/tickert-info.html (the "Elevate Your
     Vision" landing page). That reference uses Syne at display sizes
     with a tight letter-spacing (-0.02em), a strong italic accent line,
     and a small uppercase label-mono eyebrow above. We keep our own copy
     and the existing typewriter-on-strong typing effect — only the
     type stack and the editorial spacing come from the reference. */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 24px 80px;
    position: relative;
    z-index: 1;
  }

  .hero__inner {
    text-align: left;
    max-width: 920px;
    width: 100%;
  }

  /* Eyebrow — uppercase tracked label sitting above the headline, in
     the same letter-spacing pattern as the reference's
     "Established 2024" chip. */
  .hero__eyebrow {
    display: inline-block;
    margin: 0 0 18px;
    padding: 0 0 0 16px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--muted-text);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 800;
    color: var(--heading-text);
    margin: 0 0 24px;
    line-height: 0.96;
    letter-spacing: -0.035em;
  }

  .hero__title :global(strong) {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-primary);
    visibility: hidden;
    letter-spacing: -0.035em;
  }

  .hero__title :global(.typewriter-cursor) {
    display: inline-block;
    width: 3px;
    height: 0.9em;
    background: var(--color-primary);
    margin-left: 4px;
    vertical-align: text-bottom;
    animation: blink 0.8s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--muted-text);
    max-width: 560px;
    margin: 0 0 48px;
    line-height: 1.55;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
    background: var(--color-primary);
    color: white;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px color-mix(in srgb, var(--color-primary) 40%, transparent);
  }

  .hero__btn-label-mono {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--muted-text);
    padding-bottom: 4px;
    border-bottom: 1px solid var(--divider-color);
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .hero__btn-label-mono:hover {
    color: var(--heading-text);
    border-color: var(--heading-text);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 100px 16px 60px;
    }
  }
</style>

<script>
  let typed = false

  function typewrite() {
    if (typed) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const strong = document.querySelector('.hero__title strong')
      if (strong) strong.style.visibility = 'visible'
      typed = true
      return
    }

    const strong = document.querySelector('.hero__title strong')
    if (!strong) return

    const text = strong.textContent || ''
    strong.textContent = ''
    strong.style.visibility = 'visible'

    const cursor = document.createElement('span')
    cursor.className = 'typewriter-cursor'
    strong.insertAdjacentElement('afterend', cursor)
    typed = true

    let i = 0
    const interval = setInterval(() => {
      if (i >= text.length) {
        clearInterval(interval)
        setTimeout(() => cursor.remove(), 2500)
        return
      }
      strong.textContent += text[i]
      i++
    }, 80)
  }

  typewrite()
  document.addEventListener('astro:page-load', typewrite)
</script>
