---
import Icon from '../icons/Icon.astro'
import { parseBold } from '../../utils/markup'
import type { Lang } from '../../types'
import { t } from '../../lib/i18n'

interface Props {
  data: {
    title: string
    text: string
  }
  lang?: Lang
}

const { data, lang = 'en' } = Astro.props
const titleHtml = parseBold(data.title)
---

<section class="hero" data-scroll-anchor="home-hero" data-scroll-anchor-progress="0" data-animate="fade-slide-up">
  <div class="hero__inner">
    <span class="hero__eyebrow">
      {/* TODO: localise this later */}
      {t('home_hero_eyebrow', lang)}
    </span>
    <h1 class="hero__title" set:html={titleHtml} />

    <p class="hero__subtitle">{data.text}</p>

    <div class="hero__cta">
      <a href="/projects/" class="hero__btn">
        <Icon name="rocket" size={18} color="currentColor" />
        {t('home_hero_cta_work', lang)}
        <Icon name="arrow-right" size={16} color="currentColor" class="icon-chevron" />
      </a>
      <a href="/services/" class="hero__btn-label-mono">
        {t('home_hero_cta_services', lang)}
      </a>
    </div>
  </div>
</section>

<style>
  /* Hero — Space Grotesk display + Fraunces accent word + Inter lead.
     Typewriter still targets strong; only the type stack/spacing change. */
  .hero {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7.5rem 1.5rem 5rem;
    position: relative;
    z-index: 1;
  }

  .hero__inner {
    text-align: start;
    max-width: 920px;
    width: 100%;
  }

  .hero__eyebrow {
    display: inline-block;
    margin: 0 0 23px;
    padding-inline-start: 16px;
    font-family: var(--font-display);
    font-size: var(--type-eyebrow);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--muted-text);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 9vw + 0.75rem, 6rem);
    font-weight: 700;
    color: var(--heading-text);
    margin: 0 0 1.75rem;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero__title :global(strong) {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 500;
    font-optical-sizing: auto;
    font-synthesis: none;
    color: var(--color-primary);
    letter-spacing: 0;
  }

  .hero__title :global(.typewriter-cursor) {
    display: inline-block;
    width: 3px;
    height: 0.9em;
    background: var(--color-primary);
    margin-inline-start: 4px;
    vertical-align: text-bottom;
    animation: blink 0.8s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: var(--type-lead);
    font-weight: 400;
    color: var(--muted-text);
    max-width: 560px;
    margin: 0 0 38px;
    line-height: 1.5;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    border-radius: 9999px;
    font-family: var(--font-display);
    font-size: var(--type-body-sm);
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
    background: var(--color-primary);
    color: white;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px color-mix(in srgb, var(--color-primary) 40%, transparent);
  }

  .hero__btn-label-mono {
    font-family: var(--font-display);
    font-size: var(--type-eyebrow);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--muted-text);
    padding-bottom: 4px;
    border-bottom: 1px solid var(--divider-color);
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .hero__btn-label-mono:hover {
    color: var(--heading-text);
    border-color: var(--heading-text);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 6rem 1rem 3.75rem;
    }

    .hero__cta {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .hero__btn {
      min-height: 3rem;
    }
  }

  /* RTL: flip directional chevrons so they point along the reading direction. */
  [dir="rtl"] .hero__cta .icon-chevron :global(svg) {
    transform: scaleX(-1);
  }
</style>

<script>
  // Typewriter for the hero accent word ("best" / «الأفضل» / …).
  //
  // Astro ClientRouter fires `astro:page-load` on the first visit AND after
  // every navigation (see Astro view-transitions guide). Calling typewrite()
  // both immediately and on page-load used to tear down the in-flight interval
  // then bail on dataset.typed — leaving the accent word empty. One listener
  // only. GSAP TextPlugin types character-by-character; kill() on swap.
  import gsap from 'gsap'
  import { TextPlugin } from 'gsap/TextPlugin'

  gsap.registerPlugin(TextPlugin)

  let tween: gsap.core.Tween | null = null
  let holdTimer: ReturnType<typeof setTimeout> | null = null
  let failSafe: ReturnType<typeof setTimeout> | null = null
  let activeCursor: HTMLElement | null = null
  let activeStrong: HTMLElement | null = null

  function fullText(el: HTMLElement): string {
    return (el.dataset.typewriter || el.textContent || '').trim()
  }

  function reveal(el: HTMLElement, text: string): void {
    el.textContent = text
    el.style.visibility = 'visible'
  }

  function teardown(): void {
    tween?.kill()
    tween = null
    if (holdTimer) {
      clearTimeout(holdTimer)
      holdTimer = null
    }
    if (failSafe) {
      clearTimeout(failSafe)
      failSafe = null
    }
    if (activeCursor) {
      activeCursor.remove()
      activeCursor = null
    }
    if (activeStrong) {
      const text = fullText(activeStrong)
      if (text) reveal(activeStrong, text)
      activeStrong = null
    }
  }

  function typewrite(): void {
    teardown()

    const strong = document.querySelector<HTMLElement>('.hero__title strong')
    if (!strong) return

    if (!strong.dataset.typewriter) {
      strong.dataset.typewriter = (strong.textContent || '').trim()
    }
    const text = strong.dataset.typewriter
    if (!text) {
      strong.style.visibility = 'visible'
      return
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      reveal(strong, text)
      return
    }

    activeStrong = strong
    strong.textContent = ''
    strong.style.visibility = 'visible'

    const cursor = document.createElement('span')
    cursor.className = 'typewriter-cursor'
    cursor.setAttribute('aria-hidden', 'true')
    strong.insertAdjacentElement('afterend', cursor)
    activeCursor = cursor

    failSafe = setTimeout(() => {
      if (activeStrong === strong && (strong.textContent || '').length < text.length) {
        tween?.kill()
        tween = null
        reveal(strong, text)
        cursor.remove()
        if (activeCursor === cursor) activeCursor = null
      }
    }, Math.max(2500, text.length * 80 + 800))

    tween = gsap.to(strong, {
      duration: Math.max(0.5, text.length * 0.08),
      text: { value: text, delimiter: '' },
      ease: 'none',
      onComplete: () => {
        if (failSafe) {
          clearTimeout(failSafe)
          failSafe = null
        }
        holdTimer = setTimeout(() => {
          cursor.remove()
          if (activeCursor === cursor) activeCursor = null
        }, 2500)
      },
    })
  }

  document.addEventListener('astro:page-load', typewrite)
  document.addEventListener('astro:before-swap', teardown)
</script>

<noscript>
  <style>
    .hero__title strong {
      visibility: visible;
    }
  </style>
</noscript>
