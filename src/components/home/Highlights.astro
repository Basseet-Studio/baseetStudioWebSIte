---
// Highlights.astro — "Why Choose Baseet" presented as a boarding pass.
//
// Inspired by the airline ticket design from
// docs/refrences/stitch stuff/tickert-info.html (lines 188-286) — kept the
// ticket shape (notches + dashed perforation + stub with barcode) and
// re-skinned it in our existing card-window palette so it sits on the
// Vanta cloud background like everything else. No glassmorphism, no
// backdrop-filter. All "elements on top" — the Vanta clouds remain
// untouched below the ticket.
//
// The 4 home.json highlights become 4 boarding-pass detail slots
// (Departure / Cabin / Duration / Status) so the existing data flows
// through unchanged.
import Icon from '../icons/Icon.astro'
import { resolveIcon } from '../icons/iconMappings'
import type { Lang, Highlight } from '../../types'
import { t } from '../../lib/i18n'

interface Props {
  highlights: Highlight[]
  lang?: Lang
}

const { highlights, lang = 'en' } = Astro.props

// The 4 highlights become the 4 "boarding details" slots. We map them to
// fixed ticket labels so the data stays semantic — every highlight gets
// a slot no matter how many the data has (1–4).
const TICKET_SLOTS = [
  { eyebrow: 'Departure', label: 'Track record' },
  { eyebrow: 'Cabin', label: 'Active platforms' },
  { eyebrow: 'Duration', label: 'Avg partnership' },
  { eyebrow: 'Status', label: 'Team composition' },
] as const

// Fallback when there are fewer/more than 4 highlights in data.
function slotFor(i: number) {
  return TICKET_SLOTS[i] ?? { eyebrow: `Slot ${i + 1}`, label: 'Highlight' }
}

// FA-class strings so resolveIcon() can map them to the actual Phosphor
// glyph names we have in /public/icons/regular/.
const slotIcons = [
  'fas fa-rocket',
  'fas fa-layer-group',
  'fas fa-handshake',
  'fas fa-users',
]
---

<section class="why" data-scroll-anchor="home-highlights" data-scroll-anchor-progress="0.14" data-animate="fade-slide-up" aria-labelledby="why-heading">
  <header class="why__head">
    <span class="why__eyebrow">
      <span class="why__eyebrow-dot" aria-hidden="true"></span>
      {t('home_highlights_title', lang)}
    </span>
    <h2 class="why__heading" id="why-heading">
      Four things, done <span class="why__heading-accent">properly.</span>
    </h2>
    <p class="why__sub">
      {/* TODO: localise this later */}
      A boarding pass is the right shape for a promise. Here's ours.
    </p>
  </header>

  <div class="ticket" role="group" aria-label="Why choose Baseet — boarding pass summary">
    {/* Soft shadow plate behind the ticket — the only "background" element.
        Sits behind everything, never touches the Vanta layer above. */}
    <div class="ticket__shadow" aria-hidden="true"></div>

    {/* ===== Main ticket body (left) ===== */}
    <div class="ticket__main">
      {/* Header row: Carrier + Gate */}
      <div class="ticket__row ticket__row--header">
        <div class="ticket__cell">
          <span class="ticket__eyebrow">Carrier</span>
          <h3 class="ticket__carrier">BASEET STUDIO</h3>
        </div>
        <div class="ticket__cell ticket__cell--right">
          <span class="ticket__eyebrow">Gate</span>
          <span class="ticket__gate">ABU&nbsp;DHABI</span>
        </div>
      </div>

      {/* Route row — three cells: From | flight glyph | To */}
      <div class="ticket__row ticket__row--route">
        <div class="ticket__cell">
          <span class="ticket__eyebrow">From</span>
          <span class="ticket__value ticket__value--route">IDEA</span>
          <span class="ticket__code">BRIEF.01</span>
        </div>
        <div class="ticket__route-glyph" aria-hidden="true">
          <Icon name="paper-plane-tilt" size={28} color="var(--color-primary)" />
          <span class="ticket__route-line"></span>
          <span class="ticket__route-cap">Aesthetic&nbsp;Precision</span>
        </div>
        <div class="ticket__cell ticket__cell--right">
          <span class="ticket__eyebrow">To</span>
          <span class="ticket__value ticket__value--route">PRODUCT</span>
          <span class="ticket__code">SHIP.99</span>
        </div>
      </div>

      {/* Footer row — 4 boarding details (the metrics from home.json) */}
      <div class="ticket__row ticket__row--details">
        {highlights.slice(0, 4).map((item, i) => {
          const slot = slotFor(i)
          const glyph = resolveIcon(slotIcons[i] ?? 'fas fa-sparkles')
          return (
            <div class="ticket__detail">
              <span class="ticket__detail-icon" aria-hidden="true">
                <Icon name={glyph.name} variant={glyph.variant} size={16} color="currentColor" />
              </span>
              <span class="ticket__eyebrow">{slot.label}</span>
              <span class="ticket__detail-metric">{item.metric}</span>
              <span class="ticket__detail-label">{item.label}</span>
            </div>
          )
        })}
      </div>
    </div>

    {/* Vertical dashed perforation between main + stub */}
    <div class="ticket__perf-line" aria-hidden="true"></div>

    {/* ===== Ticket stub (right) — barcode + flight meta ===== */}
    <aside class="ticket__stub" aria-label="Boarding pass stub">
      <div class="ticket__stub-top">
        <div class="ticket__cell">
          <span class="ticket__eyebrow">Flight</span>
          <span class="ticket__value">BS-2026</span>
        </div>
        <div class="ticket__cell">
          <span class="ticket__eyebrow">Seat</span>
          <span class="ticket__value">FRONT&nbsp;ROW</span>
        </div>
        <div class="ticket__cell">
          <span class="ticket__eyebrow">Boarding</span>
          <span class="ticket__value">NOW</span>
        </div>
      </div>

      <span class="ticket__stub-code">1001-BASEET-2026-STUDIO</span>
    </aside>
  </div>
</section>

<style>
  /* =============================================================
     Section shell
     ============================================================= */
  .why {
    padding: 80px 24px 64px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .why__head {
    max-width: 640px;
    margin: 0 auto 52px;
    text-align: left;
  }

  .why__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 12px;
    border-radius: 9999px;
    font-family: var(--font-display);
    font-size: var(--type-eyebrow);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 22%, transparent);
    margin-bottom: 23px;
  }

  .why__eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .why__heading {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: 700;
    color: var(--heading-text);
    margin: 0 0 28px;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .why__heading-accent {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 500;
    font-optical-sizing: auto;
    font-synthesis: none;
    color: var(--color-primary);
  }

  [lang="ar"] .why__heading-accent,
  [dir="rtl"] .why__heading-accent {
    font-family: var(--font-accent);
    font-style: normal;
  }

  .why__sub {
    font-family: var(--font-body);
    font-size: var(--type-lead);
    font-weight: 400;
    color: var(--muted-text);
    margin: 0;
    max-width: 56ch;
    line-height: 1.5;
  }

  /* =============================================================
     Ticket — boarding pass. Uses card-window tokens (day/night) per
     DESIGN.md; subtle stock tint only — clouds still show through.
     ============================================================= */
  .ticket {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 280px;
    --ticket-stub-w: 280px;
    --ticket-perf-x: calc(100% - var(--ticket-stub-w));
    /* Theme-aware stock — mixes card-window with a whisper of paper */
    --ticket-surface: color-mix(in srgb, var(--card-window-bg) 82%, var(--bg-page));
    --ticket-stub-surface: color-mix(in srgb, var(--color-primary) 5%, var(--card-window-bg));
    --ticket-detail-surface: color-mix(in srgb, var(--color-primary) 6%, transparent);
    --ticket-detail-border: color-mix(in srgb, var(--color-primary) 12%, transparent);
    background: var(--ticket-surface);
    border: 1px solid var(--card-window-border);
    border-radius: 22px;
    box-shadow: var(--card-window-shadow);
    overflow: visible;
    backdrop-filter: none;
    --notch-r: 30px;
    --perf-r: 10px;
    -webkit-mask:
      radial-gradient(circle var(--notch-r) at left 50%, transparent 98%, #000 100%),
      radial-gradient(circle var(--notch-r) at right 50%, transparent 98%, #000 100%),
      radial-gradient(circle var(--perf-r) at var(--ticket-perf-x) 0%, transparent 98%, #000 100%),
      radial-gradient(circle var(--perf-r) at var(--ticket-perf-x) 100%, transparent 98%, #000 100%),
      linear-gradient(#000, #000);
    -webkit-mask-composite: source-in;
    mask:
      radial-gradient(circle var(--notch-r) at left 50%, transparent 98%, #000 100%),
      radial-gradient(circle var(--notch-r) at right 50%, transparent 98%, #000 100%),
      radial-gradient(circle var(--perf-r) at var(--ticket-perf-x) 0%, transparent 98%, #000 100%),
      radial-gradient(circle var(--perf-r) at var(--ticket-perf-x) 100%, transparent 98%, #000 100%),
      linear-gradient(#000, #000);
    mask-composite: intersect;
  }

  [data-theme="night"] .ticket {
    --ticket-surface: color-mix(in srgb, var(--card-window-bg) 90%, var(--bg-page));
    --ticket-stub-surface: color-mix(in srgb, var(--color-primary) 8%, var(--card-window-bg));
    --ticket-detail-surface: color-mix(in srgb, var(--color-primary) 10%, transparent);
    --ticket-detail-border: color-mix(in srgb, var(--color-primary) 18%, transparent);
  }

  .ticket__shadow {
    position: absolute;
    inset: 18px;
    background: color-mix(in srgb, var(--heading-text) 6%, transparent);
    filter: blur(28px);
    border-radius: 22px;
    z-index: -1;
    pointer-events: none;
  }

  /* =============================================================
     Main ticket body
     ============================================================= */
  .ticket__main {
    position: relative;
    padding: 36px 40px 32px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }

  /* The dashed right edge on the main body, separating it from the
     stub. We can't use a border because of the rounded corners —
     instead we paint a 1px dashed line as a pseudo element. */
  .ticket__main::after {
    content: "";
    position: absolute;
    top: 16px;
    bottom: 16px;
    right: 0;
    width: 0;
    border-right: 2px dashed var(--divider-color);
    pointer-events: none;
  }

  .ticket__row {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  .ticket__row--header {
    grid-template-columns: 1fr 1fr;
  }
  .ticket__row--route {
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .ticket__row--details {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    align-items: stretch;
  }

  .ticket__cell {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .ticket__cell--right {
    text-align: right;
    align-items: flex-end;
  }
  [dir="rtl"] .ticket__cell--right {
    text-align: left;
    align-items: flex-start;
  }

  .ticket__eyebrow {
    font-family: var(--font-display);
    font-size: var(--type-caption);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted-text);
    font-weight: 600;
  }

  .ticket__carrier {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--heading-text);
    line-height: 1;
    text-transform: uppercase;
  }

  .ticket__gate {
    font-family: var(--font-display);
    font-size: var(--type-body);
    font-weight: 600;
    color: var(--heading-text);
    letter-spacing: 0.06em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .ticket__value {
    font-family: var(--font-display);
    font-size: var(--type-body);
    font-weight: 600;
    color: var(--heading-text);
    letter-spacing: 0.06em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .ticket__value--route {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .ticket__code {
    font-family: var(--font-display);
    font-size: var(--type-eyebrow);
    color: var(--muted-text);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    margin-top: 2px;
  }

  /* Route glyph — flight icon + dashed line + caption, between From/To */
  .ticket__route-glyph {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--color-primary);
    min-width: 120px;
  }

  .ticket__route-line {
    display: block;
    width: 100%;
    height: 0;
    border-top: 1.5px dashed color-mix(in srgb, var(--muted-text) 60%, transparent);
  }

  .ticket__route-cap {
    font-family: var(--font-display);
    font-size: var(--type-eyebrow);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--muted-text);
    white-space: nowrap;
  }

  /* ----- Detail slot (per highlight) — equal grid cells ----- */
  .ticket__detail {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 28px;
    border-radius: 14px;
    background: var(--ticket-detail-surface);
    border: 1px solid rgba(16, 24, 32, 0.12);
    min-width: 0;
    height: 100%;
  }

  .ticket__detail-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
    color: var(--color-primary);
    margin-bottom: 6px;
    flex-shrink: 0;
  }

  .ticket__detail-metric {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    font-weight: 700;
    line-height: 1;
    color: var(--heading-text);
    letter-spacing: -0.02em;
  }

  .ticket__detail-label {
    font-family: var(--font-body);
    font-size: var(--type-body-sm);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted-text);
    line-height: 1.4;
    margin-top: auto;
    text-transform: none;
  }

  .ticket__perf-line {
    display: none;
  }

  .ticket__stub {
    position: relative;
    padding: 36px 28px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    background: var(--ticket-stub-surface);
    border-radius: 0 22px 22px 0;
    min-width: 0;
  }
  [dir="rtl"] .ticket__stub {
    border-radius: 22px 0 0 22px;
  }

  .ticket__stub-top {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* QR placeholder removed — no half-solution, no fake square. The stub
     is just the flight/seat/boarding meta + the code line. */

  .ticket__stub-code {
    display: block;
    font-family: var(--font-display);
    font-size: var(--type-eyebrow);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted-text);
    text-align: center;
    margin-top: 8px;
    font-variant-numeric: tabular-nums;
  }

  /* =============================================================
     Responsive
     ============================================================= */
  @media (max-width: 860px) {
    .ticket {
      grid-template-columns: 1fr;
      --ticket-perf-x: 50%;
      -webkit-mask:
        linear-gradient(#000, #000);
      mask:
        linear-gradient(#000, #000);
    }

    .ticket__main {
      padding: 32px 28px 24px;
      gap: 22px;
    }

    .ticket__main::after {
      top: auto;
      right: 24px;
      bottom: 0;
      left: 24px;
      width: auto;
      height: 0;
      border-right: none;
      border-bottom: 2px dashed var(--divider-color);
    }

    .ticket__row--details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ticket__row--route {
      gap: 16px;
    }

    .ticket__stub {
      border-radius: 0 0 22px 22px;
      padding: 24px 28px 28px;
      gap: 18px;
    }
    [dir="rtl"] .ticket__stub {
      border-radius: 0 0 22px 22px;
    }
  }

  @media (max-width: 480px) {
    .why {
      padding: 56px 16px 48px;
    }

    .ticket__main {
      padding: 26px 22px 20px;
    }

    .ticket__row--header {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .ticket__cell--right {
      text-align: left;
      align-items: flex-start;
    }
    [dir="rtl"] .ticket__cell--right {
      text-align: right;
      align-items: flex-end;
    }

    .ticket__row--route {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .ticket__cell {
      text-align: center;
      align-items: center;
    }

    .ticket__route-glyph {
      min-width: 0;
    }

    .ticket__row--details {
      grid-template-columns: 1fr;
    }

    .ticket__stub {
      padding: 22px 22px 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .why__eyebrow-dot {
      animation: none;
    }
  }
</style>