---
// Highlights.astro — "Why Choose Baseet" presented as a boarding pass.
//
// Inspired by the airline ticket design from
// docs/refrences/stitch stuff/tickert-info.html (lines 188-286) — kept the
// ticket shape (notches + dashed perforation + stub with barcode) and
// re-skinned it in our existing card-window palette so it sits on the
// Vanta cloud background like everything else. No glassmorphism, no
// backdrop-filter. All "elements on top" — the Vanta clouds remain
// untouched below the ticket.
//
// The 4 home.json highlights become 4 boarding-pass detail slots
// (Departure / Cabin / Duration / Status) so the existing data flows
// through unchanged.
import Icon from '../icons/Icon.astro'
import { resolveIcon } from '../icons/iconMappings'
import type { Lang, Highlight } from '../../types'

interface Props {
  highlights: Highlight[]
  lang?: Lang
}

const { highlights, lang = 'en' } = Astro.props

// The 4 highlights become the 4 "boarding details" slots. We map them to
// fixed ticket labels so the data stays semantic — every highlight gets
// a slot no matter how many the data has (1–4).
const TICKET_SLOTS = [
  { eyebrow: 'Departure', label: 'Track record' },
  { eyebrow: 'Cabin', label: 'Active platforms' },
  { eyebrow: 'Duration', label: 'Avg partnership' },
  { eyebrow: 'Status', label: 'Team composition' },
] as const

// Fallback when there are fewer/more than 4 highlights in data.
function slotFor(i: number) {
  return TICKET_SLOTS[i] ?? { eyebrow: `Slot ${i + 1}`, label: 'Highlight' }
}

// FA-class strings so resolveIcon() can map them to the actual Phosphor
// glyph names we have in /public/icons/regular/.
const slotIcons = [
  'fas fa-rocket',
  'fas fa-layer-group',
  'fas fa-handshake',
  'fas fa-users',
]
---

<section class="why" data-animate="fade-slide-up" aria-labelledby="why-heading">
  <header class="why__head">
    <span class="why__eyebrow">
      <span class="why__eyebrow-dot" aria-hidden="true"></span>
      Why Choose Baseet
    </span>
    <h2 class="why__heading" id="why-heading">
      Four things, done <span class="why__heading-accent">properly.</span>
    </h2>
    <p class="why__sub">
      {/* TODO: localise this later */}
      A boarding pass is the right shape for a promise. Here's ours.
    </p>
  </header>

  <div class="ticket" role="group" aria-label="Why choose Baseet — boarding pass summary">
    {/* Soft shadow plate behind the ticket — the only "background" element.
        Sits behind everything, never touches the Vanta layer above. */}
    <div class="ticket__shadow" aria-hidden="true"></div>

    {/* Left/right ticket notches — the half-circle indents that sell the
        "boarding pass" silhouette. Hidden on narrow screens where the
        layout collapses. */}
    <div class="ticket__notch ticket__notch--left" aria-hidden="true"></div>
    <div class="ticket__notch ticket__notch--right" aria-hidden="true"></div>

    {/* Perforation circles that frame the dashed line between main ticket
        and stub. Rendered outside the dashed border so they sit on top. */}
    <span class="ticket__perf ticket__perf--top" aria-hidden="true"></span>
    <span class="ticket__perf ticket__perf--bottom" aria-hidden="true"></span>

    {/* ===== Main ticket body (left) ===== */}
    <div class="ticket__main">
      {/* Header row: Carrier + Gate */}
      <div class="ticket__row ticket__row--header">
        <div class="ticket__cell">
          <span class="ticket__eyebrow">Carrier</span>
          <h3 class="ticket__carrier">BASEET STUDIO</h3>
        </div>
        <div class="ticket__cell ticket__cell--right">
          <span class="ticket__eyebrow">Gate</span>
          <span class="ticket__gate">ABU&nbsp;DHABI</span>
        </div>
      </div>

      {/* Route row — three cells: From | flight glyph | To */}
      <div class="ticket__row ticket__row--route">
        <div class="ticket__cell">
          <span class="ticket__eyebrow">From</span>
          <span class="ticket__value ticket__value--route">IDEA</span>
          <span class="ticket__code">BRIEF.01</span>
        </div>
        <div class="ticket__route-glyph" aria-hidden="true">
          <Icon name="paper-plane-tilt" size={28} color="var(--color-primary)" />
          <span class="ticket__route-line"></span>
          <span class="ticket__route-cap">Aesthetic&nbsp;Precision</span>
        </div>
        <div class="ticket__cell ticket__cell--right">
          <span class="ticket__eyebrow">To</span>
          <span class="ticket__value ticket__value--route">PRODUCT</span>
          <span class="ticket__code">SHIP.99</span>
        </div>
      </div>

      {/* Footer row — 4 boarding details (the metrics from home.json) */}
      <div class="ticket__row ticket__row--details">
        {highlights.slice(0, 4).map((item, i) => {
          const slot = slotFor(i)
          const glyph = resolveIcon(slotIcons[i] ?? 'fas fa-sparkles')
          return (
            <div class="ticket__detail">
              <span class="ticket__detail-icon" aria-hidden="true">
                <Icon name={glyph.name} variant={glyph.variant} size={16} color="currentColor" />
              </span>
              <span class="ticket__eyebrow">{slot.label}</span>
              <span class="ticket__detail-metric">{item.metric}</span>
              <span class="ticket__detail-label">{item.label}</span>
            </div>
          )
        })}
      </div>
    </div>

    {/* Vertical dashed perforation between main + stub */}
    <div class="ticket__perf-line" aria-hidden="true"></div>

    {/* ===== Ticket stub (right) — barcode + flight meta ===== */}
    <aside class="ticket__stub" aria-label="Boarding pass stub">
      <div class="ticket__stub-top">
        <div class="ticket__cell">
          <span class="ticket__eyebrow">Flight</span>
          <span class="ticket__value">BS-2026</span>
        </div>
        <div class="ticket__cell">
          <span class="ticket__eyebrow">Seat</span>
          <span class="ticket__value">FRONT&nbsp;ROW</span>
        </div>
        <div class="ticket__cell">
          <span class="ticket__eyebrow">Boarding</span>
          <span class="ticket__value">NOW</span>
        </div>
      </div>

      <div class="ticket__stub-qr" aria-label="QR code — easter egg, leads elsewhere">
        {/* QR code image goes here. Drop a square PNG/SVG (e.g. qr.png or
            qr.svg) into /public/ and replace the <span> placeholder below
            with <img src="/qr.png" alt="" />. Currently sized at 168×168
            so a 512×512 source renders cleanly. */}
        <span class="ticket__stub-qr-placeholder" aria-hidden="true">
          <Icon name="barcode" size={72} color="currentColor" />
          <span class="ticket__stub-qr-hint">scan me</span>
        </span>
      </div>
      <span class="ticket__stub-code">1001-BASEET-2026-STUDIO</span>
    </aside>
  </div>
</section>

<style>
  /* =============================================================
     Section shell
     ============================================================= */
  .why {
    padding: 80px 24px 64px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .why__head {
    max-width: 640px;
    margin: 0 auto 48px;
    text-align: left;
  }

  .why__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 12px;
    border-radius: 9999px;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 22%, transparent);
    margin-bottom: 20px;
  }

  .why__eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .why__heading {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    font-weight: 400;
    color: var(--heading-text);
    margin: 0 0 12px;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .why__heading-accent {
    color: var(--color-primary);
    font-style: italic;
  }

  [lang="ar"] .why__heading-accent,
  [dir="rtl"] .why__heading-accent {
    font-style: normal;
  }

  .why__sub {
    font-size: 1.05rem;
    color: var(--muted-text);
    margin: 0;
    max-width: 56ch;
    line-height: 1.55;
  }

  /* =============================================================
     Ticket — the boarding pass card.
     Two columns on desktop, single column on mobile. The notches
     live on the OUTSIDE edges so the dashed perforation stays
     visible between the two halves.
     ============================================================= */
  .ticket {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 280px;
    background: var(--card-window-bg);
    border: 1px solid var(--card-window-border);
    border-radius: 22px;
    box-shadow: var(--card-window-shadow);
    overflow: visible;
    backdrop-filter: none;
  }

  /* The shadow plate — a soft blurred slab sitting just behind the
     ticket. It is the only "background" piece on this section, and
     it sits BEHIND the ticket (z-index -1) so it never paints over
     the Vanta clouds. */
  .ticket__shadow {
    position: absolute;
    inset: 18px;
    background: rgba(0, 0, 0, 0.05);
    filter: blur(28px);
    border-radius: 22px;
    z-index: -1;
    pointer-events: none;
  }

  /* Half-circle notches at the edges. Bumped to 44×88 (was 28×56) so the
     cut-out reads at a glance, and made transparent so the Vanta clouds
     show through — they become real "windows" in the ticket rather than
     painted cut-outs. The notches sit above the ticket body so they
     punch through both the border and the surface.
     On narrow screens the layout collapses to one column and the
     notches are hidden. */
  .ticket__notch {
    position: absolute;
    top: 50%;
    width: 44px;
    height: 88px;
    transform: translateY(-50%);
    background: transparent;
    /* Solid border matches the ticket so the notch reads as an opening
       cut into the card. Inset shadow gives the cut edge a slight inner
       lip. */
    border-top: 1px solid var(--card-window-border);
    border-bottom: 1px solid var(--card-window-border);
    z-index: 3;
    pointer-events: none;
  }
  .ticket__notch--left {
    left: -22px;
    border-right: 1px solid var(--card-window-border);
    border-radius: 0 44px 44px 0;
    box-shadow: inset -8px 0 12px -8px rgba(0, 0, 0, 0.18);
  }
  .ticket__notch--right {
    right: -22px;
    border-left: 1px solid var(--card-window-border);
    border-radius: 44px 0 0 44px;
    box-shadow: inset 8px 0 12px -8px rgba(0, 0, 0, 0.18);
  }

  /* Perforation circles — round dots that flank the dashed line and
     sit on top of the border, matching the ticket reference. */
  .ticket__perf {
    position: absolute;
    width: 18px;
    height: 18px;
    background: transparent;
    border: 1px solid var(--card-window-border);
    border-radius: 50%;
    z-index: 4;
    pointer-events: none;
  }
  .ticket__perf--top {
    top: -9px;
    left: calc(100% - 280px - 9px);
  }
  .ticket__perf--bottom {
    bottom: -9px;
    left: calc(100% - 280px - 9px);
  }

  /* =============================================================
     Main ticket body
     ============================================================= */
  .ticket__main {
    position: relative;
    padding: 36px 40px 32px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }

  /* The dashed right edge on the main body, separating it from the
     stub. We can't use a border because of the rounded corners —
     instead we paint a 1px dashed line as a pseudo element. */
  .ticket__main::after {
    content: "";
    position: absolute;
    top: 16px;
    bottom: 16px;
    right: 0;
    width: 0;
    border-right: 2px dashed var(--divider-color);
    pointer-events: none;
  }

  .ticket__row {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  .ticket__row--header {
    grid-template-columns: 1fr 1fr;
  }
  .ticket__row--route {
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .ticket__row--details {
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .ticket__cell {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .ticket__cell--right {
    text-align: right;
    align-items: flex-end;
  }
  [dir="rtl"] .ticket__cell--right {
    text-align: left;
    align-items: flex-start;
  }

  .ticket__eyebrow {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted-text);
    font-weight: 600;
  }

  .ticket__carrier {
    font-family: var(--font-title);
    font-size: 1.45rem;
    letter-spacing: 0.02em;
    margin: 0;
    color: var(--heading-text);
    line-height: 1;
  }

  .ticket__gate {
    font-family: var(--font-title);
    font-size: 1.05rem;
    color: var(--heading-text);
    letter-spacing: 0.02em;
    line-height: 1.1;
  }

  .ticket__value {
    font-family: var(--font-title);
    font-size: 1rem;
    color: var(--heading-text);
    letter-spacing: 0.02em;
    line-height: 1.15;
  }

  .ticket__value--route {
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .ticket__code {
    font-size: 0.65rem;
    color: var(--muted-text);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    margin-top: 2px;
  }

  /* Route glyph — flight icon + dashed line + caption, between From/To */
  .ticket__route-glyph {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--color-primary);
    min-width: 120px;
  }

  .ticket__route-line {
    display: block;
    width: 100%;
    height: 0;
    border-top: 1.5px dashed color-mix(in srgb, var(--muted-text) 60%, transparent);
  }

  .ticket__route-cap {
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--muted-text);
    white-space: nowrap;
  }

  /* ----- Detail slot (per highlight) ----- */
  .ticket__detail {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 14px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
    min-width: 0;
  }

  .ticket__detail-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .ticket__detail-metric {
    font-family: var(--font-title);
    font-size: 1.55rem;
    line-height: 1;
    color: var(--heading-text);
    letter-spacing: -0.01em;
  }

  .ticket__detail-label {
    font-size: 0.72rem;
    color: var(--muted-text);
    line-height: 1.35;
  }

  /* =============================================================
     Stub
     ============================================================= */
  .ticket__perf-line {
    display: none; /* border pseudo on main is enough on desktop */
  }

  .ticket__stub {
    position: relative;
    padding: 36px 28px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    background: color-mix(in srgb, var(--color-primary) 4%, transparent);
    border-radius: 0 22px 22px 0;
    min-width: 0;
  }
  [dir="rtl"] .ticket__stub {
    border-radius: 22px 0 0 22px;
  }

  .ticket__stub-top {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* QR code area — placeholder for the user's image (easter-egg QR).
     Swap the inner <span class="ticket__stub-qr-placeholder"> for an
     <img src="/qr.png" alt="" /> when the asset is ready. The frame
     stays so the layout doesn't shift. */
  .ticket__stub-qr {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 168px;
    margin: 0 auto;
    background: var(--bg-page);
    border: 1px solid var(--card-window-border);
    border-radius: 6px;
    padding: 8px;
    color: var(--muted-text);
  }

  .ticket__stub-qr img,
  .ticket__stub-qr svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .ticket__stub-qr-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 100%;
    height: 100%;
    color: color-mix(in srgb, var(--muted-text) 70%, transparent);
  }

  .ticket__stub-qr-hint {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.24em;
  }

  .ticket__stub-code {
    display: block;
    font-size: 0.58rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--muted-text);
    text-align: center;
    margin-top: 8px;
    font-variant-numeric: tabular-nums;
  }

  /* =============================================================
     Responsive
     ============================================================= */
  @media (max-width: 860px) {
    .ticket {
      grid-template-columns: 1fr;
    }

    .ticket__notch--left,
    .ticket__notch--right {
      display: none;
    }

    .ticket__perf--top,
    .ticket__perf--bottom {
      display: none;
    }

    .ticket__main {
      padding: 32px 28px 24px;
      gap: 22px;
    }

    .ticket__main::after {
      top: auto;
      right: 24px;
      bottom: 0;
      left: 24px;
      width: auto;
      height: 0;
      border-right: none;
      border-bottom: 2px dashed var(--divider-color);
    }

    .ticket__row--details {
      grid-template-columns: repeat(2, 1fr);
    }

    .ticket__row--route {
      gap: 16px;
    }

    .ticket__stub {
      border-radius: 0 0 22px 22px;
      padding: 24px 28px 28px;
      gap: 18px;
    }
    [dir="rtl"] .ticket__stub {
      border-radius: 0 0 22px 22px;
    }
  }

  @media (max-width: 480px) {
    .why {
      padding: 56px 16px 48px;
    }

    .ticket__main {
      padding: 26px 22px 20px;
    }

    .ticket__row--header {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .ticket__cell--right {
      text-align: left;
      align-items: flex-start;
    }
    [dir="rtl"] .ticket__cell--right {
      text-align: right;
      align-items: flex-end;
    }

    .ticket__row--route {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .ticket__cell {
      text-align: center;
      align-items: center;
    }

    .ticket__route-glyph {
      min-width: 0;
    }

    .ticket__row--details {
      grid-template-columns: 1fr;
    }

    .ticket__stub {
      padding: 22px 22px 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .why__eyebrow-dot {
      animation: none;
    }
  }
</style>