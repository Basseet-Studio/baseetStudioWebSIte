---
import Icon from '../icons/Icon.astro'
import type { Lang } from '../../types'
import { t } from '../../lib/i18n'
import { localizeHref } from '../../lib/localize-href'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const contactHref = localizeHref(lang, '/contact/')
---

<section class="home-cta" data-animate="fade-slide-up">
  <div class="home-cta__inner">
    <h2 class="home-cta__title">{t('home_cta_title', lang)}</h2>
    <p class="home-cta__body">{t('home_cta_body', lang)}</p>
    <a href={contactHref} class="home-cta__button">
      {t('home_cta_button', lang)}
      <Icon name="arrow-right" size={16} color="currentColor" class="icon-chevron" />
    </a>
  </div>
</section>

<style>
  .home-cta {
    padding: 72px 24px;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .home-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .home-cta__title {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--heading-text);
    margin: 0;
    line-height: 1.1;
  }

  .home-cta__body {
    font-family: var(--font-body);
    font-size: var(--type-lead);
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
    max-width: 560px;
  }

  .home-cta__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 16px 32px;
    border-radius: 9999px;
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-display);
    font-size: var(--type-body-sm);
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .home-cta__button:hover,
  .home-cta__button:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px color-mix(in srgb, var(--color-primary) 40%, transparent);
    outline: none;
  }

  [dir="rtl"] .home-cta__button .icon-chevron :global(svg) {
    transform: scaleX(-1);
  }

  @media (max-width: 768px) {
    .home-cta {
      padding: 56px 16px;
    }
  }
</style>
