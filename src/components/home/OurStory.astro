---
import type { Lang } from '../../types'
import { t } from '../../lib/i18n'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
---

<section class="story" data-animate="fade-slide-up">
  <h2 class="story__title">{t('home_story_title', lang)}</h2>
  <p class="story__body">{t('home_story_body', lang)}</p>
</section>

<style>
  .story {
    padding: 64px 24px;
    max-width: 760px;
    margin: 0 auto;
  }

  .story__title {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--heading-text);
    margin: 0 0 22px;
    line-height: 1.1;
  }

  .story__body {
    font-family: var(--font-body);
    font-size: var(--type-lead);
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 768px) {
    .story {
      padding: 48px 16px;
    }
  }
</style>
