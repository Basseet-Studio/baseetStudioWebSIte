---
import Icon from '../icons/Icon.astro'
import { resolveIcon } from '../icons/iconMappings'
import type { Lang, ProjectSummary } from '../../types'

interface Props {
  projects: ProjectSummary[]
  lang?: Lang
}

const { projects, lang = 'en' } = Astro.props

function statusClass(status: string): string {
  switch (status) {
    case 'Live':
      return 'carousel__status--live'
    case 'Coming Soon':
      return 'carousel__status--soon'
    case 'Confidential':
      return 'carousel__status--confidential'
    default:
      return ''
  }
}
---

<section class="carousel" data-animate="fade-slide-up">
  <h2 class="carousel__heading">{/* TODO: localise this later */ 'Our Projects'}</h2>
  <div class="carousel__track">
    {projects.map((project) => (
      <a
        href={`/projects/${project.slug}/`}
        class="carousel__card glass glass-card"
        style={`border-left: 4px solid ${project.color}`}
      >
        <h3 class="carousel__name">{project.name}</h3>
        <p class="carousel__tagline">{/* TODO: localise this later */ project.tagline}</p>
        <span class={`carousel__status ${statusClass(project.status)}`}>{/* TODO: localise this later */ project.status}</span>
        <div class="carousel__platforms">
          {project.platforms.map((platform) => (
            <span class="carousel__platform-icon" title={platform.name}>
              <Icon name={resolveIcon(platform.icon).name} size={20} color="currentColor" />
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .carousel {
    padding: 80px 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .carousel__heading {
    font-size: 2rem;
    font-weight: 700;
    color: var(--heading-text);
    text-align: center;
    margin: 0 0 48px;
  }

  .carousel__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 8px;
  }

  .carousel__track::-webkit-scrollbar {
    height: 6px;
  }

  .carousel__track::-webkit-scrollbar-track {
    background: var(--surface-soft);
    border-radius: 3px;
  }

  .carousel__track::-webkit-scrollbar-thumb {
    background: var(--surface-strong);
    border-radius: 3px;
  }

  .carousel__card {
    flex: 0 0 320px;
    scroll-snap-align: start;
    padding: 24px;
    border-radius: 12px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .carousel__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
  }

  .carousel__name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--heading-text);
    margin: 0;
  }

  .carousel__tagline {
    font-size: 0.875rem;
    color: var(--muted-text);
    margin: 0;
    line-height: 1.5;
    flex: 1;
  }

  .carousel__status {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
    width: fit-content;
  }

  .carousel__status--live {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
  }

  .carousel__status--soon {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
  }

  .carousel__status--confidential {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
  }

  .carousel__platforms {
    display: flex;
    gap: 12px;
    font-size: 1.125rem;
    color: var(--color-secondary);
    opacity: 0.7;
  }

  .carousel__platform-icon {
    transition: opacity 0.2s ease;
  }

  .carousel__platform-icon:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .carousel__card {
      flex: 0 0 280px;
    }

    .carousel {
      padding: 60px 16px;
    }
  }
</style>
