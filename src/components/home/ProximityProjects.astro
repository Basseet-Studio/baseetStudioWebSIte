---
// Home projects grid — logo + name per tile, using the same built logo
// SVGs as the work page app bar (/projects/logos/{slug}.svg).

import type { Lang, ProjectSummary } from '../../types'

interface Props {
  projects: ProjectSummary[]
  lang?: Lang
}

const { projects, lang = 'en' } = Astro.props
---

<section class="px" id="px-stage" aria-labelledby="px-heading">
  <h2 class="px__heading" id="px-heading">Our Projects</h2>

  <ul class="px__grid" role="list">
    {projects.map((project) => (
      <li class="px__item">
        <a
          href={`/projects/${project.slug}/`}
          class="px__tile"
          aria-label={`View ${project.name}`}
          style={`--px-color: ${project.color};`}
        >
          <span class="px__logo-wrap">
            <img
              class="px__logo"
              src={`/projects/logos/${project.slug}.svg`}
              alt=""
              width="72"
              height="72"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="px__label">{project.name}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .px {
    padding: 80px 24px 64px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .px__heading {
    font-family: 'Rammetto One', 'Rambla', system-ui, sans-serif;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    text-align: center;
    margin: 0 0 40px;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .px__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: clamp(24px, 4vw, 40px);
    justify-items: center;
  }

  .px__item {
    width: 100%;
    max-width: 140px;
  }

  .px__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--text-primary);
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .px__logo-wrap {
    width: 87px;
    height: 87px;
    display: grid;
    place-items: center;
  }

  .px__logo {
    width: 72px;
    height: 72px;
    object-fit: contain;
    display: block;
    transition: transform 0.25s ease;
  }

  .px__label {
    font-family: 'Rambla', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    line-height: 1.2;
    color: var(--text-secondary);
    transition: color 0.25s ease;
  }

  .px__tile:hover,
  .px__tile:focus-visible {
    transform: translateY(-2px);
    outline: none;
  }

  .px__tile:hover .px__logo,
  .px__tile:focus-visible .px__logo {
    transform: scale(1.06);
  }

  .px__tile:hover .px__label,
  .px__tile:focus-visible .px__label {
    color: var(--px-color);
  }

  .px__tile:focus-visible .px__logo-wrap {
    outline: 2px solid var(--px-color);
    outline-offset: 4px;
    border-radius: var(--r-small, 12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .px__tile,
    .px__logo,
    .px__label {
      transition: none;
    }

    .px__tile:hover,
    .px__tile:focus-visible {
      transform: none;
    }

    .px__tile:hover .px__logo,
    .px__tile:focus-visible .px__logo {
      transform: none;
    }
  }
</style>
