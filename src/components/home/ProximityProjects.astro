---
// Home projects grid — logo + name per tile, using the same built logo
// SVGs as the work page app bar (/projects/logos/{slug}.svg).

import type { Lang, ProjectSummary } from '../../types'
import { t } from '../../lib/i18n'

interface Props {
  projects: ProjectSummary[]
  lang?: Lang
}

const { projects, lang = 'en' } = Astro.props
---

<section class="px" id="px-stage" aria-labelledby="px-heading">
  <h2 class="px__heading" id="px-heading">{t('home_projects_title', lang)}</h2>

  <ul class="px__grid" role="list">
    {projects.map((project) => (
      <li class="px__item">
        <a
          href={`/projects/${project.slug}/`}
          class="px__tile card-window"
          aria-label={t('home_projects_view', lang, { name: project.name })}
          style={`--px-color: ${project.color};`}
        >
          <span class="px__logo-wrap">
            <img
              class="px__logo"
              src={`/projects/logos/${project.slug}.svg`}
              alt=""
              width="64"
              height="64"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="px__label">{project.name}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .px {
    padding: 80px 24px 64px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .px__heading {
    font-family: var(--font-title);
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    text-align: center;
    margin: 0 0 40px;
    color: var(--heading-text);
    letter-spacing: -0.01em;
  }

  .px__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    gap: clamp(20px, 3vw, 32px);
    justify-items: center;
  }

  .px__item {
    width: 100%;
    max-width: 148px;
  }

  .px__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 18px 14px 16px;
    text-decoration: none;
    color: var(--text-primary);
    border-radius: var(--card-window-radius-tight);
    transition:
      color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .px__logo-wrap {
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
  }

  .px__logo {
    width: 64px;
    height: 64px;
    object-fit: contain;
    display: block;
    transition: transform 0.25s ease;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.08));
  }

  [data-theme="night"] .px__logo {
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.35));
  }

  .px__label {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    line-height: 1.25;
    color: var(--text-secondary);
    transition: color 0.25s ease;
  }

  .px__tile:hover,
  .px__tile:focus-visible {
    transform: translateY(-3px);
    outline: none;
    box-shadow: var(--card-window-shadow-hover);
    border-color: color-mix(in srgb, var(--px-color) 28%, var(--card-window-border));
  }

  .px__tile:hover .px__logo,
  .px__tile:focus-visible .px__logo {
    transform: scale(1.05);
  }

  .px__tile:hover .px__label,
  .px__tile:focus-visible .px__label {
    color: var(--px-color);
  }

  .px__tile:focus-visible {
    outline: 2px solid var(--px-color);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .px__tile,
    .px__logo,
    .px__label {
      transition: none;
    }

    .px__tile:hover,
    .px__tile:focus-visible {
      transform: none;
    }

    .px__tile:hover .px__logo,
    .px__tile:focus-visible .px__logo {
      transform: none;
    }
  }
</style>
