---
import ProfileCard from './ProfileCard.astro'
import type { Lang } from '../../types'
import { t } from '../../lib/i18n'

interface Props {
  members: Array<{
    name: string
    role: string
    bio?: string
    image: string
    iconPattern?: 'code' | 'money'
    social?: { github?: string; linkedin?: string; twitter?: string }
  }>
  lang?: Lang
}

const { members, lang = 'en' } = Astro.props

const ICON_PATTERNS = {
  code: '/images/home/team/iconpattern-code.svg',
  money: '/images/home/team/iconpattern-money.svg',
} as const

const platformMeta: Record<string, { label: string; icon: string; variant?: 'regular' | 'bold' | 'fill' }> = {
  github: { label: 'GitHub', icon: 'github-logo', variant: 'fill' },
  linkedin: { label: 'LinkedIn', icon: 'linkedin-logo', variant: 'fill' },
  twitter: { label: 'X (Twitter)', icon: 'x-logo', variant: 'fill' },
}

function visibleSocialLinks(social: Record<string, string | undefined> | undefined) {
  if (!social) return []
  return Object.entries(social)
    .filter(([platform, url]) => url && url !== '#' && platformMeta[platform])
    .map(([platform, url]) => ({
      platform,
      url: url as string,
      ...platformMeta[platform],
    }))
}
---

<section class="team" data-scroll-anchor="home-team" data-scroll-anchor-progress="0.85" data-animate="fade-slide-up">
  <h2 class="team__heading">{t('home_team_title', lang)}</h2>

  <div class="team__grid">
    {members.map((member) => {
      const pattern = member.iconPattern === 'money' ? 'money' : 'code'
      const socialLinks = visibleSocialLinks(member.social)
      const isCfo = pattern === 'money'

      return (
        <div class="team__card-slot" data-animate="fade-slide-up">
          <ProfileCard
            name={member.name}
            title={member.role}
            avatarUrl={member.image}
            iconUrl={ICON_PATTERNS[pattern]}
            socialLinks={socialLinks}
            behindGlowColor={isCfo ? 'rgba(251, 205, 55, 0.12)' : 'rgba(73, 107, 193, 0.14)'}
          />
        </div>
      )
    })}
  </div>
</section>

<script>
  import('../../scripts/profile-card').then((m) => {
    let destroy: (() => void) | undefined

    const run = () => {
      destroy?.()
      destroy = m.initProfileCards()
    }
    const stop = () => {
      destroy?.()
      destroy = undefined
      m.destroyProfileCards()
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run, { once: true })
    } else {
      run()
    }
    document.addEventListener('astro:page-load', run)
    document.addEventListener('astro:before-swap', stop)
  })
</script>

<style>
  .team {
    padding: 80px 24px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .team__heading {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--heading-text);
    text-align: center;
    margin: 0 0 52px;
    text-wrap: balance;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 28px 20px;
    justify-items: stretch;
    align-items: stretch;
    grid-auto-rows: 1fr;
  }

  .team__card-slot {
    width: 100%;
    max-width: 260px;
    margin-inline: auto;
    height: 100%;
    display: flex;
  }

  .team__card-slot :global(.pc-card-wrapper) {
    flex: 1;
    height: 100%;
    max-width: none;
  }

  @media (max-width: 640px) {
    .team {
      padding: 60px 16px;
    }

    .team__grid {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 24px 16px;
    }
  }
</style>
