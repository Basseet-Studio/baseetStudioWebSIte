---
// App bar brand mark — Baseet logo from the Logo Kit (public/brand/baseet-logo.png).
// The PNG is used as a MASK and painted with currentColor, so it follows the
// theme: dark navy by day, near-white at night (via --nav-text).
// Kept the old component name + props so AppBar.astro needs no changes.
interface Props {
  class?: string
  width?: number
  height?: number
}

// Source is 1120 x 708 -> aspect 1.582
const ASPECT = 1120 / 708
const { class: className = 'app-bar__logo-mark', height = 30 } = Astro.props
const width = Math.round(height * ASPECT)
---

<span
  class:list={[className, 'baseet-logo']}
  role="img"
  aria-hidden="true"
  style={`width:${width}px;height:${height}px;`}
></span>

<style is:global>
  .baseet-logo {
    display: block;
    flex-shrink: 0;
    background-color: currentColor;
    -webkit-mask: url('/brand/baseet-logo.png') center / contain no-repeat;
    mask: url('/brand/baseet-logo.png') center / contain no-repeat;
  }
</style>
