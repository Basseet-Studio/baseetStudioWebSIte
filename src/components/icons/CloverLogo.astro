---
// App bar brand mark — Baseet logo (balloon + clouds) from the Logo Kit.
// File: public/brand/baseet-logo.png (made by fix9/apply.sh with sips, 96px tall = 3x).
// Kept the old component name + props so AppBar.astro needs no changes.
interface Props {
  class?: string
  width?: number
  height?: number
}

// Source is 1120 x 708 -> aspect 1.582
const ASPECT = 1120 / 708
const { class: className = 'app-bar__logo-mark', height = 30 } = Astro.props
const width = Math.round(height * ASPECT)
---

<img
  class:list={[className, 'baseet-logo']}
  src="/brand/baseet-logo.png"
  alt=""
  width={width}
  height={height}
  decoding="async"
  aria-hidden="true"
  style={`width:${width}px;height:${height}px;`}
/>

<style is:global>
  .baseet-logo {
    display: block;
    object-fit: contain;
    flex-shrink: 0;
  }
</style>
