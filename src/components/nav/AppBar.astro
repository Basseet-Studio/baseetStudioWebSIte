---
// AppBar.astro — Adaptive glassmorphic floating pill navigation
import ThemeSwitcher from '../shared/ThemeSwitcher.astro'
import LangSwitcher from './LangSwitcher.astro'
import Icon from '../icons/Icon.astro'
import CloverLogo from '../icons/CloverLogo.astro'
import { resolveIcon } from '../icons/iconMappings'
import { SOURCE_SVGS } from '../../lib/sourceSvgs'
import { t } from '../../lib/i18n'
import { getFooterData } from '../../lib/home'
import links from '../../content/data/links.json'
import type { Lang, NavItem } from '../../types'
import { isRtl, langPrefix as localePrefix, localizedPath } from '../../lib/locale'

interface Props {
  lang?: Lang
  slug?: string
  projectName?: string
  projectColor?: string
  projectIconClass?: string
  projectNavItems?: NavItem[]
  projectNavMeta?: NavItem[]
}

const {
  lang = 'en',
  slug,
  projectName,
  projectColor,
  projectIconClass,
  projectNavItems,
  projectNavMeta,
} = Astro.props
const footerData = getFooterData(lang)
const isProject = !!projectName && !!(projectNavItems && projectNavItems.length > 0)
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'

const prefix = localePrefix(lang)
const projectRoot = `${prefix}/projects/${slug || ''}`.replace(/\/$/, '') || '/'

type ProjectNavEntry = NavItem & { fullUrl: string; isActive: boolean; dataKey: string }

const projectNav: ProjectNavEntry[] = isProject && projectNavItems
  ? projectNavItems.map(item => {
      const url = item.url || ''
      const fullUrl =
        url === ''
          ? `${projectRoot}/`
          : `${projectRoot}/${url.replace(/^\//, '')}`
      const normalizedFull = fullUrl.replace(/\/$/, '') || '/'
      const isActive =
        (url === '' && (pathname === projectRoot || pathname === projectRoot + '/')) ||
        (url !== '' && (pathname === normalizedFull || pathname === normalizedFull + '/' || pathname.startsWith(normalizedFull + '/')))
      return {
        ...item,
        fullUrl,
        isActive,
        dataKey: (item.i18nKey || item.label || url).toLowerCase().replace(/[^a-z0-9-]/g, '-'),
      }
    })
  : []

const projectIconResolved = projectIconClass
  ? resolveIcon(projectIconClass)
  : { name: 'cube', variant: 'regular' as const }

const normalizedPath = pathname.replace(/\/$/, '') || '/'
const appBarNavKeys = ['nav_home', 'nav_work', 'nav_services', 'nav_clients', 'nav_contact'] as const
type StandardNavEntry = { label: string; url: string; dataKey: string; isActive: boolean }
const standardNav: StandardNavEntry[] = appBarNavKeys.map((key) => {
  const link = footerData.links.find((item) => item.i18nKey === key)
  const bare = (link?.url ?? '/').replace(/\/$/, '') || '/'
  const url = localizedPath(lang, bare === '/' ? '/' : `${bare}/`).replace(/\/$/, '') || '/'
  const bareNorm = bare
  const pathBare = normalizedPath.replace(/^\/(ar|ur|hi|fil)(?=\/|$)/, '') || '/'
  const pathBareNorm = pathBare.replace(/\/$/, '') || '/'
  return {
    label: t(key, lang),
    url: url === '' ? '/' : (url.endsWith('/') ? url : `${url}/`),
    dataKey: key.replace('nav_', ''),
    isActive: pathBareNorm === bareNorm || pathBareNorm === bare,
  }
})

type ProjectMetaEntry = { key: string; label: string; url: string }
const defaultProjectMeta: ProjectMetaEntry[] = [
  { key: 'work', label: t('nav_work', lang), url: localizedPath(lang, '/projects/') },
  { key: 'contact', label: t('nav_contact', lang), url: localizedPath(lang, '/contact/') },
]
const projectMeta: ProjectMetaEntry[] = isProject && projectNavMeta?.length
  ? projectNavMeta.map((item) => ({
      key: (item.i18nKey || item.label).toLowerCase().replace(/[^a-z0-9-]/g, '-'),
      label: item.i18nKey ? t(item.i18nKey, lang) : item.label,
      url: localizedPath(lang, item.url || '/'),
    }))
  : defaultProjectMeta

const projectLogoSrc = slug && SOURCE_SVGS[slug]
  ? `/projects/logos/${slug}.svg`
  : null

const socialIconMap: Record<string, string> = {
  instagram: 'instagram-logo',
  linkedin: 'linkedin-logo',
  github: 'github-logo',
  twitter: 'x-logo',
}
const socialLabelMap: Record<string, string> = {
  instagram: 'Instagram',
  linkedin: 'LinkedIn',
  github: 'GitHub',
  twitter: 'X (Twitter)',
}
const socialLinks = (['instagram', 'linkedin', 'github', 'twitter'] as const)
  .filter(p => links.social[p] && links.social[p] !== '#')
  .map(p => ({ platform: p, icon: socialIconMap[p], label: socialLabelMap[p], url: links.social[p] as string }))
---

<a href="#main-content" class="skip-to-content">{t('skip_to_content', lang)}</a>

<nav
  class="app-bar app-bar--visible"
  id="app-bar"
  dir={isRtl(lang) ? 'rtl' : 'ltr'}
  aria-label={t('nav_main', lang)}
  data-is-project={isProject ? 'true' : 'false'}
  data-slug={slug || ''}
  data-project-color={projectColor || ''}
  style={isProject && projectColor ? `--project-color:${projectColor};` : ''}
  transition:name="app-bar"
  transition:persist
>
  <div class="app-bar__inner">
    {isProject ? (
      <>
        <a href={localizedPath(lang, '/')} class="app-bar__logo" aria-label={t('nav_back_home', lang)}>
          <CloverLogo />
        </a>
        <span class="app-bar__logo-divider" aria-hidden="true"></span>
        <a href={projectRoot} class="app-bar__project-mark" style={`color:${projectColor || 'var(--color-primary)'}`} aria-label={`${projectName || 'Project'} home`}>
          {projectLogoSrc ? (
            <img src={projectLogoSrc} alt="" class="app-bar__project-logo" width="22" height="22" aria-hidden="true" />
          ) : (
            <Icon name={projectIconResolved.name} variant={projectIconResolved.variant} size={22} color="currentColor" />
          )}
          {projectName && <span class="app-bar__project-name">{projectName}</span>}
        </a>
      </>
    ) : (
      <a href={localizedPath(lang, '/')} class="app-bar__logo" aria-label={t('nav_home_brand', lang)}>
        <CloverLogo />
      </a>
    )}

    <ul class="app-bar__links" id="app-bar-links">
      {isProject
        ? projectNav.map(item => (
            <li>
              <a
                href={item.fullUrl}
                class:list={['app-bar__link', { active: item.isActive }]}
                data-page={item.dataKey}
                aria-current={item.isActive ? 'page' : undefined}
              >
                <span class="app-bar__link-label">{item.i18nKey ? t(item.i18nKey, lang) : item.label}</span>
              </a>
            </li>
          ))
        : standardNav.map(item => (
            <li>
              <a
                href={item.url}
                class:list={['app-bar__link', { active: item.isActive }]}
                data-page={item.dataKey}
                aria-current={item.isActive ? 'page' : undefined}
              >
                <span class="app-bar__link-label">{item.label}</span>
              </a>
            </li>
          ))}
    </ul>

    {isProject && (
      <ul class="app-bar__meta">
        {projectMeta.map(meta => (
          <li>
            <a
              href={meta.url}
              class="app-bar__link app-bar__link--meta"
              data-page={meta.key}
            >
              <span class="app-bar__link-label">{meta.label}</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    <div class="app-bar__actions">
      <LangSwitcher lang={lang} />
      <ThemeSwitcher lang={lang} />
    </div>

    <div class="app-bar__social-links" aria-label={t('social_links', lang)}>
      {socialLinks.map(link => (
        <a
          href={link.url}
          class="app-bar__social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.label}
        >
          <Icon name={link.icon} variant="fill" size={14} color="currentColor" />
        </a>
      ))}
    </div>

    <button class="app-bar__mobile-toggle" id="mobile-toggle" aria-label={t('nav_toggle_menu', lang)} aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<style is:global>
  .app-bar[data-slug='geeb'] {
    --nav-max-width: 1280px;
  }

  .app-bar[data-slug='geeb'] .app-bar__link {
    padding: 8px 11px;
  }
</style>

<script>
  import '../nav/AppBar.ts'
</script>
