---
// Language switcher — custom in-site menu (not a native <select>).
import Icon from '../icons/Icon.astro'
import { t } from '../../lib/i18n'
import {
  LOCALES,
  htmlLang,
  isRtl,
  langFromPathname,
  localeLabel,
  localizedPath,
  stripLocalePrefix,
} from '../../lib/locale'
import type { Lang } from '../../types'

interface Props {
  lang?: Lang
}

const { lang: langProp } = Astro.props
const pathname = Astro.url.pathname
const lang = langProp ?? langFromPathname(pathname)
const barePath = stripLocalePrefix(pathname)
const label = t('lang_switcher_label', lang)
---

<div class="lang-switcher" data-lang-switcher>
  <button
    type="button"
    class="lang-switcher__trigger"
    data-lang-trigger
    popovertarget="lang-switcher-menu"
    popovertargetaction="toggle"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls="lang-switcher-menu"
    aria-label={label}
  >
    <span class="lang-switcher__current">{localeLabel(lang)}</span>
    <span class="lang-switcher__caret" aria-hidden="true">
      <Icon name="caret-down" size={14} color="currentColor" />
    </span>
  </button>
  <div
    id="lang-switcher-menu"
    class="lang-switcher__menu"
    data-lang-menu
    popover="auto"
    role="listbox"
    aria-label={label}
  >
    {LOCALES.map((code) => (
      <a
        href={localizedPath(code, barePath)}
        class:list={['lang-switcher__option', { 'is-active': code === lang }]}
        data-lang-option
        role="option"
        aria-selected={code === lang}
        hreflang={htmlLang(code)}
        lang={htmlLang(code)}
        dir={isRtl(code) ? 'rtl' : 'ltr'}
      >
        {localeLabel(code)}
      </a>
    ))}
  </div>
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    position: relative;
  }

  .lang-switcher__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0.45rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--heading-text) 14%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--heading-text) 6%, transparent);
    color: var(--heading-text);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .lang-switcher__trigger:hover {
    background: var(--nav-hover-bg, var(--interactive-hover));
  }

  .lang-switcher__trigger:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .lang-switcher__caret {
    display: inline-flex;
    transition: transform 200ms ease;
  }

  .lang-switcher.is-open .lang-switcher__caret {
    transform: rotate(180deg);
  }

  .lang-switcher__menu {
    position: fixed;
    inset: unset;
    margin: 0;
    padding: 0.35rem;
    min-width: 8rem;
    display: none;
    flex-direction: column;
    gap: 0.15rem;
    border: 1px solid var(--nav-border, var(--border-soft));
    border-radius: 18px;
    background: var(--nav-bg, var(--bg-elevated));
    box-shadow: var(--nav-shadow, var(--shadow-soft));
    z-index: 1100;
  }

  .lang-switcher__menu:popover-open,
  .lang-switcher__menu.is-open {
    display: flex;
  }

  .lang-switcher__option {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 0.85rem;
    border-radius: 12px;
    color: var(--nav-text, var(--heading-text));
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  .lang-switcher__option:hover,
  .lang-switcher__option:focus-visible {
    background: var(--nav-hover-bg, var(--interactive-hover));
    outline: none;
  }

  .lang-switcher__option.is-active {
    background: var(--nav-active-bg);
    color: var(--nav-active-text, var(--color-primary));
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-switcher__caret {
      transition: none;
    }
  }
</style>
