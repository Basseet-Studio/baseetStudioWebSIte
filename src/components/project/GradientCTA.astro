---
// GradientCTA.astro — closing call-to-action on project pages.
// Name kept for compatibility with existing imports. The card is now a calm,
// readable surface: heading-colour text on the elevated background, the
// studio primary button, and no decorative blur orbs (removed at source).
// `gradient`, `accentColor` and `decorated` are accepted but ignored so older
// callers keep compiling.
import type { Lang } from '../../types'

interface Props {
  title: string
  body?: string
  ctaLabel: string
  ctaHref: string
  gradient?: string
  accentColor?: string
  lang?: Lang
  decorated?: boolean
}

const { title, body, ctaLabel, ctaHref } = Astro.props
---

<section class="project-cta-section">
  <div class="project-cta-card">
    <div class="project-cta-content">
      <h2 class="project-cta-title">{title}</h2>
      {body && <p class="project-cta-text">{body}</p>}
    </div>
    <a href={ctaHref} class="project-cta-button">{ctaLabel}</a>
  </div>
</section>

<style>
  .project-cta-section { padding: 80px 24px; }
  .project-cta-card {
    max-width: 1072px;
    margin: 0 auto;
    padding: 48px;
    border-radius: 24px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-soft);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .project-cta-content { max-width: 620px; }
  .project-cta-title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--heading-text);
  }
  .project-cta-text { margin: 0; font-size: 1.05rem; line-height: 1.6; color: var(--muted-text); }
  .project-cta-button {
    display: inline-flex;
    align-items: center;
    padding: 14px 28px;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .project-cta-button:hover { background: color-mix(in srgb, var(--color-primary) 86%, #000); }
  .project-cta-button:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  @media (max-width: 640px) {
    .project-cta-section { padding: 56px 16px; }
    .project-cta-card { padding: 32px 24px; }
  }
</style>
