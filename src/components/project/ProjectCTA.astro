---
import Icon from '../icons/Icon.astro'
import type { Platform, Lang } from '../../types'
import { t } from '../../lib/i18n'
import { localizedPath } from '../../lib/locale'

interface Props {
  status: string
  platforms: Platform[]
  links?: { ios?: string; android?: string; web?: string }
  lang: Lang
}

const { status, platforms, links = {}, lang = 'en' } = Astro.props

// Per FR-033: only render a platform badge if its URL is real (not "#" / empty / missing).
function realLink(p: string): string | undefined {
  const key = p.toLowerCase() as 'ios' | 'android' | 'web'
  const url = links[key]
  if (url && url !== '#') return url
  return undefined
}

const platformIcons: Record<string, string> = {
  iOS: 'apple-logo',
  Android: 'android-logo',
  Web: 'globe',
}

const platformLabels: Record<string, string> = {
  iOS: 'App Store',
  Android: 'Google Play',
  Web: t('project_cta_platform_web', lang),
}

const visiblePlatforms = platforms.filter(p => realLink(p.name))
const contactHref = localizedPath(lang, '/contact/')
const [inquiryBefore, inquiryAfter = ''] = t('project_cta_confidential_contact', lang).split('{link}')
---

<section id="cta" class="project-cta" data-animate="fade-up">
  <div class="glass project-cta__card">
    {status === 'Coming Soon' && (
      <>
        <h2 style="font-size:1.75rem;font-weight:700;margin-bottom:12px;color:var(--heading-text);">{t('project_cta_coming_title', lang)}</h2>
        <p style="opacity:0.7;margin-bottom:24px;">{t('project_cta_coming_text', lang)}</p>
        {/* P1 audit #14 — uses the global .cta-btn--primary class. The
            background colour still comes from the per-project
            --project-color token so the waitlist button matches the page. */}
        <a href={contactHref} class="cta-btn--primary" style="background:var(--project-color, var(--color-primary));">
          {t('project_cta_coming_button', lang)}
        </a>
      </>
    )}

    {status === 'Ready to Deliver' && (
      <>
        <h2 style="font-size:1.75rem;font-weight:700;margin-bottom:12px;color:var(--heading-text);">{t('project_cta_ready_title', lang)}</h2>
        <p style="opacity:0.7;margin-bottom:24px;">{t('project_cta_ready_text', lang)}</p>
        <a href={contactHref} class="cta-btn--primary" style="background:var(--project-color, var(--color-primary));">
          {t('project_cta_ready_button', lang)}
        </a>
      </>
    )}

    {status === 'Live' && visiblePlatforms.length > 0 && (
      <>
        <h2 style="font-size:1.75rem;font-weight:700;margin-bottom:12px;color:var(--heading-text);">{t('project_cta_live_title', lang)}</h2>
        <p style="opacity:0.7;margin-bottom:24px;">{t('project_cta_live_text', lang)}</p>
        <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
          {visiblePlatforms.map(p => {
            const href = realLink(p.name)
            if (!href) return null
            return (
              <a
                href={href}
                class="cta-btn--primary"
                style="background:var(--project-color, var(--color-primary));"
              >
                <Icon name={platformIcons[p.name] || 'arrow-square-out'} size={18} color="white" />
                {platformLabels[p.name] || p.name}
              </a>
            )
          })}
        </div>
      </>
    )}

    {status === 'Confidential' && (
      <>
        <h2 style="font-size:1.75rem;font-weight:700;margin-bottom:12px;color:var(--heading-text);">{t('project_cta_confidential_title', lang)}</h2>
        <p style="opacity:0.7;margin-bottom:24px;">{t('project_cta_confidential_text', lang)}</p>
        <p style="font-size:0.85rem;opacity:0.5;">{inquiryBefore}<a href={contactHref} style="color:var(--project-color, var(--color-primary));">{t('project_cta_confidential_link', lang)}</a>{inquiryAfter}</p>
      </>
    )}

    {status === 'Completed' && (
      <>
        <h2 style="font-size:1.75rem;font-weight:700;margin-bottom:12px;color:var(--heading-text);">{t('project_cta_completed_title', lang)}</h2>
        <p style="opacity:0.7;margin-bottom:24px;">{t('project_cta_completed_text', lang)}</p>
      </>
    )}
  </div>
</section>
