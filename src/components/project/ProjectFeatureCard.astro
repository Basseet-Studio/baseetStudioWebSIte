---
// ProjectFeatureCard.astro — Reusable feature card for project pages
// Uses Phosphor icon in gradient circle, title, description

import Icon from '../icons/Icon.astro'

interface Props {
  title: string
  description: string
  iconName: string
  projectColor: string
  projectGradient: string
  index?: number
}

const { title, description, iconName, projectColor, projectGradient, index = 0 } = Astro.props
const delayStyle = index > 0 ? `animation-delay:${index * 0.05}s;` : ''
---

<div
  class="glass glass-card"
  style="padding:32px;border-radius:24px;transition:transform 0.3s,box-shadow 0.3s;animation:fadeInUp 0.6s ease-out forwards;opacity:0;${delayStyle}"
  data-animate="fade-up"
>
  <div
    style={`width:64px;height:64px;border-radius:16px;background:${projectGradient};display:flex;align-items:center;justify-content:center;margin-bottom:20px;font-size:1.5rem;`}
  >
    <Icon name={iconName} size={28} color="white" />
  </div>
  <h3 style="font-size:1.25rem;font-weight:600;margin-bottom:8px;color:var(--heading-text);">
    {title}
  </h3>
  <p style="font-size:0.9rem;color:var(--muted-text);line-height:1.6;">
    {description}
  </p>
</div>

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
