---
// ProjectFeatureCard.astro — Reusable feature card for project pages
// Uses Phosphor icon in gradient circle, title, description.
//
// Audit fixes baked in:
// - P1 audit #8 — `glass glass-card` was the default surface across every
//   project card. Replaced with the card-window tokens from DESIGN.md so
//   the Vanta clouds show through (Open Sky Rule). The card now lifts on
//   hover instead of starting elevated.

import Icon from '../icons/Icon.astro'

interface Props {
  title: string
  description: string
  iconName: string
  projectColor: string
  projectGradient: string
  index?: number
}

const { title, description, iconName, projectColor, projectGradient, index = 0 } = Astro.props
const delayStyle = index > 0 ? `animation-delay:${index * 0.05}s;` : ''
---

<div
  class="project-feature-card"
  style={delayStyle}
  data-animate="fade-up"
>
  <div
    class="project-feature-card__icon"
    style={`background:${projectGradient};`}
  >
    <Icon name={iconName} size={28} color="white" />
  </div>
  <h3 class="project-feature-card__title">
    {title}
  </h3>
  <p class="project-feature-card__description">
    {description}
  </p>
</div>

<style>
  .project-feature-card {
    /* P1 audit #8 — translucent surface, 1px cloud-tinted border, no
     * pre-applied shadow. Lifts on hover. Matches DESIGN.md's card-window
     * token (translucent so the Vanta clouds show through). */
    padding: 32px;
    border-radius: 24px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    box-shadow: var(--card-shadow);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }
  .project-feature-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--card-shadow-hover);
  }
  .project-feature-card:focus-within {
    transform: translateY(-3px);
    box-shadow: var(--card-shadow-hover);
  }
  .project-feature-card__icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .project-feature-card__title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--heading-text);
    line-height: 1.3;
  }
  .project-feature-card__description {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted-text);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Reduced motion: skip the entry animation. Hover lift is exempt as
   * DESIGN.md treats hover transforms as response, not choreography. */
  @media (prefers-reduced-motion: reduce) {
    .project-feature-card {
      animation: none;
      opacity: 1;
    }
  }
</style>
