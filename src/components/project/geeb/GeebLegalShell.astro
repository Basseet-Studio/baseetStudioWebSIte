---
import '../../../styles/projects/geeb.css'
import ProjectLayout from '../../../layouts/Project.astro'
import Icon from '../../icons/Icon.astro'
import { getProject } from '../../../lib/projects'
import type { Lang } from '../../../types'

interface Props {
  variant: 'hub' | 'doc'
  docType: 'terms' | 'privacy'
  audience?: 'customers' | 'vendors'
  lang?: Lang
}

const { variant, docType, audience, lang: langProp } = Astro.props
const pathname = Astro.url.pathname
const lang: Lang = langProp ?? (pathname.startsWith('/ar') ? 'ar' : 'en')
const slug = 'geeb'
const project = getProject(slug)
if (!project) return Astro.redirect('/404')

const base = `/${lang === 'ar' ? 'ar/' : ''}projects/geeb`

const docMeta = {
  terms: {
    title: 'Terms & Conditions',
    icon: 'file-text',
    hubLede: 'Choose the agreement that applies to you. Customer and vendor terms are separate because each role carries different responsibilities on Geeb.',
  },
  privacy: {
    title: 'Privacy Policy',
    icon: 'shield',
    hubLede: 'How Geeb handles data depends on whether you book services or provide them. Pick the policy written for your role.',
  },
} as const

const audienceMeta = {
  customers: {
    title: 'For customers',
    icon: 'user',
    desc: 'Booking, payments, reviews, and account data when you hire a pro through Geeb.',
  },
  vendors: {
    title: 'For vendors',
    icon: 'hard-hat',
    desc: 'Pro profiles, job routing, payouts, verification, and performance data when you work on Geeb.',
  },
} as const

const meta = docMeta[docType]
const pageTitle =
  variant === 'hub'
    ? meta.title
    : `${meta.title} — ${audienceMeta[audience!].title}`

const audienceKeys = ['customers', 'vendors'] as const

const loremSections = [
  {
    heading: 'Introduction',
    paragraphs: [
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.',
      'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.',
    ],
  },
  {
    heading: 'Your responsibilities',
    paragraphs: [
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer nec odio. Praesent libero. Sed cursus ante dapibus diam. Sed nisi. Nulla quis sem at nibh elementum imperdiet.',
      'Duis sagittis ipsum. Praesent mauris. Fusce nec tellus sed augue semper porta. Mauris massa. Vestibulum lacinia arcu eget nulla.',
    ],
  },
  {
    heading: 'Our commitments',
    paragraphs: [
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur sodales ligula in libero. Sed dignissim lacinia nunc. Curabitur tortor. Pellentesque nibh.',
      'Aenean quam. In scelerisque sem at dolor. Maecenas mattis. Sed convallis tristique sem. Proin ut ligula vel nunc egestas porttitor.',
    ],
  },
  {
    heading: 'Changes',
    paragraphs: [
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Morbi lectus risus, iaculis vel, suscipit quis, luctus non, massa. Fusce ac turpis quis ligula lacinia aliquet.',
    ],
  },
]
---

<ProjectLayout
  title={`${pageTitle} — ${project.name} — Baseet Studio`}
  description={`${pageTitle} — ${project.name}: ${project.tagline}`}
  slug={project.slug}
  projectColor={project.color}
  projectGradient={project.gradient}
  projectName={project.name}
  projectIconClass={project.iconClass}
  projectNavItems={project.navItems}
  projectNavMeta={project.navMetaItems}
  lang={lang}
>

  <section class="geeb-subhero">
    <div class="geeb-hero__glow geeb-hero__glow--a" aria-hidden="true"></div>

    <div class="geeb-subhero__inner">
      {variant === 'doc' && audience && (
        <nav class="geeb-legal-breadcrumb" aria-label="Breadcrumb">
          <a href={`${base}/${docType}/`}>{meta.title}</a>
          <span aria-hidden="true">/</span>
          <span>{audienceMeta[audience].title}</span>
        </nav>
      )}

      <span class="geeb-eyebrow">
        <Icon name={variant === 'doc' && audience ? audienceMeta[audience].icon : meta.icon} size={14} color="currentColor" />
        {variant === 'hub' ? meta.title : audienceMeta[audience!].title}
      </span>

      <h1 class="geeb-subhero__title" data-animate="fade-up">
        {variant === 'hub' ? meta.title : `${meta.title} for ${audience === 'customers' ? 'customers' : 'vendors'}`}
      </h1>

      <p class="geeb-subhero__lede" data-animate="fade-up">
        {variant === 'hub'
          ? meta.hubLede
          : `Placeholder ${docType === 'terms' ? 'terms' : 'privacy policy'} copy for Geeb ${audience === 'customers' ? 'customers' : 'vendors'}. Final legal text will replace this lorem ipsum before launch.`}
      </p>
    </div>
  </section>

  {variant === 'hub' && (
    <section class="geeb-content geeb-content--narrow">
      <div class="geeb-legal-hub">
        {audienceKeys.map((key) => (
          <a href={`${base}/${docType}/${key}/`} class="geeb-legal-hub__card" data-animate="fade-up">
            <div class="geeb-legal-hub__icon">
              <Icon name={audienceMeta[key].icon} size={24} color="currentColor" />
            </div>
            <h2 class="geeb-legal-hub__title">{audienceMeta[key].title}</h2>
            <p class="geeb-legal-hub__desc">{audienceMeta[key].desc}</p>
            <span class="geeb-legal-hub__cta">
              Read policy
              <Icon name="arrow-right" size={14} color="currentColor" />
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {variant === 'doc' && audience && (
    <section class="geeb-content geeb-content--narrow">
      <article class="geeb-legal-prose">
        {loremSections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((p) => <p>{p}</p>)}
          </section>
        ))}
      </article>
    </section>
  )}
</ProjectLayout>
