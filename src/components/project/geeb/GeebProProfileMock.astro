---
/** CSS pro profile card for the pro signup hero. */
---

<div class="geeb-pro-profile card-window" aria-label="Pro profile preview">
  <div class="geeb-pro-profile__header">
    <div class="geeb-pro-profile__avatar">MK</div>
    <div>
      <strong class="geeb-pro-profile__name">Musa Khalid</strong>
      <span class="geeb-pro-profile__trade">Licensed Plumber</span>
    </div>
    <span class="geeb-pro-profile__verified">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0l2.2 1.5L13 1l1 2.7L16 6v4l-2 2.3L13 15l-2.8-.5L8 16l-2.2-1.5L3 15l-1-2.7L0 10V6l2-2.3L3 1l2.8.5L8 0z"/></svg>
      Verified
    </span>
  </div>

  <div class="geeb-pro-profile__areas">
    <span class="geeb-pro-profile__area">Abu Dhabi</span>
    <span class="geeb-pro-profile__area">Al Reem</span>
    <span class="geeb-pro-profile__area">Khalifa City</span>
  </div>

  <div class="geeb-pro-profile__stats">
    <div>
      <span class="geeb-pro-profile__stat-val">4.9</span>
      <span class="geeb-pro-profile__stat-lbl">Rating</span>
    </div>
    <div>
      <span class="geeb-pro-profile__stat-val">12</span>
      <span class="geeb-pro-profile__stat-lbl">Jobs this month</span>
    </div>
    <div>
      <span class="geeb-pro-profile__stat-val">$2,340</span>
      <span class="geeb-pro-profile__stat-lbl">Earned</span>
    </div>
  </div>

  <div class="geeb-pro-profile__bar">
    <div class="geeb-pro-profile__bar-fill"></div>
  </div>
  <p class="geeb-pro-profile__bar-label">Profile completeness — 87%</p>
</div>
