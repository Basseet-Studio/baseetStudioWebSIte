---
import type { ProjectIndexCard } from '../../lib/projects'
import MatrixPreview from './previews/MatrixPreview.astro'
import MoneyBoxPreview from './previews/MoneyBoxPreview.astro'
import NumuPreview from './previews/NumuPreview.astro'
import BaseetIMSPreview from './previews/BaseetIMSPreview.astro'

interface Props {
  project: ProjectIndexCard
  layoutClass: string
}

const { project, layoutClass } = Astro.props
const hasVideo = Boolean(project.previewVideo)
const isInteractive = Boolean(project.previewInteractive)
const projectHref = `/projects/${project.slug}/`

const previewBgDay: Record<string, string> = {
  matrix: '#f3f4f6',
  moneybox: '#faf8f5',
  numu: '#f5f5fa',
  baseetims: '#0c1014',
}

const previewBgNight: Record<string, string> = {
  matrix: '#151820',
  moneybox: '#1a2420',
  numu: '#1e1a28',
  baseetims: '#0c1014',
}

/* Light-tone previews use dark caption text; dark-tone previews use light captions */
const previewTone: Record<string, 'light' | 'dark'> = {
  matrix: 'light',
  moneybox: 'light',
  numu: 'light',
  baseetims: 'dark',
}

const previewBgDayVal = project.previewInteractive
  ? previewBgDay[project.previewInteractive]
  : undefined
const previewBgNightVal = project.previewInteractive
  ? previewBgNight[project.previewInteractive]
  : undefined
const previewToneVal = project.previewInteractive
  ? previewTone[project.previewInteractive]
  : undefined

const tileClasses = [
  'wg',
  layoutClass,
  isInteractive && 'wg--interactive',
  isInteractive && previewToneVal === 'light' && 'wg--preview-light',
  isInteractive && previewToneVal === 'dark' && 'wg--preview-dark',
]
const tileStyle = previewBgDayVal
  ? `--wg-accent: ${project.color}; --wg-preview-bg-day: ${previewBgDayVal}; --wg-preview-bg-night: ${previewBgNightVal ?? previewBgDayVal}; --wg-preview-bg: ${previewBgDayVal};`
  : `--wg-accent: ${project.color};`
const TileTag = isInteractive ? 'article' : 'a'
const tileAttrs = isInteractive
  ? {}
  : { href: projectHref }
---

<TileTag
  {...tileAttrs}
  class:list={tileClasses}
  data-wg-tile
  style={tileStyle}
>
  <span class="wg__frame">
    <span class="wg__media">
      {isInteractive ? (
        <>
          {project.previewInteractive === 'matrix' && <MatrixPreview />}
          {project.previewInteractive === 'moneybox' && <MoneyBoxPreview />}
          {project.previewInteractive === 'numu' && <NumuPreview />}
          {project.previewInteractive === 'baseetims' && <BaseetIMSPreview />}
        </>
      ) : hasVideo ? (
        <video
          class="wg__visual"
          src={project.previewVideo!}
          poster={project.previewImage}
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        />
      ) : (
        <img
          class="wg__visual"
          src={project.previewImage}
          alt=""
          loading="lazy"
          decoding="async"
        />
      )}
    </span>

    <span class="wg__tint" aria-hidden="true"></span>

    <span class="wg__zip-frame" data-zip-frame aria-hidden="true"></span>

    <span class="wg__copy">
      {isInteractive ? (
        <a href={projectHref} class="wg__link">
          <span class="wg__name">{project.name}</span>
          <span class="wg__tagline">{project.tagline}</span>
          <span class="wg__open">Open project →</span>
        </a>
      ) : (
        <>
          <span class="wg__name">{project.name}</span>
          <span class="wg__tagline">{project.tagline}</span>
        </>
      )}
    </span>
  </span>
</TileTag>

<style>
  .wg {
    display: block;
    height: 100%;
    min-height: 0;
    text-decoration: none;
    color: #fff;
    position: relative;
    outline: none;
    border-radius: var(--wg-radius, var(--r-small, 12px));
  }

  .wg__frame {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: inherit;
    overflow: hidden;
    border-radius: inherit;
    background: color-mix(in srgb, var(--wg-accent) 8%, rgba(8, 12, 20, 0.35));
    transform: translateZ(0);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wg__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }

  .wg__visual {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    border-radius: inherit;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .wg--interactive .wg__frame {
    background: var(--wg-preview-bg);
  }

  :global([data-theme='night']) .wg--interactive .wg__frame {
    --wg-preview-bg: var(--wg-preview-bg-night, var(--wg-preview-bg-day));
    background: var(--wg-preview-bg);
  }

  .wg--interactive :global(.preview-stage) {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    background-color: var(--wg-preview-bg);
  }

  :global([data-theme='night']) .wg--interactive :global(.preview-stage) {
    background-color: var(--wg-preview-bg-night, var(--wg-preview-bg-day));
  }

  .wg__tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: linear-gradient(
      180deg,
      transparent 28%,
      rgba(6, 10, 18, 0.48) 68%,
      rgba(6, 10, 18, 0.9) 100%
    );
    pointer-events: none;
  }

  .wg--interactive .wg__tint {
    z-index: 3;
    top: auto;
    height: 38%;
    background: var(--wg-preview-bg);
    opacity: 0.94;
  }

  .wg--interactive.wg--preview-dark .wg__tint {
    background: var(--wg-preview-bg);
    opacity: 0.9;
  }

  .wg--preview-light .wg__name {
    color: var(--heading-text);
    text-shadow: none;
  }

  .wg--preview-light .wg__tagline {
    color: var(--muted-text);
  }

  .wg--preview-light .wg__open {
    color: var(--wg-accent);
  }

  .wg--preview-light .wg__link:focus-visible {
    outline-color: var(--wg-accent);
  }

  .wg--preview-dark .wg__name {
    color: var(--text-inverse);
    text-shadow: none;
  }

  .wg--preview-dark .wg__tagline {
    color: var(--text-secondary);
  }

  .wg--preview-dark .wg__open {
    color: var(--wg-accent);
  }

  .wg__zip-frame {
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: inherit;
    border: 2px solid var(--wg-accent);
    pointer-events: none;
    clip-path: inset(calc(100% - 2px) 0 0 0 round var(--wg-radius, var(--r-small, 12px)));
  }

  .wg.is-zipped .wg__zip-frame {
    clip-path: inset(0 round var(--wg-radius, var(--r-small, 12px)));
  }

  .wg__copy {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 5;
    padding: clamp(16px, 3vw, 28px);
    display: grid;
    gap: 6px;
    pointer-events: none;
  }

  .wg__link {
    display: grid;
    gap: 6px;
    text-decoration: none;
    color: inherit;
    pointer-events: auto;
  }

  .wg__link:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.85);
    outline-offset: 3px;
    border-radius: var(--r-small, 12px);
  }

  .wg__name {
    font-family: var(--font-title);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .wg__tagline {
    font-size: clamp(0.85rem, 1.6vw, 0.98rem);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
    max-width: 36ch;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s ease,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wg__open {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.65);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wg:hover .wg__frame,
  .wg:focus-within .wg__frame {
    transform: translateY(-3px);
  }

  .wg:hover .wg__visual,
  .wg:focus-within .wg__visual {
    transform: scale(1.04);
  }

  .wg--interactive:hover .wg__visual,
  .wg--interactive:focus-within .wg__visual {
    transform: none;
  }

  .wg:hover .wg__tagline,
  .wg:focus-within .wg__tagline,
  .wg:hover .wg__open,
  .wg:focus-within .wg__open {
    opacity: 1;
    transform: translateY(0);
  }

  a.wg:focus-visible .wg__frame {
    outline: 2px solid rgba(255, 255, 255, 0.85);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .wg__frame,
    .wg__visual,
    .wg__tagline,
    .wg__open {
      transition: none;
    }

    .wg__tagline,
    .wg__open {
      opacity: 1;
      transform: none;
    }
  }
</style>
