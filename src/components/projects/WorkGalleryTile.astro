---
import type { ProjectIndexCard } from '../../lib/projects'
import MatrixPreview from './previews/MatrixPreview.astro'
import MoneyBoxPreview from './previews/MoneyBoxPreview.astro'
import NumuPreview from './previews/NumuPreview.astro'
import BaseetIMSPreview from './previews/BaseetIMSPreview.astro'
import { localizeHref } from '../../lib/localize-href'
import { t } from '../../lib/i18n'
import type { Lang } from '../../types'

interface Props {
  project: ProjectIndexCard
  layoutClass: string
  lang?: Lang
}

const { project, layoutClass, lang = 'en' } = Astro.props
const hasVideo = Boolean(project.previewVideo)
const isInteractive = Boolean(project.previewInteractive)
const projectHref = localizeHref(lang, `/projects/${project.slug}/`)

const previewBgDay: Record<string, string> = {
  matrix: '#f3f4f6',
  moneybox: '#faf8f5',
  numu: '#f5f5fa',
  invexo: '#f4f6f8',
}

const previewBgNight: Record<string, string> = {
  matrix: '#151820',
  moneybox: '#1a2420',
  numu: '#1e1a28',
  invexo: '#080c10',
}

/* Light-tone previews use dark caption text; dark-tone previews use light captions */
const previewTone: Record<string, 'light' | 'dark'> = {
  matrix: 'light',
  moneybox: 'light',
  numu: 'light',
  invexo: 'light',
}

const previewBgDayVal = project.previewInteractive
  ? previewBgDay[project.previewInteractive]
  : undefined
const previewBgNightVal = project.previewInteractive
  ? previewBgNight[project.previewInteractive]
  : undefined
const previewToneVal = project.previewInteractive
  ? previewTone[project.previewInteractive]
  : undefined

const tileClasses = [
  'wg',
  layoutClass,
  isInteractive ? 'wg--interactive' : 'wg--static',
  isInteractive && previewToneVal === 'light' && 'wg--preview-light',
  isInteractive && previewToneVal === 'dark' && 'wg--preview-dark',
]
const tileStyle = previewBgDayVal
  ? `--wg-accent: ${project.color}; --wg-preview-bg-day: ${previewBgDayVal}; --wg-preview-bg-night: ${previewBgNightVal ?? previewBgDayVal};`
  : `--wg-accent: ${project.color};`
const TileTag = isInteractive ? 'article' : 'a'
const tileAttrs = isInteractive
  ? {}
  : { href: projectHref }
---

<TileTag
  {...tileAttrs}
  class:list={tileClasses}
  data-wg-tile
  style={tileStyle}
>
  <span class="wg__frame">
    <span class="wg__media">
      {isInteractive ? (
        <>
          {project.previewInteractive === 'matrix' && <MatrixPreview />}
          {project.previewInteractive === 'moneybox' && <MoneyBoxPreview />}
          {project.previewInteractive === 'numu' && <NumuPreview />}
          {project.previewInteractive === 'invexo' && <BaseetIMSPreview />}
        </>
      ) : hasVideo ? (
        <video
          class="wg__visual"
          src={project.previewVideo!}
          poster={project.previewImage}
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        />
      ) : (
        <img
          class="wg__visual"
          src={project.previewImage}
          alt=""
          loading="lazy"
          decoding="async"
        />
      )}
    </span>

    <span class="wg__tint" aria-hidden="true"></span>

    <span class="wg__zip-frame" data-zip-frame aria-hidden="true"></span>

    <span class="wg__copy">
      {isInteractive ? (
        <a href={projectHref} class="wg__link">
          <span class="wg__name">{project.name}</span>
          <span class="wg__meta">
            <span class="wg__tagline">{project.tagline}</span>
            <span class="wg__open">{t('projects_open', lang)}</span>
          </span>
        </a>
      ) : (
        <>
          <span class="wg__name">{project.name}</span>
          <span class="wg__meta">
            <span class="wg__tagline">{project.tagline}</span>
            <span class="wg__open">{t('projects_open', lang)}</span>
          </span>
        </>
      )}
    </span>
  </span>
</TileTag>

<style>
  .wg {
    display: block;
    width: 100%;
    min-height: 0;
    text-decoration: none;
    color: #fff;
    position: relative;
    outline: none;
    border-radius: var(--wg-radius, var(--r-small, 12px));
  }

  .wg__frame {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: inherit;
    overflow: hidden;
    border-radius: inherit;
    background: color-mix(in srgb, var(--wg-accent) 8%, rgba(8, 12, 20, 0.35));
    transform: translateZ(0);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wg__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }

  .wg__visual {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    border-radius: inherit;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .wg--interactive {
    --wg-preview-bg: var(--wg-preview-bg-day);
  }

  .wg--interactive .wg__frame {
    background: var(--wg-preview-bg);
  }

  :global([data-theme='night']) :global(.wg.wg--interactive) {
    --wg-preview-bg: var(--wg-preview-bg-night, var(--wg-preview-bg-day));
  }

  :global([data-theme='night']) .wg--interactive .wg__frame {
    background: var(--wg-preview-bg);
  }

  .wg--interactive :global(.preview-stage) {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    background-color: var(--wg-preview-bg);
  }

  .wg__tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
  }

  /* Static image/video tiles — theme-aware scrim + captions (same pattern as previews) */
  .wg--static {
    --wg-scrim: #f8f7f5;
    --wg-caption-name: #1c1917;
    --wg-caption-body: #57534e;
  }

  :global([data-theme='night']) :global(.wg.wg--static) {
    --wg-scrim: #0f141c;
    --wg-caption-name: #ebe8f4;
    --wg-caption-body: #a8a0c0;
  }

  .wg--static .wg__tint {
    z-index: 3;
    top: auto;
    height: 38%;
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--wg-scrim) 35%, transparent) 28%,
      color-mix(in srgb, var(--wg-scrim) 88%, transparent) 68%,
      var(--wg-scrim) 100%
    );
  }

  :global(.wg.wg--static) :global(.wg__name) {
    color: var(--wg-caption-name);
    text-shadow: none;
  }

  :global(.wg.wg--static) :global(.wg__tagline) {
    color: var(--wg-caption-body);
  }

  :global(.wg.wg--static) :global(.wg__open) {
    color: var(--wg-accent);
  }

  .wg--interactive .wg__tint {
    z-index: 3;
    top: auto;
    height: 34%;
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--wg-preview-bg-day) 30%, transparent) 28%,
      color-mix(in srgb, var(--wg-preview-bg-day) 85%, transparent) 68%,
      var(--wg-preview-bg-day) 100%
    );
    opacity: 1;
  }

  :global([data-theme='night']) :global(.wg.wg--interactive.wg--preview-light .wg__tint) {
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--wg-preview-bg-night) 25%, transparent) 22%,
      color-mix(in srgb, var(--wg-preview-bg-night) 82%, transparent) 62%,
      var(--wg-preview-bg-night) 100%
    );
  }

  .wg--preview-dark {
    --wg-scrim-day: #f8f7f5;
    --wg-scrim-night: var(--wg-preview-bg-night, #0c1014);
    --wg-caption-name: #1c1917;
    --wg-caption-body: #57534e;
  }

  :global([data-theme='night']) :global(.wg.wg--preview-dark) {
    --wg-caption-name: #ebe8f4;
    --wg-caption-body: #a8a0c0;
  }

  :global(.wg.wg--preview-dark) :global(.wg__name) {
    color: var(--wg-caption-name);
    text-shadow: none;
  }

  :global(.wg.wg--preview-dark) :global(.wg__tagline) {
    color: var(--wg-caption-body);
  }

  :global(.wg.wg--preview-dark) :global(.wg__open) {
    color: var(--wg-accent);
  }

  /* Dark-app previews (Invexo) — light scrim + dark text in day, dark scrim + light text at night */
  .wg--interactive.wg--preview-dark .wg__tint {
    z-index: 3;
    top: auto;
    height: 34%;
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--wg-scrim-day) 35%, transparent) 28%,
      color-mix(in srgb, var(--wg-scrim-day) 88%, transparent) 68%,
      var(--wg-scrim-day) 100%
    );
    opacity: 1;
  }

  :global([data-theme='night']) :global(.wg.wg--interactive.wg--preview-dark .wg__tint) {
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--wg-scrim-night) 30%, transparent) 25%,
      color-mix(in srgb, var(--wg-scrim-night) 85%, transparent) 65%,
      var(--wg-scrim-night) 100%
    );
  }

  .wg--preview-light {
    --wg-caption-name: #1c1917;
    --wg-caption-body: #57534e;
  }

  :global([data-theme='night']) :global(.wg.wg--preview-light) {
    --wg-caption-name: #ebe8f4;
    --wg-caption-body: #a8a0c0;
  }

  :global(.wg.wg--preview-light) :global(.wg__name) {
    color: var(--wg-caption-name);
    text-shadow: none;
  }

  :global(.wg.wg--preview-light) :global(.wg__tagline) {
    color: var(--wg-caption-body);
  }

  :global(.wg.wg--preview-light) :global(.wg__open) {
    color: var(--wg-accent);
  }

  .wg--preview-light .wg__link:focus-visible {
    outline-color: var(--wg-accent);
  }

  .wg--interactive .wg__zip-frame {
    display: none;
  }

  .wg__zip-frame {
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: inherit;
    border: 2px solid var(--wg-accent);
    pointer-events: none;
    clip-path: inset(calc(100% - 2px) 0 0 0 round var(--wg-radius, var(--r-small, 12px)));
  }

  .wg.is-zipped .wg__zip-frame {
    clip-path: inset(0 round var(--wg-radius, var(--r-small, 12px)));
  }

  .wg--interactive .wg__copy {
    padding: clamp(12px, 2.2vw, 20px);
  }

  .wg__copy {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 5;
    padding: clamp(16px, 3vw, 28px);
    display: grid;
    gap: 6px;
    pointer-events: none;
  }

  .wg__link {
    display: grid;
    gap: 4px;
    text-decoration: none;
    color: inherit;
    pointer-events: auto;
  }

  .wg__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(8px, 1.5vw, 14px);
    min-width: 0;
  }

  .wg--interactive.wg--preview-light :global(.wg__tagline),
  .wg--interactive.wg--preview-light :global(.wg__open) {
    color: var(--wg-caption-body);
  }

  .wg--interactive.wg--preview-light :global(.wg__open) {
    color: var(--wg-accent);
  }

  .wg--interactive.wg--preview-dark :global(.wg__tagline) {
    color: var(--wg-caption-body);
  }

  .wg--interactive.wg--preview-dark :global(.wg__open) {
    color: var(--wg-accent);
  }

  :global(.wg__tagline) {
    font-size: clamp(0.85rem, 1.6vw, 0.98rem);
    line-height: 1.35;
    flex: 1;
    min-width: 0;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.4s ease,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.wg__open) {
    font-size: clamp(0.72rem, 1.2vw, 0.8rem);
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s ease,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wg:hover .wg__frame,
  .wg:focus-within .wg__frame {
    transform: translateY(-3px);
  }

  .wg:hover .wg__visual,
  .wg:focus-within .wg__visual {
    transform: scale(1.04);
  }

  .wg--interactive:hover .wg__visual,
  .wg--interactive:focus-within .wg__visual {
    transform: none;
  }

  .wg__link:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.85);
    outline-offset: 3px;
    border-radius: var(--r-small, 12px);
  }

  :global(.wg__name) {
    font-family: var(--font-title);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* Fallback for tiles without explicit caption class — overridden above */
  .wg__name {
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  :global(.wg.wg--static) :global(.wg__name),
  :global(.wg.wg--preview-light) :global(.wg__name),
  :global(.wg.wg--preview-dark) :global(.wg__name) {
    text-shadow: none;
  }

  :global(.wg.wg--static) :global(.wg__tagline) {
    max-width: none;
  }

  .wg--static .wg__copy {
    padding: clamp(12px, 2.2vw, 20px);
    gap: 4px;
  }

  :global(.wg:hover) :global(.wg__tagline),
  :global(.wg:focus-within) :global(.wg__tagline),
  :global(.wg:hover) :global(.wg__open),
  :global(.wg:focus-within) :global(.wg__open) {
    opacity: 1;
    transform: translateY(0);
  }

  a.wg:focus-visible .wg__frame {
    outline: 2px solid rgba(255, 255, 255, 0.85);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .wg__frame,
    .wg__visual,
    .wg__tagline,
    .wg__open {
      transition: none;
    }

    .wg__tagline,
    .wg__open {
      opacity: 1;
      transform: none;
    }
  }
</style>
