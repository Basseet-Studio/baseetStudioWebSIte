---
import PreviewShell from './PreviewShell.astro'

const columns = [
  { id: 'todo', label: 'To Do' },
  { id: 'doing', label: 'In Prog' },
  { id: 'review', label: 'Review' },
  { id: 'done', label: 'Done' },
]

const sidebarNav = [
  { label: 'Tasks', active: true },
  { label: 'Projects', active: false },
  { label: 'Calendar', active: false },
]
---

<PreviewShell label="Interactive preview: Matrix task board" class="mx-preview" previewType="matrix">
  <div class="preview-canvas preview-canvas--matrix mx-preview__canvas">
    <aside class="mx-preview__sidebar" aria-hidden="true">
      <div class="mx-preview__sidebar-user">
        <span class="mx-preview__avatar">M</span>
        <span class="mx-preview__user-name">mohamed</span>
      </div>
      <nav class="mx-preview__sidebar-nav">
        {sidebarNav.map((item) => (
          <span class:list={['mx-preview__nav-item', item.active && 'mx-preview__nav-item--active']}>
            {item.label}
          </span>
        ))}
      </nav>
    </aside>

    <div class="mx-preview__main">
      <header class="mx-preview__topbar" aria-hidden="true">
        <span class="mx-preview__search">Search tasks, projects…</span>
        <span class="mx-preview__top-actions">
          <span class="mx-preview__new-btn">+ New</span>
          <span class="mx-preview__sun">☀</span>
        </span>
      </header>

      <div class="mx-preview__content">
        <div class="mx-preview__page-head">
          <div class="mx-preview__page-head-left">
            <span class="mx-preview__page-title">All Tasks</span>
            <span class="mx-preview__page-meta" data-task-count>6 tasks</span>
          </div>
          <div class="mx-preview__toolbar" aria-hidden="true">
            <span class="mx-preview__toolbar-pill mx-preview__toolbar-pill--active">Board</span>
            <span class="mx-preview__toolbar-pill">List</span>
            <span class="mx-preview__toolbar-btn">Filter</span>
          </div>
        </div>

        <div class="mx-preview__board" data-board>
          {columns.map((col) => (
            <div class="mx-preview__col" data-col={col.id}>
              <div class="mx-preview__col-label" data-col-label={col.id}>{col.label}</div>
              <div class="mx-preview__body" data-body={col.id}></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</PreviewShell>

<style>
  .mx-preview__canvas {
    --mx-bg: #f3f4f6;
    --mx-sidebar-bg: #ffffff;
    --mx-topbar-bg: #ffffff;
    --mx-content-bg: #f9fafb;
    --mx-brand: #2563eb;
    --mx-brand-soft: #dbeafe;
    --mx-muted: #6b7280;
    --mx-border: #e5e7eb;
    --mx-card-bg: #ffffff;
    --mx-card-text: #1f2937;
    --mx-shell-text: #111827;
    background-color: var(--mx-bg);
    font-family: var(--font-body);
    color: var(--mx-shell-text);
  }

  :global([data-theme='night']) .mx-preview__canvas {
    --mx-bg: #151820;
    --mx-sidebar-bg: #1a1f2b;
    --mx-topbar-bg: #1a1f2b;
    --mx-content-bg: #151820;
    --mx-brand: #60a5fa;
    --mx-brand-soft: #1e3a5f;
    --mx-muted: #94a3b8;
    --mx-border: #2a3140;
    --mx-card-bg: #222836;
    --mx-card-text: #e2e8f0;
    --mx-shell-text: #f1f5f9;
  }

  .mx-preview__sidebar {
    flex: 0 0 118px;
    background: var(--mx-sidebar-bg);
    border-right: 1px solid var(--mx-border);
    padding: 10px 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: none;
    min-height: 0;
  }

  .mx-preview__sidebar-user {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--mx-border);
  }

  .mx-preview__avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--mx-brand);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mx-preview__user-name {
    font-size: 11px;
    font-weight: 600;
    color: var(--mx-shell-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mx-preview__sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .mx-preview__nav-item {
    font-size: 11px;
    color: var(--mx-muted);
    padding: 5px 7px;
    border-radius: 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mx-preview__nav-item--active {
    background: var(--mx-brand-soft);
    color: var(--mx-brand);
    font-weight: 600;
  }

  .mx-preview__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: var(--mx-content-bg);
    min-height: 0;
  }

  .mx-preview__topbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    background: var(--mx-topbar-bg);
    border-bottom: 1px solid var(--mx-border);
    flex-shrink: 0;
    pointer-events: none;
  }

  .mx-preview__search {
    flex: 1;
    font-size: 11px;
    color: var(--mx-muted);
    background: var(--mx-bg);
    border: 1px solid var(--mx-border);
    border-radius: 999px;
    padding: 5px 10px;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mx-preview__top-actions {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
  }

  .mx-preview__new-btn {
    font-size: 11px;
    font-weight: 600;
    color: var(--mx-shell-text);
    border: 1px solid var(--mx-border);
    border-radius: 5px;
    padding: 3px 7px;
    background: var(--mx-card-bg);
  }

  .mx-preview__sun {
    font-size: 13px;
    line-height: 1;
  }

  .mx-preview__content {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 8px 10px 10px;
    gap: 6px;
  }

  .mx-preview__page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    gap: 8px;
  }

  .mx-preview__page-head-left {
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
  }

  .mx-preview__page-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--mx-shell-text);
  }

  .mx-preview__page-meta {
    font-size: 11px;
    color: var(--mx-muted);
  }

  .mx-preview__toolbar {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    pointer-events: none;
  }

  .mx-preview__toolbar-pill,
  .mx-preview__toolbar-btn {
    font-size: 10px;
    color: var(--mx-muted);
    padding: 3px 7px;
    border-radius: 4px;
    border: 1px solid var(--mx-border);
    background: var(--mx-card-bg);
  }

  .mx-preview__toolbar-pill--active {
    background: var(--mx-brand-soft);
    color: var(--mx-brand);
    border-color: transparent;
    font-weight: 600;
  }

  .mx-preview__board {
    display: flex;
    gap: 7px;
    flex: 1;
    min-height: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .mx-preview__board::-webkit-scrollbar {
    display: none;
  }

  .mx-preview__col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    min-height: 0;
  }

  .mx-preview__col-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--mx-muted);
    margin-bottom: 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 0;
  }

  .mx-preview__body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .mx-preview__body::-webkit-scrollbar {
    display: none;
  }

  :global(.mx-preview__card) {
    background: var(--mx-card-bg);
    border-radius: 6px;
    padding: 6px 7px;
    font-size: 11px;
    cursor: grab;
    line-height: 1.3;
    border: 1px solid var(--mx-border);
    border-left: 3px solid var(--mx-border-pri, #3b82f6);
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-shrink: 0;
  }

  :global(.mx-preview__card--high) {
    --mx-border-pri: #3b82f6;
  }

  :global(.mx-preview__card--medium) {
    --mx-border-pri: #f59e0b;
  }

  :global(.mx-preview__card--critical) {
    --mx-border-pri: #ef4444;
  }

  :global(.mx-preview__card-title) {
    color: var(--mx-card-text);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.mx-preview__pri) {
    align-self: flex-start;
    font-size: 9px;
    font-weight: 600;
    padding: 2px 5px;
    border-radius: 4px;
  }

  :global(.mx-preview__pri--high) {
    background: #fee2e2;
    color: #dc2626;
  }

  :global(.mx-preview__pri--medium) {
    background: #fef3c7;
    color: #d97706;
  }

  :global(.mx-preview__pri--critical) {
    background: #fce7f3;
    color: #db2777;
  }

  :global([data-theme='night'] .mx-preview__pri--high) {
    background: #3d2020;
    color: #fca5a5;
  }

  :global([data-theme='night'] .mx-preview__pri--medium) {
    background: #3d3020;
    color: #fcd34d;
  }

  :global([data-theme='night'] .mx-preview__pri--critical) {
    background: #3d2030;
    color: #f9a8d4;
  }
</style>
