---
import Icon from '../icons/Icon.astro'
import { meetingTypes, availability } from '../../config/booking'
import { t } from '../../lib/i18n'
import type { Lang } from '../../types'

interface Props {
  apiUrl: string
  lang: Lang
}

const { apiUrl, lang } = Astro.props

const copy = {
  timezone: t('booking_timezone', lang),
  slotsEmpty: t('booking_slots_empty', lang),
  slotsLoading: t('booking_slots_loading', lang),
  calendarLoading: t('booking_calendar_loading', lang),
  noMonthDays: t('booking_no_month_days', lang),
  pickDay: t('booking_pick_day', lang),
  more: t('booking_more', lang),
  less: t('booking_less', lang),
  submitting: t('booking_submitting', lang),
  confirm: t('booking_confirm', lang),
  successTitle: t('booking_success_title', lang),
  successLead: t('booking_success_lead', lang),
  errorGeneric: t('booking_error_generic', lang),
  errorSlotTaken: t('booking_error_slot_taken', lang),
  errorRateLimit: t('booking_error_rate_limit', lang),
  errorNetwork: t('booking_error_network', lang),
  errorName: t('booking_error_name', lang),
  errorEmail: t('booking_error_email', lang),
  errorPhone: t('booking_error_phone', lang),
  monthPrev: t('booking_month_prev', lang),
  monthNext: t('booking_month_next', lang),
}
---

<section
  class="booking"
  data-booking-root
  data-api-url={apiUrl}
  data-lang={lang}
  data-max-days-ahead={String(availability.maxDaysAhead)}
  data-animate="fade-up"
>
  <script type="application/json" data-booking-copy set:html={JSON.stringify(copy)} />

  <header class="booking__intro">
    <p class="booking__eyebrow">{t('booking_eyebrow', lang)}</p>
    <h2 class="booking__title">{t('booking_title', lang)}</h2>
    <p class="booking__lead">{t('booking_lead', lang)}</p>
  </header>

  <div class="booking__envelope" data-booking-success hidden>
    <div class="booking__paper" aria-hidden="true"></div>
    <div class="booking__letter booking__letter--success">
      <div class="booking__stamp" aria-hidden="true">
        <span class="booking__stamp-text">{t('booking_stamp', lang)}</span>
        <span class="booking__stamp-mark">
          <Icon name="calendar-check" size={26} color="currentColor" />
        </span>
        <span class="booking__stamp-rate">RSVP</span>
      </div>
      <p class="booking__success-title">{t('booking_success_title', lang)}</p>
      <p class="booking__success-when" data-booking-success-when></p>
      <p class="booking__success-lead" data-booking-success-lead></p>
      <div class="booking__success-actions">
        <a class="booking__submit" data-booking-ics href="#">{t('booking_add_to_calendar', lang)}</a>
        <button type="button" class="booking__ghost" data-booking-reset>
          {t('booking_book_another', lang)}
        </button>
      </div>
    </div>
  </div>

  <div class="booking__envelope" data-booking-panel>
    <div class="booking__paper" aria-hidden="true"></div>
    <div class="booking__letter">
      <div class="booking__stamp" aria-hidden="true">
        <span class="booking__stamp-text">{t('booking_stamp', lang)}</span>
        <span class="booking__stamp-mark">
          <Icon name="calendar-check" size={26} color="currentColor" />
        </span>
        <span class="booking__stamp-rate">RSVP</span>
      </div>
      <span class="booking__priority" aria-hidden="true">{t('booking_priority', lang)}</span>

      <div class="booking__grid">
        <div class="booking__col booking__col--when">
          <fieldset class="booking__types">
            <legend class="booking__label-mono">{t('booking_type_legend', lang)}</legend>
            {meetingTypes.map((type, index) => (
              <label class="booking__type" title={t(`booking_type_${type.id}_desc`, lang)}>
                <input type="radio" name="meetingType" value={type.id} checked={index === 0} />
                <span class="booking__type-check" aria-hidden="true"></span>
                <span class="booking__type-name">{t(`booking_type_${type.id}`, lang)}</span>
                <span class="booking__type-mins">{t('booking_duration', lang, { n: String(type.durationMinutes) })}</span>
                <span class="booking__sr">{t(`booking_type_${type.id}_desc`, lang)}</span>
              </label>
            ))}
          </fieldset>

          <div class="booking__cal-wrap">
            <div class="booking__cal-head">
              <p class="booking__label-mono">{t('booking_calendar_legend', lang)}</p>
              <div class="booking__month-nav">
                <button type="button" class="booking__nav" data-booking-prev aria-label={copy.monthPrev}>
                  <Icon name="arrow-left" size={18} color="currentColor" />
                </button>
                <h3 class="booking__month-label" data-booking-month-label></h3>
                <button type="button" class="booking__nav" data-booking-next aria-label={copy.monthNext}>
                  <Icon name="arrow-right" size={18} color="currentColor" />
                </button>
              </div>
            </div>
            <div class="booking__weekdays" data-booking-weekdays></div>
            <div class="booking__calendar" data-booking-calendar data-state="loading"></div>
            <p class="booking__tz" data-booking-tz></p>
          </div>
        </div>

        <div class="booking__divider" aria-hidden="true"></div>

        <div class="booking__col booking__col--who">
          <p class="booking__label-mono">{t('booking_slot_legend', lang)}</p>
          <div class="booking__slots" data-booking-slots hidden></div>
          <p class="booking__summary" data-booking-summary hidden></p>

          <form class="booking__form" data-booking-form data-booking-details hidden novalidate>
            <p class="booking__label-mono">{t('booking_details_legend', lang)}</p>
            <label class="booking__field" data-field="name">
              <span class="booking__label-mono">{t('booking_name', lang)}</span>
              <input
                id="booking-name"
                type="text"
                name="name"
                autocomplete="name"
                required
                maxlength="120"
                aria-describedby="booking-name-err"
              />
              <span id="booking-name-err" class="booking__field-hint" data-error="name"></span>
            </label>
            <label class="booking__field" data-field="email">
              <span class="booking__label-mono">{t('booking_email', lang)}</span>
              <input
                id="booking-email"
                type="email"
                name="email"
                autocomplete="email"
                required
                maxlength="254"
                aria-describedby="booking-email-err"
              />
              <span id="booking-email-err" class="booking__field-hint" data-error="email"></span>
            </label>
            <button
              type="button"
              class="booking__more"
              data-booking-extra-toggle
              aria-expanded="false"
              aria-controls="booking-extra"
            >
              {t('booking_more', lang)}
            </button>
            <div id="booking-extra" class="booking__extra" data-booking-extra hidden>
              <label class="booking__field" data-field="phone">
                <span class="booking__label-mono">
                  {t('booking_phone', lang)}
                  <em>{t('booking_phone_optional', lang)}</em>
                </span>
                <input
                  id="booking-phone"
                  type="tel"
                  name="phone"
                  autocomplete="tel"
                  aria-describedby="booking-phone-err"
                />
                <span id="booking-phone-err" class="booking__field-hint" data-error="phone"></span>
              </label>
              <label class="booking__field">
                <span class="booking__label-mono">
                  {t('booking_notes', lang)}
                  <em>{t('booking_phone_optional', lang)}</em>
                </span>
                <textarea
                  id="booking-notes"
                  name="notes"
                  rows="3"
                  maxlength="2000"
                  placeholder={t('booking_notes_placeholder', lang)}
                ></textarea>
              </label>
            </div>
            <div class="booking__hp" aria-hidden="true">
              <label>
                Website
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>
            <p class="booking__status" data-booking-status hidden role="status" aria-live="polite"></p>
            <button type="submit" class="booking__submit" data-booking-submit>
              {t('booking_confirm', lang)}
            </button>
            <p class="booking__signed">{t('booking_signed', lang)}</p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import('../../scripts/booking-widget').then((m) => {
    const run = () => m.initBookingWidget()
    const stop = () => m.destroyBookingWidget()
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run, { once: true })
    } else {
      run()
    }
    document.addEventListener('astro:page-load', run)
    document.addEventListener('astro:before-swap', stop)
  })
</script>

<style>
  .booking {
    max-width: 1080px;
    margin-inline: auto;
  }

  .booking__intro {
    text-align: center;
    margin: 0 auto 28px;
    max-width: 40rem;
  }

  .booking__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--paper-muted);
    margin: 0 0 10px;
  }

  .booking__title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--heading-text);
    margin: 0 0 10px;
    line-height: 1.15;
    text-wrap: balance;
  }

  .booking__lead {
    font-family: var(--font-body);
    font-size: var(--type-body);
    color: var(--muted-text);
    line-height: 1.55;
    margin: 0;
  }

  .booking__envelope {
    position: relative;
    padding: var(--space-md);
    background: var(--paper-cream);
    border-radius: var(--radius-envelope);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 55%, transparent) inset,
      0 50px 100px -24px rgba(28, 22, 14, 0.22),
      0 24px 48px -28px rgba(28, 22, 14, 0.14);
  }

  .booking__envelope::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: var(--space-md);
    background-image: repeating-linear-gradient(
      -45deg,
      var(--airmail-red) 0,
      var(--airmail-red) 14px,
      var(--paper-cream) 14px,
      var(--paper-cream) 28px,
      var(--airmail-blue) 28px,
      var(--airmail-blue) 42px,
      var(--paper-cream) 42px,
      var(--paper-cream) 56px
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .booking__paper {
    position: absolute;
    inset: var(--space-md);
    border-radius: var(--radius-paper);
    background: var(--paper-cream);
    filter: url(#paper-realistic);
    pointer-events: none;
    z-index: 0;
  }

  .booking__letter {
    position: relative;
    z-index: 2;
    color: var(--paper-ink);
    padding: 36px 48px 40px;
    min-height: 520px;
  }

  .booking__letter--success {
    min-height: 0;
    padding-block: 56px 40px;
    max-width: 36rem;
  }

  .booking__stamp {
    position: absolute;
    top: 18px;
    inset-inline-end: 18px;
    width: 88px;
    height: 100px;
    background: color-mix(in srgb, var(--paper-cream) 82%, var(--color-light));
    border: var(--radius-paper) dashed var(--paper-ink);
    padding: var(--space-sm) 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    transform: rotate(6deg);
    box-shadow: 0 6px 16px rgba(28, 22, 14, 0.14);
    z-index: 4;
    pointer-events: none;
  }

  .booking__stamp::before {
    content: '';
    position: absolute;
    inset: -6px;
    border: var(--radius-paper) dotted color-mix(in srgb, var(--paper-ink) 30%, transparent);
    pointer-events: none;
  }

  .booking__stamp-text {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--paper-ink) 60%, transparent);
  }

  .booking__stamp-mark {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--paper-ink);
    color: var(--paper-cream);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .booking__stamp-rate {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--paper-ink);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .booking__priority {
    position: absolute;
    inset-inline-end: 14px;
    top: 132px;
    transform: rotate(-90deg);
    transform-origin: right top;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper-muted) 60%, transparent);
    pointer-events: none;
    white-space: nowrap;
  }

  [dir='rtl'] .booking__priority {
    transform: rotate(90deg);
    transform-origin: left top;
  }

  [dir='rtl'] .booking__stamp {
    transform: rotate(-6deg);
  }

  .booking__grid {
    display: grid;
    grid-template-columns: 1.15fr 1px 0.85fr;
    gap: 36px;
    align-items: start;
    padding-top: var(--space-sm);
    padding-inline-end: 28px;
  }

  .booking__col {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
  }

  .booking__divider {
    width: 1px;
    align-self: stretch;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--paper-line) 18%,
      var(--paper-line) 82%,
      transparent 100%
    );
  }

  .booking__label-mono {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--paper-muted);
    font-weight: 500;
    display: block;
    margin: 0 0 10px;
    padding: 0;
  }

  .booking__types {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  .booking__types legend {
    width: 100%;
  }

  .booking__type {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--paper-ink);
    min-height: var(--touch-min);
    padding-inline-end: var(--space-xs);
    transition: opacity var(--transition-fast);
  }

  .booking__type:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .booking__type input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .booking__type-check {
    width: var(--space-md);
    height: var(--space-md);
    border: var(--radius-paper) solid var(--paper-ink);
    border-radius: var(--radius-paper);
    flex-shrink: 0;
    display: grid;
    place-items: center;
  }

  .booking__type:has(input:checked) .booking__type-check {
    background: var(--paper-ink);
  }

  .booking__type:has(input:checked) .booking__type-check::after {
    content: '';
    width: var(--space-sm);
    height: var(--space-xs);
    border-inline-start: var(--radius-paper) solid var(--paper-cream);
    border-bottom: var(--radius-paper) solid var(--paper-cream);
    transform: rotate(-45deg) translate(1px, -1px);
  }

  .booking__type:has(input:focus-visible) {
    outline: var(--radius-paper) solid var(--paper-ink);
    outline-offset: var(--space-xs);
    border-radius: var(--radius-paper);
  }

  .booking__type-name {
    font-weight: 500;
  }

  .booking__type-mins {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper-muted);
  }

  .booking__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .booking__cal-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-block-end: var(--space-sm);
  }

  .booking__cal-head .booking__label-mono {
    margin: 0;
  }

  .booking__month-nav {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .booking__month-label {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--paper-ink);
    margin: 0;
    min-width: 11ch;
    text-align: center;
  }

  .booking__nav {
    width: var(--touch-min);
    height: var(--touch-min);
    display: grid;
    place-items: center;
    border: 0;
    border-bottom: var(--radius-paper) dashed transparent;
    background: transparent;
    color: var(--paper-ink);
    cursor: pointer;
    border-radius: var(--radius-paper);
  }

  .booking__nav:hover:not(:disabled) {
    border-bottom-color: var(--paper-ink);
    color: var(--color-primary);
  }

  .booking__nav:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .booking__nav:focus-visible {
    outline: var(--radius-paper) solid var(--paper-ink);
    outline-offset: var(--radius-paper);
  }

  [dir='rtl'] .booking__nav :global(svg) {
    transform: scaleX(-1);
  }

  .booking__weekdays,
  .booking__calendar {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--space-xs);
  }

  .booking__weekdays span {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-muted);
    padding-block: 6px;
  }

  .booking__day {
    min-height: var(--touch-min);
    min-width: 0;
    aspect-ratio: 1;
    border: 0;
    border-radius: var(--radius-paper);
    background: transparent;
    color: var(--paper-ink);
    font-family: var(--font-display);
    font-size: 0.92rem;
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease;
  }

  .booking__day--pad {
    pointer-events: none;
  }

  .booking__day--skel {
    background: color-mix(in srgb, var(--paper-ink) 6%, transparent);
    animation: booking-pulse 1.2s ease-in-out infinite;
  }

  .booking__day:hover:not(:disabled) {
    background: color-mix(in srgb, var(--paper-ink) 8%, transparent);
  }

  .booking__day.is-today:not(.is-selected) {
    box-shadow: inset 0 0 0 var(--radius-paper) dashed color-mix(in srgb, var(--paper-ink) 45%, transparent);
  }

  .booking__day.is-selected {
    background: var(--paper-ink);
    color: var(--paper-cream);
  }

  .booking__day:disabled {
    color: color-mix(in srgb, var(--paper-muted) 55%, transparent);
    cursor: default;
  }

  .booking__day:focus-visible {
    outline: var(--radius-paper) solid var(--paper-ink);
    outline-offset: var(--radius-paper);
  }

  .booking__empty,
  .booking__hint,
  .booking__tz {
    margin: 10px 0 0;
    font-size: var(--type-caption);
    color: var(--paper-muted);
    line-height: 1.45;
  }

  .booking__empty {
    grid-column: 1 / -1;
  }

  .booking__slots {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .booking__slot {
    border: var(--radius-paper) solid var(--paper-ink);
    background: transparent;
    color: var(--paper-ink);
    border-radius: var(--radius-paper);
    padding: 10px 14px;
    font-family: var(--font-display);
    font-size: 0.9rem;
    cursor: pointer;
    min-height: var(--touch-min);
    transition: background 180ms ease, color 180ms ease;
  }

  .booking__slot:hover {
    background: color-mix(in srgb, var(--paper-ink) 8%, transparent);
  }

  .booking__slot.is-selected {
    background: var(--paper-ink);
    color: var(--paper-cream);
  }

  .booking__slot:focus-visible {
    outline: var(--radius-paper) solid var(--paper-ink);
    outline-offset: var(--radius-paper);
  }

  .booking__slot--skel {
    width: 5.5rem;
    pointer-events: none;
    border-color: transparent;
    background: color-mix(in srgb, var(--paper-ink) 6%, transparent);
    animation: booking-pulse 1.2s ease-in-out infinite;
  }

  .booking__summary {
    margin: 0;
    font-family: var(--font-handwriting);
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--paper-ink);
  }

  .booking__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-block-start: var(--space-xs);
  }

  .booking__field {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .booking__field .booking__label-mono {
    margin-bottom: 6px;
  }

  .booking__field em {
    font-style: normal;
    opacity: 0.7;
    letter-spacing: 0.12em;
  }

  .booking__field input,
  .booking__field textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--paper-ink);
    background: transparent;
    border: 0;
    border-bottom: var(--radius-paper) dashed var(--paper-line);
    border-radius: 0;
    padding: var(--space-sm) 0 12px;
    width: 100%;
    min-height: var(--touch-min);
  }

  .booking__field textarea {
    min-height: 5.5rem;
    resize: vertical;
  }

  .booking__field input:hover,
  .booking__field textarea:hover {
    border-bottom-color: color-mix(in srgb, var(--paper-ink) 50%, transparent);
  }

  .booking__field input:focus-visible,
  .booking__field textarea:focus-visible {
    outline: none;
    border-bottom-color: var(--paper-ink);
  }

  .booking__field[data-invalid='true'] input {
    border-bottom-color: color-mix(in srgb, var(--airmail-red) 55%, var(--paper-line));
  }

  .booking__field-hint {
    min-height: 1.1em;
