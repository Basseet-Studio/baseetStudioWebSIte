---
// ContactForm.astro — Form posts to links.json.forms.contact_form_url (Cloudflare Worker).
// The actionUrl is inlined into the client script via define:vars so the
// network call always uses the real endpoint (no DOM lookup that can fail).
//
// Visual: card-window surface (NOT glass — see absolute bans in DESIGN.md)
// with input fields that share a single class so the styles live in one
// place. Submit button is a primary pill, no Tailwind class soup.
import Icon from '../icons/Icon.astro'
import type { Lang } from '../../types'

interface Props {
  actionUrl: string
  lang: Lang
}

const { actionUrl, lang = 'en' } = Astro.props
---

<div class="contact-form card-window p-8 md:p-10" data-animate="fade-up">
  <form id="contact-form" class="contact-form__fields">
    <div class="contact-form__field">
      <label for="contact-name" class="contact-form__label">
        {/* TODO: localise this later */}
        Your Name *
      </label>
      <input
        type="text"
        id="contact-name"
        name="name"
        required
        minlength="2"
        class="contact-form__input"
        placeholder="John Doe"
      />
    </div>

    <div class="contact-form__field">
      <label for="contact-email" class="contact-form__label">
        {/* TODO: localise this later */}
        Email Address *
      </label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        class="contact-form__input"
        placeholder="john@example.com"
      />
    </div>

    <div class="contact-form__field">
      <label for="contact-phone" class="contact-form__label">
        {/* TODO: localise this later */}
        Phone (optional)
      </label>
      <input
        type="tel"
        id="contact-phone"
        name="phone"
        class="contact-form__input"
        placeholder="+971 50 123 4567"
      />
    </div>

    <div class="contact-form__field">
      <label for="contact-subject" class="contact-form__label">
        {/* TODO: localise this later */}
        Subject *
      </label>
      <input
        type="text"
        id="contact-subject"
        name="subject"
        required
        minlength="3"
        class="contact-form__input"
        placeholder="Project inquiry"
      />
    </div>

    <div class="contact-form__field contact-form__field--full">
      <label for="contact-message" class="contact-form__label">
        {/* TODO: localise this later */}
        Message *
      </label>
      <textarea
        id="contact-message"
        name="message"
        required
        minlength="10"
        rows="5"
        class="contact-form__input contact-form__textarea"
        placeholder="Tell us about your project..."
      ></textarea>
    </div>

    <div id="contact-form-status" class="contact-form__status" role="status" aria-live="polite"></div>

    <button
      type="submit"
      class="contact-form__submit"
    >
      {/* TODO: localise this later */}
      Send Message
      <Icon name="paper-plane-tilt" size={16} color="white" />
    </button>
  </form>
</div>

<script define:vars={{ actionUrl }}>
  // Per FR-032/033/034 the worker URL comes from links.json.forms.contact_form_url
  // and is inlined here at build time. The previous DOM-query implementation
  // returned an empty string when [data-form-action] was missing, so the
  // fetch posted to "" and the worker was never called.
  console.log('[ContactForm] Worker endpoint:', actionUrl || '(empty)');

  const form = document.getElementById('contact-form');
  const statusEl = document.getElementById('contact-form-status');

  if (!form) {
    console.error('[ContactForm] #contact-form not found in DOM');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    console.log('[ContactForm] Submit intercepted. Worker URL:', actionUrl);

    const formData = {
      name: form.querySelector('[name="name"]')?.value.trim(),
      email: form.querySelector('[name="email"]')?.value.trim(),
      phone: form.querySelector('[name="phone"]')?.value.trim() || undefined,
      subject: form.querySelector('[name="subject"]')?.value.trim(),
      message: form.querySelector('[name="message"]')?.value.trim(),
      lang: document.body.dataset.lang || 'en',
    };
    console.log('[ContactForm] Payload:', formData);

    if (!formData.name || formData.name.length < 2) {
      showStatus('Please enter your name.', 'error');
      return;
    }
    if (!formData.email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(formData.email)) {
      showStatus('Please enter a valid email.', 'error');
      return;
    }
    if (!formData.subject || formData.subject.length < 3) {
      showStatus('Please enter a subject.', 'error');
      return;
    }
    if (!formData.message || formData.message.length < 10) {
      showStatus('Message must be at least 10 characters.', 'error');
      return;
    }

    if (!actionUrl) {
      console.error('[ContactForm] actionUrl is empty — worker endpoint missing from links.json.forms.contact_form_url');
      showStatus('Form endpoint not configured. Please email us directly at baseet.socials@gmail.com.', 'error');
      return;
    }

    showStatus('Sending…', 'pending');

    try {
      console.log('[ContactForm] POST →', actionUrl);
      const response = await fetch(actionUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData),
        signal: AbortSignal.timeout(15000),
      });
      console.log('[ContactForm] Response status:', response.status, response.statusText);

      if (response.ok) {
        let body = null;
        try { body = await response.json(); } catch (_) { /* not JSON */ }
        console.log('[ContactForm] Response body:', body);
        showStatus('Thank you! Your message has been sent.', 'success');
        form.reset();
      } else {
        let errBody = null;
        try { errBody = await response.json(); } catch (_) { /* not JSON */ }
        console.error('[ContactForm] Worker rejected request:', response.status, errBody);
        showStatus((errBody && errBody.error) || `Worker returned ${response.status}. Please try again or email us directly.`, 'error');
      }
    } catch (err) {
      const name = err && err.name ? err.name : 'Error';
      const message = err && err.message ? err.message : String(err);
      console.error('[ContactForm] Network/fetch failure:', name, message, err);
      if (name === 'TimeoutError') {
        showStatus('Request timed out. Please try again or email us directly.', 'error');
      } else if (name === 'AbortError') {
        showStatus('Request cancelled.', 'error');
      } else {
        showStatus(`Unable to reach form worker (${name}). Please email us directly at baseet.socials@gmail.com.`, 'error');
      }
    }
  });

  function showStatus(message, type) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.dataset.type = type;
    statusEl.hidden = false;
  }
</script>

<style>
  /* The contact form lives inside a card-window. Inputs are simple,
     consistent, theme-aware (day / night via the existing tokens). */

  .contact-form__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 28px;
  }

  /* The full-width fields (message, submit, status) span both columns. */
  .contact-form__field--full,
  .contact-form__status,
  .contact-form__submit {
    grid-column: 1 / -1;
  }

  @media (max-width: 640px) {
    .contact-form__fields {
      grid-template-columns: 1fr;
    }
    .contact-form__field--full,
    .contact-form__status,
      .contact-form__submit {
      grid-column: 1 / -1;
    }
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-form__label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted-text);
  }

  .contact-form__input {
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--border-soft);
    background: var(--bg-elevated);
    color: var(--text-primary);
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.4;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    outline: none;
  }

  .contact-form__input::placeholder {
    color: var(--muted-text);
    opacity: 0.7;
  }

  .contact-form__input:hover {
    border-color: var(--border-strong);
  }

  .contact-form__input:focus-visible {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 22%, transparent);
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 140px;
    line-height: 1.55;
  }

  .contact-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 28px;
    border-radius: 9999px;
    background: var(--color-primary);
    color: #fff;
    border: none;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 0 6px 20px color-mix(in srgb, var(--color-primary) 25%, transparent);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    margin-top: 8px;
  }

  .contact-form__submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .contact-form__submit:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .contact-form__status {
    margin-top: 4px;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 0.9rem;
    line-height: 1.5;
    border: 1px solid var(--border-soft);
    background: var(--bg-elevated);
    color: var(--text-secondary);
    display: none;
  }

  .contact-form__status:not([hidden]) {
    display: block;
  }

  .contact-form__status[data-type="success"] {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
    color: var(--heading-text);
  }

  .contact-form__status[data-type="pending"] {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--heading-text);
  }

  .contact-form__status[data-type="error"] {
    background: color-mix(in srgb, #d64545 12%, transparent);
    border-color: color-mix(in srgb, #d64545 35%, transparent);
    color: var(--heading-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-form__input,
    .contact-form__submit {
      transition: none;
    }
    .contact-form__submit:hover {
      transform: none;
    }
  }
</style>
