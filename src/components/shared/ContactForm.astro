---
// ContactForm.astro — Form posts to links.json.forms.contact_form_url (Cloudflare Worker).
// The actionUrl is inlined into the client script via define:vars so the
// network call always uses the real endpoint (no DOM lookup that can fail).
//
// Visual: the form is styled like a paper letter / postcard, taken from
// docs/refrences/stitch stuff/paper-post-contact.html — an airmail border
// (red / white / blue diagonal stripes), cream paper background, a vintage
// stamp in the corner, and dashed underline inputs. The whole letter
// drifts gently (improved on the reference's float-drift keyframes so it
// reads as paper floating in still air rather than a wobble).
//
// Per FR-032/033/034 the worker URL comes from links.json.forms.contact_form_url
// and is inlined here at build time.

import Icon from '../icons/Icon.astro'
import type { Lang } from '../../types'

interface Props {
  actionUrl: string
  lang: Lang
}

const { actionUrl, lang = 'en' } = Astro.props
---

<div class="contact-form" data-animate="fade-up">
  <div class="contact-form__envelope" data-contact-envelope>
    <div class="contact-form__paper" aria-hidden="true"></div>
    <div class="contact-form__letter">
      {/* ===== Top-right corner cluster: the vintage "BASEET POST" stamp
          sits at the corner, and a row of 5 social-media mail-stamps
          flanks it. Both rotate slightly and have their own float keyframes
          so the corner reads as a stack of cards dropped on the envelope. ===== */}
      <div class="contact-form__corner">
        {/* The vintage "BASEET POST" stamp is decorative — only the social
            links inside this cluster are interactive. */}
        <div class="contact-form__stamp" aria-hidden="true">
          <span class="contact-form__stamp-text">BASEET&nbsp;POST</span>
          <span class="contact-form__stamp-mark">
            <Icon name="paper-plane-tilt" size={26} color="#fff" />
          </span>
          <span class="contact-form__stamp-rate">∞¢</span>
        </div>
      <ul class="contact-form__social-stamps" aria-label="Find us on social">
        <li class="contact-form__social-stamp" style="--rot:-4deg;--delay:0s;">
          <a href="https://instagram.com/baseet.studio" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <Icon name="instagram-logo" size={22} color="currentColor" />
            <span>IG</span>
          </a>
        </li>
        <li class="contact-form__social-stamp" style="--rot:3deg;--delay:0.3s;">
          <a href="https://linkedin.com/company/baseetstudios" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <Icon name="linkedin-logo" size={22} color="currentColor" />
            <span>IN</span>
          </a>
        </li>
        <li class="contact-form__social-stamp" style="--rot:-2deg;--delay:0.6s;">
          <a href="https://twitter.com/baseetstudios" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
            <Icon name="x-logo" size={22} color="currentColor" />
            <span>X</span>
          </a>
        </li>
        <li class="contact-form__social-stamp" style="--rot:4deg;--delay:0.9s;">
          <a href="https://github.com/baseetstudios" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <Icon name="github-logo" size={22} color="currentColor" />
            <span>GH</span>
          </a>
        </li>
        <li class="contact-form__social-stamp" style="--rot:-1deg;--delay:1.2s;">
          <a href="https://tiktok.com/@baseet.studio" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <Icon name="tiktok-logo" size={22} color="currentColor" />
            <span>TT</span>
          </a>
        </li>
      </ul>
    </div>

    <form id="contact-form" class="contact-form__fields">
      {/* ===== Left column — message + intent ===== */}
      <div class="contact-form__col contact-form__col--left">
        <div class="contact-form__subject">
          <span class="contact-form__label-mono">The Subject</span>
          <h2 class="contact-form__subject-title">A New Chapter</h2>
        </div>

        <div class="contact-form__field contact-form__field--full contact-form__field--message">
          <textarea
            id="contact-message"
            name="message"
            required
            minlength="10"
            rows="7"
            class="contact-form__dashed contact-form__dashed--textarea"
            placeholder="What story shall we write together?"
          ></textarea>
          <span class="contact-form__label-floating">Message</span>
        </div>

        <div class="contact-form__field contact-form__field--full">
          <span class="contact-form__label-mono">Intent</span>
          <div class="contact-form__intent">
            {['Branding', 'Digital', 'Mobile', 'Strategy'].map((label) => (
              <label class="contact-form__intent-chip">
                <input type="checkbox" name="intent" value={label.toLowerCase()} />
                <span>{label}</span>
              </label>
            ))}
          </div>
        </div>
      </div>

      {/* Vertical divider between columns */}
      <div class="contact-form__divider" aria-hidden="true"></div>

      {/* ===== Right column — sender + recipient + submit ===== */}
      <div class="contact-form__col contact-form__col--right">
        <div class="contact-form__field-group">
          <span class="contact-form__label-mono">Sender</span>
          <div class="contact-form__field">
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              minlength="2"
              class="contact-form__dashed"
              placeholder="Your Name"
            />
          </div>
          <div class="contact-form__field">
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              class="contact-form__dashed"
              placeholder="Return Address (Email)"
            />
          </div>
          <div class="contact-form__field">
            <input
              type="tel"
              id="contact-phone"
              name="phone"
              class="contact-form__dashed"
              placeholder="Phone (optional)"
            />
          </div>
          <div class="contact-form__field">
            <input
              type="text"
              id="contact-subject"
              name="subject"
              required
              minlength="3"
              class="contact-form__dashed"
              placeholder="Subject"
            />
          </div>
        </div>

        <div class="contact-form__recipient">
          <span class="contact-form__label-mono">Recipient</span>
          <ul class="contact-form__recipient-list">
            <li class="contact-form__recipient-name">
              {/* Agency name — handwritten font. */}
              <a href="/" class="contact-form__recipient-link contact-form__recipient-link--hand">Baseet Studio</a>
            </li>
            <li>
              <a
                href="https://maps.google.com/?q=Abu+Dhabi+UAE"
                target="_blank"
                rel="noopener noreferrer"
                class="contact-form__recipient-link"
                aria-label="Open Abu Dhabi, UAE in Google Maps"
              >
                Abu Dhabi, UAE
              </a>
            </li>
            <li>
              <a
                href="mailto:baseet.socials@gmail.com"
                class="contact-form__recipient-link"
                aria-label="Email Baseet Studio"
              >
                baseet.socials@gmail.com
              </a>
            </li>
            <li>
              <a
                href="tel:+971507566474"
                class="contact-form__recipient-link"
                aria-label="Call Baseet Studio"
              >
                +971 50 756 6474
              </a>
            </li>
            <li>
              <a
                href="https://wa.me/971507566474"
                target="_blank"
                rel="noopener noreferrer"
                class="contact-form__recipient-link"
                aria-label="Open WhatsApp chat with Baseet Studio"
              >
                WhatsApp chat
              </a>
            </li>
            <li>
              {/* Location is currently a placeholder anchor until the
                  studio's exact pin is provided. */}
              <a
                href="#"
                class="contact-form__recipient-link contact-form__recipient-link--placeholder"
                aria-label="Studio location (coming soon)"
                title="Studio location — coming soon"
              >
                Studio location · coming soon
              </a>
            </li>
          </ul>
        </div>

        <div class="contact-form__submit-wrap">
          <button type="submit" class="contact-form__submit">
            Post Inquiry
          </button>
          <p class="contact-form__submit-note contact-form__submit-note--hand">
            Signed, sealed, delivered.
          </p>
        </div>

        <div id="contact-form-status" class="contact-form__status" role="status" aria-live="polite"></div>
      </div>
    </form>

    {/* Decorative airmail priority line, sitting along the bottom edge */}
    <span class="contact-form__priority" aria-hidden="true">
      Baseet · Airmail · Priority
    </span>
    </div>
  </div>
</div>

<script define:vars={{ actionUrl }}>
  // Per FR-032/033/034 the worker URL comes from links.json.forms.contact_form_url
  // and is inlined here at build time. The previous DOM-query implementation
  // returned an empty string when [data-form-action] was missing, so the
  // fetch posted to "" and the worker was never called.
  console.log('[ContactForm] Worker endpoint:', actionUrl || '(empty)');

  const form = document.getElementById('contact-form');
  const statusEl = document.getElementById('contact-form-status');

  if (!form) {
    console.error('[ContactForm] #contact-form not found in DOM');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    console.log('[ContactForm] Submit intercepted. Worker URL:', actionUrl);

    // Gather checked intent chips
    const intentEls = form.querySelectorAll('input[name="intent"]:checked');
    const intent = Array.from(intentEls).map((el) => /** @type {HTMLInputElement} */ (el).value);

    const formData = {
      name: form.querySelector('[name="name"]')?.value.trim(),
      email: form.querySelector('[name="email"]')?.value.trim(),
      phone: form.querySelector('[name="phone"]')?.value.trim() || undefined,
      subject: form.querySelector('[name="subject"]')?.value.trim(),
      message: form.querySelector('[name="message"]')?.value.trim(),
      intent,
      lang: document.body.dataset.lang || 'en',
    };
    console.log('[ContactForm] Payload:', formData);

    if (!formData.name || formData.name.length < 2) {
      showStatus('Please enter your name.', 'error');
      return;
    }
    if (!formData.email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(formData.email)) {
      showStatus('Please enter a valid email.', 'error');
      return;
    }
    if (!formData.subject || formData.subject.length < 3) {
      showStatus('Please enter a subject.', 'error');
      return;
    }
    if (!formData.message || formData.message.length < 10) {
      showStatus('Message must be at least 10 characters.', 'error');
      return;
    }

    if (!actionUrl) {
      console.error('[ContactForm] actionUrl is empty — worker endpoint missing from links.json.forms.contact_form_url');
      showStatus('Form endpoint not configured. Please email us directly at baseet.socials@gmail.com.', 'error');
      return;
    }

    showStatus('Sending…', 'pending');

    try {
      console.log('[ContactForm] POST →', actionUrl);
      const response = await fetch(actionUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData),
        signal: AbortSignal.timeout(15000),
      });
      console.log('[ContactForm] Response status:', response.status, response.statusText);

      if (response.ok) {
        let body = null;
        try { body = await response.json(); } catch (_) { /* not JSON */ }
        console.log('[ContactForm] Response body:', body);
        showStatus('Thank you! Your message has been sent.', 'success');
        form.reset();
      } else {
        let errBody = null;
        try { errBody = await response.json(); } catch (_) { /* not JSON */ }
        console.error('[ContactForm] Worker rejected request:', response.status, errBody);
        showStatus((errBody && errBody.error) || `Worker returned ${response.status}. Please try again or email us directly.`, 'error');
      }
    } catch (err) {
      const name = err && err.name ? err.name : 'Error';
      const message = err && err.message ? err.message : String(err);
      console.error('[ContactForm] Network/fetch failure:', name, message, err);
      if (name === 'TimeoutError') {
        showStatus('Request timed out. Please try again or email us directly.', 'error');
      } else if (name === 'AbortError') {
        showStatus('Request cancelled.', 'error');
      } else {
        showStatus(`Unable to reach form worker (${name}). Please email us directly at baseet.socials@gmail.com.`, 'error');
      }
    }
  });

  function showStatus(message, type) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.dataset.type = type;
    statusEl.hidden = false;
  }
</script>

<script>
  import('../../animations/contact-envelope').then((m) => {
    const run = () => m.init()
    const stop = () => m.destroy()
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run, { once: true })
    } else {
      run()
    }
    document.addEventListener('astro:page-load', run)
    document.addEventListener('astro:before-swap', stop)
  })
</script>

<style>
  /* =============================================================
     Tokens — paper-post-contact cream surface + airmail stripes.
     Theme-aware: cream paper in day, deep navy in night.
     ============================================================= */
  .contact-form {
    /* CSS variables used by the letter + airmail + stamp treatments */
    --paper-cream: #fdfbf7;
    --paper-cream-edge: #e8e2d2;
    --paper-ink: #1c1a16;
    --paper-muted: #5a5448;
    --paper-line: rgba(28, 26, 22, 0.16);
    --airmail-red: #d93025;
    --airmail-blue: #1a73e8;
    --airmail-bg: #fdfbf7;
  }

  [data-theme="night"] .contact-form {
    --paper-cream: #14202b;
    --paper-cream-edge: #1f2d3a;
    --paper-ink: #f0ece1;
    --paper-muted: rgba(240, 236, 225, 0.62);
    --paper-line: rgba(240, 236, 225, 0.18);
    --airmail-bg: #14202b;
  }

  /* ===== Envelope — one cohesive paper surface with airmail border ===== */
  .contact-form__envelope {
    position: relative;
    padding: 16px;
    background: var(--paper-cream);
    border-radius: 6px;
    box-shadow:
      0 1px 0 color-mix(in srgb, white 55%, transparent) inset,
      0 50px 100px -24px rgba(28, 22, 14, 0.22),
      0 24px 48px -28px rgba(28, 22, 14, 0.14);
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* Airmail border: same -45deg angle on every side. Uses a single
     repeating-linear-gradient on ::before, masked by the envelope's
     border so the pattern wraps cleanly around all four edges. */
  .contact-form__envelope::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 16px;
    background-image: repeating-linear-gradient(
      -45deg,
      var(--airmail-red) 0,
      var(--airmail-red) 14px,
      var(--airmail-bg) 14px,
      var(--airmail-bg) 28px,
      var(--airmail-blue) 28px,
      var(--airmail-blue) 42px,
      var(--airmail-bg) 42px,
      var(--airmail-bg) 56px
    );
    /* Mask the gradient so it only shows in the padding area (the
       border) — the centre is cut out by the letter covering it. */
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* Subtle vignette on the paper face */
  .contact-form__envelope::after {
    content: "";
    position: absolute;
    inset: 16px;
    border-radius: 2px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(0, 0, 0, 0.04) 100%
    );
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 1;
  }

  /* Paper fibre layer — static, moves with the envelope as one piece */
  .contact-form__paper {
    position: absolute;
    inset: 16px;
    border-radius: 2px;
    background: var(--paper-cream);
    filter: url(#paper-realistic);
    pointer-events: none;
    z-index: 0;
  }

  .contact-form__letter {
    position: relative;
    color: var(--paper-ink);
    padding: 56px 56px 48px;
    min-height: 600px;
    border-radius: 2px;
    z-index: 2;
    background: transparent;
  }

  /* =============================================================
     Top-right corner cluster — the vintage stamp + the row of
     social-media mail-stamps sit together in the upper-right
     corner, slightly overlapping like a stack of cards.
     ============================================================= */
  .contact-form__corner {
    position: absolute;
    top: 28px;
    right: 28px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    z-index: 4;
  }

  /* =============================================================
     Vintage stamp — sits in the top-right corner, slightly rotated.
     Houses the studio mark + the "letter rate". Kept cream-white
     so it reads as a stamp even against the paper letter.
     ============================================================= */
  .contact-form__stamp {
    position: relative;
    width: 96px;
    height: 110px;
    background: color-mix(in srgb, var(--paper-cream) 82%, #fff8ef);
    border: 2px dashed var(--paper-ink);
    padding: 8px 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    transform: rotate(6deg);
    box-shadow: 0 6px 16px rgba(28, 22, 14, 0.14);
    flex-shrink: 0;
  }

  /* The dotted outer ring from the reference's stamp-vintage::before */
  .contact-form__stamp::before {
    content: "";
    position: absolute;
    inset: -6px;
    border: 2px dotted color-mix(in srgb, var(--paper-ink) 30%, transparent);
    pointer-events: none;
  }

  .contact-form__stamp-text {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--paper-ink) 60%, transparent);
  }

  .contact-form__stamp-mark {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--paper-ink);
    color: var(--paper-cream);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .contact-form__stamp-rate {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--paper-ink);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* =============================================================
     Form grid — 2 columns + vertical divider
     ============================================================= */
  .contact-form__fields {
    display: grid;
    grid-template-columns: 1.4fr 1px 1fr;
    gap: 56px;
    align-items: stretch;
  }

  .contact-form__col {
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-width: 0;
  }

  /* Vertical dashed divider — fades in/out top and bottom like the
     reference's vertical-divider element. */
  .contact-form__divider {
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--paper-line) 18%,
      var(--paper-line) 82%,
      transparent 100%
    );
  }

  /* ----- Subject block (top of left column) ----- */
  .contact-form__subject {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact-form__subject-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 700;
    color: var(--paper-ink);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  /* ----- Mono label (uppercase tracked) ----- */
  .contact-form__label-mono {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--paper-muted);
    font-weight: 500;
    display: block;
    margin-bottom: 10px;
  }

  /* Floating label that sits above the textarea — matches the
     reference's "Message" label */
  .contact-form__label-floating {
    position: absolute;
    top: -14px;
    left: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: color-mix(in srgb, var(--paper-muted) 70%, transparent);
  }

  /* ----- Dashed inputs (no border, only bottom dashed) ----- */
  .contact-form__field {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .contact-form__field--message {
    position: relative;
  }

  .contact-form__field-group {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-form__dashed {
    background: transparent;
    border: none;
    border-bottom: 1.5px dashed var(--paper-line);
    padding: 10px 0;
    width: 100%;
    color: var(--paper-ink);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    transition: border-color 0.3s ease;
    outline: none;
    border-radius: 0;
  }

  .contact-form__dashed::placeholder {
    color: color-mix(in srgb, var(--paper-muted) 70%, transparent);
    font-style: italic;
  }

  .contact-form__dashed:hover {
    border-bottom-color: color-mix(in srgb, var(--paper-ink) 50%, transparent);
  }

  .contact-form__dashed:focus {
    border-bottom-color: var(--paper-ink);
    box-shadow: none;
  }

  .contact-form__dashed--textarea {
    resize: vertical;
    min-height: 160px;
    line-height: 1.55;
    padding-top: 16px;
  }

  /* ----- Intent chips ----- */
  .contact-form__intent {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 18px;
    margin-top: 4px;
  }

  .contact-form__intent-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--paper-ink);
    transition: opacity 0.2s ease;
  }

  .contact-form__intent-chip:hover {
    text-decoration: underline;
  }

  .contact-form__intent-chip input {
    appearance: none;
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--paper-ink);
    border-radius: 2px;
    background: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .contact-form__intent-chip input:checked {
    background: var(--paper-ink);
  }

  .contact-form__intent-chip input:checked::after {
    content: "";
    width: 8px;
    height: 4px;
    border-left: 2px solid var(--paper-cream);
    border-bottom: 2px solid var(--paper-cream);
    transform: rotate(-45deg) translate(1px, -1px);
  }

  /* ----- Recipient block — every line is a clickable link. The
     agency name and the signature below the submit button use
     the handwriting font; the rest stay mono. ----- */
  .contact-form__recipient {
    margin-top: 8px;
  }

  .contact-form__recipient-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-form__recipient-name {
    margin-bottom: 2px;
  }

  .contact-form__recipient-link {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--paper-ink);
    text-decoration: none;
    border-bottom: 1px dashed color-mix(in srgb, var(--paper-line) 80%, transparent);
    padding-bottom: 1px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .contact-form__recipient-link:hover {
    color: var(--color-primary, var(--paper-ink));
    border-bottom-color: currentColor;
  }

  .contact-form__recipient-link:focus-visible {
    outline: 2px solid var(--paper-ink);
    outline-offset: 2px;
    border-radius: 2px;
  }

