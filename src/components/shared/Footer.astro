---
import Icon from '../icons/Icon.astro'
import linksData from '../../content/data/links.json'
import { getFooterData } from '../../lib/home'
import { getServicesIndex } from '../../lib/services'
import { t } from '../../lib/i18n'
import { localizedPath } from '../../lib/locale'
import type { Lang } from '../../types'

const socialPlatforms = [
  { key: 'github', icon: 'github-logo' },
  { key: 'linkedin', icon: 'linkedin-logo' },
  { key: 'twitter', icon: 'x-logo' },
  { key: 'instagram', icon: 'instagram-logo' },
  { key: 'tiktok', icon: 'tiktok-logo' },
]

interface Props {
  compact?: boolean
  lang?: Lang
}

const { compact = false, lang = 'en' } = Astro.props
const footerData = getFooterData(lang)
const serviceCategories = getServicesIndex(lang)
const homeHref = localizedPath(lang, '/')
const projectsHref = localizedPath(lang, '/projects/')
const contactHref = localizedPath(lang, '/contact/')
---

<footer class={`footer ${compact ? 'footer--compact' : ''}`}>
  <div class="footer__container">

    {compact ? (
      <nav class="footer__compact" aria-label={t('footer_site_sections', lang)}>
        <div class="footer__compact-group">
          <h4 class="footer__heading">{t('footer_projects', lang)}</h4>
          <ul class="footer__compact-list">
            <li><a href={projectsHref}>{t('footer_projects', lang)}</a></li>
          </ul>
        </div>
        <div class="footer__compact-group">
          <h4 class="footer__heading">{t('footer_services', lang)}</h4>
          <ul class="footer__compact-list">
            {serviceCategories.map(cat => (
              <li>
                <a href={`${localizedPath(lang, '/services/')}#${cat.id}`}>{cat.title}</a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    ) : (
      <div class="footer__row">
        <div class="footer__brand">
          <a href={homeHref} class="footer__logo">
            <svg class="footer__logo-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" aria-hidden="true"><rect width="256" height="256" fill="none"/><path d="M128,120s90-96,0-96S128,120,128,120Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"/><path d="M128,120s-96-90-96,0S128,120,128,120Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"/><path d="M128,120s-90,96,0,96S128,120,128,120Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"/><path d="M128,120s96,90,96,0S128,120,128,120Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"/><path d="M128,120s64,56,80,120" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"/></svg>
            <span class="footer__logo-text">
              <strong>Baseet Studio</strong>
              <em>{t('footer_brand_tagline', lang)}</em>
            </span>
          </a>
        </div>

        <nav class="footer__nav" aria-label="Footer">
          <div class="footer__nav-group">
            <h4 class="footer__heading">{t('footer_services', lang)}</h4>
            <ul class="footer__links footer__links--inline">
              {serviceCategories.map(cat => (
                <li>
                  <a href={`${localizedPath(lang, '/services/')}#${cat.id}`}>{cat.title}</a>
                </li>
              ))}
            </ul>
          </div>

          <div class="footer__nav-group">
            <h4 class="footer__heading">{t('footer_projects', lang)}</h4>
            <ul class="footer__links footer__links--inline">
              <li><a href={projectsHref}>{t('footer_projects', lang)}</a></li>
            </ul>
          </div>

          <div class="footer__nav-group">
            <h4 class="footer__heading">{t('nav_contact', lang)}</h4>
            <ul class="footer__links footer__links--inline">
              <li>
                <a href={contactHref} class="footer__contact-link">{t('footer_write_us', lang)}</a>
              </li>
              <li>
                <a href={linksData.contact.email_link} class="footer__contact-link">Email</a>
              </li>
              <li>
                <a href={linksData.contact.whatsapp_link} target="_blank" rel="noopener noreferrer" class="footer__contact-link">WhatsApp</a>
              </li>
            </ul>
          </div>
        </nav>

        <div class="footer__social">
          {socialPlatforms.map(item => {
            const url = linksData.social[item.key as keyof typeof linksData.social]
            if (!url || url === '#') return null
            return (
              <a href={url} target="_blank" rel="noopener noreferrer"
                class="footer-social-icon"
                aria-label={item.key}>
                <Icon name={item.icon} size={16} variant="fill" color="currentColor" />
              </a>
            )
          })}
        </div>
      </div>
    )}

  </div>

  <div class="footer__bottom">
    <p class="footer__copyright">{footerData.copyright}</p>
    <p id="visitor-info" data-visiting={t('footer_visiting', lang).split('{')[0].trim() || 'Visiting from'} data-device="Device" data-unknown="Unknown"></p>
  </div>
</footer>

<button id="back-to-top" class="footer-back-to-top" aria-label="Back to top" type="button">
  <Icon name="caret-up" size={20} color="currentColor" />
</button>

<style>
  .footer {
    background: transparent;
    border-top: 1px solid var(--footer-border);
    position: relative;
    z-index: 2;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .footer__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 24px 24px; /* tight, not 64px+40px */
  }

  /* Compact mode (used on the contact page): single horizontal row of
     Projects + Services, no brand block, no contact, no social. */
  .footer--compact .footer__container {
    padding: 28px 24px 20px;
  }

  .footer__compact {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    gap: 64px;
    flex-wrap: wrap;
  }

  .footer__compact-group {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 16px;
  }

  .footer__compact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 20px;
  }

  .footer__compact-list a {
    color: var(--footer-text-muted);
    font-size: 0.85rem;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__compact-list a:hover {
    color: var(--footer-text-primary);
  }

  .footer--compact .footer__heading {
    margin: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--footer-text-soft);
    font-weight: 600;
  }

  /* =============================================================
     Default mode — one horizontal row.
     Brand (left) · nav groups (centre) · social (right).
     Uses the full width instead of stacking empty columns.
     ============================================================= */
  .footer__row {
    display: grid;
    grid-template-columns: minmax(220px, 1.2fr) auto auto;
    align-items: center;
    gap: 32px;
  }

  .footer__brand {
    display: flex;
    align-items: center;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--footer-text-primary);
    text-decoration: none;
  }

  .footer__logo-mark {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }

  .footer__logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .footer__logo-text strong {
    font-weight: 700;
    font-size: 1rem;
    color: var(--footer-text-primary);
    font-family: var(--font-title);
    letter-spacing: -0.005em;
  }

  .footer__logo-text em {
    font-style: normal;
    font-size: 0.72rem;
    color: var(--footer-text-muted);
    font-weight: 400;
  }

  .footer__nav {
    display: flex;
    align-items: center;
    gap: 36px;
    flex-wrap: wrap;
  }

  .footer__nav-group {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .footer__heading {
    color: var(--footer-text-soft);
    font-size: 0.7rem;
    font-weight: 600;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 16px;
  }

  .footer__links--inline {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .footer__links a {
    color: var(--footer-text-muted);
    font-size: 0.85rem;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__links a:hover {
    color: var(--footer-text-primary);
  }

  .footer__contact-link {
    font-size: 0.85rem;
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .footer-social-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--footer-chip-bg);
    color: var(--footer-text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .footer-social-icon:hover {
    background: var(--interactive-hover);
    transform: translateY(-1px);
  }

  .footer__bottom {
    border-top: 1px solid var(--footer-border);
    max-width: 1200px;
    margin: 16px auto 0;
    padding: 14px 24px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
  }

  .footer__copyright {
    color: var(--footer-text-soft);
    font-size: 0.75rem;
    margin: 0;
  }

  #visitor-info {
    color: var(--footer-text-soft);
    font-size: 10px;
    margin: 0;
  }

  /* === Back to Top === */
  .footer-back-to-top {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 50;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--footer-chip-bg);
    color: var(--footer-text-primary);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--footer-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity var(--transition-base), visibility var(--transition-base), transform var(--transition-base), background var(--transition-fast);
  }

  .footer-back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .footer-back-to-top:hover {
    background: var(--interactive-hover);
    transform: translateY(-2px);
  }

  .footer-back-to-top.visible:hover {
    transform: translateY(-2px);
  }

  /* === Responsive === */
  @media (max-width: 1023px) {
    .footer__row {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .footer__brand {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }

    .footer__nav {
      grid-column: 1 / -1;
      gap: 24px;
    }

    .footer__social {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }

    .footer__compact {
      gap: 32px;
    }
    .footer__compact-group {
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }
    .footer__compact-list {
      justify-content: center;
    }
  }

  @media (max-width: 639px) {
    .footer__container {
      padding: 24px 16px 16px;
    }
    .footer__row {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .footer__brand,
    .footer__nav,
    .footer__social {
      grid-column: auto;
      justify-content: flex-start;
    }
    .footer__nav {
      gap: 16px;
    }
    .footer__nav-group {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .footer__bottom {
      padding: 12px 16px 14px;
    }
    .footer-back-to-top {
      bottom: 20px;
      right: 20px;
    }

    .footer__compact {
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }
    .footer__compact-list {
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }
  }
</style>

<script>
  const btn = document.getElementById('back-to-top')
  if (btn) {
    const onScroll = () => {
      btn.classList.toggle('visible', window.scrollY > 300)
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' })
    })
  }
</script>
