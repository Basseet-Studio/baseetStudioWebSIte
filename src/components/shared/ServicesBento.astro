---
// ServicesBento.astro — The full /services index layout.
//
// Three parts:
//   1. The capability bento — an offset grid where some cards span 2 cols,
//      some span 2 rows. No two cards have the same dimensions on desktop.
//      This is a deliberate refusal of the identical-card-grid template
//      tell called out in DESIGN.md.
//   2. The process timeline — a vertical numbered timeline replacing the
//      hero-metric "6 identical numbered tiles" template. Each step gets
//      its own row with a connector line.
//   3. The CTA — a single composed card with copy on the left and a primary
//      action on the right, instead of a centered stacked card.

import Icon from '../icons/Icon.astro'
import { resolveIcon } from '../icons/iconMappings'
import ServiceCard from './ServiceCard.astro'

interface SubService {
  name: string
  icon: string
}

interface Category {
  id: string
  slug: string
  title: string
  tagline?: string
  shortDescription: string
  color: string
  gradient: string
  icon: string
  subServices?: SubService[]
}

interface ProcessStep {
  number: string
  title: string
  desc: string
  icon: string
}

interface CTA {
  title: string
  subtitle?: string
  description?: string
  button: string
}

interface Props {
  categories: Category[]
  process?: {
    title: string
    subtitle: string
    steps: ProcessStep[]
  }
  cta?: CTA
  // Localised chrome strings. Defaults match the EN copy in services.json.
  copy: {
      eyebrow?: string
      intro?: string
      explore?: string
      ctaHref: string
      ctaArrowIcon?: string // 'arrow-right' | 'arrow-left' — bottom CTA arrow
      cardArrowIcon?: string // 'arrow-right' | 'arrow-left' — per-card CTA arrow
    }
}

// Pre-defined size slots. The grid is 4 cols × 3 rows. Each category gets
// the next size in order, cycling when we run out. The arrangement is
// intentional: anchor at top-left, wide strips on the right column, tall
// strip balancing, smalls filling the gaps.
const SIZE_ORDER: Array<'anchor' | 'wide' | 'tall' | 'standard'> = [
  'anchor', // Web — flagship, top-left, big
  'wide',   // Mobile — wide strip top-right
  'tall',   // Internal — tall column right side
  'standard', // SEO — small
  'wide',   // Design — wide strip bottom-left
  'standard', // Cloud — small (final slot)
]

const { categories, process, cta, copy } = Astro.props
const arrowIcon = copy.ctaArrowIcon ?? 'arrow-right'
const cardArrowIcon = copy.cardArrowIcon ?? arrowIcon
---

{/* =====================================================================
     Part 1 — Capability bento
     ===================================================================== */}
<div class="services-bento">
  {categories.map((category, i) => (
    <ServiceCard
          index={i + 1}
          id={category.id}
          slug={category.slug}
          title={category.title}
          tagline={category.tagline}
          shortDescription={category.shortDescription}
          color={category.color}
          gradient={category.gradient}
          iconClass={category.icon}
          subServices={category.subServices?.slice(0, 3) ?? []}
          ctaLabel={copy.explore ?? 'Explore service'}
          href={`/services/${category.slug}/`}
          size={SIZE_ORDER[i % SIZE_ORDER.length]}
          arrowIcon={cardArrowIcon}
        />
  ))}
</div>

{/* =====================================================================
     Part 2 — Process timeline
     ===================================================================== */}
{process && process.steps && process.steps.length > 0 && (
  <section class="process-timeline" id="process" data-animate="fade-up">
    <header class="process-timeline__head">
      <span class="eyebrow-chip" style="background:color-mix(in srgb, var(--color-primary) 10%, transparent); color:var(--color-primary); border:1px solid color-mix(in srgb, var(--color-primary) 22%, transparent);">
        How we work
      </span>
      <h2 class="process-timeline__title">{process.title}</h2>
      <p class="process-timeline__subtitle">{process.subtitle}</p>
    </header>

    <ol class="process-timeline__list">
      {process.steps.map((step, i) => {
        const stepIcon = resolveIcon(step.icon || 'fas fa-circle')
        return (
          <li class="process-step" data-animate="fade-up">
            <div class="process-step__rail" aria-hidden="true">
              <span class="process-step__node">
                <Icon name={stepIcon.name} variant={stepIcon.variant} size={16} color="currentColor" />
              </span>
              {i < process.steps.length - 1 && <span class="process-step__line"></span>}
            </div>
            <div class="process-step__copy">
              <div class="process-step__meta">
                <span class="process-step__number">{step.number}</span>
                <h3 class="process-step__title">{step.title}</h3>
              </div>
              <p class="process-step__desc">{step.desc}</p>
            </div>
          </li>
        )
      })}
    </ol>
  </section>
)}

{/* =====================================================================
     Part 3 — CTA
     ===================================================================== */}
{cta && (
  <section class="ready-to-ship" data-animate="fade-up">
    <div class="ready-to-ship__inner card-window">
      <div class="ready-to-ship__copy">
        <span class="eyebrow-chip ready-to-ship__eyebrow" style="background:color-mix(in srgb, var(--color-accent) 14%, transparent); color:var(--color-accent); border:1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);">
          Ready when you are
        </span>
        <h2 class="ready-to-ship__title">{cta.title}</h2>
        {cta.description && (
          <p class="ready-to-ship__text">{cta.description}</p>
        )}
      </div>
      <div class="ready-to-ship__action">
        <a
          href={copy.ctaHref}
          class="ready-to-ship__button"
          style="background:var(--color-primary);color:#fff;"
        >
          {cta.button}
          <Icon name={arrowIcon} size={16} color="currentColor" />
        </a>
        {cta.subtitle && (
          <p class="ready-to-ship__note">{cta.subtitle}</p>
        )}
      </div>
    </div>
  </section>
)}

<style>
  /* ===== Bento grid ===== */
  .services-bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(220px, auto);
    gap: 20px;
  }

  @media (max-width: 960px) {
    .services-bento {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 560px) {
    .services-bento {
      grid-template-columns: 1fr;
    }
  }

  /* ===== Process timeline ===== */
  .process-timeline {
    margin-top: 96px;
  }

  .process-timeline__head {
    max-width: 640px;
    margin: 0 0 48px;
  }

  .eyebrow-chip {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 18px;
  }

  .process-timeline__title {
    font-size: 2.25rem;
    font-weight: 400;
    color: var(--heading-text);
    margin: 0 0 12px;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .process-timeline__subtitle {
    font-size: 1.05rem;
    color: var(--muted-text);
    margin: 0;
    max-width: 520px;
    line-height: 1.5;
  }

  .process-timeline__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process-step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 24px;
    padding: 24px 0;
    align-items: flex-start;
  }

  /* Offset the inner copy for odd steps to break the visual rhythm.
     Even: copy starts at column 1; odd: copy starts at column 2 with the
     rail pushed right. The result is a staggered timeline. */
  .process-step:nth-child(odd) .process-step__copy {
    padding-left: 0;
  }
  .process-step:nth-child(even) {
    grid-template-columns: 56px 1fr 80px 1fr;
  }
  .process-step:nth-child(even) .process-step__copy {
    grid-column: 4;
  }
  .process-step:nth-child(even) .process-step__rail {
    grid-column: 1;
    grid-row: 1;
  }

  .process-step__rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 8px;
  }

  .process-step__node {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
    border: 1px solid color-mix(in srgb, var(--color-primary) 22%, transparent);
    font-weight: 600;
    z-index: 2;
    flex-shrink: 0;
  }

  .process-step__line {
    flex: 1;
    width: 2px;
    min-height: 56px;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-primary) 28%, transparent) 0%,
      color-mix(in srgb, var(--color-primary) 8%, transparent) 100%
    );
    margin-top: 8px;
  }

  [dir="rtl"] .process-step__line {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-primary) 28%, transparent) 0%,
      color-mix(in srgb, var(--color-primary) 8%, transparent) 100%
    );
  }

  .process-step__copy {
    padding-top: 8px;
  }

  .process-step__meta {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 6px;
  }

  .process-step__number {
    font-family: var(--font-title);
    font-size: 1.15rem;
    color: var(--color-primary);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  .process-step__title {
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--heading-text);
    margin: 0;
    letter-spacing: -0.005em;
  }

  .process-step__desc {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--muted-text);
    margin: 0;
    max-width: 56ch;
  }

  /* Responsive: collapse the even/odd stagger on small screens. */
  @media (max-width: 720px) {
    .process-step,
    .process-step:nth-child(even) {
      grid-template-columns: 44px 1fr;
      gap: 16px;
    }
    .process-step__copy,
    .process-step:nth-child(even) .process-step__copy {
      grid-column: 2;
    }
    .process-step__rail,
    .process-step:nth-child(even) .process-step__rail {
      grid-column: 1;
    }
    .process-step__node {
      width: 38px;
      height: 38px;
    }
    .process-timeline__title {
      font-size: 1.85rem;
    }
  }

  /* ===== CTA ===== */
  .ready-to-ship {
    margin-top: 96px;
  }

  .ready-to-ship__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 48px;
    align-items: center;
    padding: 56px 56px;
    border-radius: 28px;
    position: relative;
    overflow: hidden;
  }

  /* A soft warm halo behind the eyebrow + button. Uses accent (marigold). */
  .ready-to-ship__inner::before {
    content: "";
    position: absolute;
    top: -40%;
    right: -10%;
    width: 60%;
    height: 180%;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--color-accent) 18%, transparent) 0%,
      transparent 60%
    );
    pointer-events: none;
    z-index: 0;
  }

  .ready-to-ship__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ready-to-ship__title {
    font-size: 2.1rem;
    font-weight: 400;
    color: var(--heading-text);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .ready-to-ship__text {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted-text);
    margin: 0;
    max-width: 50ch;
  }

  .ready-to-ship__action {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }

  [dir="rtl"] .ready-to-ship__action {
    align-items: flex-start;
  }

  .ready-to-ship__button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 32px;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-primary) 25%, transparent);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .ready-to-ship__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .ready-to-ship__note {
    font-size: 0.8rem;
    color: var(--muted-text);
    margin: 0;
    text-align: right;
  }

  [dir="rtl"] .ready-to-ship__note {
    text-align: left;
  }

  @media (max-width: 720px) {
    .ready-to-ship__inner {
      grid-template-columns: 1fr;
      padding: 36px 28px;
      gap: 28px;
    }
    .ready-to-ship__action {
      align-items: flex-start;
    }
    [dir="rtl"] .ready-to-ship__action {
      align-items: flex-end;
    }
    .ready-to-ship__title {
      font-size: 1.7rem;
    }
    .ready-to-ship__note {
      text-align: left;
    }
    [dir="rtl"] .ready-to-ship__note {
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ready-to-ship__button,
    .ready-to-ship__button:hover {
      transition: none;
      transform: none;
    }
  }
</style>
