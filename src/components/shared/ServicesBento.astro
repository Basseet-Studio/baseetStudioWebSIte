---
// ServicesBento.astro — The full /services index layout.
//
// Three parts:
//   1. Editorial zigzag service rows (layout from nice-services.tsx reference).
//   2. Lateral pin process journey (GSAP ScrollTrigger pin indicator).
//   3. The CTA — a single composed card with copy on the left and a primary
//      action on the right, instead of a centered stacked card.

import Icon from '../icons/Icon.astro'
import ServiceRow from './ServiceRow.astro'
import ProcessPin from './ProcessPin.astro'

interface SubService {
  name: string
  icon: string
}

interface Category {
  id: string
  slug: string
  title: string
  tagline?: string
  shortDescription: string
  color: string
  gradient: string
  icon: string
  subServices?: SubService[]
}

interface ProcessStep {
  number: string
  title: string
  desc: string
  lead?: string
  icon: string
}

interface CTA {
  title: string
  subtitle?: string
  description?: string
  button: string
}

interface Props {
  categories: Category[]
  process?: {
    title: string
    subtitle: string
    steps: ProcessStep[]
  }
  cta?: CTA
  copy: {
    intro?: string
    explore?: string
    ctaHref: string
    ctaArrowIcon?: string
    cardArrowIcon?: string
  }
}

const { categories, process, cta, copy } = Astro.props
const arrowIcon = copy.ctaArrowIcon ?? 'arrow-right'
const cardArrowIcon = copy.cardArrowIcon ?? arrowIcon
const isAr = copy.ctaHref.includes('/ar/')
---

{/* =====================================================================
     Part 1 — Editorial zigzag services
     ===================================================================== */}
<div class="services-rows">
  {categories.map((category, i) => (
    <ServiceRow
      index={i + 1}
      title={category.title}
      tagline={category.tagline}
      shortDescription={category.shortDescription}
      color={category.color}
      gradient={category.gradient}
      iconClass={category.icon}
      subServices={category.subServices?.slice(0, 3) ?? []}
      ctaLabel={copy.explore ?? 'Explore service'}
      href={isAr ? `/ar/services/${category.slug}/` : `/services/${category.slug}/`}
      arrowIcon={cardArrowIcon}
    />
  ))}
</div>

{/* =====================================================================
     Part 2 — Lateral pin process journey
     ===================================================================== */}
{process && process.steps && process.steps.length > 0 && (
  <ProcessPin
    title={process.title}
    subtitle={process.subtitle}
    steps={process.steps}
  />
)}

{/* =====================================================================
     Part 3 — CTA
     ===================================================================== */}
{cta && (
  <section class="ready-to-ship" data-animate="fade-up">
    <div class="ready-to-ship__inner card-window">
      <div class="ready-to-ship__copy">
        <span class="eyebrow-chip ready-to-ship__eyebrow" style="background:color-mix(in srgb, var(--color-accent) 14%, transparent); color:var(--color-accent); border:1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);">
          Ready when you are
        </span>
        <h2 class="ready-to-ship__title">{cta.title}</h2>
        {cta.description && (
          <p class="ready-to-ship__text">{cta.description}</p>
        )}
      </div>
      <div class="ready-to-ship__action">
        <a
          href={copy.ctaHref}
          class="ready-to-ship__button"
          style="background:var(--color-primary);color:#fff;"
        >
          {cta.button}
          <Icon name={arrowIcon} size={16} color="currentColor" />
        </a>
        {cta.subtitle && (
          <p class="ready-to-ship__note">{cta.subtitle}</p>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .services-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(80px, 12vw, 160px);
  }

  .eyebrow-chip {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 18px;
  }

  .ready-to-ship {
    margin-top: 96px;
  }

  .ready-to-ship__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 48px;
    align-items: center;
    padding: 56px 56px;
    border-radius: var(--card-window-radius);
    position: relative;
    overflow: hidden;
  }

  .ready-to-ship__inner::before {
    content: "";
    position: absolute;
    top: -40%;
    right: -10%;
    width: 60%;
    height: 180%;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--color-accent) 18%, transparent) 0%,
      transparent 60%
    );
    pointer-events: none;
    z-index: 0;
  }

  .ready-to-ship__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ready-to-ship__title {
    font-size: 2.1rem;
    font-weight: 400;
    color: var(--heading-text);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .ready-to-ship__text {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted-text);
    margin: 0;
    max-width: 50ch;
  }

  .ready-to-ship__action {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }

  [dir="rtl"] .ready-to-ship__action {
    align-items: flex-start;
  }

  .ready-to-ship__button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 32px;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-primary) 25%, transparent);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .ready-to-ship__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .ready-to-ship__note {
    font-size: 0.8rem;
    color: var(--muted-text);
    margin: 0;
    text-align: right;
  }

  [dir="rtl"] .ready-to-ship__note {
    text-align: left;
  }

  @media (max-width: 720px) {
    .ready-to-ship__inner {
      grid-template-columns: 1fr;
      padding: 36px 28px;
      gap: 28px;
    }
    .ready-to-ship__action {
      align-items: flex-start;
    }
    [dir="rtl"] .ready-to-ship__action {
      align-items: flex-end;
    }
    .ready-to-ship__title {
      font-size: 1.7rem;
    }
    .ready-to-ship__note {
      text-align: left;
    }
    [dir="rtl"] .ready-to-ship__note {
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ready-to-ship__button,
    .ready-to-ship__button:hover {
      transition: none;
      transform: none;
    }
  }
</style>
