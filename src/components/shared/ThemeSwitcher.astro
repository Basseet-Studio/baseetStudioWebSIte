---
// ThemeSwitcher.astro — Day/Night toggle. Renders both sun + moon icons
// with a '/' separator so the visual reads as "either/or". Good padding
// around the pair. Click anywhere on the button to toggle.
import Icon from '../icons/Icon.astro'
import { t } from '../../lib/i18n'
import type { Lang } from '../../types'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
---

<button
  type="button"
  class="theme-switcher"
  id="theme-switcher"
  aria-label={t('theme_switch_to_night', lang)}
  aria-pressed="false"
  title={t('theme_toggle', lang)}
  data-label-day={t('theme_switch_to_day', lang)}
  data-label-night={t('theme_switch_to_night', lang)}
>
  <Icon name="sun" size={16} color="currentColor" />
  <span class="theme-switcher__sep" aria-hidden="true">/</span>
  <Icon name="moon" size={16} color="currentColor" />
</button>

<script>
  import {
    THEME_STORAGE_KEY,
    applyTheme,
    getHourFromDate,
    getUiThemeForHour,
    pinSkyHourForTheme,
    resolveThemeFromClock,
    type SiteTheme,
  } from '../../lib/theme'

  let themeClockInterval: ReturnType<typeof setInterval> | null = null

  function getCurrentTheme(): SiteTheme {
    return document.documentElement.getAttribute('data-theme') === 'night' ? 'night' : 'day'
  }

  function updateThemeSwitchUI() {
    const button = document.getElementById('theme-switcher')
    if (!button) return
    const isNight = getCurrentTheme() === 'night'
    button.setAttribute('aria-pressed', String(isNight))
    button.setAttribute(
      'aria-label',
      isNight ? button.dataset.labelDay || 'Switch to day mode' : button.dataset.labelNight || 'Switch to night mode',
    )
  }

  function syncThemeFromClock() {
    applyTheme(resolveThemeFromClock())
    updateThemeSwitchUI()
  }

  function initThemeFromStorage() {
    try {
      const saved = localStorage.getItem(THEME_STORAGE_KEY)
      if (saved === 'day' || saved === 'night') {
        const liveTheme = getUiThemeForHour(getHourFromDate())
        if (saved !== liveTheme) {
          pinSkyHourForTheme(saved)
        }
      }
    } catch {
      /* ignore */
    }
  }

  function initThemeSwitcher() {
    const button = document.getElementById('theme-switcher')
    if (!button) return

    initThemeFromStorage()
    syncThemeFromClock()
    updateThemeSwitchUI()

    if (!themeClockInterval) {
      themeClockInterval = window.setInterval(syncThemeFromClock, 60_000)
    }

    button.onclick = () => {
      const nextTheme: SiteTheme = getCurrentTheme() === 'night' ? 'day' : 'night'
      pinSkyHourForTheme(nextTheme)
      applyTheme(nextTheme)
      try {
        localStorage.setItem(THEME_STORAGE_KEY, nextTheme)
      } catch {
        /* ignore */
      }
      updateThemeSwitchUI()
      import('../../lib/scene/cloudscape-boot.ts')
        .then((m) => m.setCloudscapeTheme(nextTheme))
        .catch((err) => console.warn('[ThemeSwitcher] cloudscape theme update failed:', err))
    }
  }

  window.addEventListener('load', initThemeSwitcher)
  document.addEventListener('astro:page-load', initThemeSwitcher)
  document.addEventListener('baseet:theme-change', updateThemeSwitchUI)
</script>

<style>
  .theme-switcher {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid var(--border-soft);
    border-radius: var(--card-window-radius-tight, 18px);
    background: var(--bg-elevated);
    color: var(--text-primary);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }

  .theme-switcher:hover {
    background: var(--interactive-hover);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .theme-switcher__sep {
    font-size: 1.05rem;
    font-weight: 600;
    opacity: 0.45;
    line-height: 1;
    user-select: none;
  }
</style>
