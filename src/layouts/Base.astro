---
// Base.astro — Root layout shell with ViewTransitions, CloudscapeBg, AppBar, Footer
import { ClientRouter } from 'astro:transitions'
import CloudscapeBg from '../components/background/CloudscapeBg.astro'
import { resolveSceneConfig } from '../lib/scene/resolve-scene-config'
import AppBar from '../components/nav/AppBar.astro'
import Footer from '../components/shared/Footer.astro'
import PaperFilters from '../components/shared/PaperFilters.astro'
import type { Lang, Section, NavItem } from '../types'
import { t } from '../lib/i18n'
import {
  LOCALES,
  hreflangAlternates,
  htmlLang,
  inLanguage,
  isRtl,
  localizedUrl,
  ogLocale,
  stripLocalePrefix,
} from '../lib/locale'

import '../styles/global.css'
import '../styles/glass.css'
import '../styles/animations.css'
import '../styles/nav.css'

interface Props {
  title: string
  description?: string
  section: Section
  lang: Lang
  ogImage?: string
  ogImageAlt?: string
  ogImageWidth?: number
  ogImageHeight?: number
  projectName?: string
  projectColor?: string
  projectIconClass?: string
  slug?: string
  projectNavItems?: NavItem[]
  projectNavMeta?: NavItem[]
  /** Render the footer in compact (Projects + Services only) mode. */
  footerCompact?: boolean
}

const {
  title,
  description,
  section,
  lang = 'en',
  ogImage = '/icons/bold/clover-bold.svg',
  ogImageAlt = 'Baseet Studio — Digital product studio in Abu Dhabi',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  projectName,
  projectColor,
  projectIconClass,
  slug,
  projectNavItems,
  projectNavMeta,
  footerCompact = false,
} = Astro.props

// Canonical + hreflang URLs (relative path on the canonical Site URL).
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? 'https://baseetstudio.com'
const pathname = Astro.url.pathname
const sceneConfig = resolveSceneConfig(pathname)
const sceneConfigJson = JSON.stringify(sceneConfig)
const barePath = stripLocalePrefix(pathname)
const canonicalURL = localizedUrl(siteOrigin, lang, barePath)
const alternates = hreflangAlternates(siteOrigin, barePath)

// lang / dir are dynamic for all locales.
const htmlLangAttr = htmlLang(lang)
const htmlDir = isRtl(lang) ? 'rtl' : 'ltr'

// Twitter handle (matches the social link in links.json).
const twitterHandle = '@baseetstudios'

// Default description if the page does not pass one.
const fallbackDescription = 'Baseet Studio crafts mobile apps, web platforms, and digital experiences for ambitious brands in Abu Dhabi and beyond.'
const metaDescription = description || fallbackDescription

// Locale tags per page language.
const ogLocaleValue = ogLocale(lang)
const ogLocaleAlternates = LOCALES.filter((l) => l !== lang).map((l) => ogLocale(l))

// JSON-LD: Organization + LocalBusiness + WebSite.
const jsonLdOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteOrigin}/#organization`,
  name: 'Baseet Studio',
  url: siteOrigin,
  logo: `${siteOrigin}/icons/bold/clover-bold.svg`,
  email: 'mailto:baseet.socials@gmail.com',
  telephone: '+971507566474',
  sameAs: [
    'https://github.com/baseetstudios',
    'https://linkedin.com/company/baseetstudios',
    'https://twitter.com/baseetstudios',
    'https://instagram.com/baseet.studio',
    'https://tiktok.com/@baseet.studio',
  ],
}

const jsonLdLocalBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteOrigin}/#localbusiness`,
  name: 'Baseet Studio',
  image: `${siteOrigin}/icons/bold/clover-bold.svg`,
  url: siteOrigin,
  telephone: '+971507566474',
  email: 'baseet.socials@gmail.com',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Abu Dhabi',
    addressRegion: 'Abu Dhabi',
    addressCountry: 'AE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 24.4539,
    longitude: 54.3773,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
      opens: '09:00',
      closes: '18:00',
    },
  ],
  parentOrganization: { '@id': `${siteOrigin}/#organization` },
}

const jsonLdWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteOrigin}/#website`,
  name: 'Baseet Studio',
  url: siteOrigin,
  inLanguage: LOCALES.map((l) => inLanguage(l)),
  publisher: { '@id': `${siteOrigin}/#organization` },
}
---

<!doctype html>
<html lang={htmlLangAttr} dir={htmlDir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline src="/theme-boot.js" data-astro-rerun></script>

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />

    {/* hreflang alternates for all locales */}
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Baseet Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocaleValue} />
    {ogLocaleAlternates.map((loc) => (
      <meta property="og:locale:alternate" content={loc} />
    ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />

    <!-- Google Fonts — Space Grotesk (display), Fraunces (accent), Inter (body).
         Locale script faces for ar/ur/hi. One link per family so loaders and
         tooling can see the three-face system clearly. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500;1,9..144,600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Amiri+Quran&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">

    <ClientRouter />

    <!-- JSON-LD: Organization, LocalBusiness, WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrganization)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdLocalBusiness)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebSite)} is:inline />
  </head>
  <body
    data-page={section}
    data-lang={lang}
    data-scene-renderer={sceneConfig.renderer}
    data-scene-config={sceneConfigJson}
  >
    <a href="#main-content" class="skip-to-content">{t('skip_to_content', lang)}</a>
    <PaperFilters />
    <CloudscapeBg />
    <AppBar lang={lang} slug={slug} projectName={projectName} projectColor={projectColor} projectIconClass={projectIconClass} projectNavItems={projectNavItems} projectNavMeta={projectNavMeta} />

    <main transition:animate="fade" transition:name="content" id="main-content" style="position:relative;z-index:1;min-height:100vh;">
      <slot />
    </main>

    <Footer compact={footerCompact} lang={lang} />

    <script define:vars={{ sceneConfig }}>
      window.__BASEET_SCENE_CONFIG__ = sceneConfig
    </script>

    <script>
      import('../animations/global.ts').then(m => {
        m.init()
        document.addEventListener('astro:after-swap', () => {
          m.destroy()
          m.init()
        })
      })
    </script>

    <script>
      // Round 3 — visitor auto-detect (device + country) in the footer.
      // Re-runs on astro:page-load so the line updates on view-transition navigations.
      import('../scripts/visitor-detect').then(m => {
        const run = () => m.init()
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', run)
        } else {
          run()
        }
        document.addEventListener('astro:page-load', run)
      })
    </script>
  </body>
</html>
