---
import Base from './Base.astro'
import type { Lang, Section } from '../types'

interface Props {
  title: string
  description?: string
  section: Section
  lang?: Lang
  /** Render the footer in compact (Projects + Services only) mode. */
  footerCompact?: boolean
  /** Drop the default page padding so a full-viewport hero owns the first screen. */
  flushHero?: boolean
}

const { title, description, section, lang = 'en', footerCompact = false, flushHero = false } = Astro.props
---

<Base
  title={title}
  description={description}
  section={section}
  lang={lang}
  footerCompact={footerCompact}
>
  <div class:list={['page-content', { 'page-content--flush-hero': flushHero }]}>
    <slot />
  </div>
</Base>
