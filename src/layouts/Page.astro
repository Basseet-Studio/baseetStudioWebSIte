---
import Base from './Base.astro'
import type { Lang, Section } from '../types'

interface Props {
  title: string
  description?: string
  section: Section
  lang?: Lang
  /** Render the footer in compact (Projects + Services only) mode. */
  footerCompact?: boolean
}

const { title, description, section, lang = 'en', footerCompact = false } = Astro.props
---

<Base
  title={title}
  description={description}
  section={section}
  lang={lang}
  footerCompact={footerCompact}
>
  <div class="page-content" style="max-width:1200px;margin:0 auto;padding:120px 24px 64px;">
    <slot />
  </div>
</Base>
