---
// Project.astro — Per-project layout wrapper extending Base.astro
// Exposes the project accent as --project-color (accent use only)
// Passes project nav items to AppBar for adaptive navigation
import Base from './Base.astro'
import type { Lang, NavItem } from '../types'
import '../styles/projects/shared.css'
import '../styles/projects/editorial.css'

interface Props {
  title: string
  description?: string
  slug: string
  projectColor: string
  projectGradient: string
  projectName?: string
  projectIconClass?: string
  projectNavItems?: NavItem[]
  projectNavMeta?: NavItem[]
  lang?: Lang
}

const { title, description, slug, projectColor, projectName, projectIconClass, projectNavItems, projectNavMeta, lang = 'en' } = Astro.props
const accent = /^#[0-9a-fA-F]{3,8}$/.test(projectColor || '') ? projectColor : '#496BC1'
---

<Base title={title} description={description} section="projects" lang={lang} projectName={projectName} projectColor={'#496BC1'} projectIconClass={projectIconClass} slug={slug} projectNavItems={projectNavItems} projectNavMeta={projectNavMeta}>
  {/* The project's own brand colour is exposed as a small accent only
      (status dot, numbering, focus details). --project-gradient is a flat
      colour so legacy "white text on gradient" elements stay readable.
      No page-level wash or background effect is rendered here. */}
  <div
    style={`--project-color:${accent};--project-gradient:${accent};`}
    class="project-wrapper" data-project={slug}
  >
    <slot />
  </div>
</Base>
