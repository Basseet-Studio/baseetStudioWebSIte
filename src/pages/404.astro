---
import Base from '../layouts/Base.astro'

// Return a real HTTP 404 so search engines and crawlers de-index the URL.
Astro.response.status = 404
---

<Base title="404 — Page Not Found" description="The page you are looking for could not be found. Return to the Baseet Studio homepage." section="home" lang="en">
  <div
    style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100dvh;text-align:center;padding:4rem 1.5rem;"
  >
    <h1 style="font-size:clamp(1.5rem, 8vw, 4rem);font-weight:700;margin:0;opacity:0.3;line-height:1;">
      404
    </h1>
    <h2 style="font-size:1.75rem;margin:1rem 0 0.5rem;">
      Page Not Found
    </h2>
    <p style="max-width:100%;opacity:0.6;margin-bottom:2rem;">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="cta-btn--primary"
      style="background:var(--color-primary);"
    >
      Back to Home
    </a>
  </div>
</Base>
