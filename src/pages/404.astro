---
import Base from '../layouts/Base.astro'

// Return a real HTTP 404 so search engines and crawlers de-index the URL.
Astro.response.status = 404
---

<Base title="404 — Page Not Found" description="The page you are looking for could not be found. Return to the Baseet Studio homepage." section="home" lang="en">
  <div
    style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;text-align:center;padding:0 24px;"
  >
    <h1 style="font-size:6rem;font-weight:700;margin:0;opacity:0.3;line-height:1;">
      404
    </h1>
    <h2 style="font-size:1.75rem;margin:16px 0 8px;">
      Page Not Found
    </h2>
    <p style="max-width:400px;opacity:0.6;margin-bottom:32px;">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      style={`
        display:inline-block;
        padding:12px 32px;
        border-radius:50px;
        background:var(--color-primary);
        color:white;
        text-decoration:none;
        font-weight:600;
        transition:opacity 0.2s;
      `}
    >
      Back to Home
    </a>
  </div>
</Base>
