---
import ClientsIndex from '../../../views/ClientsIndex.astro'
import { PREFIXED_LOCALES, parseLocaleParam } from '../../../lib/locale'
import type { Lang } from '../../../types'

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((locale) => ({ params: { locale } }))
}

const lang = parseLocaleParam(Astro.params.locale) as Lang
---
<ClientsIndex lang={lang} />
