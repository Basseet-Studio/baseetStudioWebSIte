---
// Locale-prefixed project landing — reuses the EN custom landings with lang.
import Geeb from '../../../projects/geeb.astro'
import Numu from '../../../projects/numu.astro'
import Moneybox from '../../../projects/moneybox.astro'
import Matrix from '../../../projects/matrix.astro'
import Invexo from '../../../projects/invexo.astro'
import Ordelo from '../../../projects/ordelo.astro'
import Zyrn from '../../../projects/zyrn.astro'
import Chopshop from '../../../projects/chopshop.astro'
import Medev from '../../../projects/medev.astro'
import Jemeti from '../../../projects/jemeti.astro'
import Photorestore from '../../../projects/photorestore-ai.astro'
import MedicalEducation from '../../../projects/medical-education-app.astro'
import NssFair from '../../../projects/nss-virtual-education-fair.astro'
import { getProject, getProjectSlugs } from '../../../../lib/projects'
import { PREFIXED_LOCALES, parseLocaleParam } from '../../../../lib/locale'
import { localizeHref } from '../../../../lib/localize-href'
import type { Lang } from '../../../../types'

export function getStaticPaths() {
  return PREFIXED_LOCALES.flatMap((locale) =>
    getProjectSlugs(locale).map((slug) => ({
      params: { locale, slug },
    })),
  )
}

const lang = parseLocaleParam(Astro.params.locale) as Lang
const slug = Astro.params.slug as string
const project = getProject(slug, lang)

if (!project) {
  return Astro.redirect(localizeHref(lang, '/404'))
}
---

{slug === 'geeb' && <Geeb lang={lang} />}
{slug === 'numu' && <Numu lang={lang} />}
{slug === 'moneybox' && <Moneybox lang={lang} />}
{slug === 'matrix' && <Matrix lang={lang} />}
{slug === 'invexo' && <Invexo lang={lang} />}
{slug === 'ordelo' && <Ordelo lang={lang} />}
{slug === 'zyrn' && <Zyrn lang={lang} />}
{slug === 'chopshop' && <Chopshop lang={lang} />}
{slug === 'medev' && <Medev lang={lang} />}
{slug === 'jemeti' && <Jemeti lang={lang} />}
{slug === 'photorestore-ai' && <Photorestore lang={lang} />}
{slug === 'medical-education-app' && <MedicalEducation lang={lang} />}
{slug === 'nss-virtual-education-fair' && <NssFair lang={lang} />}
