---
// /ar/services — Arabic mirror of the /services index page.
//
// Scope per PRODUCT.md: localized chrome (eyebrows, CTAs, page-level copy)
// + RTL layout. Per-service content (subServices copy, hero subtitle, etc.)
// is currently shown in English; full Arabic content translation is a
// follow-up pass tracked separately. The page is honest about this with
// the "lang note" near the top — better than fake-translated copy that
// erodes trust with Arabic-speaking prospects.
//
// The same build-time data flow as the EN page (getServicesIndex +
// getAllServices) is used; only the chrome strings swap.
import Page from '../../../layouts/Page.astro'
import Icon from '../../../components/icons/Icon.astro'
import { resolveIcon } from '../../../components/icons/iconMappings'
import { getAllServices, getServicesIndex } from '../../../lib/services'
import servicesIndex from '../../../content/data/services.json'
import ar from '../../../content/i18n/services.json'
import type { Lang } from '../../../types'

const lang: Lang = 'ar'
const t = ar.page.index

// Same data wiring as the EN page: sub-services come from the per-slug
// detail files, capped to 3 per card so the card stays a glance, not a list.
const subsBySlug: Record<string, Array<{ name: string; icon: string }>> = {}
for (const detail of getAllServices()) {
  subsBySlug[detail.slug] = (detail.subServices ?? []).slice(0, 3).map((s) => ({
    name: s.name,
    icon: s.icon,
  }))
}

const servicesData = {
  ...servicesIndex,
  categories: getServicesIndex(),
}

// Honest content-availability note. The studio hasn't shipped Arabic
// translations of the per-service copy yet; the chrome and layout are
// Arabic. A small banner near the page title makes the state clear without
// hiding it in a footer.
const contentNote =
  'الصفحة الرئيسية والوصف التفصيلي للخدمات متاحان بالعربية. تفاصيل الخدمات (الأوصاف، العمليات، الأسئلة الشائعة) متاحة حاليًا بالإنجليزية.'
---

<Page title={t.title} description={t.description} section="services" lang={lang}>
  <section class="mb-16" data-animate="fade-up">
    <h1 class="text-4xl font-bold mb-4" style="color:var(--heading-text);">
      {t.titleHead}
    </h1>
    <p class="text-lg opacity-70 max-w-2xl" style="color:var(--muted-text);">
      {t.titleSub}
    </p>
    <p class="text-base opacity-60 max-w-3xl mt-2" style="color:var(--muted-text);">
      {t.titleDesc}
    </p>
    <p class="text-sm opacity-60 max-w-3xl mt-4 p-3 rounded" style="background:color-mix(in srgb, var(--color-primary) 8%, transparent); color:var(--muted-text);">
      {contentNote}
    </p>
  </section>

  <div class="services-grid">
    {servicesData.categories?.map((category: any) => {
      const cat = resolveIcon(category.icon || 'fas fa-circle')
      return (
        <a
          id={category.id}
          href={`/ar/services/${category.slug}/`}
          class="service-card card-window"
          data-animate="fade-up"
          style={`--card-accent:${category.color};`}
        >
          <div class="service-card__bar" style={`background:${category.gradient};`}></div>
          <div class="service-card__body">
            <div class="service-card__icon" style={`background:color-mix(in srgb, ${category.color} 12%, transparent);color:${category.color};`}>
              <Icon name={cat.name} variant={cat.variant} size={26} color="currentColor" />
            </div>
            <h2 class="service-card__title">{category.title}</h2>
            {category.tagline && <p class="service-card__tagline">{category.tagline}</p>}
            <p class="service-card__short">{category.shortDescription}</p>
            <ul class="service-card__list">
              {(subsBySlug[category.slug] ?? []).map((sub) => {
                const subIcon = resolveIcon(sub.icon || 'fas fa-circle')
                return (
                  <li class="service-card__list-item">
                    <span class="service-card__list-icon" style={`color:${category.color};`}>
                      <Icon name={subIcon.name} variant={subIcon.variant} size={14} color="currentColor" />
                    </span>
                    <span>{sub.name}</span>
                  </li>
                )
              })}
            </ul>
            <span class="service-card__cta" style={`color:${category.color};`}>
              {t.cardCta}
              <Icon name="arrow-left" size={14} color="currentColor" />
            </span>
          </div>
        </a>
      )
    })}
  </div>

  {servicesData.process?.steps?.length > 0 && (
    <section class="mt-20" id="process" data-animate="fade-up">
      <h2 class="text-3xl font-bold mb-2 text-center" style="color:var(--heading-text);">
        {t.processTitle}
      </h2>
      <p class="text-center opacity-70 mb-10" style="color:var(--muted-text);">
        {t.processSub}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicesData.process.steps.map((step: any) => {
          const stepIcon = resolveIcon(step.icon || 'fas fa-circle')
          return (
            <div class="card-window card-window--tight p-6 text-center" data-animate="fade-up">
              <div
                class="w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-sm font-bold"
                style="background: var(--color-primary); color: white;"
              >
                {step.number}
              </div>
              <div class="mb-3 flex justify-center" style="color: var(--color-primary);">
                <Icon name={stepIcon.name} variant={stepIcon.variant} size={20} color="currentColor" />
              </div>
              <h3 class="font-semibold mb-2" style="color:var(--heading-text);">{step.title}</h3>
              <p class="text-sm opacity-60" style="color:var(--muted-text);">{step.desc}</p>
            </div>
          )
        })}
      </div>
    </section>
  )}

  {servicesData.cta && (
    <div class="text-center mt-16 card-window p-12" data-animate="fade-in">
      <h3 class="text-2xl font-bold mb-2" style="color:var(--heading-text);">{t.ctaTitle}</h3>
      {servicesData.cta.subtitle && (
        <p class="text-lg opacity-80 mb-2" style="color:var(--muted-text);">{t.ctaSub}</p>
      )}
      {servicesData.cta.description && (
        <p class="opacity-70 mb-6 max-w-2xl mx-auto" style="color:var(--muted-text);">{t.ctaDesc}</p>
      )}
      <a
        href="/ar/contact/"
        class="inline-block px-8 py-3 rounded-full font-semibold transition-all duration-300 hover:scale-105"
        style="background: var(--color-primary); color: white;"
      >
        {t.ctaButton}
      </a>
    </div>
  )}
</Page>
