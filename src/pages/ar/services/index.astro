---
// /ar/services — Arabic mirror of the /services index page.
//
// Scope per PRODUCT.md: localized chrome (eyebrows, CTAs, page-level copy)
// + RTL layout. Per-service content (subServices copy, hero subtitle, etc.)
// is currently shown in English; full Arabic content translation is a
// follow-up pass tracked separately. The page is honest about this with
// the "lang note" near the top — better than fake-translated copy that
// erodes trust with Arabic-speaking prospects.
//
// Reuses ServicesBento.astro + ServiceCard.astro so the layout is identical
// to the EN page (with RTL adjustments via the [dir="rtl"] selectors baked
// into the components).
import Page from '../../../layouts/Page.astro'
import { getAllServices, getServicesIndex } from '../../../lib/services'
import servicesIndex from '../../../content/data/services.json'
import ServicesBento from '../../../components/shared/ServicesBento.astro'
import ar from '../../../content/i18n/services.json'
import type { Lang } from '../../../types'

const lang: Lang = 'ar'
const t = ar.page.index

const subsBySlug: Record<string, Array<{ name: string; icon: string }>> = {}
for (const detail of getAllServices()) {
  subsBySlug[detail.slug] = (detail.subServices ?? []).slice(0, 3).map((s) => ({
    name: s.name,
    icon: s.icon,
  }))
}

const servicesData = {
  ...servicesIndex,
  categories: getServicesIndex().map((c: any) => ({
    ...c,
    subServices: subsBySlug[c.slug] ?? [],
  })),
}

// Honest content-availability note. The studio hasn't shipped Arabic
// translations of the per-service copy yet; the chrome and layout are
// Arabic. A small banner near the page title makes the state clear without
// hiding it in a footer.
const contentNote =
  'الصفحة الرئيسية والوصف التفصيلي للخدمات متاحان بالعربية. تفاصيل الخدمات (الأوصاف، العمليات، الأسئلة الشائعة) متاحة حاليًا بالإنجليزية.'
---

<Page title={t.title} description={t.description} section="services" lang={lang}>
  <section class="services-hero" data-animate="fade-up">
    <span class="services-hero__eyebrow">
      <span class="services-hero__eyebrow-dot" aria-hidden="true"></span>
      {t.titleEyebrow}
    </span>
    <h1 class="services-hero__title">
      ست خدمات.<br/>
      <span class="services-hero__title-accent">استوديو واحد، من البداية إلى النهاية.</span>
    </h1>
    <p class="services-hero__lead">
      {t.titleDesc}
    </p>

    <dl class="services-hero__meta">
      <div class="services-hero__meta-item">
        <dt>متوسط الشراكة</dt>
        <dd>3 سنوات</dd>
      </div>
      <div class="services-hero__meta-item">
        <dt>الخدمات</dt>
        <dd>06</dd>
      </div>
      <div class="services-hero__meta-item">
        <dt>المقر</dt>
        <dd>أبوظبي، الإمارات</dd>
      </div>
    </dl>

    <p class="ar-content-note" role="note">
      {contentNote}
    </p>
  </section>

  <ServicesBento
    categories={servicesData.categories}
    process={{
      title: t.processTitle,
      subtitle: t.processSub,
      steps: servicesData.process?.steps ?? [],
    }}
    cta={{
      title: t.ctaTitle,
      subtitle: t.ctaSub,
      description: t.ctaDesc,
      button: t.ctaButton,
    }}
    copy={{
          explore: t.cardCta,
          ctaHref: '/ar/contact/',
          ctaArrowIcon: 'arrow-left',
          cardArrowIcon: 'arrow-left',
        }}
  />
</Page>

<style>
  /* Same hero system as the EN page. The eyebrow uses dir=rtl to flip the
     breathing-dot position via logical properties. */
  .services-hero {
    margin-bottom: 64px;
    max-width: 880px;
  }

  .services-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 12px;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 22%, transparent);
    margin-bottom: 24px;
  }

  .services-hero__eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-primary) 60%, transparent);
    animation: services-pulse 2.4s ease-in-out infinite;
  }

  [data-theme="night"] .services-hero__eyebrow-dot {
    animation: none;
  }

  @keyframes services-pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-primary) 60%, transparent);
    }
    50% {
      box-shadow: 0 0 0 8px color-mix(in srgb, var(--color-primary) 0%, transparent);
    }
  }

  .services-hero__title {
    font-size: clamp(2.4rem, 5.4vw, 4.4rem);
    line-height: 1.18;
    font-weight: 400;
    color: var(--heading-text);
    margin: 0 0 22px;
    letter-spacing: -0.01em;
  }

  .services-hero__title-accent {
    color: var(--color-primary);
  }

  .services-hero__lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--muted-text);
    margin: 0 0 36px;
    max-width: 62ch;
  }

  .services-hero__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, max-content));
    gap: 56px;
    margin: 0;
    padding-top: 28px;
    border-top: 1px solid var(--divider-color);
  }

  .services-hero__meta-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .services-hero__meta-item dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-text);
    font-weight: 600;
    margin: 0;
  }

  .services-hero__meta-item dd {
    font-family: var(--font-title);
    font-size: 1.65rem;
    color: var(--heading-text);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .ar-content-note {
    margin: 28px 0 0;
    padding: 14px 18px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-primary) 7%, transparent);
    color: var(--muted-text);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .services-hero__meta {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .services-hero__meta-item dd {
      font-size: 1.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-hero__eyebrow-dot {
      animation: none;
    }
  }
</style>
