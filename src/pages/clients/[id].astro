---
import ClientDetail from '../../views/ClientDetail.astro'
import { getAllClients } from '../../lib/clients'

export function getStaticPaths() {
  return getAllClients('en').map((client) => ({
    params: { id: client.id },
  }))
}

const { id } = Astro.params
---
<ClientDetail lang="en" id={id as string} />
