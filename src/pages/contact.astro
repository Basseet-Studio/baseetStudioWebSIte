---
// /contact — Post a letter.
//
// The contact page is a single paper letter / envelope. No top hero, no
// channel bento — all contact info lives inside the letter (recipient
// block) and on the envelope (stamps). Reply time / working hours are
// metadata inside the form, not a separate section.
import Page from '../layouts/Page.astro'
import linksData from '../content/data/links.json'
import ContactForm from '../components/shared/ContactForm.astro'
import type { Lang } from '../types'

const lang: 'en' = 'en'
const description =
  'Tell us what you are shipping. Baseet Studio in Abu Dhabi — we reply to every project enquiry within one working day.'
---

<Page title="Contact — Baseet Studio" description={description} section="contact" lang={lang} footerCompact>
  <section class="form-section" data-animate="fade-up">
    <ContactForm actionUrl={linksData.forms.contact_form_url} lang={lang} />
  </section>
</Page>

<style>
  /* =====================================================================
     Form section — only the form, no hero / bento on this page. The
     envelope itself does the storytelling.
     ===================================================================== */
  .form-section {
    /* Center the envelope horizontally with comfortable vertical space. */
    max-width: 1080px;
    margin: 0 auto 64px;
  }
</style>
