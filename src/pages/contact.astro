---
// /contact — The Direct Line.
//
// Editorial hero with a real human greeting. Email + phone + WhatsApp get
// the bento treatment (different sizes, different visual weight) — NOT
// three identical stacked glass cards. Form gets a wider home with a
// 2-column internal layout for short fields. NO glassmorphism (absolute
// ban); all surfaces use the card-window token so the Vanta clouds stay
// visible.
import Page from '../layouts/Page.astro'
import Icon from '../components/icons/Icon.astro'
import linksData from '../content/data/links.json'
import ContactForm from '../components/shared/ContactForm.astro'
import type { Lang } from '../types'


const lang: 'en' = 'en'
const description =
  'Tell us what you are shipping. Baseet Studio in Abu Dhabi — we reply to every project enquiry within one working day.'

// Gulf Standard Time (GST = UTC+4, no DST). Abu Dhabi stays on this year-round.
// Rendered as a static label so the timezone promise is honest without
// shipping a runtime clock.
const timezoneLabel = 'GST (UTC+4)'
---

<Page title="Contact — Baseet Studio" description={description} section="contact" lang={lang} footerCompact>
  {/* =====================================================================
       Hero — editorial. Eyebrow + big headline + lead + meta with hours
       and timezone.
       ===================================================================== */}
  <section class="contact-hero" data-animate="fade-up">
    <span class="contact-hero__eyebrow">
      <span class="contact-hero__eyebrow-dot" aria-hidden="true"></span>
      {/* TODO: localise this later */ 'Direct line'
    </span>
    <h1 class="contact-hero__title">
      {/* TODO: localise this later */}
      Tell us what<br/>
      <span class="contact-hero__title-accent">you're shipping.</span>
    </h1>
    <p class="contact-hero__lead">
      {/* TODO: localise this later */}
      A new product, a stuck project, a curious question — pick the channel that suits you. We read every message and reply within one working day, Gulf Standard Time.
    </p>

    <dl class="contact-hero__meta">
      <div class="contact-hero__meta-item">
        <dt>Reply within</dt>
        <dd>1 working day</dd>
      </div>
      <div class="contact-hero__meta-item">
        <dt>Working hours</dt>
        <dd>Sun – Thu · 9–18</dd>
      </div>
      <div class="contact-hero__meta-item">
        <dt>Timezone</dt>
        <dd>{timezoneLabel}</dd>
      </div>
    </dl>
  </section>

  {/* =====================================================================
       Direct channels — the bento. Each channel has its own visual weight.
       Email is the anchor (full-width, big). Phone and WhatsApp share a row
       with different widths. Address + social fill the bottom strip.
       ===================================================================== */}
  <section class="channels" data-animate="fade-up" aria-label="Direct contact channels">
    {/* Anchor — email */}
    <a
      href={linksData.contact.email_link}
      class="channel channel--email card-window"
      data-animate="fade-up"
    >
      <div class="channel__head">
        <span class="channel__icon" style="background:color-mix(in srgb, var(--color-primary) 14%, transparent);color:var(--color-primary);">
          <Icon name="envelope" size={26} color="currentColor" />
        </span>
        <div class="channel__meta">
          <span class="channel__label">Email — preferred for project briefs</span>
          <span class="channel__value channel__value--lg">
            {linksData.contact.email}
          </span>
        </div>
      </div>
      <span class="channel__cta">
        Open in mail app
        <Icon name="arrow-up-right" size={16} color="currentColor" />
      </span>
    </a>

    {/* Wide — phone */}
    <a
      href={linksData.contact.phone_link}
      class="channel channel--phone card-window"
      data-animate="fade-up"
    >
      <div class="channel__head">
        <span class="channel__icon" style="background:color-mix(in srgb, var(--color-accent) 16%, transparent);color:var(--color-accent);">
          <Icon name="phone" size={24} color="currentColor" />
        </span>
        <div class="channel__meta">
          <span class="channel__label">Phone · {timezoneLabel}</span>
          <span class="channel__value">
            {linksData.contact.phone}
          </span>
        </div>
      </div>
      <span class="channel__cta">
        Call now
        <Icon name="arrow-up-right" size={16} color="currentColor" />
      </span>
    </a>

    {/* Wide — WhatsApp (warm, featured) */}
    <a
      href={linksData.contact.whatsapp_link}
      target="_blank"
      rel="noopener noreferrer"
      class="channel channel--whatsapp card-window"
      data-animate="fade-up"
    >
      <div class="channel__head">
        <span class="channel__icon" style="background:#25D366;color:#fff;">
          <Icon name="whatsapp-logo" size={26} variant="fill" color="currentColor" />
        </span>
        <div class="channel__meta">
          <span class="channel__label">WhatsApp · fastest during working hours</span>
          <span class="channel__value">
            {linksData.contact.whatsapp}
          </span>
        </div>
      </div>
      <span class="channel__cta">
        Open chat
        <Icon name="arrow-up-right" size={16} color="currentColor" />
      </span>
    </a>

    {/* Standard — address */}
    <div class="channel channel--address card-window" data-animate="fade-up">
      <div class="channel__head">
        <span class="channel__icon" style="background:color-mix(in srgb, var(--heading-text) 8%, transparent);color:var(--heading-text);">
          <Icon name="map-pin" size={22} color="currentColor" />
        </span>
        <div class="channel__meta">
          <span class="channel__label">Studio</span>
          <span class="channel__value channel__value--sm">
            {linksData.contact.address}
          </span>
        </div>
      </div>
    </div>
  </section>

  {/* =====================================================================
       Form — paper letter / postcard treatment (paper-post-contact ref).
       The ContactForm component renders the letter, the stamp, and the
       social stamps row all in one block.
       ===================================================================== */}
  <section class="form-section" data-animate="fade-up">
    <header class="form-section__head">
      <h2 class="form-section__title">
        {/* TODO: localise this later */}
        Or write to us here.
      </h2>
      <p class="form-section__sub">
        {/* TODO: localise this later */}
        Same humans read this. The shorter the brief, the faster we reply.
      </p>
    </header>
    <ContactForm actionUrl={linksData.forms.contact_form_url} lang={lang} />
  </section>
</Page>

<style>
  /* =====================================================================
     Hero — same shape as services + clients. Keeps the brand voice in
     one place across the site.
     ===================================================================== */
  .contact-hero {
    margin-bottom: 56px;
    max-width: 880px;
  }

  .contact-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 12px;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 22%, transparent);
    margin-bottom: 24px;
  }

  .contact-hero__eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-primary) 60%, transparent);
    animation: contact-pulse 2.4s ease-in-out infinite;
  }

  [data-theme="night"] .contact-hero__eyebrow-dot {
    animation: none;
  }

  @keyframes contact-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-primary) 60%, transparent); }
    50% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--color-primary) 0%, transparent); }
  }

  .contact-hero__title {
    font-size: clamp(2.4rem, 5.4vw, 4.4rem);
    line-height: 1.04;
    font-weight: 400;
    color: var(--heading-text);
    margin: 0 0 22px;
    letter-spacing: -0.02em;
  }

  .contact-hero__title-accent {
    color: var(--color-primary);
    font-style: italic;
  }

  [lang="ar"] .contact-hero__title-accent,
  [dir="rtl"] .contact-hero__title-accent {
    font-style: normal;
  }

  .contact-hero__lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--muted-text);
    margin: 0 0 36px;
    max-width: 62ch;
  }

  .contact-hero__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, max-content));
    gap: 56px;
    margin: 0;
    padding-top: 28px;
    border-top: 1px solid var(--divider-color);
  }

  .contact-hero__meta-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact-hero__meta-item dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-text);
    font-weight: 600;
    margin: 0;
  }

  .contact-hero__meta-item dd {
    font-family: var(--font-title);
    font-size: 1.45rem;
    color: var(--heading-text);
    margin: 0;
    letter-spacing: -0.005em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .contact-hero__meta {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .contact-hero__meta-item dd {
      font-size: 1.15rem;
    }
  }

  /* =====================================================================
     Channels bento
     ---------------------------------------------------------------------
     Layout (≥860px):
       Row 1: [Email — full width, the anchor]
       Row 2: [Phone — wide] [WhatsApp — wide]
       Row 3: [Address — standard]
     Different sizes per channel = the offset grid feel. The email is the
     loudest because email is what most teams prefer for project briefs.
     ===================================================================== */
  .channels {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    margin-bottom: 96px;
  }

  .channel--email {
    grid-column: span 6;
  }
  .channel--phone {
    grid-column: span 3;
  }
  .channel--whatsapp {
    grid-column: span 3;
  }
  .channel--address {
    grid-column: span 6;
  }

  @media (max-width: 860px) {
    .channels {
      grid-template-columns: 1fr;
    }
    .channel {
      grid-column: 1 / -1 !important;
    }
  }

  /* ----- Channel card ----- */
  .channel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 32px;
    border-radius: 22px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .channel:not(.channel--address):hover {
    transform: translateY(-3px);
    box-shadow: var(--card-window-shadow-hover);
  }

  /* Anchor (email) — bigger type */
  .channel--email {
    padding: 36px 40px;
  }
  .channel--email .channel__icon {
    width: 60px;
    height: 60px;
  }

  /* Address — quiet, no hover */
  .channel--address {
    cursor: default;
  }

  /* ----- Channel content ----- */
  .channel__head {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: 1;
    min-width: 0;
  }

  .channel__icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .channel__label {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-text);
    font-weight: 600;
  }

  .channel__value {
    font-family: var(--font-title);
    font-size: 1.15rem;
    color: var(--heading-text);
    letter-spacing: -0.005em;
    line-height: 1.15;
    word-break: break-word;
  }

  .channel__value--lg {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .channel__value--sm {
    font-size: 1rem;
    font-family: var(--font-body);
  }

  .channel__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary);
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Hover: lift and shift the CTA arrow. */
  .channel:not(.channel--address):hover .channel__cta {
    transform: translateX(3px);
  }
  [dir="rtl"] .channel:not(.channel--address):hover .channel__cta {
    transform: translateX(-3px);
  }

  /* Per-channel color theming on hover (border accent + cta color).
     The icon stays the same, but the border and cta shift to the channel's
     accent color so each channel feels distinct. */
  .channel--email:hover {
    border-color: color-mix(in srgb, var(--color-primary) 35%, transparent);
  }
  .channel--phone:hover {
    border-color: color-mix(in srgb, var(--color-accent) 38%, transparent);
  }
  .channel--phone:hover .channel__cta {
    color: var(--color-accent);
  }
  .channel--whatsapp:hover {
    border-color: color-mix(in srgb, #25D366 38%, transparent);
  }
  .channel--whatsapp:hover .channel__cta {
    color: #25D366;
  }

  @media (max-width: 720px) {
    .channel {
      padding: 22px 24px;
      gap: 14px;
    }
    .channel--email {
      padding: 28px 24px;
    }
    .channel__head {
      gap: 14px;
    }
    .channel__icon {
      width: 42px;
      height: 42px;
    }
    .channel--email .channel__icon {
      width: 52px;
      height: 52px;
    }
    .channel__value {
      font-size: 1.05rem;
    }
    .channel__value--lg {
      font-size: 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .channel,
    .channel__cta,
    .channel-hero__eyebrow-dot {
      transition: none;
      animation: none;
    }
    .channel:not(.channel--address):hover {
      transform: none;
    }
  }

  /* =====================================================================
     Form section
     ===================================================================== */
  .form-section {
    margin-bottom: 96px;
  }

  .form-section__head {
    margin-bottom: 28px;
    max-width: 640px;
  }

  .form-section__title {
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 400;
    color: var(--heading-text);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .form-section__sub {
    font-size: 0.98rem;
    color: var(--muted-text);
    margin: 0;
    line-height: 1.55;
  }

  /* The ContactForm uses a single-column layout today; the rest of the page
     is doing the work to feel spacious. The form keeps the canvas
     (card-window) without glassmorphism so it sits cleanly in the layout.

   The social-strip block was removed — social links now live inside
   the ContactForm as floating stamps (see ContactForm.astro for the
   paper-stamp treatment). */
</style>
