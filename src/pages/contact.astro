---
import Page from '../layouts/Page.astro'
import Icon from '../components/icons/Icon.astro'
import linksData from '../content/data/links.json'
import ContactForm from '../components/shared/ContactForm.astro'
import type { Lang } from '../types'


const lang: 'en' = 'en'
const description = 'Get in touch with Baseet Studio in Abu Dhabi. We respond to new project enquiries within 24 hours — email, phone, or WhatsApp.'
---

<Page title="Contact Us — Baseet Studio" description={description} section="contact" lang={lang}>
  <!-- Hero Badge + Heading -->
  <section style="margin-bottom:56px;text-align:center;" data-animate="fade-up">
    <span style="display:inline-block;padding:8px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, var(--color-primary, #496BC1) 10%, transparent);color:var(--color-primary, #496BC1);border:1px solid color-mix(in srgb, var(--color-primary, #496BC1) 25%, transparent);margin-bottom:16px;">
      {/* TODO: localise this later */ 'Get in Touch'}
    </span>
    <h1 style="font-size:2.8rem;font-weight:700;margin-bottom:12px;color:var(--heading-text);">
      {/* TODO: localise this later */ "Let's Work Together"}
    </h1>
    <p style="font-size:1.1rem;color:var(--muted-text);max-width:500px;margin:0 auto;">
      {/* TODO: localise this later */ "We'll get back to you within 24 hours."}
    </p>
  </section>

  <div style="display:grid;grid-template-columns:1fr 380px;gap:40px;align-items:start;">
    <!-- Contact Form (2/3) -->
    <div>
      <ContactForm actionUrl={linksData.forms.contact_form_url} lang={lang} />
    </div>

    <!-- Sidebar (1/3) -->
    <aside style="display:flex;flex-direction:column;gap:24px;">

      <!-- Contact Info Card -->
      <div class="glass glass-card" style="padding:28px;border-radius:20px;" data-animate="fade-up">
        <h3 style="font-size:1.1rem;font-weight:600;margin-bottom:20px;color:var(--heading-text);">
          {/* TODO: localise this later */ 'Contact Info'}
        </h3>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:16px;">
          <li style="display:flex;align-items:flex-start;gap:12px;">
            <div style={`width:40px;height:40px;border-radius:12px;background:color-mix(in srgb, var(--color-primary, #496BC1) 10%, transparent);display:flex;align-items:center;justify-content:center;flex-shrink:0;`}>
              <Icon name="envelope" size={20} color="var(--color-primary, #496BC1)" />
            </div>
            <div>
              <p style="font-size:0.7rem;color:var(--muted-text);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:2px;">
                {/* TODO: localise this later */ 'Email'}
              </p>
              <a href={`mailto:${linksData.contact.email}`} style="font-size:0.9rem;color:var(--heading-text);text-decoration:none;transition:opacity 0.2s;"
                onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
                {linksData.contact.email}
              </a>
            </div>
          </li>
          <li style="display:flex;align-items:flex-start;gap:12px;">
            <div style={`width:40px;height:40px;border-radius:12px;background:color-mix(in srgb, var(--color-primary, #496BC1) 10%, transparent);display:flex;align-items:center;justify-content:center;flex-shrink:0;`}>
              <Icon name="phone" size={20} color="var(--color-primary, #496BC1)" />
            </div>
            <div>
              <p style="font-size:0.7rem;color:var(--muted-text);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:2px;">
                {/* TODO: localise this later */ 'Phone'}
              </p>
              <a href={`tel:${linksData.contact.phone}`} style="font-size:0.9rem;color:var(--heading-text);text-decoration:none;transition:opacity 0.2s;"
                onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
                {linksData.contact.phone}
              </a>
            </div>
          </li>
          <li style="display:flex;align-items:flex-start;gap:12px;">
            <div style={`width:40px;height:40px;border-radius:12px;background:color-mix(in srgb, var(--color-primary, #496BC1) 10%, transparent);display:flex;align-items:center;justify-content:center;flex-shrink:0;`}>
              <Icon name="map-pin" size={20} color="var(--color-primary, #496BC1)" />
            </div>
            <div>
              <p style="font-size:0.7rem;color:var(--muted-text);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:2px;">
                {/* TODO: localise this later */ 'Address'}
              </p>
              <p style="font-size:0.9rem;color:var(--heading-text);">{linksData.contact.address}</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- WhatsApp CTA Card -->
      <a href={linksData.contact.whatsapp_link} target="_blank" rel="noopener noreferrer"
        class="glass glass-card" style="padding:28px;border-radius:20px;text-decoration:none;display:block;transition:transform 0.3s;"
        data-animate="fade-up" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style={`width:44px;height:44px;border-radius:12px;background:#25D366;display:flex;align-items:center;justify-content:center;margin-bottom:12px;`}>
          <Icon name="whatsapp-logo" size={22} variant="fill" color="white" />
        </div>
        <h4 style="font-size:1rem;font-weight:600;color:var(--heading-text);margin-bottom:4px;">
          {/* TODO: localise this later */ 'Chat on WhatsApp'}
        </h4>
        <p style="font-size:0.8rem;color:var(--muted-text);">
          {/* TODO: localise this later */ 'Quick responses during business hours'}
        </p>
      </a>

      <!-- Follow Us Card -->
      <div class="glass glass-card" style="padding:28px;border-radius:20px;" data-animate="fade-up">
        <h3 style="font-size:1.1rem;font-weight:600;margin-bottom:16px;color:var(--heading-text);">
          {/* TODO: localise this later */ 'Follow Us'}
        </h3>
        <div style="display:flex;gap:14px;flex-wrap:wrap;">
          {Object.entries(linksData.social).filter(([, url]) => url && url !== '#').map(([platform, url]) => {
            const socialIcons: { [key: string]: string } = {
              instagram: 'instagram-logo', linkedin: 'linkedin-logo', twitter: 'x-logo',
              github: 'github-logo', dribbble: 'dribbble-logo', facebook: 'facebook-logo',
              youtube: 'youtube-logo', tiktok: 'tiktok-logo',
            }
            return (
              <a href={url} target="_blank" rel="noopener noreferrer"
                style="opacity:0.6;transition:opacity 0.2s;color:var(--heading-text);"
                onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'"
                aria-label={platform}>
                <Icon name={socialIcons[platform] || 'globe'} size={22} variant="fill" color="currentColor" />
              </a>
            )
          })}
        </div>
      </div>
    </aside>
  </div>

  <style>
    @media (max-width: 768px) {
      /* On mobile, sidebar stacks below form */
      section + div { grid-template-columns: 1fr !important; }
    }
  </style>
</Page>
