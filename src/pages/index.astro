---
// Home page — imports all home section components
import Page from '../layouts/Page.astro'
import Hero from '../components/home/Hero.astro'
import Features from '../components/home/Features.astro'
import ProximityProjects from '../components/home/ProximityProjects.astro'
import Clients from '../components/home/Clients.astro'
import Team from '../components/home/Team.astro'
import Highlights from '../components/home/Highlights.astro'
import ScrollSpacer from '../components/home/ScrollSpacer.astro'
import homeData from '../content/data/home.json'
import clientsData from '../content/data/clients.json'
import { SOURCE_SVGS } from '../lib/sourceSvgs'
import type { Lang } from '../types'


const lang: 'en' = 'en'
const description = 'Baseet Studio is a digital product studio in Abu Dhabi building mobile apps, web platforms, and digital experiences for ambitious brands.'

// Only show projects that have built logo SVGs in /projects/logos/.
const homeProjects = homeData.projects.filter((p) => SOURCE_SVGS[p.slug])
---

<Page title="Baseet Studio" description={description} section="home" lang={lang}>
  <Hero data={homeData.hero} lang={lang} />
  <ScrollSpacer height="35vh" />
  <Highlights highlights={homeData.highlights} lang={lang} />
  <ScrollSpacer height="30vh" />
  <Features features={homeData.features} lang={lang} />
  <ScrollSpacer height="25vh" />
  <ProximityProjects projects={homeProjects} lang={lang} />
  <Clients clients={clientsData.clients} lang={lang} />
  <Team members={homeData.team} lang={lang} />
  <ScrollSpacer height="20vh" />
</Page>
