---
import ProjectLayout from '../../layouts/Project.astro'
import ProjectGallery from '../../components/project/ProjectGallery.astro'
import ProjectCTA from '../../components/project/ProjectCTA.astro'
import GradientCTA from '../../components/project/GradientCTA.astro'
import Icon from '../../components/icons/Icon.astro'
import { resolveIcon } from '../../components/icons/iconMappings'
import { getProject } from '../../lib/projects'
import type { Project } from '../../types'


const lang: 'en' = 'en'
const slug = 'bd-railway-automated-timetable'
const project = getProject(slug)
if (!project) return Astro.redirect('/404')
---

<ProjectLayout title={`${project.name} — Baseet Studio`} description={project.tagline} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>
  <!-- Case Study Hero -->
  <section style="padding:140px 24px 64px;max-width:900px;margin:0 auto;text-align:center;" data-animate="fade-up">
    <!-- Back to projects link -->
    <a href={'/projects/'} style={`display:inline-flex;align-items:center;gap:8px;color:${project.color};text-decoration:none;font-weight:500;margin-bottom:32px;transition:opacity 0.2s;`}>
      <Icon name="arrow-left" size={20} color={project.color} />
      {/* TODO: localise this later */ 'Back to Projects'}
    </a>

    <!-- Project icon -->
    <div style={`width:80px;height:80px;border-radius:20px;background:${project.gradient};display:flex;align-items:center;justify-content:center;margin:0 auto 24px;box-shadow:0 10px 30px color-mix(in srgb, ${project.color} 25%, transparent);`}>
      <Icon name={resolveIcon(project.iconClass).name} size={36} color="white" />
    </div>

    <h1 style="font-size:2.8rem;font-weight:700;color:var(--heading-text);margin-bottom:8px;">{project.name}</h1>
    <p style={`font-size:1.25rem;color:${project.color};font-weight:600;margin-bottom:32px;`}>{project.tagline}</p>
    <p style="font-size:1.1rem;opacity:0.7;max-width:600px;margin:0 auto 32px;line-height:1.7;">{project.hero.subtitle}</p>

    <!-- CTA Buttons. P1 audit #14 — uses the global `.cta-btn--primary` class. -->
        <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
          {project.hero.cta_primary && (
            <a href={project.hero.cta_primary_link || '/contact/'}
              class="cta-btn--primary"
              style={`background:${project.gradient};`}>
              {project.hero.cta_primary}
            </a>
          )}
        </div>
  </section>

  <!-- Challenge Section -->
  <section style="padding:48px 24px;max-width:800px;margin:0 auto;" data-animate="fade-up">
    <div class="glass glass-card" style="padding:40px;border-radius:24px;">
      <div style={`display:flex;align-items:center;gap:12px;margin-bottom:16px;`}>
        <div style={`width:40px;height:40px;border-radius:12px;background:${project.gradient};display:flex;align-items:center;justify-content:center;`}>
          <Icon name="target" size={20} color="white" />
        </div>
        <h2 style="font-size:1.5rem;font-weight:700;color:var(--heading-text);">
          {/* TODO: localise this later */ 'The Challenge'}
        </h2>
      </div>
      <p style="opacity:0.7;line-height:1.8;font-size:1rem;">
        {project.description ? project.description.replace(/^##\s.*$/gm, '').replace(/\*\*/g, '').replace(/#+\s/g, '').trim().slice(0, 300) + '...' : 'Description coming soon.'}
      </p>
    </div>
  </section>

  <!-- Solution Section -->
  <section style="padding:48px 24px;max-width:800px;margin:0 auto;" data-animate="fade-up">
    <div class="glass glass-card" style="padding:40px;border-radius:24px;">
      <div style={`display:flex;align-items:center;gap:12px;margin-bottom:16px;`}>
        <div style={`width:40px;height:40px;border-radius:12px;background:${project.gradient};display:flex;align-items:center;justify-content:center;`}>
          <Icon name="lightbulb" size={20} color="white" />
        </div>
        <h2 style="font-size:1.5rem;font-weight:700;color:var(--heading-text);">
          {/* TODO: localise this later */ 'Our Solution'}
        </h2>
      </div>
      <p style="opacity:0.7;line-height:1.8;font-size:1rem;">
        {/* TODO: localise this later */ 'We designed and developed a comprehensive solution tailored to the unique requirements, leveraging modern technology and user-centered design principles.'}
      </p>
    </div>
  </section>

  <!-- Gallery -->
  {project.screenshots && project.screenshots.length > 0 && (
    <ProjectGallery screenshots={project.screenshots} galleryType={project.galleryType || 'web'} projectSlug={project.slug} projectColor={project.color} projectName={project.name} />
  )}

  <!-- Results Section -->
  <section style="padding:48px 24px;max-width:800px;margin:0 auto;" data-animate="fade-up">
    <div class="glass glass-card" style="padding:40px;border-radius:24px;">
      <div style={`display:flex;align-items:center;gap:12px;margin-bottom:16px;`}>
        <div style={`width:40px;height:40px;border-radius:12px;background:${project.gradient};display:flex;align-items:center;justify-content:center;`}>
          <Icon name="chart-line" size={20} color="white" />
        </div>
        <h2 style="font-size:1.5rem;font-weight:700;color:var(--heading-text);">
          {/* TODO: localise this later */ 'Results'}
        </h2>
      </div>
      <p style="opacity:0.7;line-height:1.8;font-size:1rem;">
        {/* TODO: localise this later */ 'The project was delivered successfully, meeting all requirements and exceeding expectations in performance, usability, and reliability.'}
      </p>
    </div>
  </section>

  <!-- Technology Used -->
  {project.tech && project.tech.length > 0 && (
    <section style="padding:48px 24px;max-width:800px;margin:0 auto;text-align:center;" data-animate="fade-up">
      <h2 style="font-size:1.5rem;font-weight:700;color:var(--heading-text);margin-bottom:24px;">
        {/* TODO: localise this later */ 'Technology Used'}
      </h2>
      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:12px;">
        {project.tech.map(tech => (
          <span style={`padding:10px 20px;border-radius:9999px;background:color-mix(in srgb, ${project.color} 10%, transparent);color:${project.color};font-weight:500;font-size:0.85rem;border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);`}>
            {tech}
          </span>
        ))}
      </div>
    </section>
  )}

  <!-- Gradient CTA. P1 audit #11, #15, #20 — uses the shared component. -->
    <GradientCTA
      title={`Interested in ${project.name}?`}
      body="Get in touch and we will help you get started."
      ctaLabel="Get in Touch"
      ctaHref="/contact/"
      gradient={project.gradient}
      accentColor={project.color}
      lang={lang}
    />

    <ProjectCTA status={project.status} platforms={project.platforms || []} links={project.links} lang={lang} />
  </ProjectLayout>
