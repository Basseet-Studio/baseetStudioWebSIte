---
import '../../styles/projects/chopshop.css'
import ProjectLayout from '../../layouts/Project.astro'
import ProjectGallery from '../../components/project/ProjectGallery.astro'
import ProjectCTA from '../../components/project/ProjectCTA.astro'
import ProjectFeatureCard from '../../components/project/ProjectFeatureCard.astro'
import ProjectTestimonial from '../../components/project/ProjectTestimonial.astro'
import ProjectFAQ from '../../components/project/ProjectFAQ.astro'
import GradientCTA from '../../components/project/GradientCTA.astro'
import Icon from '../../components/icons/Icon.astro'
import { resolveIcon } from '../../components/icons/iconMappings'
import { getProject } from '../../lib/projects'
import type { Lang, Project } from '../../types'
import { studioFullName } from '../../lib/locale'
import { localizeHref } from '../../lib/localize-href'


interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props
const slug = 'chopshop'
const project = getProject(slug, lang)
if (!project) return Astro.redirect(localizeHref(lang, '/404'))
---

<ProjectLayout title={`${project.name} — ${studioFullName(lang)}`} description={project.tagline} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>

  <!-- Hero. P3 audit #17 — the old `tag` decoration was unrelated to the
       product (ChopShop is e-commerce). Replaced with shopping-bag and
       storefront icons that reinforce the brand. P3 audit #18 + #32 —
       the hero uses the responsive `.project-hero--centered` class which
       collapses padding to ~96px on phones so the title lands in the
       first viewport instead of below the fold. The coloured background
       wash (`.project-hero-wash`) lives in shared.css and is theme-aware. -->
  <section class="project-hero project-hero--centered">
    <div style={`position:absolute;top:10%;right:5%;opacity:0.08;transform:rotate(15deg);color:${project.color};pointer-events:none;`}>
      <Icon name="shopping-bag" size={120} color={project.color} />
    </div>
    <div style={`position:absolute;bottom:15%;left:8%;opacity:0.06;transform:rotate(-10deg);color:${project.color};pointer-events:none;`}>
      <Icon name="storefront" size={96} color={project.color} />
    </div>

    <div style="max-width:800px;margin:0 auto;position:relative;z-index:1;">
      <div style="display:flex;justify-content:center;margin-bottom:28px;" data-animate="fade-up">
        <div style={`width:96px;height:96px;border-radius:24px;background:${project.gradient};display:flex;align-items:center;justify-content:center;box-shadow:0 12px 40px -10px color-mix(in srgb, ${project.color} 30%, transparent);`}>
          <Icon name={resolveIcon(project.iconClass).name} size={40} color="white" />
        </div>
      </div>

      <h1 style="font-size:3.2rem;font-weight:700;color:var(--heading-text);font-family: var(--font-display);margin-bottom:8px;letter-spacing:-0.02em;" data-animate="fade-up">
        {project.name}
      </h1>
      <p style={`font-size:1.3rem;font-weight:600;color:${project.color};margin-bottom:24px;font-family: var(--font-body);`} data-animate="fade-up">
        {project.tagline}
      </p>

      <div style="margin-bottom:28px;" data-animate="fade-up">
        <span style={`display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);font-family: var(--font-body);`}>
          <Icon name="check-circle" size={16} color={project.color} />
          {project.status}
        </span>
      </div>

      <h2 style="font-size:2rem;font-weight:700;color:var(--heading-text);margin-bottom:20px;line-height:1.3;font-family: var(--font-display);" data-animate="fade-up">
        {project.hero.title}
      </h2>
      <p style="font-size:1.15rem;color:var(--muted-text);margin-bottom:36px;max-width:580px;margin-left:auto;margin-right:auto;line-height:1.7;font-family: var(--font-body);" data-animate="fade-up">
        {project.hero.subtitle}
      </p>

      <!-- CTA Buttons. P1 audit #14 — uses the global `.cta-btn--primary` /
           `.cta-btn--secondary` classes (defined in global.css) instead of
           inline `onmouseover` JS. CSS hover works on touch, honors
           prefers-reduced-motion, and is CSP-friendly. -->
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;" data-animate="fade-up">
        {project.hero.cta_primary && (
          <a href={project.hero.cta_primary_link || '/contact/'}
            class="cta-btn--primary"
            style={`background:${project.gradient};`}>
            {project.hero.cta_primary}
          </a>
        )}
        {project.hero.cta_secondary && (
          <a href={project.hero.cta_secondary_link || '#features'}
            class="cta-btn--secondary"
            style={`border-color:color-mix(in srgb, ${project.color} 25%, transparent);`}>
            {project.hero.cta_secondary}
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Features -->
  {project.features && project.features.length > 0 && (
    <section id="features" style="padding:64px 24px;max-width:1200px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:48px;" data-animate="fade-up">
        <span style={`display:inline-block;padding:8px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);margin-bottom:16px;font-family: var(--font-body);`}>
          {/* TODO: localise this later */ 'Features'}
        </span>
        <h2 style="font-size:2rem;margin-bottom:0;color:var(--heading-text);font-family: var(--font-display);">
          {/* TODO: localise this later */ 'Key Features'}
        </h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:24px;">
        {project.features.map((feature, i) => (
          <ProjectFeatureCard title={feature.title} description={feature.description} iconName={resolveIcon(feature.icon).name} projectColor={project.color} projectGradient={project.gradient} index={i} />
        ))}
      </div>
    </section>
  )}

  <!-- Gallery -->
  {project.screenshots && project.screenshots.length > 0 && (
    <ProjectGallery screenshots={project.screenshots} galleryType={project.galleryType || 'mobile'} projectSlug={project.slug} projectColor={project.color} projectName={project.name} />
  )}

  <!-- Testimonials -->
  {project.testimonials && project.testimonials.length > 0 && (
    <section style="padding:64px 24px;max-width:1200px;margin:0 auto;">
      <h2 style="text-align:center;font-size:2rem;margin-bottom:48px;color:var(--heading-text);font-family: var(--font-display);">
        {/* TODO: localise this later */ 'What People Say'}
      </h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(340px, 1fr));gap:24px;">
        {project.testimonials.map(t => (
          <ProjectTestimonial quote={t.quote} author={t.author} role={t.role} projectColor={project.color} projectGradient={project.gradient} />
        ))}
      </div>
    </section>
  )}

  <!-- FAQ -->
  {project.faq && project.faq.length > 0 && (
    <section style="padding:64px 24px;max-width:800px;margin:0 auto;">
      <h2 style="text-align:center;font-size:2rem;margin-bottom:48px;color:var(--heading-text);font-family: var(--font-display);">
        {/* TODO: localise this later */ 'FAQ'}
      </h2>
      <div style="display:flex;flex-direction:column;gap:12px;">
        {project.faq.map(item => (
          <ProjectFAQ question={item.question} answer={item.answer} projectColor={project.color} />
        ))}
      </div>
    </section>
  )}

  <!-- Gradient CTA. P1 audit #11, #15, #20 — was a copy-pasted block; now
       uses the shared <GradientCTA> component. -->
  <GradientCTA
    title={`Interested in ${project.name}?`}
    body="Get in touch and we will help you get started."
    ctaLabel="Get in Touch"
    ctaHref="/contact/"
    gradient={project.gradient}
    accentColor={project.color}
    lang={lang}
  />

  <ProjectCTA status={project.status} platforms={project.platforms || []} links={project.links} lang={lang} />
</ProjectLayout>
