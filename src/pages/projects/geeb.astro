---
import ProjectLayout from '../../layouts/Project.astro'
import ProjectGallery from '../../components/project/ProjectGallery.astro'
import ProjectCTA from '../../components/project/ProjectCTA.astro'
import ProjectFeatureCard from '../../components/project/ProjectFeatureCard.astro'
import ProjectTestimonial from '../../components/project/ProjectTestimonial.astro'
import ProjectFAQ from '../../components/project/ProjectFAQ.astro'
import Icon from '../../components/icons/Icon.astro'
import { resolveIcon } from '../../components/icons/iconMappings'
import { getProject } from '../../lib/projects'
import linksData from '../../content/data/links.json'
import type { Lang, Project, ProjectLinks } from '../../types'

const pathname = Astro.url.pathname
const lang: Lang = pathname.startsWith('/ar') ? 'ar' : 'en'
const slug = 'geeb'
const project = getProject(slug)
if (!project) return Astro.redirect('/404')

// Project-specific link options from the central links file.
// `#` means "not configured yet" — components hide those per FR-033.
const projectLinks: ProjectLinks = (linksData.projects.geeb || {}) as ProjectLinks

function realUrl(url?: string): string | undefined {
  return url && url !== '#' ? url : undefined
}

// Resolved URLs for the hero CTAs and the ProjectCTA component
const waitlistUrl = realUrl(projectLinks.waitlist) || realUrl(projectLinks.web) || '/contact/'
const proSignupUrl = realUrl(projectLinks.pro_signup) || `/${lang === 'ar' ? 'ar/' : ''}projects/geeb/pro/`
const featuresUrl = realUrl(projectLinks.features) || `/${lang === 'ar' ? 'ar/' : ''}projects/geeb/features/`
const faqUrl = realUrl(projectLinks.faq) || `/${lang === 'ar' ? 'ar/' : ''}projects/geeb/faq/`
const appStoreUrl = realUrl(projectLinks.app_store) || realUrl(projectLinks.ios)
const playStoreUrl = realUrl(projectLinks.play_store) || realUrl(projectLinks.android)
const webAppUrl = realUrl(projectLinks.web)

// Service categories specific to Geeb — a B2C home-services marketplace
const serviceCategories = [
  { name: 'Plumbing', icon: 'wrench', description: 'Leaks, fixtures, drains, water heaters' },
  { name: 'Electrical', icon: 'lightning', description: 'Wiring, switches, lighting, repairs' },
  { name: 'Handyman', icon: 'hammer', description: 'Mounting, assembly, small fixes' },
  { name: 'Painting', icon: 'paint-brush', description: 'Interior, exterior, touch-ups' },
  { name: 'Cleaning', icon: 'sparkle', description: 'Deep cleans, move-out, recurring' },
  { name: 'Appliance Repair', icon: 'gear', description: 'Washer, dryer, fridge, oven' },
  { name: 'AC & HVAC', icon: 'snowflake', description: 'Install, service, maintenance' },
  { name: 'Carpentry', icon: 'ruler', description: 'Doors, shelves, custom builds' },
]

const howItWorks = [
  {
    step: '01',
    title: 'Tell us what you need',
    text: 'Pick a service, share a few details, and we will match you with verified pros near you.',
    icon: 'magnifying-glass',
  },
  {
    step: '02',
    title: 'Book a pro you trust',
    text: 'Compare profiles, ratings, and upfront prices. Lock in a time that fits your schedule.',
    icon: 'calendar-check',
  },
  {
    step: '03',
    title: 'Get it done — guaranteed',
    text: 'Track your pro in real time, pay securely in-app, and enjoy a 30-day workmanship guarantee.',
    icon: 'shield-check',
  },
]
---

<ProjectLayout title={`${project.name} — Baseet Studio`} description={project.tagline} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/src/styles/projects/geeb.css" />

  <!-- Hero: warm amber gradient with wrench brand mark + service ribbon -->
  <section class="geeb-hero">
    <!-- Decorative grid pattern -->
    <div class="geeb-hero__grid" aria-hidden="true"></div>
    <!-- Soft glow orbs -->
    <div class="geeb-hero__glow geeb-hero__glow--a" aria-hidden="true"></div>
    <div class="geeb-hero__glow geeb-hero__glow--b" aria-hidden="true"></div>

    <!-- Floating service icons in background -->
    <div class="geeb-hero__float geeb-hero__float--1"><Icon name="wrench" size={36} color="currentColor" /></div>
    <div class="geeb-hero__float geeb-hero__float--2"><Icon name="lightning" size={28} color="currentColor" /></div>
    <div class="geeb-hero__float geeb-hero__float--3"><Icon name="paint-brush" size={32} color="currentColor" /></div>
    <div class="geeb-hero__float geeb-hero__float--4"><Icon name="gear" size={26} color="currentColor" /></div>

    <div class="geeb-hero__inner">
      <!-- Brand mark: wrench on gradient square -->
      <div class="geeb-hero__mark" data-animate="fade-up">
        <div class="geeb-hero__mark-icon">
          <Icon name={resolveIcon(project.iconClass).name} size={44} color="white" />
        </div>
        <span class="geeb-hero__mark-label">Geeb</span>
      </div>

      <h1 class="geeb-hero__name" data-animate="fade-up">{project.name}</h1>
      <p class="geeb-hero__tagline" data-animate="fade-up">{project.tagline}</p>

      <!-- Status badge -->
      <div class="geeb-hero__status" data-animate="fade-up">
        <span class="geeb-pill">
          <Icon name="hourglass" size={14} color="currentColor" />
          {project.status}
        </span>
      </div>

      <h2 class="geeb-hero__title" data-animate="fade-up">{project.hero.title}</h2>
      <p class="geeb-hero__subtitle" data-animate="fade-up">{project.hero.subtitle}</p>

      <div class="geeb-hero__ctas" data-animate="fade-up">
        {project.hero.cta_primary && (
          <a href={waitlistUrl} class="geeb-btn geeb-btn--primary">
            <Icon name="device-mobile" size={18} color="white" />
            {project.hero.cta_primary}
          </a>
        )}
        {project.hero.cta_secondary && (
          <a href={proSignupUrl} class="geeb-btn geeb-btn--secondary">
            <Icon name="hard-hat" size={18} color="currentColor" />
            {project.hero.cta_secondary}
          </a>
        )}
      </div>

      <!-- Trust ribbon: ratings + verified pros count -->
      <div class="geeb-hero__trust" data-animate="fade-up">
        <div class="geeb-trust-item">
          <div class="geeb-trust-stars" aria-label="4.9 out of 5 stars">
            <Icon name="star" size={14} color="currentColor" />
            <Icon name="star" size={14} color="currentColor" />
            <Icon name="star" size={14} color="currentColor" />
            <Icon name="star" size={14} color="currentColor" />
            <Icon name="star" size={14} color="currentColor" />
          </div>
          <span class="geeb-trust-label">4.9 average rating</span>
        </div>
        <div class="geeb-trust-divider"></div>
        <div class="geeb-trust-item">
          <span class="geeb-trust-strong">2,400+</span>
          <span class="geeb-trust-label">verified pros</span>
        </div>
        <div class="geeb-trust-divider"></div>
        <div class="geeb-trust-item">
          <span class="geeb-trust-strong">30-day</span>
          <span class="geeb-trust-label">workmanship guarantee</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Categories: visual grid of what you can book -->
  <section class="geeb-section" id="services">
    <div class="geeb-section__inner">
      <div class="geeb-section__head" data-animate="fade-up">
        <span class="geeb-eyebrow">
          <Icon name="wrench" size={14} color="currentColor" />
          Service categories
        </span>
        <h2 class="geeb-section__title">One app. Every trade.</h2>
        <p class="geeb-section__lede">From a dripping tap to a full kitchen repaint, Geeb covers the jobs that keep your home running. Tap a category to see pros near you.</p>
      </div>

      <div class="geeb-categories">
        {serviceCategories.map((cat, i) => (
          <a href="#features" class="geeb-category" data-animate="fade-up" style={`animation-delay:${i * 0.04}s;`}>
            <div class="geeb-category__icon">
              <Icon name={cat.icon} size={24} color="currentColor" />
            </div>
            <h3 class="geeb-category__name">{cat.name}</h3>
            <p class="geeb-category__desc">{cat.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works: 3-step process -->
  <section class="geeb-section geeb-section--alt" id="how">
    <div class="geeb-section__inner">
      <div class="geeb-section__head" data-animate="fade-up">
        <span class="geeb-eyebrow">
          <Icon name="path" size={14} color="currentColor" />
          How it works
        </span>
        <h2 class="geeb-section__title">From "uh oh" to "all done" in three steps</h2>
      </div>

      <div class="geeb-how">
        {howItWorks.map((step, i) => (
          <div class="geeb-how__step" data-animate="fade-up" style={`animation-delay:${i * 0.1}s;`}>
            <div class="geeb-how__step-head">
              <div class="geeb-how__step-num">{step.step}</div>
              <div class="geeb-how__step-icon">
                <Icon name={step.icon} size={22} color="currentColor" />
              </div>
            </div>
            <h3 class="geeb-how__step-title">{step.title}</h3>
            <p class="geeb-how__step-text">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  {project.features && project.features.length > 0 && (
    <section id="features" class="geeb-section">
      <div class="geeb-section__inner">
        <div class="geeb-section__head" data-animate="fade-up">
          <span class="geeb-eyebrow">
            <Icon name="sparkle" size={14} color="currentColor" />
            Why Geeb
          </span>
          <h2 class="geeb-section__title">Built for trust, speed, and a job done right</h2>
        </div>

        <div class="geeb-features">
          {project.features.map((feature, i) => (
            <ProjectFeatureCard title={feature.title} description={feature.description} iconName={resolveIcon(feature.icon).name} projectColor={project.color} projectGradient={project.gradient} index={i} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- For Pros callout -->
  <section class="geeb-pros">
    <div class="geeb-pros__inner">
      <div class="geeb-pros__copy" data-animate="fade-up">
        <span class="geeb-eyebrow geeb-eyebrow--invert">
          <Icon name="hard-hat" size={14} color="currentColor" />
          For service pros
        </span>
        <h2 class="geeb-pros__title">More jobs. Less hassle.</h2>
        <p class="geeb-pros__text">List your craft on Geeb and get matched with customers in your service area. We handle discovery, scheduling, payments, and reviews — you handle the work. Free to join, transparent fees, fast payouts.</p>
        <ul class="geeb-pros__list">
          <li><Icon name="check-circle" size={16} color="currentColor" /> Free profile and listings</li>
          <li><Icon name="check-circle" size={16} color="currentColor" /> Smart job routing to your service area</li>
          <li><Icon name="check-circle" size={16} color="currentColor" /> Same-day payouts via Stripe Connect</li>
          <li><Icon name="check-circle" size={16} color="currentColor" /> Built-in reviews to grow your reputation</li>
        </ul>
        <a href="/contact/" class="geeb-btn geeb-btn--primary">
          <Icon name="arrow-right" size={18} color="white" />
          Apply to become a pro
        </a>
      </div>

      <!-- Mocked pro dashboard card -->
      <div class="geeb-pros__card" data-animate="fade-up">
        <div class="geeb-pros__card-head">
          <div class="geeb-pros__card-avatar">
            <Icon name="hard-hat" size={20} color="white" />
          </div>
          <div>
            <div class="geeb-pros__card-name">Karim R. — Plumber</div>
            <div class="geeb-pros__card-meta">
              <Icon name="star" size={12} color="currentColor" /> 4.9 · 312 jobs · Verified Pro
            </div>
          </div>
        </div>
        <div class="geeb-pros__card-stats">
          <div class="geeb-pros__stat">
            <div class="geeb-pros__stat-value">12</div>
            <div class="geeb-pros__stat-label">Jobs this week</div>
          </div>
          <div class="geeb-pros__stat">
            <div class="geeb-pros__stat-value">$2,840</div>
            <div class="geeb-pros__stat-label">Earned this week</div>
          </div>
          <div class="geeb-pros__stat">
            <div class="geeb-pros__stat-value">98%</div>
            <div class="geeb-pros__stat-label">Accept rate</div>
          </div>
        </div>
        <div class="geeb-pros__card-jobs">
          <div class="geeb-pros__card-job">
            <div class="geeb-pros__card-job-dot"></div>
            <div class="geeb-pros__card-job-text">Leaking kitchen tap — Al Reem</div>
            <span class="geeb-pros__card-job-price">$85</span>
          </div>
          <div class="geeb-pros__card-job">
            <div class="geeb-pros__card-job-dot"></div>
            <div class="geeb-pros__card-job-text">Water heater install — Saadiyat</div>
            <span class="geeb-pros__card-job-price">$240</span>
          </div>
          <div class="geeb-pros__card-job">
            <div class="geeb-pros__card-job-dot"></div>
            <div class="geeb-pros__card-job-text">Drain blockage — Khalidiya</div>
            <span class="geeb-pros__card-job-price">$120</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  {project.screenshots && project.screenshots.length > 0 && (
    <ProjectGallery screenshots={project.screenshots} galleryType={project.galleryType || 'mobile'} projectSlug={project.slug} projectColor={project.color} projectName={project.name} />
  )}

  <!-- Testimonials -->
  {project.testimonials && project.testimonials.length > 0 && (
    <section class="geeb-section">
      <div class="geeb-section__inner">
        <h2 class="geeb-section__title" style="text-align:center;margin-bottom:48px;">
          {/* TODO: localise this later */ 'What people are saying'}
        </h2>
        <div class="geeb-testimonials">
          {project.testimonials.map(t => (
            <ProjectTestimonial quote={t.quote} author={t.author} role={t.role} projectColor={project.color} projectGradient={project.gradient} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {project.faq && project.faq.length > 0 && (
    <section class="geeb-section geeb-section--alt" id="faq">
      <div class="geeb-section__inner geeb-section__inner--narrow">
        <div class="geeb-section__head" data-animate="fade-up">
          <span class="geeb-eyebrow">
            <Icon name="question" size={14} color="currentColor" />
            FAQ
          </span>
          <h2 class="geeb-section__title">Questions, answered</h2>
        </div>
        <div class="geeb-faq">
          {project.faq.map(item => (
            <ProjectFAQ question={item.question} answer={item.answer} projectColor={project.color} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Gradient CTA -->
  <section class="geeb-cta">
    <div class="geeb-cta__inner">
      <div class="geeb-cta__glow geeb-cta__glow--a" aria-hidden="true"></div>
      <div class="geeb-cta__glow geeb-cta__glow--b" aria-hidden="true"></div>
      <h2 class="geeb-cta__title" data-animate="fade-up">
        {/* TODO: localise this later */ `Ready to fix, build, or hire?`}
      </h2>
      <p class="geeb-cta__text" data-animate="fade-up">
        {/* TODO: localise this later */ 'Join the Geeb waitlist and be first to book or list your services when we launch.'}
      </p>
      <div class="geeb-cta__actions" data-animate="fade-up">
        <a href="/contact/" class="geeb-btn geeb-btn--invert">
          <Icon name="envelope" size={18} color="currentColor" />
          {/* TODO: localise this later */ 'Join the waitlist'}
        </a>
        <a href="/contact/" class="geeb-btn geeb-btn--ghost">
          <Icon name="briefcase" size={18} color="currentColor" />
          {/* TODO: localise this later */ 'Apply as a pro'}
        </a>
      </div>
    </div>
  </section>

  <ProjectCTA status={project.status} platforms={project.platforms || []} links={project.links} lang={lang} />
</ProjectLayout>
