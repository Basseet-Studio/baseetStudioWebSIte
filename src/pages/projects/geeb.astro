---
import '../../styles/projects/geeb.css'
import ProjectLayout from '../../layouts/Project.astro'
import ProjectFAQ from '../../components/project/ProjectFAQ.astro'
import Icon from '../../components/icons/Icon.astro'
import GeebBookingMock from '../../components/project/geeb/GeebBookingMock.astro'
import GeebAppSwitcher from '../../components/project/geeb/GeebAppSwitcher.astro'
import GeebTradeGrid from '../../components/project/geeb/GeebTradeGrid.astro'
import GeebDispatchTimeline from '../../components/project/geeb/GeebDispatchTimeline.astro'
import GeebFeatureRows from '../../components/project/geeb/GeebFeatureRows.astro'
import GeebVendorDashboard from '../../components/project/geeb/GeebVendorDashboard.astro'
import { getProject } from '../../lib/projects'
import { resolveIcon } from '../../components/icons/iconMappings'
import linksData from '../../content/data/links.json'
import type { Lang, ProjectLinks } from '../../types'
import { studioFullName } from '../../lib/locale'
import { localizeHref } from '../../lib/localize-href'

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props
const slug = 'geeb'
const project = getProject(slug, lang)
if (!project) return Astro.redirect(localizeHref(lang, '/404'))

const projectLinks: ProjectLinks = (linksData.projects.geeb || {}) as ProjectLinks

function realUrl(url?: string): string | undefined {
  return url && url !== '#' ? url : undefined
}

const waitlistUrl = realUrl(projectLinks.waitlist) || realUrl(projectLinks.web) || localizeHref(lang, '/contact/')
const proSignupUrl = realUrl(projectLinks.pro_signup) || localizeHref(lang, '/projects/geeb/pro/')
const downloadUrl = realUrl(projectLinks.download) || localizeHref(lang, '/projects/geeb/download/')

const serviceCategories = [
  { name: 'Plumbing', icon: 'wrench', description: 'Leaks, fixtures, drains, water heaters', span: 'wide' },
  { name: 'Electrical', icon: 'lightning', description: 'Wiring, switches, lighting, repairs' },
  { name: 'Handyman', icon: 'hammer', description: 'Mounting, assembly, small fixes' },
  { name: 'Painting', icon: 'paint-brush', description: 'Interior, exterior, touch-ups' },
  { name: 'Cleaning', icon: 'sparkle', description: 'Deep cleans, move-out, recurring' },
  { name: 'Appliance Repair', icon: 'gear', description: 'Washer, dryer, fridge, oven' },
  { name: 'AC & HVAC', icon: 'snowflake', description: 'Install, service, maintenance' },
  { name: 'Carpentry', icon: 'ruler', description: 'Doors, shelves, custom builds' },
]

const marqueeTrades = [
  { name: 'Plumbing', icon: 'wrench' },
  { name: 'Electrical', icon: 'lightning' },
  { name: 'Handyman', icon: 'hammer' },
  { name: 'Painting', icon: 'paint-brush' },
  { name: 'Cleaning', icon: 'sparkle' },
  { name: 'AC & HVAC', icon: 'snowflake' },
  { name: 'Carpentry', icon: 'ruler' },
  { name: 'Appliance Repair', icon: 'gear' },
]

const howItWorks = [
  {
    step: '01',
    title: 'Tell us what you need',
    text: 'Pick a service, share a few details, and we will match you with verified pros near you.',
    icon: 'magnifying-glass',
    vignette: 'search' as const,
  },
  {
    step: '02',
    title: 'Book a pro you trust',
    text: 'Compare profiles, ratings, and upfront prices. Lock in a time that fits your schedule.',
    icon: 'calendar-check',
    vignette: 'compare' as const,
  },
  {
    step: '03',
    title: 'Get it done — guaranteed',
    text: 'Track your pro in real time, pay securely in-app, and enjoy a 30-day workmanship guarantee.',
    icon: 'shield-check',
    vignette: 'track' as const,
  },
]

const featureBullets: Record<string, string[]> = {
  'Three Apps, One Platform': [
    'Shared Flutter monorepo',
    'Consistent UX across apps',
    'Faster feature rollout',
  ],
  'Trending Vendors & Smart Discovery': [
    'Curated top-rated pros',
    'Personalized home screen',
    'Quick category access',
  ],
  'Hierarchical Area System': [
    'City → district → neighborhood',
    'Accurate local matching',
    'Smart job routing',
  ],
  'Verified Pros, Secure Auth & 2FA': [
    'ID and trade verification',
    'Google OAuth for customers',
    'OTP vendor onboarding',
  ],
  'Reviews & Ratings v2.1': [
    'Auto-calculated ratings',
    'Real-time cross-app sync',
    'PostgreSQL RLS security',
  ],
  'Offline-First Vendor App': [
    'Hive local caching',
    'Background data sync',
    'Works on shaky connections',
  ],
}

const vignetteMap: Record<string, string> = {
  'Three Apps, One Platform': 'apps',
  'Trending Vendors & Smart Discovery': 'trending',
  'Hierarchical Area System': 'areas',
  'Verified Pros, Secure Auth & 2FA': 'verified',
  'Reviews & Ratings v2.1': 'reviews',
  'Offline-First Vendor App': 'offline',
}

const featureRows = (project.features || []).map((f) => ({
  title: f.title,
  description: f.description,
  icon: resolveIcon(f.icon),
  bullets: featureBullets[f.title],
  vignette: vignetteMap[f.title] ?? 'apps',
}))
---

<ProjectLayout title={`${project.name} — ${studioFullName(lang)}`} description={project.tagline} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>

<link href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800&display=swap" rel="stylesheet">

  <main class="geeb-main">
    <section class="geeb-hero">
      <div class="geeb-hero__wash" aria-hidden="true"></div>

      <div class="geeb-hero__split">
        <div class="geeb-hero__copy">
          <div class="geeb-hero__brand" data-animate="fade-up">
            <div class="geeb-hero__brand-mark">
              <img src="/projects/logos/geeb.svg" alt="" width="32" height="32" class="geeb-hero__brand-logo" decoding="async" />
            </div>
            <img src="/projects/names/geeb.svg" alt="" width="130" height="36" class="geeb-hero__brand-wordmark" decoding="async" aria-hidden="true" />
            <span class="geeb-sr-only">{project.name}</span>
          </div>

          <p class="geeb-hero__tagline" data-animate="fade-up">{project.tagline}</p>

          <div data-animate="fade-up">
            <span class="geeb-pill">
              <Icon name="hourglass" size={14} color="currentColor" />
              {project.status}
            </span>
          </div>

          <h1 class="geeb-hero__title" data-animate="fade-up">Trusted pros for every job at home</h1>
          <p class="geeb-hero__subtitle" data-animate="fade-up">{project.hero.subtitle}</p>

          <div class="geeb-hero__ctas" data-animate="fade-up">
            {project.hero.cta_primary && (
              <a href={downloadUrl} class="geeb-btn geeb-btn--primary">
                <Icon name="download" size={18} color="white" />
                {project.hero.cta_primary}
              </a>
            )}
            {project.hero.cta_secondary && (
              <a href={proSignupUrl} class="geeb-btn geeb-btn--secondary">
                <Icon name="hard-hat" size={18} color="currentColor" />
                {project.hero.cta_secondary}
              </a>
            )}
          </div>

          <p class="geeb-hero__trust" data-animate="fade-up">
            Verified pros · Upfront pricing · 30-day guarantee
          </p>
        </div>

        <div data-animate="fade-up">
          <GeebBookingMock />
        </div>
      </div>
    </section>

    <div class="geeb-marquee" data-geeb-marquee aria-hidden="true">
      <div class="geeb-marquee__track" data-geeb-marquee-track>
        {[...marqueeTrades, ...marqueeTrades].map((trade) => (
          <span class="geeb-marquee__item">
            <Icon name={trade.icon} size={20} color="currentColor" />
            {trade.name}
          </span>
        ))}
      </div>
    </div>

    <section class="geeb-section geeb-section--alt">
      <div class="geeb-section__inner">
        <div class="geeb-section__head" data-animate="fade-up">
          <h2 class="geeb-section__title">Three apps. One platform.</h2>
          <p class="geeb-section__lede">Customer, vendor, and admin experiences share a single architecture — consistent UX, faster iteration, easier scaling.</p>
        </div>
        <GeebAppSwitcher />
      </div>
    </section>

    <section class="geeb-section" id="services">
      <div class="geeb-section__inner">
        <div class="geeb-section__head" data-animate="fade-up">
          <h2 class="geeb-section__title">One app. Every trade.</h2>
          <p class="geeb-section__lede">From a dripping tap to a full kitchen repaint, Geeb covers the jobs that keep your home running.</p>
        </div>
        <GeebTradeGrid trades={serviceCategories} />
      </div>
    </section>

    <section class="geeb-section geeb-section--alt" id="how">
      <div class="geeb-section__inner">
        <div class="geeb-section__head" data-animate="fade-up">
          <h2 class="geeb-section__title">From "uh oh" to "all done"</h2>
          <p class="geeb-section__lede">Three steps to book a trusted pro and get the job done right.</p>
        </div>
        <GeebDispatchTimeline steps={howItWorks} />
      </div>
    </section>

    <section class="geeb-section geeb-section--scrub">
      <div class="geeb-section__inner geeb-scrub">
        <p class="geeb-scrub__text" data-geeb-scrub>
          Home repairs should not feel like a gamble. Geeb brings verified pros, transparent pricing, and real-time tracking to every job — so you hire with confidence and get it done right.
        </p>
      </div>
    </section>

    {featureRows.length > 0 && (
      <section class="geeb-section" id="features">
        <div class="geeb-section__inner">
          <div class="geeb-section__head" data-animate="fade-up">
            <h2 class="geeb-section__title">Built for trust, speed, and a job done right</h2>
            <p class="geeb-section__lede">Every feature is designed around the moment you need a pro — and the peace of mind that follows.</p>
          </div>
          <GeebFeatureRows features={featureRows} />
        </div>
      </section>
    )}

    <GeebVendorDashboard proSignupUrl={proSignupUrl} />

    {project.faq && project.faq.length > 0 && (
      <section class="geeb-section geeb-section--alt" id="faq">
        <div class="geeb-section__inner geeb-section__inner--narrow">
          <div class="geeb-section__head" data-animate="fade-up">
            <h2 class="geeb-section__title">Questions, answered</h2>
          </div>
          <div class="geeb-faq">
            {project.faq.map((item) => (
              <ProjectFAQ question={item.question} answer={item.answer} projectColor={project.color} />
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="geeb-cta">
      <div class="geeb-cta__inner">
        <h2 class="geeb-cta__title" data-animate="fade-up">Ready to fix, build, or hire?</h2>
        <p class="geeb-cta__text" data-animate="fade-up">
          Join the Geeb waitlist and be first to book or list your services when we launch.
        </p>
        <div class="geeb-cta__actions" data-animate="fade-up">
          <a href={downloadUrl} class="geeb-btn geeb-btn--invert">
            <Icon name="download" size={18} color="currentColor" />
            Get the apps
          </a>
          <a href={proSignupUrl} class="geeb-btn geeb-btn--ghost">
            <Icon name="briefcase" size={18} color="currentColor" />
            Apply as a pro
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { init, destroy } from '../../animations/projects/geeb'
    init()
    document.addEventListener('astro:before-swap', destroy)
    document.addEventListener('astro:page-load', init)
  </script>
</ProjectLayout>
