---
import '../../../styles/projects/geeb.css'
import ProjectLayout from '../../../layouts/Project.astro'
import Icon from '../../../components/icons/Icon.astro'
import { getProject } from '../../../lib/projects'
import linksData from '../../../content/data/links.json'
import type { Lang, ProjectLinks } from '../../../types'

const pathname = Astro.url.pathname
const lang: Lang = pathname.startsWith('/ar') ? 'ar' : 'en'
const slug = 'geeb'
const project = getProject(slug)
if (!project) return Astro.redirect('/404')

const projectLinks: ProjectLinks = (linksData.projects.geeb || {}) as ProjectLinks
const waitlistUrl = projectLinks.waitlist && projectLinks.waitlist !== '#' ? projectLinks.waitlist : '/contact/'
const prefix = lang === 'ar' ? '/ar' : ''

const apps = [
  {
    name: 'Customer App',
    desc: 'Book trusted pros in minutes, track the job live, chat when you need to, and pay securely when the work is done.',
    icon: 'device-mobile',
    status: 'Coming Soon',
    bullets: ['Browse verified trades', 'Live job tracking', 'Secure in-app payments'],
  },
  {
    name: 'Vendor App',
    desc: 'Get matched to nearby jobs, manage your schedule, update customers on the go, and cash out when you finish.',
    icon: 'hard-hat',
    status: 'Coming Soon',
    bullets: ['Smart job routing', 'Calendar & availability', 'Fast payouts'],
  },
]

const platforms = [
  {
    name: 'iOS',
    desc: 'iPhone & iPad — App Store release with the public launch wave.',
    icon: 'apple-logo',
  },
  {
    name: 'Android',
    desc: 'Phone & tablet — Google Play release alongside iOS.',
    icon: 'android-logo',
  },
]

const steps = [
  {
    title: 'Join the waitlist',
    desc: 'Tell us your city and whether you book services or work as a pro.',
  },
  {
    title: 'Get early access',
    desc: 'We open city by city. Waitlist members hear first when Geeb arrives nearby.',
  },
  {
    title: 'Book or take jobs',
    desc: 'Customers hire verified pros. Pros accept work that fits their trade and schedule.',
  },
]
---

<ProjectLayout
  title={`Download — ${project.name} — Baseet Studio`}
  description={`Download ${project.name} apps — ${project.tagline}`}
  slug={project.slug}
  projectColor={project.color}
  projectGradient={project.gradient}
  projectName={project.name}
  projectIconClass={project.iconClass}
  projectNavItems={project.navItems}
  projectNavMeta={project.navMetaItems}
  lang={lang}
>

  <section class="geeb-subhero">
    <div class="geeb-hero__glow geeb-hero__glow--a" aria-hidden="true"></div>
    <div class="geeb-subhero__inner">
      <span class="geeb-eyebrow">
        <Icon name="download" size={14} color="currentColor" />
        Download
      </span>
      <h1 class="geeb-subhero__title" data-animate="fade-up">Get the Geeb apps</h1>
      <p class="geeb-subhero__lede" data-animate="fade-up">
        Two apps power the marketplace — one for customers who need work done, one for pros who do the work. Join the waitlist to be first when we launch in your city.
      </p>
    </div>
  </section>

  <section class="geeb-content">
    <div class="geeb-download-grid geeb-download-grid--two">
      {apps.map((app) => (
        <div class="geeb-download-card geeb-download-card--rich" data-animate="fade-up">
          <div class="geeb-download-card__icon">
            <Icon name={app.icon} size={28} color="currentColor" />
          </div>
          <h3>{app.name}</h3>
          <p>{app.desc}</p>
          <ul class="geeb-download-card__list">
            {app.bullets.map((item) => (
              <li>
                <Icon name="check" size={14} color="currentColor" />
                {item}
              </li>
            ))}
          </ul>
          <span class="geeb-download-card__badge">{app.status}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="geeb-content geeb-content--platforms">
    <div class="geeb-section-head" data-animate="fade-up">
      <h2 class="geeb-section-title">Coming to your phone</h2>
      <p class="geeb-section-lede">
        Native apps for the platforms people already use. Store links go live with the first city launch.
      </p>
    </div>
    <div class="geeb-download-platforms">
      {platforms.map((p) => (
        <div class="geeb-download-platform" data-animate="fade-up">
          <div class="geeb-download-card__icon">
            <Icon name={p.icon} size={24} color="currentColor" />
          </div>
          <div>
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="geeb-content geeb-content--narrow">
    <div class="geeb-section-head" data-animate="fade-up">
      <h2 class="geeb-section-title">How early access works</h2>
      <p class="geeb-section-lede">
        Geeb rolls out city by city so quality stays high. Here is what joining the waitlist gets you.
      </p>
    </div>
    <ol class="geeb-download-steps">
      {steps.map((step, i) => (
        <li class="geeb-download-step" data-animate="fade-up">
          <span class="geeb-download-step__num" aria-hidden="true">{i + 1}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="geeb-cta">
    <div class="geeb-cta__inner">
      <h2 class="geeb-cta__title" data-animate="fade-up">Not live yet? Join the waitlist.</h2>
      <p class="geeb-cta__text" data-animate="fade-up">
        Be the first to know when Geeb launches near you. Customers and pros welcome.
      </p>
      <div class="geeb-cta__actions" data-animate="fade-up">
        <a href={waitlistUrl} class="geeb-btn geeb-btn--invert">
          <Icon name="envelope" size={18} color="currentColor" />
          Join the waitlist
        </a>
        <a href={`${prefix}/projects/geeb/pro/`} class="geeb-btn geeb-btn--ghost">
          <Icon name="hard-hat" size={18} color="currentColor" />
          Apply as a pro
        </a>
      </div>
    </div>
  </section>
</ProjectLayout>
