---
import ProjectLayout from '../../../layouts/Project.astro'
import Icon from '../../../components/icons/Icon.astro'
import { resolveIcon } from '../../../components/icons/iconMappings'
import { getProject } from '../../../lib/projects'
import type { Lang, Project } from '../../../types'

const pathname = Astro.url.pathname
const lang: Lang = pathname.startsWith('/ar') ? 'ar' : 'en'
const slug = 'geeb'
const project = getProject(slug)
if (!project) return Astro.redirect('/404')

const proBenefits = [
  {
    title: 'A steady stream of jobs',
    text: 'Get matched with customers in your service area — no marketing, no chasing leads.',
    icon: 'target',
  },
  {
    title: 'Set your own schedule',
    text: 'Pick the hours and days you want to work. Pause anytime, no minimum hours.',
    icon: 'calendar-check',
  },
  {
    title: 'Transparent fees, fast payouts',
    text: 'A flat platform fee per job, no hidden cuts. Payouts to your bank within 24 hours.',
    icon: 'credit-card',
  },
  {
    title: 'Verified, reviewed customers',
    text: 'Every customer is real and rated. No-shows covered by our protection policy.',
    icon: 'shield-check',
  },
  {
    title: 'Tools to grow your business',
    text: 'Customer messaging, job history, performance analytics, and tax-ready reports.',
    icon: 'chart-line',
  },
  {
    title: 'Free to join, no commitment',
    text: 'No upfront cost, no exclusivity. Stay independent — Geeb is one more channel, not your boss.',
    icon: 'lock',
  },
]

const proCategories = [
  'Plumbing',
  'Electrical',
  'Carpentry',
  'Painting',
  'Cleaning',
  'Handyman',
  'Appliance repair',
  'AC & HVAC',
  'Pest control',
  'Landscaping',
  'Locksmith',
  'Other',
]
---

<ProjectLayout title={`Become a Pro — ${project.name} — Baseet Studio`} description={`Become a ${project.name} Pro — ${project.tagline}`} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/src/styles/projects/geeb.css" />

  <!-- Subpage hero -->
  <section class="geeb-subhero">
    <div class="geeb-hero__grid" aria-hidden="true"></div>
    <div class="geeb-hero__glow geeb-hero__glow--a" aria-hidden="true"></div>

    <div class="geeb-subhero__inner">
      <span class="geeb-eyebrow">
        <Icon name="hard-hat" size={14} color="currentColor" />
        For service pros
      </span>
      <h1 class="geeb-subhero__title" data-animate="fade-up">Grow your trade business on Geeb</h1>
      <p class="geeb-subhero__lede" data-animate="fade-up">
        Join the network of verified pros connecting with customers in your city. Free to apply, transparent fees, and the tools you need to run your business from your phone.
      </p>
    </div>
  </section>

  <!-- Benefits grid -->
  <section class="geeb-content">
    <div class="geeb-section__head" data-animate="fade-up">
      <span class="geeb-eyebrow">
        <Icon name="sparkle" size={14} color="currentColor" />
        Why pros choose Geeb
      </span>
      <h2 class="geeb-section__title">More jobs. Less hassle. More of the work you love.</h2>
      <p class="geeb-section__lede">
        Whether you are an independent plumber or a multi-team HVAC company, Geeb gives you the customers, the tools, and the payouts — without the overhead of running your own marketing or dispatch.
      </p>
    </div>

    <div class="geeb-features">
      {proBenefits.map((benefit) => (
        <div class="geeb-how__step" data-animate="fade-up">
          <div class="geeb-how__step-head" style="margin-bottom: 12px;">
            <div class="geeb-how__step-icon">
              <Icon name={benefit.icon} size={22} color="currentColor" />
            </div>
          </div>
          <h3 style="font-family:'Manrope',sans-serif;font-size:1.15rem;font-weight:700;margin:0 0 8px;color:var(--geeb-ink);">
            {benefit.title}
          </h3>
          <p style="font-size:0.95rem;line-height:1.6;color:var(--geeb-stone);margin:0;">
            {benefit.text}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Signup form + benefits side-by-side -->
  <section class="geeb-content geeb-content--narrow">
    <div class="geeb-section__head" data-animate="fade-up">
      <span class="geeb-eyebrow">
        <Icon name="envelope" size={14} color="currentColor" />
        Apply now
      </span>
      <h2 class="geeb-section__title">Tell us about your trade</h2>
      <p class="geeb-section__lede">
        We review every application within 48 hours. Approved pros get an onboarding call and can set their schedule the same day.
      </p>
    </div>

    <div class="geeb-pro-grid">
      <!-- Form -->
      <form class="geeb-pro-form" data-animate="fade-up" action="/contact/" method="get">
        <h2>Apply to become a pro</h2>
        <p>All fields required. We will reach out within 48 hours.</p>

        <div class="geeb-pro-form__row">
          <div class="geeb-pro-form__field">
            <label for="pro-first-name">First name</label>
            <input id="pro-first-name" name="first_name" type="text" autocomplete="given-name" required />
          </div>
          <div class="geeb-pro-form__field">
            <label for="pro-last-name">Last name</label>
            <input id="pro-last-name" name="last_name" type="text" autocomplete="family-name" required />
          </div>
        </div>

        <div class="geeb-pro-form__row">
          <div class="geeb-pro-form__field">
            <label for="pro-email">Email</label>
            <input id="pro-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="geeb-pro-form__field">
            <label for="pro-phone">Phone</label>
            <input id="pro-phone" name="phone" type="tel" autocomplete="tel" required />
          </div>
        </div>

        <div class="geeb-pro-form__row">
          <div class="geeb-pro-form__field">
            <label for="pro-category">Primary trade</label>
            <select id="pro-category" name="category" required>
              <option value="" disabled selected>Select a trade</option>
              {proCategories.map((cat) => (
                <option value={cat}>{cat}</option>
              ))}
            </select>
          </div>
          <div class="geeb-pro-form__field">
            <label for="pro-city">Service city</label>
            <input id="pro-city" name="city" type="text" placeholder="e.g. Abu Dhabi" required />
          </div>
        </div>

        <div class="geeb-pro-form__row">
          <div class="geeb-pro-form__field geeb-pro-form__field--full">
            <label for="pro-experience">Years of experience</label>
            <input id="pro-experience" name="experience" type="number" min="0" max="60" placeholder="e.g. 8" required />
          </div>
        </div>

        <div class="geeb-pro-form__row">
          <div class="geeb-pro-form__field geeb-pro-form__field--full">
            <label for="pro-notes">Anything else we should know?</label>
            <textarea id="pro-notes" name="notes" placeholder="Certifications, languages, specialties, team size…"></textarea>
          </div>
        </div>

        <button type="submit" class="geeb-btn geeb-btn--primary geeb-pro-form__submit">
          <Icon name="paper-plane-tilt" size={18} color="white" />
          Submit application
        </button>

        <p class="geeb-pro-form__note">
          By submitting you agree to <a href={`/${lang === 'ar' ? 'ar/' : ''}projects/geeb/terms/vendors/`}>Geeb's pro terms</a>. We will never share your details with third parties.
        </p>
      </form>

      <!-- Reassurance card -->
      <aside class="geeb-pro-benefits" data-animate="fade-up">
        <h3>What happens next</h3>
        <ul>
          <li>
            <span class="geeb-pro-benefits__icon"><Icon name="envelope" size={18} color="currentColor" /></span>
            <span><strong>1. Application review</strong>We review your trade, service area, and qualifications within 48 hours.</span>
          </li>
          <li>
            <span class="geeb-pro-benefits__icon"><Icon name="phone-call" size={18} color="currentColor" /></span>
            <span><strong>2. Onboarding call</strong>A 20-minute call to walk you through the app, payouts, and how jobs are routed.</span>
          </li>
          <li>
            <span class="geeb-pro-benefits__icon"><Icon name="shield-check" size={18} color="currentColor" /></span>
            <span><strong>3. Verification</strong>Background check, ID verification, and trade references. We handle the paperwork.</span>
          </li>
          <li>
            <span class="geeb-pro-benefits__icon"><Icon name="rocket" size={18} color="currentColor" /></span>
            <span><strong>4. Go live</strong>Set your schedule, publish your profile, and start receiving job requests.</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- CTA -->
  <section class="geeb-cta">
    <div class="geeb-cta__inner">
      <div class="geeb-cta__glow geeb-cta__glow--a" aria-hidden="true"></div>
      <div class="geeb-cta__glow geeb-cta__glow--b" aria-hidden="true"></div>
      <h2 class="geeb-cta__title" data-animate="fade-up">Questions before you apply?</h2>
      <p class="geeb-cta__text" data-animate="fade-up">
        Our pro support team is happy to walk you through the platform, fees, and what to expect in your first month.
      </p>
      <div class="geeb-cta__actions" data-animate="fade-up">
        <a href="/contact/" class="geeb-btn geeb-btn--invert">
          <Icon name="envelope" size={18} color="currentColor" />
          Contact pro support
        </a>
      </div>
    </div>
  </section>
</ProjectLayout>
