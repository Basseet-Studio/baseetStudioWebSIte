---
import Page from '../../layouts/Page.astro'
import WorkGalleryTile from '../../components/projects/WorkGalleryTile.astro'
import { getProjectsForIndex } from '../../lib/projects'

const lang: 'en' = 'en'
const description =
  'Products we build in-house — mobile apps, web platforms, and tools shipped from Abu Dhabi.'
const projects = getProjectsForIndex()

const anchor = projects.find((p) => p.indexTier === 'anchor')
const flagship = projects.filter((p) => p.indexTier === 'flagship')
const more = projects.filter((p) => p.indexTier === 'more')

const mosaicClass: Record<string, string> = {
  deshikitchen: 'wg--deshikitchen',
  moneybox: 'wg--moneybox',
  numu: 'wg--numu',
  jemeti: 'wg--jemeti',
  'photorestore-ai': 'wg--photorestore',
  baseetims: 'wg--baseetims',
}

const labClass: Record<string, string> = {
  geeb: 'wg--geeb',
  chopshop: 'wg--chopshop',
  'medical-education-app': 'wg--mai',
}
---

<Page title="Projects — Baseet Studio" description={description} section="projects" lang={lang}>
  <div class="work-wall" data-work-wall>
    <header class="work-wall__intro">
      <p class="work-wall__kicker" data-wall-intro>Baseet Studio</p>
      <h1 class="work-wall__title" data-wall-intro>Our work</h1>
    </header>

    <div class="work-wall__canvas" aria-label="Project gallery">
      {anchor && (
        <WorkGalleryTile
          project={anchor}
          layoutClass="wg--matrix"
        />
      )}

      {flagship.length > 0 && (
        <div class="work-wall__mosaic" aria-label="Core products">
          {flagship.map((project) => (
            <WorkGalleryTile
              project={project}
              layoutClass={mosaicClass[project.slug] ?? 'wg--default'}
            />
          ))}
        </div>
      )}

      {more.length > 0 && (
        <div class="work-wall__lab" aria-label="More in development">
          <p class="work-wall__lab-label" data-wall-intro>Also in the lab</p>
          <div class="work-wall__lab-grid">
            {more.map((project) => (
              <WorkGalleryTile
                project={project}
                layoutClass={labClass[project.slug] ?? 'wg--lab'}
              />
            ))}
          </div>
        </div>
      )}
    </div>

    <footer class="work-wall__foot">
      <a href="/contact/" class="work-wall__foot-link">Building something? Talk to us →</a>
    </footer>
  </div>
</Page>

<style>
  .work-wall {
    --wg-radius: var(--r-small, 12px);
    --r-small: 12px;
    --wall-gap: clamp(12px, 1.6vw, 18px);

    width: min(96vw, 1360px);
    margin: 0 auto;
    padding: 0 0 clamp(80px, 12vw, 120px);
  }

  .work-wall__intro {
    padding: 4px 0 clamp(24px, 4vw, 40px);
  }

  .work-wall__kicker {
    margin: 0 0 8px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .work-wall__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--heading-text);
    text-wrap: balance;
  }

  .work-wall__canvas {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2.2vw, 28px);
  }

  /* Matrix — prominent but not edge-to-edge */
  .work-wall__canvas :global(.wg--matrix) {
    width: min(90%, 1080px);
    margin-inline: auto;
    height: clamp(300px, 40vh, 460px);
  }

  .work-wall__canvas :global(.wg--matrix .wg__name) {
    font-size: clamp(2.2rem, 5.5vw, 4rem);
  }

  .work-wall__canvas :global(.wg--matrix .wg__tagline) {
    opacity: 1;
    transform: none;
  }

  /*
   * Mosaic — 16-row grid with room to breathe.
   * Phones stack vertically on the right; Jemeti and BaseetIMS get real estate.
   */
  .work-wall__mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(16, minmax(0, 1fr));
    gap: var(--wall-gap);
    height: clamp(920px, 108vw, 1280px);
    min-height: 0;
  }

  .work-wall__mosaic :global(.wg) {
    min-height: 0;
    height: 100%;
  }

  .work-wall__mosaic :global(.wg--deshikitchen) {
    grid-column: 1 / 9;
    grid-row: 1 / 9;
  }

  .work-wall__mosaic :global(.wg--deshikitchen .wg__name) {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }

  /* Phone apps — narrow vertical strips */
  .work-wall__mosaic :global(.wg--moneybox) {
    grid-column: 9 / -1;
    grid-row: 1 / 5;
  }

  .work-wall__mosaic :global(.wg--numu) {
    grid-column: 9 / -1;
    grid-row: 5 / 9;
  }

  .work-wall__mosaic :global(.wg--moneybox .wg__frame),
  .work-wall__mosaic :global(.wg--numu .wg__frame) {
    background: color-mix(in srgb, var(--wg-accent) 6%, rgba(8, 12, 20, 0.2));
  }

  /* PhotoRestore — taller left column */
  .work-wall__mosaic :global(.wg--photorestore) {
    grid-column: 1 / 4;
    grid-row: 9 / -1;
  }

  /* Jemeti — large featured tile */
  .work-wall__mosaic :global(.wg--jemeti) {
    grid-column: 4 / 10;
    grid-row: 9 / -1;
  }

  .work-wall__mosaic :global(.wg--jemeti .wg__visual) {
    object-fit: contain;
    object-position: center;
    padding: clamp(16px, 4vw, 32px);
    background: #1a1214;
  }

  :global([data-theme='night']) .work-wall__mosaic :global(.wg--jemeti .wg__visual) {
    background: #1f1416;
  }

  /* BaseetIMS — desktop-ish ratio, not a thin slice */
  .work-wall__mosaic :global(.wg--baseetims) {
    grid-column: 9 / -1;
    grid-row: 9 / -1;
    min-height: 0;
  }

  .work-wall__mosaic :global(.wg--moneybox .wg__name) {
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
  }

  .work-wall__mosaic :global(.wg--numu .wg__name) {
    font-size: clamp(1.25rem, 2.1vw, 1.6rem);
  }

  .work-wall__mosaic :global(.wg--jemeti .wg__name) {
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
  }

  .work-wall__mosaic :global(.wg--photorestore .wg__name),
  .work-wall__mosaic :global(.wg--baseetims .wg__name) {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
  }

  /* Lab — equal three-column grid, aligned heights */
  .work-wall__lab {
    margin-top: clamp(16px, 3vw, 28px);
  }

  .work-wall__lab-label {
    margin: 0 0 12px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted-text);
  }

  .work-wall__lab-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--wall-gap);
    height: clamp(300px, 40vw, 420px);
  }

  .work-wall__lab-grid :global(.wg) {
    min-height: 0;
    height: 100%;
  }

  .work-wall__lab-grid :global(.wg__name) {
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
  }

  .work-wall__foot {
    margin-top: clamp(40px, 6vw, 64px);
    text-align: center;
  }

  .work-wall__foot-link {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
    padding-bottom: 2px;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .work-wall__foot-link:hover,
  .work-wall__foot-link:focus-visible {
    border-color: var(--color-primary);
    color: var(--heading-text);
  }

  @media (max-width: 900px) {
    .work-wall__canvas :global(.wg--matrix) {
      width: 100%;
    }

    .work-wall__mosaic {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      height: auto;
    }

    .work-wall__mosaic :global(.wg) {
      grid-column: 1 / -1 !important;
      grid-row: auto !important;
      height: clamp(220px, 54vw, 340px) !important;
    }

    .work-wall__mosaic :global(.wg--moneybox),
    .work-wall__mosaic :global(.wg--numu) {
      height: clamp(320px, 88vw, 480px) !important;
    }

    .work-wall__mosaic :global(.wg--jemeti),
    .work-wall__mosaic :global(.wg--photorestore) {
      height: clamp(300px, 72vw, 440px) !important;
    }

    .work-wall__mosaic :global(.wg--baseetims) {
      height: clamp(280px, 68vw, 420px) !important;
    }

    .work-wall__lab-grid {
      grid-template-columns: 1fr;
      height: auto;
    }

    .work-wall__lab-grid :global(.wg) {
      height: clamp(260px, 58vw, 380px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-wall__foot-link {
      transition: none;
    }
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { initPreviewLoader } from '../../scripts/previews/preview-loader'

  gsap.registerPlugin(ScrollTrigger)

  let triggers: ScrollTrigger[] = []
  let teardownPreviews: (() => void) | undefined

  function killWallMotion(): void {
    triggers.forEach((t) => t.kill())
    triggers = []
    teardownPreviews?.()
    teardownPreviews = undefined
  }

  function initZipBorders(root: HTMLElement): void {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const radius = getComputedStyle(root).getPropertyValue('--wg-radius').trim() || '12px'
    const closed = `inset(calc(100% - 2px) 0 0 0 round ${radius})`
    const open = `inset(0 round ${radius})`

    root.querySelectorAll<HTMLElement>('[data-wg-tile]').forEach((tile) => {
      if (tile.classList.contains('wg--interactive')) return

      const frame = tile.querySelector<HTMLElement>('[data-zip-frame]')
      if (!frame) return

      gsap.set(frame, { clipPath: closed })

      if (reduced) {
        const toggle = (on: boolean) => tile.classList.toggle('is-zipped', on)
        tile.addEventListener('mouseenter', () => toggle(true))
        tile.addEventListener('mouseleave', () => toggle(false))
        tile.addEventListener('focusin', () => toggle(true))
        tile.addEventListener('focusout', () => toggle(false))
        return
      }

      const tl = gsap.timeline({ paused: true, defaults: { ease: 'power2.inOut', duration: 0.5 } })
      tl.to(frame, { clipPath: open })

      tile.addEventListener('mouseenter', () => tl.play())
      tile.addEventListener('mouseleave', () => tl.reverse())
      tile.addEventListener('focusin', () => tl.play())
      tile.addEventListener('focusout', (e) => {
        if (!tile.contains(e.relatedTarget as Node)) tl.reverse()
      })
    })
  }

  function initWorkWall(): void {
    killWallMotion()

    const root = document.querySelector<HTMLElement>('[data-work-wall]')
    if (!root) return

    initZipBorders(root)
    teardownPreviews = initPreviewLoader(root)

    root.querySelectorAll<HTMLVideoElement>('video.wg__visual').forEach((video) => {
      const tile = video.closest('.wg')
      if (!tile) return

      const play = () => video.play().catch(() => {})
      const pause = () => {
        video.pause()
        video.currentTime = 0
      }

      tile.addEventListener('mouseenter', play)
      tile.addEventListener('mouseleave', pause)
      tile.addEventListener('focusin', play)
      tile.addEventListener('focusout', pause)
    })

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    gsap.from(root.querySelectorAll('[data-wall-intro]'), {
      y: 14,
      opacity: 0,
      duration: 0.55,
      stagger: 0.06,
      ease: 'power2.out',
    })

    const matrixTile = root.querySelector<HTMLElement>('.wg--matrix')
    const matrixVisual = matrixTile?.querySelector<HTMLElement>('.wg__visual:not(.wg__fallback)')
    if (matrixVisual && !matrixTile?.classList.contains('wg--interactive')) {
      const st = ScrollTrigger.create({
        trigger: matrixTile,
        start: 'top bottom',
        end: 'bottom top',
        scrub: 0.5,
        onUpdate: (self) => {
          gsap.set(matrixVisual, { y: (self.progress - 0.5) * 16 })
        },
      })
      triggers.push(st)
    }
  }

  initWorkWall()
  document.addEventListener('astro:page-load', initWorkWall)
  document.addEventListener('astro:before-swap', killWallMotion)
</script>
