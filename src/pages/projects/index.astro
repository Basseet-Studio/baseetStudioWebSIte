---
import Page from '../../layouts/Page.astro'
import Icon from '../../components/icons/Icon.astro'
import { resolveIcon } from '../../components/icons/iconMappings'
import { getProjectsIndex, type ProjectSummary } from '../../lib/projects'

const lang: 'en' = 'en'
const description = 'Explore the Baseet Studio portfolio — mobile apps, web platforms, and digital products built for clients across the UAE and beyond.'

const statusLabels: Record<string, string> = {
  'Coming Soon': 'Coming Soon',
  'Live': 'Live',
  'Completed': 'Completed',
  'Confidential': 'Confidential',
  'MVP Proof of Concept': 'MVP PoC',
  'Ready to Deliver': 'Ready to Deliver',
}
---

<Page title="Projects — Baseet Studio" description={description} section="projects" lang={lang}>
  <section style="padding:100px 24px 64px;text-align:center;" data-animate="fade-up">
    <h1 style="font-size:3rem;font-weight:700;margin-bottom:16px;color:var(--heading-text);">
      Our Projects
    </h1>
    <p style="font-size:1.25rem;max-width:600px;margin:0 auto;opacity:0.7;">
      We build digital products that transform ideas into reality.
    </p>
  </section>

  <section style="padding:0 24px 80px;max-width:1200px;margin:0 auto;">
    <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(340px, 1fr));gap:24px;">
      {getProjectsIndex().map((project: ProjectSummary) => (
        <a
          href={`/projects/${project.slug}/`}
          class="glass glass-card project-card"
          style="text-decoration:none;color:inherit;border-radius:16px;overflow:hidden;border:1px solid var(--card-border);transition:transform 0.3s,box-shadow 0.3s;"
        >
          <div style={`height:4px;background:${project.color};`}></div>
          <div style="padding:24px;">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:16px;">
              <div>
                <h3 style="font-size:1.25rem;font-weight:700;margin-bottom:6px;color:var(--heading-text);">
                  {project.name}
                </h3>
                <p style="font-size:0.9rem;opacity:0.6;">{project.tagline}</p>
              </div>
              <span style={`font-size:0.75rem;padding:4px 10px;border-radius:20px;font-weight:600;white-space:nowrap;background:${project.color}20;color:${project.color};border:1px solid ${project.color}30;`}>
                {statusLabels[project.status] || project.status}
              </span>
            </div>

            {project.platforms && project.platforms.length > 0 && (
              <div style="display:flex;gap:10px;font-size:1.1rem;opacity:0.5;">
                {project.platforms.map(p => (
                  <span title={p.name}>
                    <Icon name={resolveIcon(p.icon).name} size={18} color="currentColor" />
                  </span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
</Page>

<style>
  .project-card:hover { transform: translateY(-4px); box-shadow: var(--card-shadow-hover); }
</style>
