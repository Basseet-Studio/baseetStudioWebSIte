---
import Page from '../../layouts/Page.astro'
import Icon from '../../components/icons/Icon.astro'
import { resolveIcon } from '../../components/icons/iconMappings'
import { getProjectsIndex, type ProjectSummary } from '../../lib/projects'

const lang: 'en' = 'en'
const description = 'Explore the Baseet Studio portfolio — mobile apps, web platforms, and digital products built for clients across the UAE and beyond.'
const projects = getProjectsIndex()

const statusLabels: Record<string, string> = {
  'Coming Soon': 'Coming Soon',
  'Live': 'Live',
  'Completed': 'Completed',
  'Confidential': 'Confidential',
  'MVP Proof of Concept': 'MVP PoC',
  'Ready to Deliver': 'Ready to Deliver',
}
---

<Page title="Projects — Baseet Studio" description={description} section="projects" lang={lang}>
  <div class="proj-index" data-proj-index>
    <header class="proj-index__hero">
      <p class="proj-index__eyebrow" data-proj-hero-item>Portfolio</p>
      <h1 class="proj-index__title" data-proj-hero-item>Our Projects</h1>
      <p class="proj-index__lede" data-proj-hero-item>
        We build digital products that transform ideas into reality.
      </p>
    </header>

    <div class="proj-index__track">
      {projects.map((project: ProjectSummary, i) => (
        <article
          class="proj-card"
          data-proj-card
          data-proj-color={project.color}
          style={`--proj-accent: ${project.color}; --proj-i: ${i};`}
        >
          <a href={`/projects/${project.slug}/`} class="proj-card__link card-window card-window--interactive">
            <div class="proj-card__inner">
              <div class="proj-card__meta">
                <span class="proj-card__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="proj-card__status">{statusLabels[project.status] || project.status}</span>
              </div>
              <h2 class="proj-card__name">
                <span class="proj-card__name-row">
                  {project.icon ? (
                    <img
                      src={project.icon}
                      alt=""
                      class="proj-card__icon proj-card__icon--img"
                      width="32"
                      height="32"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : project.iconClass ? (
                    <span class="proj-card__icon proj-card__icon--glyph" aria-hidden="true">
                      <Icon name={resolveIcon(project.iconClass).name} size={28} color={project.color} />
                    </span>
                  ) : null}
                  <span>{project.name}</span>
                </span>
              </h2>
              <p class="proj-card__tagline">{project.tagline}</p>
              {project.platforms && project.platforms.length > 0 && (
                <div class="proj-card__platforms">
                  {project.platforms.map((p) => (
                    <span title={p.name}>
                      <Icon name={resolveIcon(p.icon).name} size={18} color="currentColor" />
                    </span>
                  ))}
                </div>
              )}
              <span class="proj-card__cta">
                View project
                <Icon name="arrow-right" size={14} color="currentColor" />
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</Page>

<style>
  .proj-index {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 0 96px;
  }

  .proj-index__hero {
    text-align: center;
    padding: 24px 0 56px;
    position: relative;
  }

  .proj-index__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 14px;
  }

  .proj-index__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 700;
    color: var(--heading-text);
    margin: 0 0 16px;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .proj-index__lede {
    font-size: 1.15rem;
    color: var(--muted-text);
    max-width: 52ch;
    margin: 0 auto;
    line-height: 1.55;
  }

  .proj-index__track {
    display: flex;
    flex-direction: column;
    gap: 28px;
    position: relative;
  }

  .proj-card {
    position: relative;
    will-change: transform, opacity;
  }

  .proj-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    border-radius: var(--card-window-radius);
    transform-origin: center center;
  }

  .proj-card__inner {
    padding: 28px 28px 26px;
    display: grid;
    gap: 10px;
  }

  .proj-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .proj-card__index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--proj-accent) 70%, var(--muted-text));
  }

  .proj-card__status {
    font-size: 0.72rem;
    padding: 4px 10px;
    border-radius: 20px;
    font-weight: 600;
    white-space: nowrap;
    background: color-mix(in srgb, var(--proj-accent) 12%, transparent);
    color: var(--proj-accent);
    border: 1px solid color-mix(in srgb, var(--proj-accent) 28%, transparent);
  }

  .proj-card__name {
    font-family: var(--font-title);
    font-size: clamp(1.35rem, 2.4vw, 1.65rem);
    font-weight: 700;
    color: var(--heading-text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .proj-card__name-row {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .proj-card__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .proj-card__icon--img {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    object-fit: cover;
  }

  .proj-card__icon--glyph {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--proj-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--proj-accent) 22%, transparent);
  }

  .proj-card__tagline {
    font-size: 0.95rem;
    color: var(--muted-text);
    margin: 0;
    line-height: 1.5;
    max-width: 56ch;
  }

  .proj-card__platforms {
    display: flex;
    gap: 10px;
    font-size: 1.05rem;
    color: var(--muted-text);
    margin-top: 4px;
  }

  .proj-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--proj-accent);
    opacity: 0.85;
    transition: gap 0.25s ease, opacity 0.25s ease;
  }

  .proj-card__link:hover .proj-card__cta,
  .proj-card__link:focus-visible .proj-card__cta {
    gap: 12px;
    opacity: 1;
  }

  @media (max-width: 640px) {
    .proj-index__hero {
      padding-bottom: 40px;
    }

    .proj-card__inner {
      padding: 22px 20px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proj-card {
      will-change: auto;
    }
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  let triggers: ScrollTrigger[] = []

  function killAll(): void {
    triggers.forEach((t) => t.kill())
    triggers = []
    ScrollTrigger.getAll().forEach((st) => {
      if (st.vars?.id?.toString().startsWith('proj-index')) st.kill()
    })
  }

  function initProjectsScroll(): void {
    killAll()

    const root = document.querySelector<HTMLElement>('[data-proj-index]')
    if (!root) return

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.querySelectorAll('[data-proj-card]').forEach((card) => {
        gsap.set(card, { opacity: 1, y: 0 })
      })
      return
    }

    const heroItems = gsap.utils.toArray<HTMLElement>('[data-proj-hero-item]')
    const cards = gsap.utils.toArray<HTMLElement>('[data-proj-card]')

    gsap.from(heroItems, {
      y: 24,
      opacity: 0,
      duration: 0.7,
      stagger: 0.1,
      ease: 'power2.out',
      delay: 0.1,
    })

    cards.forEach((card, i) => {
      const st = ScrollTrigger.create({
        id: `proj-index-card-${i}`,
        trigger: card,
        start: 'top 90%',
        once: true,
        onEnter: () => {
          gsap.fromTo(
            card,
            { opacity: 0, y: 20 },
            {
              opacity: 1,
              y: 0,
              duration: 0.55,
              ease: 'power2.out',
            },
          )
        },
      })
      triggers.push(st)
    })

    ScrollTrigger.refresh()
  }

  initProjectsScroll()
  document.addEventListener('astro:page-load', initProjectsScroll)
  document.addEventListener('astro:before-swap', killAll)
</script>
