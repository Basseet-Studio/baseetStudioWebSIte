---
import ProjectLayout from '../../layouts/Project.astro'
import ProjectGallery from '../../components/project/ProjectGallery.astro'
import ProjectCTA from '../../components/project/ProjectCTA.astro'
import ProjectFeatureCard from '../../components/project/ProjectFeatureCard.astro'
import ProjectTestimonial from '../../components/project/ProjectTestimonial.astro'
import ProjectFAQ from '../../components/project/ProjectFAQ.astro'
import GradientCTA from '../../components/project/GradientCTA.astro'
import ProjectClients from '../../components/project/ProjectClients.astro'
import Icon from '../../components/icons/Icon.astro'
import { resolveIcon } from '../../components/icons/iconMappings'
import { getProject } from '../../lib/projects'
import { getClientsForProject } from '../../lib/clients'
import type { Project } from '../../types'


const lang: 'en' = 'en'
const slug = 'matrix'
const project = getProject(slug)
if (!project) return Astro.redirect('/404')
const linkedClients = getClientsForProject(slug)
---

<ProjectLayout title={`${project.name} — Baseet Studio`} description={project.tagline} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>
  <link rel="stylesheet" href="/src/styles/projects/matrix.css" />

  <!-- Hero. P3 audit #18 + #32 — uses the responsive
       `.project-hero--centered` class (96px mobile padding, 140px
       desktop). The coloured background wash is theme-aware via
       `.project-hero-wash` in shared.css. Matrix keeps its dark-neon
       aesthetic through the grid overlay, glow orb, and shadow stack
       on the icon — those still render the same in both modes. -->
  <section class="project-hero project-hero--centered">
    <div style="position:absolute;inset:0;background-image:radial-gradient(circle at 1px 1px, rgba(255,255,255,0.06) 1px, transparent 0);background-size:40px 40px;opacity:0.6;"></div>
    <div style={`position:absolute;top:-20%;left:50%;transform:translateX(-50%);width:600px;height:600px;border-radius:50%;background:radial-gradient(circle, color-mix(in srgb, ${project.color} 15%, transparent) 0%, transparent 70%);filter:blur(60px);pointer-events:none;`}></div>

    <div style="max-width:800px;margin:0 auto;position:relative;z-index:1;">
      <div style="display:flex;justify-content:center;margin-bottom:28px;" data-animate="fade-up">
        <div style={`width:96px;height:96px;border-radius:24px;background:${project.gradient};display:flex;align-items:center;justify-content:center;box-shadow:0 0 40px color-mix(in srgb, ${project.color} 40%, transparent), 0 0 80px color-mix(in srgb, ${project.color} 20%, transparent), 0 8px 32px rgba(0,0,0,0.4);position:relative;`}>
          <Icon name={resolveIcon(project.iconClass).name} size={40} color="white" />
        </div>
      </div>

      <h1 style="font-size:3.2rem;font-weight:700;color:var(--heading-text);margin-bottom:8px;letter-spacing:-0.02em;" data-animate="fade-up">
        {project.name}
      </h1>
      <p style={`font-size:1.3rem;font-weight:500;color:${project.color};margin-bottom:24px;`} data-animate="fade-up">
        {project.tagline}
      </p>

      <div style="margin-bottom:28px;" data-animate="fade-up">
        <span style={`display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 25%, transparent);box-shadow:0 0 16px color-mix(in srgb, ${project.color} 10%, transparent);`}>
          <Icon name="clock" size={16} color={project.color} />
          {project.status}
        </span>
      </div>

      <h2 style="font-size:2rem;font-weight:700;color:var(--heading-text);margin-bottom:20px;line-height:1.3;" data-animate="fade-up">
        {project.hero.title}
      </h2>
      <p style="font-size:1.1rem;color:var(--muted-text);margin-bottom:36px;max-width:580px;margin-left:auto;margin-right:auto;line-height:1.7;" data-animate="fade-up">
        {project.hero.subtitle}
      </p>

      <!-- CTA Buttons. P1 audit #14 — uses the global `.cta-btn--primary` /
           `.cta-btn--secondary` classes. The neon Matrix shadow lives in
           scoped styles below (`.matrix-cta-primary` adds the extra glow
           the brand needs). -->
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;" data-animate="fade-up">
        {project.hero.cta_primary && (
          <a href={project.hero.cta_primary_link || '/contact/'}
            class="cta-btn--primary matrix-cta-primary"
            style={`background:${project.gradient};`}>
            {project.hero.cta_primary}
          </a>
        )}
        {project.hero.cta_secondary && (
          <a href={project.hero.cta_secondary_link || '#features'}
            class="cta-btn--secondary matrix-cta-secondary">
            {project.hero.cta_secondary}
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Features -->
  {project.features && project.features.length > 0 && (
    <section id="features" style="padding:64px 24px;max-width:1200px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:48px;" data-animate="fade-up">
        <span style={`display:inline-block;padding:8px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);margin-bottom:16px;`}>
          {/* TODO: localise this later */ 'Features'}
        </span>
        <h2 style="font-size:2rem;margin-bottom:0;color:var(--heading-text);">
          {/* TODO: localise this later */ 'Key Features'}
        </h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:24px;">
        {project.features.map((feature, i) => (
          <ProjectFeatureCard title={feature.title} description={feature.description} iconName={resolveIcon(feature.icon).name} projectColor={project.color} projectGradient={project.gradient} index={i} />
        ))}
      </div>
    </section>
  )}

  <!-- Gallery -->
  {project.screenshots && project.screenshots.length > 0 && (
    <ProjectGallery screenshots={project.screenshots} galleryType={project.galleryType || 'mobile'} projectSlug={project.slug} projectColor={project.color} projectName={project.name} />
  )}

  <!-- Testimonials -->
  {project.testimonials && project.testimonials.length > 0 && (
    <section style="padding:64px 24px;max-width:1200px;margin:0 auto;">
      <h2 style="text-align:center;font-size:2rem;margin-bottom:48px;color:var(--heading-text);">
        {/* TODO: localise this later */ 'What People Say'}
      </h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(340px, 1fr));gap:24px;">
        {project.testimonials.map(t => (
          <ProjectTestimonial quote={t.quote} author={t.author} role={t.role} projectColor={project.color} projectGradient={project.gradient} />
        ))}
      </div>
    </section>
  )}

  <!-- FAQ -->
  {project.faq && project.faq.length > 0 && (
    <section style="padding:64px 24px;max-width:800px;margin:0 auto;">
      <h2 style="text-align:center;font-size:2rem;margin-bottom:48px;color:var(--heading-text);">
        {/* TODO: localise this later */ 'FAQ'}
      </h2>
      <div style="display:flex;flex-direction:column;gap:12px;">
        {project.faq.map(item => (
          <ProjectFAQ question={item.question} answer={item.answer} projectColor={project.color} />
        ))}
      </div>
    </section>
  )}

  <!-- Gradient CTA. P1 audit #11, #15, #20 — uses the shared component. -->
  <ProjectClients clients={linkedClients} projectColor={project.color} />

  <GradientCTA
    title={`Interested in ${project.name}?`}
    body="Get in touch and we will help you get started."
    ctaLabel="Get in Touch"
    ctaHref="/contact/"
    gradient={project.gradient}
    accentColor={project.color}
    lang={lang}
  />

  <ProjectCTA status={project.status} platforms={project.platforms || []} links={project.links} lang={lang} />
</ProjectLayout>

<style>
  /* Matrix-only neon glow on the hero CTA. Replaces the inline
   * `onmouseover`/`onmouseout` JS that previously toggled box-shadow. */
  .matrix-cta-primary {
    box-shadow:
      0 0 24px color-mix(in srgb, var(--project-color) 30%, transparent),
      0 4px 16px rgba(0, 0, 0, 0.3);
  }
  .matrix-cta-primary:hover {
    box-shadow:
      0 0 32px color-mix(in srgb, var(--project-color) 45%, transparent),
      0 6px 20px rgba(0, 0, 0, 0.4);
  }
  .matrix-cta-secondary {
    border-color: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
  }
  .matrix-cta-secondary:hover {
    border-color: rgba(255, 255, 255, 0.35);
  }
  @media (prefers-reduced-motion: reduce) {
    .matrix-cta-secondary {
      backdrop-filter: none;
    }
  }
</style>
