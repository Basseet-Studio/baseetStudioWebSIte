---
import ProjectLayout from '../../layouts/Project.astro'
import ProjectGallery from '../../components/project/ProjectGallery.astro'
import ProjectCTA from '../../components/project/ProjectCTA.astro'
import ProjectFeatureCard from '../../components/project/ProjectFeatureCard.astro'
import ProjectTestimonial from '../../components/project/ProjectTestimonial.astro'
import ProjectFAQ from '../../components/project/ProjectFAQ.astro'
import GradientCTA from '../../components/project/GradientCTA.astro'
import Icon from '../../components/icons/Icon.astro'
import { resolveIcon } from '../../components/icons/iconMappings'
import { getProject } from '../../lib/projects'
import type { Project } from '../../types'


const lang: 'en' = 'en'
const slug = 'medev'
const project = getProject(slug)
if (!project) return Astro.redirect('/404')
---

<ProjectLayout title={`${project.name} — Baseet Studio`} description={project.tagline} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/src/styles/projects/medev.css" />

  <!-- Hero: The coloured background wash now lives in shared.css
         (`.project-hero-wash`) so it is theme-aware and fades out gradually
         as the user scrolls, instead of cutting off sharply at the bottom
         of the hero. The hero itself is transparent so the wash shows
         through. P3 audit #18 + #32 — responsive hero padding
         (96px mobile, 140px desktop) via `.project-hero--split`. -->
    <section class="project-hero project-hero--split">
      <div style="position:absolute;inset:0;background-image:radial-gradient(circle at 20px 20px, rgba(10,110,116,0.04) 2px, transparent 0);background-size:60px 60px;opacity:0.6;"></div>

      <div style="max-width:1200px;margin:0 auto;position:relative;z-index:1;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;">
          <!-- Left: Content -->
          <div style="text-align:left;">
            <div style="display:flex;align-items:center;gap:20px;margin-bottom:32px;" data-animate="fade-up">
              <div style={`width:80px;height:80px;border-radius:20px;background:${project.gradient};display:flex;align-items:center;justify-content:center;box-shadow:0 10px 40px -10px color-mix(in srgb, ${project.color} 30%, transparent);flex-shrink:0;`}>
                <Icon name={resolveIcon(project.iconClass).name} size={36} color="white" />
              </div>
              <div>
                <h1 style="font-size:2.8rem;font-weight:700;color:var(--heading-text);font-family:'IBM Plex Sans',sans-serif;line-height:1.1;">{project.name}</h1>
                <p style={`font-size:1.25rem;font-weight:600;color:${project.color};margin-top:4px;`}>{project.tagline}</p>
              </div>
            </div>

            <div style="margin-bottom:24px;" data-animate="fade-up">
              <span style={`display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);`}>
                <Icon name="check-circle" size={16} color={project.color} />
                {project.status}
              </span>
            </div>

            <h2 style="font-size:2rem;font-weight:700;color:var(--heading-text);margin-bottom:20px;line-height:1.3;font-family:'IBM Plex Sans',sans-serif;" data-animate="fade-up">
              {project.hero.title}
            </h2>
            <p style="font-size:1.15rem;color:var(--muted-text);margin-bottom:32px;max-width:500px;line-height:1.7;" data-animate="fade-up">
              {project.hero.subtitle}
            </p>

            <!-- CTA Buttons. P1 audit #14 — uses the global `.cta-btn--primary` /
                 `.cta-btn--secondary` classes instead of inline `onmouseover`. -->
            <div style="display:flex;gap:16px;flex-wrap:wrap;" data-animate="fade-up">
              {project.hero.cta_primary && (
                <a href={project.hero.cta_primary_link || '/contact/'}
                  class="cta-btn--primary"
                  style={`background:${project.gradient};`}>
                  {project.hero.cta_primary}
                </a>
              )}
              {project.hero.cta_secondary && (
                <a href={project.hero.cta_secondary_link || '#features'}
                  class="cta-btn--secondary"
                  style={`border-color:color-mix(in srgb, ${project.color} 25%, transparent);`}>
                  {project.hero.cta_secondary}
                </a>
              )}
            </div>
          </div>

        <!-- Right: Placeholder visual. P0 audit #6 — the inline `display:none`
             was beating the CSS class at every breakpoint, so the dashboard
             mockup was invisible. Now hidden by default via the class hook
             `.medev-hero-visual` (defined in `medev.css`) and revealed at the
             `lg` breakpoint. -->
        <div class="medev-hero-visual" data-animate="fade-up">
          <div style="background:white;border-radius:24px;overflow:hidden;box-shadow:0 20px 60px color-mix(in srgb, #0A6E74, 15%, transparent);border:1px solid #99F6E4;">
            <div style={`padding:14px 20px;background:${project.gradient};display:flex;align-items:center;gap:8px;`}>
              <div style="width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,0.5);"></div>
              <div style="width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,0.5);"></div>
              <div style="width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,0.5);"></div>
              <span style="color:rgba(255,255,255,0.9);font-size:0.8rem;margin-left:12px;font-weight:500;">
                {/* TODO: localise this later */ 'Medev Dashboard'}
              </span>
            </div>
            <div style="padding:24px;display:flex;flex-direction:column;gap:16px;">
              <!-- Patient card mockup -->
              <div style="background:#F0FDFA;border-radius:16px;padding:20px;border:1px solid #CCFBF1;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
                  <div style={`width:48px;height:48px;border-radius:14px;background:${project.gradient};display:flex;align-items:center;justify-content:center;`}>
                    <Icon name="user" size={24} color="white" />
                  </div>
                  <div>
                    <!-- P1 audit #13 — was hardcoded #0E4B4F / #5FBFB1 / #285E61.
                         The card surface is light by design, so these tints
                         still read on the white card in both themes. -->
                    <div class="medev-mock-heading" style="font-weight:700;font-size:0.95rem;">{/* TODO: localise this later */ 'Patient Portal'}</div>
                    <div class="medev-mock-active" style="font-size:0.75rem;">{/* TODO: localise this later */ 'Active'}</div>
                  </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">
                  <div style="background:white;border-radius:12px;padding:12px;text-align:center;border:1px solid #CCFBF1;">
                    <Icon name="file-text" size={18} color={project.color} />
                    <div class="medev-mock-label" style="font-size:0.7rem;margin-top:4px;">{/* TODO: localise this later */ 'Records'}</div>
                  </div>
                  <div style="background:white;border-radius:12px;padding:12px;text-align:center;border:1px solid #CCFBF1;">
                    <Icon name="calendar-check" size={18} color={project.color} />
                    <div class="medev-mock-label" style="font-size:0.7rem;margin-top:4px;">{/* TODO: localise this later */ 'Schedule'}</div>
                  </div>
                  <div style="background:white;border-radius:12px;padding:12px;text-align:center;border:1px solid #CCFBF1;">
                    <Icon name="first-aid" size={18} color={project.color} />
                    <div class="medev-mock-label" style="font-size:0.7rem;margin-top:4px;">{/* TODO: localise this later */ 'EHR'}</div>
                  </div>
                </div>
              </div>
              <!-- Stats mockup -->
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div style="background:white;border-radius:16px;padding:16px;border:1px solid #E5E7EB;">
                  <!-- P1 audit #13 — heading was hardcoded #0E4B4F (invisible in
                       night mode). Theme-aware muted token. -->
                  <div class="medev-mock-stat" style="font-size:1.5rem;font-weight:700;font-family:'IBM Plex Sans',sans-serif;">2,450</div>
                  <div class="medev-mock-soft" style="font-size:0.75rem;">{/* TODO: localise this later */ 'Active Patients'}</div>
                </div>
                <div style="background:white;border-radius:16px;padding:16px;border:1px solid #E5E7EB;">
                  <div class="medev-mock-stat" style="font-size:1.5rem;font-weight:700;font-family:'IBM Plex Sans',sans-serif;">98.7%</div>
                  <div class="medev-mock-soft" style="font-size:0.75rem;">{/* TODO: localise this later */ 'Uptime'}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  {project.features && project.features.length > 0 && (
    <section id="features" style="padding:64px 24px;max-width:1200px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:48px;" data-animate="fade-up">
        <span style={`display:inline-block;padding:8px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);margin-bottom:16px;`}>
          {/* TODO: localise this later */ 'Features'}
        </span>
        <h2 style="font-size:2rem;margin-bottom:0;color:var(--heading-text);font-family:'IBM Plex Sans',sans-serif;">
          {/* TODO: localise this later */ 'Key Features'}
        </h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:24px;">
        {project.features.map((feature, i) => (
          <ProjectFeatureCard title={feature.title} description={feature.description} iconName={resolveIcon(feature.icon).name} projectColor={project.color} projectGradient={project.gradient} index={i} />
        ))}
      </div>
    </section>
  )}

  <!-- Gallery -->
  {project.screenshots && project.screenshots.length > 0 && (
    <ProjectGallery screenshots={project.screenshots} galleryType={project.galleryType || 'mobile'} projectSlug={project.slug} projectColor={project.color} projectName={project.name} />
  )}

  <!-- Testimonials -->
  {project.testimonials && project.testimonials.length > 0 && (
    <section style="padding:64px 24px;max-width:1200px;margin:0 auto;">
      <h2 style="text-align:center;font-size:2rem;margin-bottom:48px;color:var(--heading-text);font-family:'IBM Plex Sans',sans-serif;">
        {/* TODO: localise this later */ 'What People Say'}
      </h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(340px, 1fr));gap:24px;">
        {project.testimonials.map(t => (
          <ProjectTestimonial quote={t.quote} author={t.author} role={t.role} projectColor={project.color} projectGradient={project.gradient} />
        ))}
      </div>
    </section>
  )}

  <!-- FAQ -->
  {project.faq && project.faq.length > 0 && (
    <section style="padding:64px 24px;max-width:800px;margin:0 auto;">
      <h2 style="text-align:center;font-size:2rem;margin-bottom:48px;color:var(--heading-text);font-family:'IBM Plex Sans',sans-serif;">
        {/* TODO: localise this later */ 'FAQ'}
      </h2>
      <div style="display:flex;flex-direction:column;gap:12px;">
        {project.faq.map(item => (
          <ProjectFAQ question={item.question} answer={item.answer} projectColor={project.color} />
        ))}
      </div>
    </section>
  )}

  <!-- Gradient CTA. P1 audit #11, #15, #20 — uses the shared component. -->
  <GradientCTA
    title={`Interested in ${project.name}?`}
    body="Get in touch and we will help you get started."
    ctaLabel="Get in Touch"
    ctaHref="/contact/"
    gradient={project.gradient}
    accentColor={project.color}
    lang={lang}
  />

  <ProjectCTA status={project.status} platforms={project.platforms || []} links={project.links} lang={lang} />
</ProjectLayout>

<style>
  /* P1 audit #13 — the dashboard mockup used hardcoded teal text colours
   * that became invisible in night mode. The card surface is always white
   * (intentional — the mockup represents an app inside the page), so we
   * keep readable ink-on-paper tones that work in both themes. */
  .medev-mock-heading {
    color: #134e4a;
  }
  .medev-mock-active {
    color: #0f766e;
  }
  .medev-mock-label {
    color: #285e61;
  }
  .medev-mock-stat {
    color: #134e4a;
  }
  .medev-mock-soft {
    color: #6b7280;
  }
</style>
