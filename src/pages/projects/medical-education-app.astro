---
// medical-education-app — case study composed from real project data (see CaseStudy.astro).
import CaseStudy from '../../components/project/CaseStudy.astro'
import { getProject } from '../../lib/projects'
import { localizeHref } from '../../lib/localize-href'
import type { Lang } from '../../types'

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props
const project = getProject('medical-education-app', lang)
if (!project) return Astro.redirect(localizeHref(lang, '/404'))
---

<CaseStudy project={project} lang={lang} mediaKind="web" featureStyle="index" />
