---
import ProjectLayout from '../../layouts/Project.astro'
import ProjectFAQ from '../../components/project/ProjectFAQ.astro'
import Icon from '../../components/icons/Icon.astro'
import { resolveIcon } from '../../components/icons/iconMappings'
import { getProject } from '../../lib/projects'
import linksData from '../../content/data/links.json'
import type { ProjectLinks } from '../../types'

const lang = 'en' as const
const slug = 'moneybox'
const project = getProject(slug)
if (!project) return Astro.redirect('/404')

const links: ProjectLinks = (linksData.projects.moneybox || project.links || {}) as ProjectLinks
const androidUrl = links.android && links.android !== '#' ? links.android : project.links?.android

const categories = ['Food', 'Transport', 'Bills', 'Shopping', 'Health', 'Entertainment', 'Savings', 'Other']

const bentoItems = [
  { title: 'Savings Goals', desc: 'Set targets and watch progress with motivating visual charts.', wide: true },
  { title: 'Expense Tracking', desc: 'Log spending by category and spot patterns early.', wide: false },
  { title: 'Clean Reports', desc: 'Monthly summaries designed for quick mobile check-ins.', wide: false },
]

const savingsGoals = [
  { name: 'Emergency fund', progress: '68% saved — $3,400 of $5,000' },
  { name: 'Summer trip', progress: '42% saved — $840 of $2,000' },
  { name: 'New laptop', progress: '91% saved — $1,820 of $2,000' },
]
---

<ProjectLayout title={`${project.name} — Baseet Studio`} description={project.tagline} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/src/styles/projects/moneybox.css" />

  <main class="moneybox-main" style="font-family:'DM Sans',sans-serif;">
    <section class="moneybox-hero">
      <div class="moneybox-hero__blur" aria-hidden="true"></div>
      <div class="moneybox-hero__grid">
        <div>
          <p style={`font-size:0.9rem;font-weight:600;color:${project.color};margin:0 0 1rem;`}>{project.tagline}</p>
          <h1 class="moneybox-hero__title" style="font-family:'Outfit',sans-serif;" data-animate="fade-up">{project.hero.title}</h1>
          <p class="moneybox-hero__subtitle" data-animate="fade-up">{project.hero.subtitle}</p>
          <div class="moneybox-hero__ctas" data-animate="fade-up">
            <a href="/projects/moneybox/download/" class="cta-btn--primary" style={`background:${project.gradient};`}>
              {project.hero.cta_primary}
            </a>
            <a href="/projects/moneybox/features/" class="cta-btn--secondary" style={`border-color:color-mix(in srgb, ${project.color} 25%, transparent);`}>
              View Features
            </a>
          </div>
        </div>
        <div class="moneybox-hero__card" data-animate="fade-up">
          <div class="moneybox-hero__card-label">Emergency fund</div>
          <div class="moneybox-hero__card-value" style="font-family:'Outfit',sans-serif;">$3,400</div>
          <div class="moneybox-hero__card-bar">
            <div class="moneybox-hero__card-bar-fill"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="moneybox-section">
      <div class="moneybox-section__inner">
        <div class="moneybox-categories">
          {categories.map((cat) => (
            <span class="moneybox-categories__chip">{cat}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="moneybox-section">
      <div class="moneybox-section__inner">
        <h2 class="moneybox-section-title" style="font-family:'Outfit',sans-serif;" data-animate="fade-up">Built for clarity</h2>
        <div class="moneybox-bento">
          {bentoItems.map((item) => (
            <div class={`moneybox-bento__card${item.wide ? ' moneybox-bento__card--wide' : ''}`} data-animate="fade-up">
              <h3 style="font-family:'Outfit',sans-serif;">{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="moneybox-section" data-moneybox-pin>
      <div class="moneybox-section__inner">
        <div class="moneybox-pin">
          <div class="moneybox-pin__title-wrap" data-moneybox-pin-title>
            <h2 class="moneybox-section-title" style="font-family:'Outfit',sans-serif;text-align:left;margin-bottom:1rem;">Watch your savings grow</h2>
            <p style="color:var(--muted-text);line-height:1.7;margin:0;">Set goals, track progress, and stay motivated with visual charts.</p>
          </div>
          <div class="moneybox-pin__goals" data-moneybox-pin-content>
            {savingsGoals.map((goal) => (
              <div class="moneybox-pin__goal" data-animate="fade-up">
                <h4 style="font-family:'Outfit',sans-serif;">{goal.name}</h4>
                <p>{goal.progress}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="moneybox-section">
      <div class="moneybox-section__inner">
        <h2 class="moneybox-section-title" style="font-family:'Outfit',sans-serif;">MoneyBox vs spreadsheets</h2>
        <div class="moneybox-compare">
          <div class="moneybox-compare__col">
            <h4 style="font-family:'Outfit',sans-serif;">MoneyBox</h4>
            <ul>
              <li>Mobile-first daily logging</li>
              <li>Visual goal progress</li>
              <li>Category breakdowns</li>
              <li>Private on-device data</li>
            </ul>
          </div>
          <div class="moneybox-compare__col">
            <h4 style="font-family:'Outfit',sans-serif;">Spreadsheets</h4>
            <ul>
              <li>Manual formula upkeep</li>
              <li>No mobile nudges</li>
              <li>End-of-month archaeology</li>
              <li>Easy to abandon</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {project.features && project.features.length > 0 && (
      <section class="moneybox-section" id="features">
        <div class="moneybox-section__inner">
          <h2 class="moneybox-section-title" style="font-family:'Outfit',sans-serif;">Key features</h2>
          <div class="moneybox-bento">
            {project.features.slice(0, 3).map((f) => (
              <div class="moneybox-bento__card" data-animate="fade-up">
                <Icon name={resolveIcon(f.icon).name} size={24} color={project.color} />
                <h3 style="font-family:'Outfit',sans-serif;margin-top:1rem;">{f.title}</h3>
                <p>{f.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {project.faq && project.faq.length > 0 && (
      <section class="moneybox-section" id="faq">
        <div class="moneybox-section__inner" style="max-width:40rem;">
          <h2 class="moneybox-section-title" style="font-family:'Outfit',sans-serif;">FAQ</h2>
          <div style="display:flex;flex-direction:column;gap:0.75rem;">
            {project.faq.map((item) => (
              <ProjectFAQ question={item.question} answer={item.answer} projectColor={project.color} />
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="moneybox-section" style="text-align:center;">
      <a href={androidUrl || '/projects/moneybox/download/'} class="cta-btn--primary" style={`background:${project.gradient};`}>Download MoneyBox</a>
    </section>
  </main>

  <script>
    import { init, destroy } from '../../animations/projects/moneybox'
    init()
    document.addEventListener('astro:before-swap', destroy)
    document.addEventListener('astro:page-load', init)
  </script>
</ProjectLayout>
