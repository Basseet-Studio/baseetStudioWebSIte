---
import ProjectLayout from '../../layouts/Project.astro'
import ProjectFAQ from '../../components/project/ProjectFAQ.astro'
import ProjectFeatureShowcase from '../../components/project/ProjectFeatureShowcase.astro'
import FeatureMedia from '../../components/project/FeatureMedia.astro'
import { getProject } from '../../lib/projects'
import { slugify } from '../../lib/slugify'
import linksData from '../../content/data/links.json'
import type { ProjectLinks } from '../../types'
import type { FeatureShowcaseItem } from '../../components/project/ProjectFeatureShowcase.astro'

const lang = 'en' as const
const slug = 'moneybox'
const project = getProject(slug)
if (!project) return Astro.redirect('/404')

const links: ProjectLinks = (linksData.projects.moneybox || project.links || {}) as ProjectLinks
const androidUrl = links.android && links.android !== '#' ? links.android : project.links?.android

const categories = ['Food', 'Transport', 'Bills', 'Shopping', 'Health', 'Entertainment', 'Savings', 'Other']

const bentoItems = [
  { title: 'Savings Goals', desc: 'Set targets and watch progress with motivating visual charts.', mediaLabel: 'Savings goals demo', wide: true },
  { title: 'Expense Tracking', desc: 'Log spending by category and spot patterns early.', mediaLabel: 'Expense logging demo', wide: false },
  { title: 'Clean Reports', desc: 'Monthly summaries designed for quick mobile check-ins.', mediaLabel: 'Reports demo', wide: false },
]

const savingsGoals = [
  { name: 'Emergency fund', progress: '68% saved — $3,400 of $5,000' },
  { name: 'Summer trip', progress: '42% saved — $840 of $2,000' },
  { name: 'New laptop', progress: '91% saved — $1,820 of $2,000' },
]

const moneyboxFeatureBullets: Record<string, string[]> = {
  'Smart Savings Goals': ['Visual progress charts', 'Multiple targets at once', 'Milestone celebrations'],
  'Expense Tracking': ['Category-based logging', 'Pattern spotting', 'Quick mobile entry'],
  'Budget Overview': ['Income vs. outgo at a glance', 'Monthly summaries', 'Readable on mobile'],
  'Clean Reporting': ['Trend views', 'Category breakdowns', 'Quick check-ins'],
  'Daily Reminders': ['Gentle expense nudges', 'Goal review prompts', 'Routine-friendly'],
  'Private by Design': ['On-device data', 'No ads', 'No data resale'],
}

const featureShowcase: FeatureShowcaseItem[] = (project.features || []).map((f) => ({
  title: f.title,
  description: f.description,
  icon: f.icon,
  bullets: moneyboxFeatureBullets[f.title],
  mediaLabel: `${f.title} demo`,
  mediaSlug: slugify(f.title),
  mediaVariant: 'mobile' as const,
}))
---

<ProjectLayout title={`${project.name} — Baseet Studio`} description={project.tagline} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>
<link rel="stylesheet" href="/src/styles/projects/moneybox.css" />

  <main class="moneybox-main" style="font-family: var(--font-body);">
    <section class="moneybox-hero">
      <div class="moneybox-hero__grid">
        <div>
          <p style={`font-size:0.9rem;font-weight:600;color:${project.color};margin:0 0 1rem;`}>{project.tagline}</p>
          <h1 class="moneybox-hero__title" style="font-family: var(--font-display);" data-animate="fade-up">{project.hero.title}</h1>
          <p class="moneybox-hero__subtitle" data-animate="fade-up">{project.hero.subtitle}</p>
          <div class="moneybox-hero__ctas" data-animate="fade-up">
            <a href="/projects/moneybox/download/" class="cta-btn--primary" style={`background:${project.gradient};`}>
              {project.hero.cta_primary}
            </a>
            <a href="#features" class="cta-btn--secondary" style={`border-color:color-mix(in srgb, ${project.color} 25%, transparent);`}>
              View Features
            </a>
          </div>
        </div>
        <div class="moneybox-hero__card" data-animate="fade-up">
          <div class="moneybox-hero__card-label">Emergency fund</div>
          <div class="moneybox-hero__card-value" style="font-family: var(--font-display);">$3,400</div>
          <div class="moneybox-hero__card-bar">
            <div class="moneybox-hero__card-bar-fill"></div>
          </div>
        </div>
      </div>
    </section>

    <div class="moneybox-marquee" data-moneybox-marquee aria-hidden="true">
      <div class="moneybox-marquee__track" data-moneybox-marquee-track>
        {[...categories, ...categories].map((cat) => (
          <span class="moneybox-marquee__item">{cat}</span>
        ))}
      </div>
    </div>

    <section class="moneybox-section">
      <div class="moneybox-section__inner">
        <h2 class="moneybox-section-title" style="font-family: var(--font-display);" data-animate="fade-up">Built for clarity</h2>
        <div class="moneybox-bento moneybox-bento--pillars">
          {bentoItems.map((item) => (
            <div class={`moneybox-bento__card${item.wide ? ' moneybox-bento__card--wide' : ''}`} data-animate="fade-up">
              <div class="moneybox-bento__thumb">
                <FeatureMedia label={item.mediaLabel} variant="mobile" compact />
              </div>
              <h3 style="font-family: var(--font-display);">{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="moneybox-section" data-moneybox-pin>
      <div class="moneybox-section__inner">
        <div class="moneybox-pin">
          <div class="moneybox-pin__title-wrap" data-moneybox-pin-title>
            <h2 class="moneybox-section-title" style="font-family: var(--font-display);text-align:left;margin-bottom:1rem;">Watch your savings grow</h2>
            <p style="color:var(--muted-text);line-height:1.7;margin:0;">Set goals, track progress, and stay motivated with visual charts.</p>
          </div>
          <div class="moneybox-pin__goals" data-moneybox-pin-content>
            {savingsGoals.map((goal) => (
              <div class="moneybox-pin__goal" data-animate="fade-up">
                <h4 style="font-family: var(--font-display);">{goal.name}</h4>
                <p>{goal.progress}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {featureShowcase.length > 0 && (
      <ProjectFeatureShowcase
        features={featureShowcase}
        projectSlug={project.slug}
        projectColor={project.color}
        projectGradient={project.gradient}
        id="features"
        heading="Everything you need to stay on track"
        lede="Six features that make daily money management feel simple — not like spreadsheet archaeology."
        fontHeading="Space Grotesk"
      />
    )}

    <section class="moneybox-section">
      <div class="moneybox-section__inner">
        <h2 class="moneybox-section-title" style="font-family: var(--font-display);">MoneyBox vs spreadsheets</h2>
        <div class="moneybox-compare">
          <div class="moneybox-compare__col">
            <h4 style="font-family: var(--font-display);">MoneyBox</h4>
            <ul>
              <li>Mobile-first daily logging</li>
              <li>Visual goal progress</li>
              <li>Category breakdowns</li>
              <li>Private on-device data</li>
            </ul>
          </div>
          <div class="moneybox-compare__col">
            <h4 style="font-family: var(--font-display);">Spreadsheets</h4>
            <ul>
              <li>Manual formula upkeep</li>
              <li>No mobile nudges</li>
              <li>End-of-month archaeology</li>
              <li>Easy to abandon</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {project.faq && project.faq.length > 0 && (
      <section class="moneybox-section" id="faq">
        <div class="moneybox-section__inner" style="max-width:40rem;">
          <h2 class="moneybox-section-title" style="font-family: var(--font-display);">FAQ</h2>
          <div style="display:flex;flex-direction:column;gap:0.75rem;">
            {project.faq.map((item) => (
              <ProjectFAQ question={item.question} answer={item.answer} projectColor={project.color} />
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="moneybox-section" style="text-align:center;">
      <a href={androidUrl || '/projects/moneybox/download/'} class="cta-btn--primary" style={`background:${project.gradient};`}>Download MoneyBox</a>
    </section>
  </main>

  <script>
    import { init, destroy } from '../../animations/projects/moneybox'
    init()
    document.addEventListener('astro:before-swap', destroy)
    document.addEventListener('astro:page-load', init)
  </script>
</ProjectLayout>
