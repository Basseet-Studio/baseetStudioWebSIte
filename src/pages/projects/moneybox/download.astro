---
import ProjectLayout from '../../../layouts/Project.astro'
import Icon from '../../../components/icons/Icon.astro'
import { getProject } from '../../../lib/projects'
import linksData from '../../../content/data/links.json'
import type { ProjectLinks } from '../../../types'

const slug = 'moneybox'
const project = getProject(slug)
if (!project) return Astro.redirect('/404')

const links: ProjectLinks = (linksData.projects.moneybox || project.links || {}) as ProjectLinks
const androidUrl = links.android && links.android !== '#' ? links.android : null
const iosUrl = links.ios && links.ios !== '#' ? links.ios : null

const platforms = [
  { name: 'Android', icon: 'android-logo', url: androidUrl, note: 'Available now' },
  { name: 'iOS', icon: 'apple-logo', url: iosUrl, note: 'Coming soon' },
]
---

<ProjectLayout
  title={`Download — ${project.name} — Baseet Studio`}
  description={`Download ${project.name} — ${project.tagline}`}
  slug={project.slug}
  projectColor={project.color}
  projectGradient={project.gradient}
  projectName={project.name}
  projectIconClass={project.iconClass}
  projectNavItems={project.navItems}
  projectNavMeta={project.navMetaItems}
  lang="en"
>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/src/styles/projects/moneybox.css" />

  <section class="moneybox-subhero">
    <h1 class="moneybox-subhero__title" style="font-family:'Outfit',sans-serif;" data-animate="fade-up">Download MoneyBox</h1>
    <p class="moneybox-subhero__lede" data-animate="fade-up">
      Get the Android build today. iOS is on the way.
    </p>
  </section>

  <div class="moneybox-download-grid">
    {platforms.map((p) => (
      <div class="moneybox-download-card" data-animate="fade-up">
        <Icon name={p.icon} size={40} color={project.color} />
        <h3 style="font-family:'Outfit',sans-serif;margin:1rem 0 0.25rem;">{p.name}</h3>
        <p style="font-size:0.9rem;color:var(--muted-text);margin:0;">{p.note}</p>
        {p.url ? (
          <a href={p.url} target="_blank" rel="noopener noreferrer">
            <Icon name="download" size={16} color="white" />
            Download
          </a>
        ) : (
          <span class="moneybox-download-card__soon">Coming Soon</span>
        )}
      </div>
    ))}
  </div>
</ProjectLayout>
