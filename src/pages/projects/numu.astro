---
import ProjectLayout from '../../layouts/Project.astro'
import ProjectGallery from '../../components/project/ProjectGallery.astro'
import ProjectFAQ from '../../components/project/ProjectFAQ.astro'
import Icon from '../../components/icons/Icon.astro'
import { getProject } from '../../lib/projects'
import linksData from '../../content/data/links.json'
import type { ProjectLinks } from '../../types'

const lang = 'en' as const
const slug = 'numu'
const project = getProject(slug)
if (!project) return Astro.redirect('/404')

const links: ProjectLinks = (linksData.projects.numu || {}) as ProjectLinks

const modules = [
  { title: 'Core Growth', desc: 'Habits, goals, tasks, reminders, and My Day unified view.', span: 'wide' },
  { title: 'Health', desc: 'Water, sleep, weight, and food logging.', span: '' },
  { title: 'Islamic', desc: 'Prayer, fasting, and nafila tracking.', span: '' },
  { title: 'Backup', desc: 'Full local backup and restore.', span: 'tall' },
  { title: 'Privacy', desc: 'No account, no cloud, no trackers. Your data stays on your device.', span: 'wide' },
]

const marqueeModules = ['Habits', 'Goals', 'Tasks', 'Reminders', 'My Day', 'Health', 'Islamic', 'Backup']

const stackCards = [
  { title: 'Morning habits', desc: '3 of 5 complete' },
  { title: 'Tasks due today', desc: '2 remaining' },
  { title: 'Prayer check-in', desc: 'On track' },
]
---

<ProjectLayout title={`${project.name} — Baseet Studio`} description={project.tagline} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700;800&family=Nunito:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/src/styles/projects/numu.css" />

  <main class="numu-main" style="font-family:'Nunito',sans-serif;">
    <section class="numu-hero">
      <div class="numu-hero__mesh" aria-hidden="true"></div>
      <div class="numu-hero__grid">
        <div class="numu-hero__copy">
          <p style={`font-size:0.9rem;font-weight:600;color:${project.color};margin:0 0 1rem;`}>{project.tagline}</p>
          <h1 class="numu-hero__title" style="font-family:'Quicksand',sans-serif;" data-animate="fade-up">
            Track habits, goals, and <span class="numu-hero__inline-pill" aria-hidden="true"></span> health — privately.
          </h1>
          <p class="numu-hero__subtitle" data-animate="fade-up">{project.hero.subtitle}</p>
          <div class="numu-hero__ctas" data-animate="fade-up">
            <a href="/projects/numu/download/" class="cta-btn--primary" style={`background:${project.gradient};`}>
              {project.hero.cta_primary}
            </a>
            <a href="/projects/numu/features/" class="cta-btn--secondary" style={`border-color:color-mix(in srgb, ${project.color} 30%, transparent);`}>
              {project.hero.cta_secondary}
            </a>
          </div>
        </div>
        <div class="numu-hero__visual" data-animate="fade-up">
          <div class="numu-hero__phone">My Day</div>
          <div class="numu-hero__streak">
            <div class="numu-hero__streak-value">90</div>
            <div class="numu-hero__streak-label">day streak</div>
          </div>
        </div>
      </div>
    </section>

    <div class="numu-marquee" data-numu-marquee aria-hidden="true">
      <div class="numu-marquee__track" data-numu-marquee-track>
        {[...marqueeModules, ...marqueeModules].map((m) => (
          <span class="numu-marquee__item">{m}</span>
        ))}
      </div>
    </div>

    <section class="numu-section">
      <div class="numu-section__inner">
        <h2 class="numu-section-title" style="font-family:'Quicksand',sans-serif;" data-animate="fade-up">
          Everything you need to grow
        </h2>
        <div class="numu-bento">
          {modules.map((mod) => (
            <div class={`numu-bento__card${mod.span ? ` numu-bento__card--${mod.span}` : ''}`} data-animate="fade-up">
              <h3>{mod.title}</h3>
              <p>{mod.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="numu-section">
      <div class="numu-section__inner numu-scrub">
        <p class="numu-scrub__text" style="font-family:'Quicksand',sans-serif;" data-numu-scrub>
          Your growth belongs to you. No account required. No cloud sync. No ads. No trackers. Just you and your data on your device.
        </p>
      </div>
    </section>

    <section class="numu-section">
      <div class="numu-section__inner">
        <h2 class="numu-section-title" style="font-family:'Quicksand',sans-serif;">My Day at a glance</h2>
        <div class="numu-stack" data-numu-stack>
          {stackCards.map((card, i) => (
            <div class="numu-stack__card" data-numu-stack-card style={`top:${i * 28}px;`}>
              <h4>{card.title}</h4>
              <p>{card.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {project.screenshots && project.screenshots.length > 0 && (
      <ProjectGallery screenshots={project.screenshots} galleryType={project.galleryType || 'mobile'} projectSlug={project.slug} projectColor={project.color} projectName={project.name} />
    )}

    {project.faq && project.faq.length > 0 && (
      <section class="numu-section" id="faq">
        <div class="numu-section__inner" style="max-width:40rem;">
          <h2 class="numu-section-title" style="font-family:'Quicksand',sans-serif;">FAQ</h2>
          <div style="display:flex;flex-direction:column;gap:0.75rem;">
            {project.faq.map((item) => (
              <ProjectFAQ question={item.question} answer={item.answer} projectColor={project.color} />
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="numu-section" style="text-align:center;">
      <a href="/projects/numu/download/" class="cta-btn--primary" style={`background:${project.gradient};`}>Download Numu</a>
    </section>
  </main>

  <script>
    import { init, destroy } from '../../animations/projects/numu'
    init()
    document.addEventListener('astro:before-swap', destroy)
    document.addEventListener('astro:page-load', init)
  </script>
</ProjectLayout>
