---
import '../../styles/projects/numu.css'
import ProjectLayout from '../../layouts/Project.astro'
import ProjectIdentity from '../../components/project/ProjectIdentity.astro'
import { screenshotSrc } from '../../lib/project-brand'
import { t } from '../../lib/i18n'
import ProjectGallery from '../../components/project/ProjectGallery.astro'
import ProjectFeatureShowcase from '../../components/project/ProjectFeatureShowcase.astro'
import ProjectFAQ from '../../components/project/ProjectFAQ.astro'
import FeatureMedia from '../../components/project/FeatureMedia.astro'
import { getProject } from '../../lib/projects'
import { slugify } from '../../lib/slugify'
import type { FeatureShowcaseItem } from '../../components/project/ProjectFeatureShowcase.astro'
import type { Lang } from '../../types'
import { studioFullName } from '../../lib/locale'
import { localizeHref } from '../../lib/localize-href'

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props
const slug = 'numu'
const project = getProject(slug, lang)
if (!project) return Astro.redirect(localizeHref(lang, '/404'))

const pillars = [
  { title: 'Core Growth', desc: 'Habits, goals, tasks, reminders, and My Day unified view.', mediaLabel: 'Habits & goals demo', span: 'wide' },
  { title: 'Health', desc: 'Water, sleep, weight, and food logging.', mediaLabel: 'Health module demo', span: '' },
  { title: 'Islamic', desc: 'Prayer, fasting, and nafila tracking.', mediaLabel: 'Islamic module demo', span: '' },
]

const heroShots = (project.screenshots || []).slice(0, 2).map((src) => screenshotSrc(project.slug, src))

const stackCards = [
  { title: 'Morning habits', desc: '3 of 5 complete' },
  { title: 'Tasks due today', desc: '2 remaining' },
  { title: 'Prayer check-in', desc: 'On track' },
]

const numuFeatureBullets: Record<string, string[]> = {
  'Core Growth Modules': ['Habit streaks and scoring', 'Goals linked to habits', 'My Day unified dashboard'],
  'Health Tracking': ['Water and sleep logging', 'Weight and food tracking', 'Workout tracking on roadmap'],
  'Islamic Practice': ['Prayer tracking with scoring', 'Fasting and nafila log', 'RTL-aware layouts'],
  'Local-First & Offline': ['No account required', 'Works fully offline', 'Export and restore anytime'],
  'No Subscriptions, No Ads, No Trackers': ['Free forever', 'No in-app purchases', 'No third-party trackers'],
  'Beautiful, RTL-Aware, Multi-Language': ['Arabic and English', 'Friendly onboarding', 'Built-in help'],
}

const featureShowcase: FeatureShowcaseItem[] = (project.features || []).map((f) => ({
  title: f.title,
  description: f.description,
  icon: f.icon,
  bullets: numuFeatureBullets[f.title],
  mediaLabel: `${f.title} demo`,
  mediaSlug: slugify(f.title),
  mediaVariant: 'mobile' as const,
}))
---

<ProjectLayout title={`${project.name} — ${studioFullName(lang)}`} description={project.tagline} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>

  <main class="numu-main" style="font-family: var(--font-body);">
    <section class="numu-hero">
      <div class="numu-hero__grid">
        <div class="numu-hero__copy">
          <ProjectIdentity slug={project.slug} name={project.name} tagline={project.tagline} status={project.status} lang={lang} headingLevel="p" />
          <h1 class="numu-hero__title" style="font-family: var(--font-display);" data-animate="fade-up">{project.hero.title}</h1>
          <p class="numu-hero__subtitle" data-animate="fade-up">{project.hero.subtitle}</p>
          <div class="numu-hero__ctas" data-animate="fade-up">
            <a href="/projects/numu/download/" class="cta-btn--primary" style={`background:var(--color-primary);`}>
              {project.hero.cta_primary}
            </a>
            <a href="#features" class="cta-btn--secondary" style={`border-color:color-mix(in srgb, ${project.color} 30%, transparent);`}>
              {project.hero.cta_secondary}
            </a>
          </div>
        </div>
        <div class="numu-hero__visual numu-hero__visual--screens" data-animate="fade-up">
          {heroShots.map((src, i) => (
            <img class="numu-hero__screen" src={src} alt={t('project_screenshot_alt', lang, { name: project.name, n: String(i + 1), total: String(project.screenshots?.length ?? heroShots.length) })} width="300" height="640" loading="eager" decoding="async" />
          ))}
        </div>
      </div>
    </section>

    <section class="numu-section">
      <div class="numu-section__inner">
        <h2 class="numu-section-title" style="font-family: var(--font-display);" data-animate="fade-up">
          Everything you need to grow
        </h2>
        <div class="numu-bento numu-bento--pillars">
          {pillars.map((mod) => (
            <div class={`numu-bento__card${mod.span ? ` numu-bento__card--${mod.span}` : ''}`} data-animate="fade-up">
              <div class="numu-bento__thumb">
                <FeatureMedia label={mod.mediaLabel} variant="mobile" compact />
              </div>
              <h3>{mod.title}</h3>
              <p>{mod.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="numu-section">
      <div class="numu-section__inner numu-scrub">
        <p class="numu-scrub__text" style="font-family: var(--font-display);" data-numu-scrub>
          Your growth belongs to you. No account required. No cloud sync. No ads. No trackers. Just you and your data on your device.
        </p>
      </div>
    </section>

    {featureShowcase.length > 0 && (
      <ProjectFeatureShowcase
        features={featureShowcase}
        projectSlug={project.slug}
        projectColor={project.color}
        projectGradient={project.gradient}
        id="features"
        heading="Features built for daily practice"
        lede="Six modules that work together — habits, health, faith, and privacy at the center."
        fontHeading="Space Grotesk"
      />
    )}

    <section class="numu-section">
      <div class="numu-section__inner">
        <h2 class="numu-section-title" style="font-family: var(--font-display);">My Day at a glance</h2>
        <div class="numu-stack" data-numu-stack>
          {stackCards.map((card, i) => (
            <div class="numu-stack__card" data-numu-stack-card style={`top:${i * 28}px;`}>
              <h4>{card.title}</h4>
              <p>{card.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {project.screenshots && project.screenshots.length > 0 && (
      <ProjectGallery screenshots={project.screenshots} galleryType={project.galleryType || 'mobile'} projectSlug={project.slug} projectColor={project.color} projectName={project.name} lang={lang} />
    )}

    {project.faq && project.faq.length > 0 && (
      <section class="numu-section" id="faq">
        <div class="numu-section__inner" style="max-width:40rem;">
          <h2 class="numu-section-title" style="font-family: var(--font-display);">FAQ</h2>
          <div style="display:flex;flex-direction:column;gap:0.75rem;">
            {project.faq.map((item) => (
              <ProjectFAQ question={item.question} answer={item.answer} projectColor={project.color} />
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="numu-section" style="text-align:center;">
      <a href="/projects/numu/download/" class="cta-btn--primary" style={`background:var(--color-primary);`}>Download Numu</a>
    </section>
  </main>

  <script>
    import { init, destroy } from '../../animations/projects/numu'
    init()
    document.addEventListener('astro:before-swap', destroy)
    document.addEventListener('astro:page-load', init)
  </script>
</ProjectLayout>
