---
import ProjectLayout from '../../layouts/Project.astro'
import ProjectGallery from '../../components/project/ProjectGallery.astro'
import ProjectCTA from '../../components/project/ProjectCTA.astro'
import ProjectFeatureCard from '../../components/project/ProjectFeatureCard.astro'
import ProjectTestimonial from '../../components/project/ProjectTestimonial.astro'
import ProjectFAQ from '../../components/project/ProjectFAQ.astro'
import Icon from '../../components/icons/Icon.astro'
import { resolveIcon } from '../../components/icons/iconMappings'
import { getProject } from '../../lib/projects'
import type { Project } from '../../types'


const lang: 'en' = 'en'
const slug = 'zaryn'
const project = getProject(slug)
if (!project) {
  return Astro.redirect('/404')
}
---

<ProjectLayout title={`${project.name} — Baseet Studio`} description={project.tagline} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/src/styles/projects/zaryn.css" />

  <!-- Split-Screen Hero with Dashboard Mockup
       The coloured background wash now lives in shared.css
       (`.project-hero-wash`) so it is theme-aware and fades out gradually
       as the user scrolls, instead of cutting off sharply at the bottom
       of the hero. The hero itself is transparent so the wash shows
       through. -->
  <section class="project-hero relative min-h-[85vh] flex items-center overflow-hidden">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16" style="max-width:1200px;margin:0 auto;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;">
        <!-- Left: Content -->
        <div style="text-align:left;">
          <div style="display:flex;align-items:center;gap:20px;margin-bottom:32px;" data-animate="fade-up">
            <div style={`width:80px;height:80px;border-radius:20px;background:${project.gradient};display:flex;align-items:center;justify-content:center;box-shadow:0 10px 40px -10px color-mix(in srgb, ${project.color} 31%, transparent);`}>
              <Icon name={resolveIcon(project.iconClass).name} size={36} color="white" />
            </div>
            <div>
              <h1 style="font-size:2.8rem;font-weight:800;color:var(--heading-text);font-family:'Space Grotesk',sans-serif;line-height:1.1;">{project.name}</h1>
              <p style={`font-size:1.3rem;font-weight:600;color:${project.color};margin-top:4px;`}>{project.tagline}</p>
            </div>
          </div>

          <!-- Status Badge -->
          <div style="margin-bottom:24px;" data-animate="fade-up">
            <span style={`display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);`}>
              <Icon name="check-circle" size={16} color={project.color} />
              {project.status}
            </span>
          </div>

          <h2 style="font-size:2rem;font-weight:700;color:var(--heading-text);margin-bottom:20px;line-height:1.3;" data-animate="fade-up">
            {project.hero.title}
          </h2>
          <p style="font-size:1.15rem;color:var(--muted-text);margin-bottom:32px;max-width:500px;line-height:1.7;" data-animate="fade-up">
            {project.hero.subtitle}
          </p>

          <div style="display:flex;gap:16px;flex-wrap:wrap;" data-animate="fade-up">
            {project.hero.cta_primary && (
              <a href={project.hero.cta_primary_link || '/contact/'} class="cta-btn"
                style={`display:inline-flex;align-items:center;gap:8px;padding:16px 32px;border-radius:50px;font-weight:600;text-decoration:none;background:${project.gradient};color:white;transition:transform 0.2s,box-shadow 0.2s;font-size:1.05rem;`}>
                {project.hero.cta_primary}
              </a>
            )}
            {project.hero.cta_secondary && (
              <a href={project.hero.cta_secondary_link || '#features'} class="cta-btn"
                style={`display:inline-flex;align-items:center;gap:8px;padding:16px 32px;border-radius:50px;font-weight:600;text-decoration:none;border:2px solid ${project.color}30;color:var(--heading-text);transition:transform 0.2s;font-size:1.05rem;`}>
                {project.hero.cta_secondary}
              </a>
            )}
          </div>
        </div>

        <!-- Right: Dashboard Mockup -->
        <div style="display:none;position:relative;" class="lg:block" data-animate="fade-up">
          <div style="background:white;border-radius:24px;overflow:hidden;box-shadow:0 20px 60px color-mix(in srgb, #F97316 20%, transparent);border:1px solid #FED7AA;">
            <div style={`display:flex;align-items:center;gap:8px;padding:12px 16px;background:${project.gradient};`}>
              <div style="width:10px;height:10px;border-radius:50%;background:white/40;"></div>
              <div style="width:10px;height:10px;border-radius:50%;background:white/40;"></div>
              <div style="width:10px;height:10px;border-radius:50%;background:white/40;"></div>
              <span style="color:white/80;font-size:0.8rem;margin-left:12px;font-weight:500;">{/* TODO: localise this later */ 'BaseetIMS Dashboard'}</span>
            </div>
            <div style="padding:20px;display:flex;flex-direction:column;gap:16px;">
              <!-- POS Terminal -->
              <div style={`background:linear-gradient(135deg, #FFF7ED, #FFEDD5);border-radius:16px;padding:20px;border:1px solid #FED7AA;`}>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                  <div style="display:flex;align-items:center;gap:8px;">
                    <Icon name="cash-register" size={20} color={project.color} />
                    <span style="font-weight:700;color:#1C1917;font-size:0.9rem;">{/* TODO: localise this later */ 'POS Terminal'}</span>
                  </div>
                  <span style="font-size:0.75rem;color:#A8A29E;">{/* TODO: localise this later */ 'Active'}</span>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">
                  <div style="background:white;border-radius:12px;padding:12px;text-align:center;border:1px solid #FED7AA;">
                    <Icon name="barcode" size={18} color={project.color} />
                    <div style="font-size:0.7rem;color:#57534E;margin-top:4px;">{/* TODO: localise this later */ 'Scan'}</div>
                  </div>
                  <div style="background:white;border-radius:12px;padding:12px;text-align:center;border:1px solid #FED7AA;">
                    <Icon name="credit-card" size={18} color={project.color} />
                    <div style="font-size:0.7rem;color:#57534E;margin-top:4px;">{/* TODO: localise this later */ 'Payment'}</div>
                  </div>
                  <div style="background:white;border-radius:12px;padding:12px;text-align:center;border:1px solid #FED7AA;">
                    <Icon name="printer" size={18} color={project.color} />
                    <div style="font-size:0.7rem;color:#57534E;margin-top:4px;">{/* TODO: localise this later */ 'Receipt'}</div>
                  </div>
                </div>
              </div>
              <!-- Quick Stats -->
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div style="background:white;border-radius:16px;padding:16px;border:1px solid #E7E5E4;">
                  <div style="font-size:1.5rem;font-weight:700;color:#1C1917;">$12,450</div>
                  <div style="font-size:0.75rem;color:#A8A29E;">{/* TODO: localise this later */ "Today's Sales"}</div>
                </div>
                <div style="background:white;border-radius:16px;padding:16px;border:1px solid #E7E5E4;">
                  <div style="font-size:1.5rem;font-weight:700;color:#1C1917;">847</div>
                  <div style="font-size:0.75rem;color:#A8A29E;">{/* TODO: localise this later */ 'Items in Stock'}</div>
                </div>
              </div>
              <!-- Mini Chart -->
              <div style="background:white;border-radius:16px;padding:16px;border:1px solid #E7E5E4;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                  <span style="font-weight:600;color:#1C1917;font-size:0.85rem;">{/* TODO: localise this later */ 'Weekly Revenue'}</span>
                  <span style="color:#10B981;font-size:0.75rem;font-weight:500;">+23.5%</span>
                </div>
                <div style="display:flex;align-items:flex-end;gap:4px;height:48px;">
                  {[40, 55, 45, 70, 60, 85, 100].map((h, i) => (
                    <div style={`flex:1;border-radius:4px 4px 0 0;height:${h}%;${i >= 5 ? `background:${project.color};` : 'background:#FED7AA;'}`}></div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento Grid Features -->
  {project.features && project.features.length > 0 && (
    <section id="features" style="padding:80px 24px;background:linear-gradient(to bottom, #FFFBF7, white);">
      <div style="max-width:1200px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:64px;" data-animate="fade-up">
          <span style={`display:inline-block;padding:8px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);margin-bottom:16px;`}>
            {/* TODO: localise this later */ 'Features'}
          </span>
          <h2 style="font-size:2.2rem;font-weight:700;color:#1C1917;font-family:'Space Grotesk',sans-serif;">
            {/* TODO: localise this later */ 'Key Features'}
          </h2>
        </div>

        <div class="bento-grid">
          {project.features.map((feature, i) => (
            <div class={`bento-card ${i === 0 ? 'bento-large' : ''}`} data-animate="fade-up" style={i > 0 ? `animation-delay:${i * 0.05}s;` : ''}>
              <div style={`width:48px;height:48px;border-radius:14px;background:${project.gradient};display:flex;align-items:center;justify-content:center;margin-bottom:16px;`}>
                <Icon name={resolveIcon(feature.icon).name} size={22} color="white" />
              </div>
              <h3 style="font-size:1.15rem;font-weight:700;color:#1C1917;margin-bottom:8px;">{feature.title}</h3>
              <p style="font-size:0.9rem;color:#57534E;line-height:1.6;">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {project.screenshots && project.screenshots.length > 0 && (
    <ProjectGallery screenshots={project.screenshots} galleryType={project.galleryType || 'mobile'} projectSlug={project.slug} projectColor={project.color} projectName={project.name} />
  )}

  <!-- Tech Stack -->
  {project.tech && project.tech.length > 0 && (
    <section style="padding:64px 24px;background:white;">
      <div style="max-width:1200px;margin:0 auto;text-align:center;">
        <h2 style="font-size:2rem;font-weight:700;color:#1C1917;margin-bottom:12px;font-family:'Space Grotesk',sans-serif;">
          {/* TODO: localise this later */ 'Built With'}
        </h2>
        <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:12px;max-width:700px;margin:32px auto 0;">
          {project.tech.map(tech => (
            <span style={`padding:10px 20px;border-radius:9999px;background:var(--chip-bg);border:1px solid var(--chip-border);color:var(--chip-text);font-weight:500;font-size:0.85rem;transition:all 0.2s;`}
              class="hover:border-project/30 hover:text-project">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </section>
  )}

  {project.testimonials && project.testimonials.length > 0 && (
    <section style="padding:64px 24px;max-width:1200px;margin:0 auto;" data-animate="fade-up">
      <h2 style="text-align:center;font-size:2rem;margin-bottom:48px;color:var(--heading-text);font-family:'Space Grotesk',sans-serif;">
        {/* TODO: localise this later */ 'What People Say'}
      </h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(340px, 1fr));gap:24px;">
        {project.testimonials.map(t => (
          <ProjectTestimonial quote={t.quote} author={t.author} role={t.role} projectColor={project.color} projectGradient={project.gradient} />
        ))}
      </div>
    </section>
  )}

  {project.faq && project.faq.length > 0 && (
    <section style="padding:64px 24px;max-width:800px;margin:0 auto;" data-animate="fade-up">
      <h2 style="text-align:center;font-size:2rem;margin-bottom:48px;color:var(--heading-text);font-family:'Space Grotesk',sans-serif;">
        {/* TODO: localise this later */ 'FAQ'}
      </h2>
      <div style="display:flex;flex-direction:column;gap:12px;">
        {project.faq.map(item => (
          <ProjectFAQ question={item.question} answer={item.answer} projectColor={project.color} />
        ))}
      </div>
    </section>
  )}

  <!-- Gradient CTA -->
  <section style="padding:80px 24px;">
    <div style="max-width:1000px;margin:0 auto;position:relative;border-radius:32px;overflow:hidden;padding:64px 48px;text-align:center;color:white;" style={`background:${project.gradient};`}>
      <div style="position:absolute;inset:0;background:rgba(0,0,0,0.1);"></div>
      <div style={`position:absolute;top:-80px;right:-80px;width:300px;height:300px;background:white;opacity:0.1;border-radius:50%;filter:blur(60px);`}></div>
      <div style={`position:absolute;bottom:-60px;left:-60px;width:200px;height:200px;background:white;opacity:0.1;border-radius:50%;filter:blur(40px);`}></div>
      <div style="position:relative;z-index:1;">
        <h2 style="font-size:2.5rem;font-weight:700;margin-bottom:16px;font-family:'Space Grotesk',sans-serif;">
          {/* TODO: localise this later */ `Interested in ${project.name}?`}
        </h2>
        <p style="font-size:1.2rem;opacity:0.9;margin-bottom:32px;max-width:600px;margin-left:auto;margin-right:auto;">
          {/* TODO: localise this later */ 'Get in touch and we will help you get started.'}
        </p>
        <a href={'/contact/'}
          style="display:inline-flex;align-items:center;gap:8px;background:white;color:${project.color};padding:16px 32px;border-radius:50px;font-weight:700;text-decoration:none;font-size:1.05rem;transition:transform 0.2s;"
          onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
          {/* TODO: localise this later */ 'Get in Touch'}
        </a>
      </div>
    </div>
  </section>

  <ProjectCTA status={project.status} platforms={project.platforms || []} links={project.links} lang={lang} />
</ProjectLayout>
