---
import '../../styles/projects/zyrn.css'
import ProjectLayout from '../../layouts/Project.astro'
import ProjectCTA from '../../components/project/ProjectCTA.astro'
import ProjectFeatureCard from '../../components/project/ProjectFeatureCard.astro'
import ProjectFAQ from '../../components/project/ProjectFAQ.astro'
import GradientCTA from '../../components/project/GradientCTA.astro'
import ProjectClients from '../../components/project/ProjectClients.astro'
import Icon from '../../components/icons/Icon.astro'
import { resolveIcon } from '../../components/icons/iconMappings'
import { getProject } from '../../lib/projects'
import { getClientsForProject } from '../../lib/clients'
import type { Lang } from '../../types'
import { studioFullName } from '../../lib/locale'
import { localizeHref } from '../../lib/localize-href'

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props
const slug = 'zyrn'
const project = getProject(slug, lang)
if (!project) return Astro.redirect(localizeHref(lang, '/404'))
const linkedClients = getClientsForProject(slug, lang)

const sellModes = [
  { label: 'Physical products', value: 'Catalog' },
  { label: 'Digital downloads', value: 'Instant' },
  { label: 'Subscriptions', value: 'Recurring' },
  { label: 'Bookings', value: 'Calendar' },
  { label: 'Customer updates', value: 'On the spot' },
]

const dayToDay = [
  {
    title: 'Morning',
    description: 'Open the dashboard. See overnight orders. Check low stock. Approve shipments. Customers already got their confirmations.',
  },
  {
    title: 'Midday',
    description: 'Launch a coupon for a flash offer. Update a product photo. Share socially. Watch cart activity.',
  },
  {
    title: 'Evening',
    description: 'Review bestsellers. Plan tomorrow’s restock. Reply only to exceptions — not every “did you get my order?”',
  },
  {
    title: 'End of month',
    description: 'View sales stats. See what promotions worked. Decide what to double down on. No shoebox of receipts.',
  },
]

const capabilities = [
  {
    title: 'Replace the paper trail',
    description: 'Orders stop living in WhatsApp and Instagram DMs. Stock stops living in notebooks. One catalog, one checkout, one order home.',
  },
  {
    title: 'Stay with the customer',
    description: 'Status updates go out the moment something changes — payment, shipment, delivery, return. No “let me check.”',
  },
  {
    title: 'See the truth in numbers',
    description: 'Sales, bestsellers, carts, promotions, inventory — live reporting so you stop guessing and start deciding.',
  },
  {
    title: 'Automate the busywork',
    description: 'Order emails, admin alerts, promotion rules, stock signals, and add-ons like cart recovery or WhatsApp status.',
  },
  {
    title: 'Own the relationship',
    description: 'Customer accounts, invoices, returns, and policies live with your brand — Instagram does not own your buyers.',
  },
  {
    title: 'Grow into more models',
    description: 'Start with a store. Add digital delivery, subscriptions, bookings, social commerce, and AI content as you scale.',
  },
]

const packages = [
  {
    name: 'Starter',
    audience: 'New entrepreneurs validating an idea',
    points: ['Branded storefront', 'Catalog + checkout', 'Order management', 'Basic notifications'],
  },
  {
    name: 'Growth',
    audience: 'Active sellers who need marketing control',
    points: ['Coupons & catalog rules', 'Deeper reporting', 'Returns / RMA', 'Staff roles'],
  },
  {
    name: 'Subscription Studio',
    audience: 'Boxes, memberships, recurring offers',
    points: ['Recurring product flows', 'Renewal messaging', 'Subscriber segments', 'Recurring revenue views'],
  },
  {
    name: 'Commerce Pro',
    audience: 'Brands that want the complete system',
    points: ['Digital + bookings', 'Advanced automations', 'Social commerce', 'Priority care'],
  },
]
---

<ProjectLayout title={`${project.name} — ${studioFullName(lang)}`} description={project.tagline} slug={project.slug} projectColor={project.color} projectGradient={project.gradient} projectName={project.name} projectIconClass={project.iconClass} projectNavItems={project.navItems} projectNavMeta={project.navMetaItems} lang={lang}>

  <section class="project-hero project-hero--centered">
    <div style={`position:absolute;top:-20%;left:50%;transform:translateX(-50%);width:600px;height:600px;border-radius:50%;background:radial-gradient(circle, color-mix(in srgb, ${project.color} 18%, transparent) 0%, transparent 70%);filter:blur(60px);pointer-events:none;`}></div>

    <div style="max-width:800px;margin:0 auto;position:relative;z-index:1;">
      <div style="display:flex;justify-content:center;margin-bottom:28px;" data-animate="fade-up">
        <div style={`width:96px;height:96px;border-radius:24px;background:${project.gradient};display:flex;align-items:center;justify-content:center;box-shadow:0 12px 40px -10px color-mix(in srgb, ${project.color} 35%, transparent);`}>
          <Icon name={resolveIcon(project.iconClass).name} size={40} color="white" />
        </div>
      </div>

      <h1 style="font-size:3.2rem;font-weight:700;color:var(--heading-text);margin-bottom:8px;letter-spacing:-0.02em;" data-animate="fade-up">
        {project.name}
      </h1>
      <p style={`font-size:1.3rem;font-weight:500;color:${project.color};margin-bottom:24px;`} data-animate="fade-up">
        {project.tagline}
      </p>

      <div style="margin-bottom:28px;" data-animate="fade-up">
        <span style={`display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 25%, transparent);`}>
          <Icon name="check-circle" size={16} color={project.color} />
          {project.status}
        </span>
      </div>

      <h2 style="font-size:2rem;font-weight:700;color:var(--heading-text);margin-bottom:20px;line-height:1.3;" data-animate="fade-up">
        {project.hero.title}
      </h2>
      <p style="font-size:1.1rem;color:var(--muted-text);margin-bottom:36px;max-width:580px;margin-left:auto;margin-right:auto;line-height:1.7;" data-animate="fade-up">
        {project.hero.subtitle}
      </p>

      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;" data-animate="fade-up">
        {project.hero.cta_primary && (
          <a href={project.hero.cta_primary_link || '/contact/'}
            class="cta-btn--primary"
            style={`background:${project.gradient};`}>
            {project.hero.cta_primary}
          </a>
        )}
        {project.hero.cta_secondary && (
          <a href={project.hero.cta_secondary_link || '#features'}
            class="cta-btn--secondary"
            style={`border-color:color-mix(in srgb, ${project.color} 25%, transparent);`}>
            {project.hero.cta_secondary}
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="zyrn-promise" data-animate="fade-up">
    <p class="zyrn-promise__line">No paper trail. No guessing.</p>
    <p class="zyrn-promise__sub">Keep up with every customer — notified on the spot.</p>
  </section>

  {project.features && project.features.length > 0 && (
    <section id="features" style="padding:64px 24px;max-width:1200px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:48px;" data-animate="fade-up">
        <span style={`display:inline-block;padding:8px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);margin-bottom:16px;`}>
          Core Capabilities
        </span>
        <h2 style="font-size:2rem;margin-bottom:12px;color:var(--heading-text);">
          One store. Clear numbers. Automations that work.
        </h2>
        <p style="font-size:1.05rem;color:var(--muted-text);max-width:560px;margin:0 auto;line-height:1.65;">
          Zyrn is not “just a website.” It is the operating system for your sales.
        </p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:24px;">
        {project.features.map((feature, i) => (
          <ProjectFeatureCard title={feature.title} description={feature.description} iconName={resolveIcon(feature.icon).name} projectColor={project.color} projectGradient={project.gradient} index={i} />
        ))}
      </div>
    </section>
  )}

  <section style="padding:64px 24px;max-width:1100px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;" data-animate="fade-up">
      <span style={`display:inline-block;padding:8px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);margin-bottom:16px;`}>
        What You Can Sell
      </span>
      <h2 style="font-size:2rem;margin-bottom:0;color:var(--heading-text);">
        Sell what you actually sell
      </h2>
    </div>
    <div class="zyrn-metrics">
      {sellModes.map((m) => (
        <div class="zyrn-metrics__tile card-window" data-animate="fade-up">
          <span class="zyrn-metrics__val">{m.value}</span>
          <span class="zyrn-metrics__lbl">{m.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section style="padding:64px 24px;max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;" data-animate="fade-up">
      <span style={`display:inline-block;padding:8px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);margin-bottom:16px;`}>
        The Zyrn Way
      </span>
      <h2 style="font-size:2rem;margin-bottom:0;color:var(--heading-text);">
        From chat chaos to a real business system
      </h2>
    </div>
    <div class="zyrn-tools">
      {capabilities.map((tool) => (
        <div class="zyrn-tools__item" data-animate="fade-up">
          <h3>{tool.title}</h3>
          <p>{tool.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section style="padding:64px 24px;max-width:1100px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;" data-animate="fade-up">
      <span style={`display:inline-block;padding:8px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);margin-bottom:16px;`}>
        Day to Day
      </span>
      <h2 style="font-size:2rem;margin-bottom:12px;color:var(--heading-text);">
        What Zyrn helps you do
      </h2>
      <p style="font-size:1.05rem;color:var(--muted-text);max-width:560px;margin:0 auto;line-height:1.65;">
        Control in the morning. Growth at midday. Clarity at month end.
      </p>
    </div>
    <div class="zyrn-day">
      {dayToDay.map((item) => (
        <div class="zyrn-day__item" data-animate="fade-up">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section style="padding:64px 24px;max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;" data-animate="fade-up">
      <span style={`display:inline-block;padding:8px 16px;border-radius:9999px;font-size:0.85rem;font-weight:600;background:color-mix(in srgb, ${project.color} 8%, transparent);color:${project.color};border:1px solid color-mix(in srgb, ${project.color} 20%, transparent);margin-bottom:16px;`}>
        Packages
      </span>
      <h2 style="font-size:2rem;margin-bottom:12px;color:var(--heading-text);">
        Start simple. Grow into a full commerce brand.
      </h2>
      <p style="font-size:1.05rem;color:var(--muted-text);max-width:560px;margin:0 auto;line-height:1.65;">
        Sell one package. The client gets a business system — not a brochure site.
      </p>
    </div>
    <div class="zyrn-packages">
      {packages.map((pkg) => (
        <div class="zyrn-packages__card" data-animate="fade-up">
          <h3>{pkg.name}</h3>
          <p class="zyrn-packages__audience">{pkg.audience}</p>
          <ul>
            {pkg.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {project.faq && project.faq.length > 0 && (
    <section style="padding:64px 24px;max-width:800px;margin:0 auto;">
      <h2 style="text-align:center;font-size:2rem;margin-bottom:48px;color:var(--heading-text);">
        FAQ
      </h2>
      <div style="display:flex;flex-direction:column;gap:12px;">
        {project.faq.map(item => (
          <ProjectFAQ question={item.question} answer={item.answer} projectColor={project.color} />
        ))}
      </div>
    </section>
  )}

  <ProjectClients clients={linkedClients} projectColor={project.color} />

  <GradientCTA
    title={`Interested in ${project.name}?`}
    body="Get a branded store that sells, notifies, measures, and grows — no paper trail, no guessing."
    ctaLabel="Get in Touch"
    ctaHref="/contact/"
    gradient={project.gradient}
    accentColor={project.color}
    lang={lang}
  />

  <ProjectCTA status={project.status} platforms={project.platforms || []} links={project.links} lang={lang} />
</ProjectLayout>

<script>
  import { init, destroy } from '../../animations/projects/zyrn'

  init()
  document.addEventListener('astro:before-swap', destroy, { once: true })
</script>
