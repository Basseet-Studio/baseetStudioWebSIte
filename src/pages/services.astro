---
// /services — index page. Renders one large card per service category with
// the same themeing (gradient bar, icon, sub-services) as the project cards.
// Each card now links to /services/<slug>/ for the dedicated detail page.
//
// The sub-service list on each card is sourced from the per-slug detail files
// (services/<slug>.json) via getAllServices() — not from the lightweight
// services.json index. The lightweight index intentionally omits sub-services
// to keep the JSONL small; the cards pull what they need at build time.
import Page from '../layouts/Page.astro'
import Icon from '../components/icons/Icon.astro'
import { resolveIcon } from '../components/icons/iconMappings'
import { getAllServices, getServicesIndex } from '../lib/services'
import servicesIndex from '../content/data/services.json'
import type { Lang } from '../types'

const lang: 'en' = 'en'
const description = 'Explore Baseet Studio services — web development, mobile apps, internal tools, SEO, UI/UX design, and cloud & DevOps for ambitious UAE brands.'

// Build a slug → subService[] map at build time so the card loop can stay
// cheap. Cap to 3 sub-services per card so each card stays a glance, not a list.
// The list is sourced from the per-slug detail files (services/<slug>.json) —
// the lightweight services.json index intentionally omits sub-services to stay
// small; the cards pull what they need at build time.
const subsBySlug: Record<string, Array<{ name: string; icon: string }>> = {}
for (const detail of getAllServices()) {
  subsBySlug[detail.slug] = (detail.subServices ?? []).slice(0, 3).map((s) => ({
    name: s.name,
    icon: s.icon,
  }))
}

// The index page reads categories from getServicesIndex() (the lib) and the
// static page chrome (title, subtitle, process, cta) from services.json.
const servicesData = {
  ...servicesIndex,
  categories: getServicesIndex(),
}
---

<Page title="Services — Baseet Studio" description={description} section="services" lang={lang}>
  <section class="mb-16" data-animate="fade-up">
    <h1 class="text-4xl font-bold mb-4" style="color:var(--heading-text);">
      {/* TODO: localise this later */}
      {servicesData.title}
    </h1>
    <p class="text-lg opacity-70 max-w-2xl" style="color:var(--muted-text);">
      {/* TODO: localise this later */}
      {servicesData.subtitle}
    </p>
    <p class="text-base opacity-60 max-w-3xl mt-2" style="color:var(--muted-text);">
      {/* TODO: localise this later */}
      {servicesData.description}
    </p>
  </section>

  <div class="services-grid">
    {servicesData.categories?.map((category: any) => {
      const cat = resolveIcon(category.icon || 'fas fa-circle')
      return (
        <a
          id={category.id}
          href={`/services/${category.slug}/`}
          class="service-card card-window"
          data-animate="fade-up"
          style={`--card-accent:${category.color};`}
        >
          <div class="service-card__bar" style={`background:${category.gradient};`}></div>
          <div class="service-card__body">
            <div class="service-card__icon" style={`background:color-mix(in srgb, ${category.color} 12%, transparent);color:${category.color};`}>
              <Icon name={cat.name} variant={cat.variant} size={26} color="currentColor" />
            </div>
            <h2 class="service-card__title">{category.title}</h2>
            {category.tagline && <p class="service-card__tagline">{category.tagline}</p>}
            <p class="service-card__short">{category.shortDescription}</p>
            <ul class="service-card__list">
              {(subsBySlug[category.slug] ?? []).map((sub) => {
                const subIcon = resolveIcon(sub.icon || 'fas fa-circle')
                return (
                  <li class="service-card__list-item">
                    <span class="service-card__list-icon" style={`color:${category.color};`}>
                      <Icon name={subIcon.name} variant={subIcon.variant} size={14} color="currentColor" />
                    </span>
                    <span>{sub.name}</span>
                  </li>
                )
              })}
            </ul>
            <span class="service-card__cta" style={`color:${category.color};`}>
              Explore service
              <Icon name="arrow-right" size={14} color="currentColor" />
            </span>
          </div>
        </a>
      )
    })}
  </div>

  {servicesData.process?.steps?.length > 0 && (
    <section class="mt-20" id="process" data-animate="fade-up">
      <h2 class="text-3xl font-bold mb-2 text-center" style="color:var(--heading-text);">
        {/* TODO: localise this later */}
        {servicesData.process.title}
      </h2>
      <p class="text-center opacity-70 mb-10" style="color:var(--muted-text);">
        {/* TODO: localise this later */}
        {servicesData.process.subtitle}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicesData.process.steps.map((step: any) => {
          const stepIcon = resolveIcon(step.icon || 'fas fa-circle')
          return (
            <div class="card-window card-window--tight p-6 text-center" data-animate="fade-up">
              <div
                class="w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-sm font-bold"
                style="background: var(--color-primary); color: white;"
              >
                {step.number}
              </div>
              <div class="mb-3 flex justify-center" style="color: var(--color-primary);">
                <Icon name={stepIcon.name} variant={stepIcon.variant} size={20} color="currentColor" />
              </div>
              <h3 class="font-semibold mb-2" style="color:var(--heading-text);">{step.title}</h3>
              <p class="text-sm opacity-60" style="color:var(--muted-text);">{step.desc}</p>
            </div>
          )
        })}
      </div>
    </section>
  )}

  {servicesData.cta && (
    <div class="text-center mt-16 card-window p-12" data-animate="fade-in">
      <h3 class="text-2xl font-bold mb-2" style="color:var(--heading-text);">{servicesData.cta.title}</h3>
      {servicesData.cta.subtitle && (
        <p class="text-lg opacity-80 mb-2" style="color:var(--muted-text);">{servicesData.cta.subtitle}</p>
      )}
      {servicesData.cta.description && (
        <p class="opacity-70 mb-6 max-w-2xl mx-auto" style="color:var(--muted-text);">{servicesData.cta.description}</p>
      )}
      <a
        href="/contact/"
        class="inline-block px-8 py-3 rounded-full font-semibold transition-all duration-300 hover:scale-105"
        style="background: var(--color-primary); color: white;"
      >
        {servicesData.cta.button}
      </a>
    </div>
  )}
</Page>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 24px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
    border-color: color-mix(in srgb, var(--card-accent, var(--color-primary)) 35%, transparent);
  }

  .service-card__bar {
    height: 4px;
    width: 100%;
  }

  .service-card__body {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .service-card__icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .service-card__title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--heading-text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .service-card__tagline {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--card-accent, var(--color-primary));
    margin: 0;
  }

  .service-card__short {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--muted-text);
    margin: 0;
  }

  .service-card__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .service-card__list-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--text-primary);
  }

  .service-card__list-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .service-card__cta {
    margin-top: auto;
    padding-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: transform 0.2s ease;
  }

  .service-card:hover .service-card__cta {
    transform: translateX(4px);
  }

  @media (max-width: 480px) {
    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-card__body {
      padding: 22px;
    }
  }
</style>
