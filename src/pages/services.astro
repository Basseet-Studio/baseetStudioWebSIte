---
// /services — index page.
//
// Bento grid (offset, no identical cards) + process timeline + ready CTA.
// See ServicesBento.astro for the grid + process + CTA components.
// Per-service sub-service copy still comes from the per-slug detail files
// so the data layer stays the same as before.
import Page from '../layouts/Page.astro'
import { getAllServices, getServicesIndex } from '../lib/services'
import servicesIndex from '../content/data/services.json'
import ServicesBento from '../components/shared/ServicesBento.astro'
import type { Lang } from '../types'

const lang: 'en' = 'en'
const description =
  'Explore Baseet Studio services — web development, mobile apps, internal tools, SEO, UI/UX design, and cloud & DevOps for ambitious UAE brands.'

// Same build-time data flow: sub-services come from the per-slug detail
// files (services/<slug>.json), capped to 3 per card so the card stays a
// glance, not a list.
const subsBySlug: Record<string, Array<{ name: string; icon: string }>> = {}
for (const detail of getAllServices()) {
  subsBySlug[detail.slug] = (detail.subServices ?? []).slice(0, 3).map((s) => ({
    name: s.name,
    icon: s.icon,
  }))
}

const servicesData = {
  ...servicesIndex,
  categories: getServicesIndex().map((c: any) => ({
    ...c,
    subServices: subsBySlug[c.slug] ?? [],
  })),
}
---

<Page title="Services — Baseet Studio" description={description} section="services" lang={lang}>
  {/* Hero — editorial shape. Eyebrow + big headline + lead + meta line that
      carries real proof (3-year average partnership, the studio's actual
      retention signal). No "we deliver excellence" copy. */}
  <section class="services-hero" data-animate="fade-up">
    <h1 class="services-hero__title">
      Six capabilities.<br/>
      <span class="services-hero__title-accent">One studio, end to end.</span>
    </h1>
    <p class="services-hero__lead">
      {/* TODO: localise this later */}
      We don't hand you off between specialists. Web, mobile, internal tools, design, SEO, and cloud — the same small team owns the work from the first sketch to the launch deploy.
    </p>

    <dl class="services-hero__meta">
      <div class="services-hero__meta-item">
        <dt>Average partnership</dt>
        <dd>3 years</dd>
      </div>
      <div class="services-hero__meta-item">
        <dt>Capabilities</dt>
        <dd>06</dd>
      </div>
      <div class="services-hero__meta-item">
        <dt>Based</dt>
        <dd>Abu Dhabi, UAE</dd>
      </div>
    </dl>
  </section>

  <ServicesBento
    categories={servicesData.categories}
    process={servicesData.process}
    cta={servicesData.cta}
    copy={{
      explore: 'Explore service',
      ctaHref: '/contact/',
    }}
  />
</Page>

<style>
  /* =====================================================================
     Services hero — editorial. Eyebrow + big headline + lead + meta.
     The eyebrow has a tiny breathing dot that pulses slowly on day mode
     (only), as a quiet "we're open for work" signal. The meta row uses
     <dl> so screen readers get label/value pairs, not a string of
     number-less fragments.
     ===================================================================== */
  .services-hero {
    margin-bottom: 64px;
    max-width: 880px;
  }

  .services-hero__title {
    font-size: clamp(2.4rem, 5.4vw, 4.4rem);
    line-height: 1.04;
    font-weight: 400;
    color: var(--heading-text);
    margin: 0 0 22px;
    letter-spacing: -0.02em;
  }

  .services-hero__title-accent {
    color: var(--color-primary);
    font-style: italic;
    /* The italic Rammetto One accent is a brand-voice flourish, not a
       "make it look editorial" reflex. The base is straight. */
  }

  [lang="ar"] .services-hero__title-accent,
  [dir="rtl"] .services-hero__title-accent {
    font-style: normal;
  }

  .services-hero__lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--muted-text);
    margin: 0 0 36px;
    max-width: 62ch;
  }

  .services-hero__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, max-content));
    gap: 56px;
    margin: 0;
    padding-top: 28px;
    border-top: 1px solid var(--divider-color);
  }

  .services-hero__meta-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .services-hero__meta-item dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-text);
    font-weight: 600;
    margin: 0;
  }

  .services-hero__meta-item dd {
    font-family: var(--font-title);
    font-size: 1.65rem;
    color: var(--heading-text);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .services-hero__meta {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .services-hero__meta-item dd {
      font-size: 1.35rem;
    }
  }

</style>
