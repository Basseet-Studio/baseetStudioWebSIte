---
import Page from '../layouts/Page.astro'
import Icon from '../components/icons/Icon.astro'
import { resolveIcon } from '../components/icons/iconMappings'
import servicesData from '../content/data/services.json'
import type { Lang } from '../types'


const lang: 'en' = 'en'
const description = 'Explore Baseet Studio services — web development, mobile apps, internal tools, SEO, UI/UX design, and cloud & DevOps for ambitious UAE brands.'
---

<Page title="Services — Baseet Studio" description={description} section="services" lang={lang}>
  <section class="mb-16">
    <h1 class="text-4xl font-bold mb-4">
      {/* TODO: localise this later */}
      {servicesData.title}
    </h1>
    <p class="text-lg opacity-70 max-w-2xl">
      {/* TODO: localise this later */}
      {servicesData.subtitle}
    </p>
    <p class="text-base opacity-60 max-w-3xl mt-2">
      {/* TODO: localise this later */}
      {servicesData.description}
    </p>
  </section>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {servicesData.categories?.map((category: any) => {
      const cat = resolveIcon(category.icon || 'fas fa-circle')
      return (
        <div id={category.id} class="glass glass-card p-8" data-animate="fade-up" scroll-margin-top="120px">
          <div class="mb-4" style="color: var(--color-primary); display:inline-flex; align-items:center; justify-content:center; width:48px; height:48px; border-radius:12px; background:color-mix(in srgb, var(--color-primary) 10%, transparent);">
            <Icon name={cat.name} variant={cat.variant} size={24} color="var(--color-primary)" />
          </div>
          <h2 class="text-xl font-semibold mb-2">{category.title}</h2>
          <p class="text-sm opacity-70 mb-4">{category.shortDesc}</p>
          <ul class="space-y-2">
            {category.services?.map((sub: any) => {
              const subIcon = resolveIcon(sub.icon || 'fas fa-circle')
              return (
                <li class="flex items-start gap-2 text-sm opacity-80">
                  <span style="color: var(--color-primary); display:inline-flex; margin-top:2px;">
                    <Icon name={subIcon.name} variant={subIcon.variant} size={14} color="var(--color-primary)" />
                  </span>
                  <div>
                    <div class="font-medium opacity-100">{sub.name}</div>
                    {sub.desc && <div class="opacity-60 text-xs">{sub.desc}</div>}
                  </div>
                </li>
              )
            })}
          </ul>
        </div>
      )
    })}
  </div>

  {servicesData.process?.steps?.length > 0 && (
    <section class="mt-20" data-animate="fade-up">
      <h2 class="text-3xl font-bold mb-2 text-center">
        {/* TODO: localise this later */}
        {servicesData.process.title}
      </h2>
      <p class="text-center opacity-70 mb-10">
        {/* TODO: localise this later */}
        {servicesData.process.subtitle}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicesData.process.steps.map((step: any) => {
          const stepIcon = resolveIcon(step.icon || 'fas fa-circle')
          return (
            <div class="glass glass-card p-6 text-center" data-animate="fade-up">
              <div
                class="w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-sm font-bold"
                style="background: var(--color-primary); color: white;"
              >
                {step.number}
              </div>
              <div class="mb-3 flex justify-center" style="color: var(--color-primary);">
                <Icon name={stepIcon.name} variant={stepIcon.variant} size={20} color="var(--color-primary)" />
              </div>
              <h3 class="font-semibold mb-2">{step.title}</h3>
              <p class="text-sm opacity-60">{step.desc}</p>
            </div>
          )
        })}
      </div>
    </section>
  )}

  {servicesData.cta && (
    <div class="text-center mt-16 glass glass-panel p-12" data-animate="fade-in">
      <h3 class="text-2xl font-bold mb-2">{servicesData.cta.title}</h3>
      {servicesData.cta.subtitle && (
        <p class="text-lg opacity-80 mb-2">{servicesData.cta.subtitle}</p>
      )}
      {servicesData.cta.description && (
        <p class="opacity-70 mb-6 max-w-2xl mx-auto">{servicesData.cta.description}</p>
      )}
      <a
        href="/contact/"
        class="inline-block px-8 py-3 rounded-full font-semibold transition-all duration-300 hover:scale-105"
        style="background: var(--color-primary); color: white;"
      >
        {servicesData.cta.button}
      </a>
    </div>
  )}
</Page>
