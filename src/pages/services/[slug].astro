---
import ServiceDetail from '../../views/ServiceDetail.astro'
import { getServicesIndex } from '../../lib/services'

export async function getStaticPaths() {
  return getServicesIndex('en').map((summary) => ({
    params: { slug: summary.slug },
  }))
}

const { slug } = Astro.params
---
<ServiceDetail lang="en" slug={slug as string} />
