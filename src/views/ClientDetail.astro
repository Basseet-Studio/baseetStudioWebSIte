---
import Page from '../layouts/Page.astro'
import Icon from '../components/icons/Icon.astro'
import ClientDetailHero from '../components/clients/ClientDetailHero.astro'
import ClientLayoutShowcase from '../components/clients/ClientLayoutShowcase.astro'
import ClientLayoutTimeline from '../components/clients/ClientLayoutTimeline.astro'
import ClientLayoutStack from '../components/clients/ClientLayoutStack.astro'
import ClientGallery from '../components/clients/ClientGallery.astro'
import { getClient } from '../lib/clients'
import { getProjectsForClient } from '../lib/projects'
import { t } from '../lib/i18n'
import { localizeHref } from '../lib/localize-href'
import type { ClientLayoutTemplate, Lang } from '../types'
import '../styles/clients/detail.css'

interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props
const client = getClient(id, lang)

if (!client) {
  return Astro.redirect(localizeHref(lang, '/404'))
}

const linkedProjects = getProjectsForClient(client.id, lang)
const steps = client.steps ?? []
const screenshots = client.screenshots ?? []
const hasChallenge = Boolean(client.challenge?.trim())
const hasSolution = Boolean(client.solution?.trim())
const hasResults = (client.results?.length ?? 0) > 0
const hasTestimonial = Boolean(client.testimonial?.quote?.trim())
const hasTech = (client.technologies?.length ?? 0) > 0
const hasProducts = linkedProjects.length > 0

const layoutComponents: Record<ClientLayoutTemplate, typeof ClientLayoutShowcase> = {
  showcase: ClientLayoutShowcase,
  timeline: ClientLayoutTimeline,
  stack: ClientLayoutStack,
}

const LayoutComponent = layoutComponents[client.layoutTemplate] ?? ClientLayoutShowcase

const pageDescription =
  client.shortDescription ||
  client.fullDescription ||
  `${client.name} case study by Baseet Studio`

---

<Page
  title={`${client.name} — Baseet Studio`}
  description={pageDescription}
  section="clients"
  lang={lang}
>
  <div class="client-detail" style={`--client-color: ${client.color}`}>
    <ClientDetailHero client={client} />

    {(hasChallenge || hasSolution) && (
      <div class:list={['client-meta', hasChallenge && hasSolution && 'client-meta--split']}>
        {hasChallenge && (
          <div class="client-meta__block card-window" data-animate="fade-up">
            <h2 class="client-meta__label">{t("clients_challenge", lang)}</h2>
            <p class="client-meta__text">{client.challenge}</p>
          </div>
        )}
        {hasSolution && (
          <div class="client-meta__block card-window" data-animate="fade-up">
            <h2 class="client-meta__label">{t("clients_what_we_did", lang)}</h2>
            <p class="client-meta__text">{client.solution}</p>
          </div>
        )}
      </div>
    )}

    {hasProducts && (
      <section class="client-products" data-animate="fade-up">
        <h2 class="client-products__title">{t("clients_products_used", lang)}</h2>
        <ul class="client-products__list">
          {linkedProjects.map((project) => (
            <li>
              <a
                href={localizeHref(lang, `/projects/${project.slug}/`)}
                class="client-products__card card-window"
                style={`--product-accent: ${project.color};`}
              >
                <span class="client-products__name">{project.name}</span>
                <span class="client-products__tagline">{project.tagline}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {steps.length > 0 && (
      <LayoutComponent client={client} steps={steps} />
    )}

    {screenshots.length > 0 && (
      <ClientGallery
        clientId={client.id}
        clientName={client.name}
        screenshots={screenshots}
        galleryType={client.galleryType ?? 'web'}
        clientColor={client.color}
      />
    )}

    {hasResults && (
      <section class="client-results" data-animate="fade-up">
        <h2 class="client-results__title">{t("clients_outcomes", lang)}</h2>
        <ul class="client-results__grid">
          {client.results!.map((r) => (
            <li class="client-results__item card-window">
              <span class="client-results__metric" style={`color: ${client.color}`}>{r.metric}</span>
              <span class="client-results__label">{r.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {hasTestimonial && (
      <figure class="client-testimonial card-window" data-animate="fade-up">
        <blockquote class="client-testimonial__quote">
          &ldquo;{client.testimonial!.quote}&rdquo;
        </blockquote>
        <figcaption>
          {client.testimonial!.author && (
            <span class="client-testimonial__author">{client.testimonial!.author}</span>
          )}
          {client.testimonial!.role && (
            <span class="client-testimonial__role">{client.testimonial!.role}</span>
          )}
        </figcaption>
      </figure>
    )}

    {hasTech && (
      <ul class="client-chips" data-animate="fade-up">
        {client.technologies!.map((tech) => (
          <li class="client-chips__item">{tech}</li>
        ))}
      </ul>
    )}

    <section class="client-cta" data-animate="fade-up">
      <a href={localizeHref(lang, "/contact/")} class="client-cta__link" style={`background: ${client.color}`}>
        {t("clients_start_project", lang)}
        <Icon name="arrow-right" size={16} color="white" />
      </a>
    </section>
  </div>
</Page>

<script>
  import { init, destroy } from '../animations/clients/detail'

  init()
  document.addEventListener('astro:before-swap', destroy)
  document.addEventListener('astro:page-load', init)
</script>
