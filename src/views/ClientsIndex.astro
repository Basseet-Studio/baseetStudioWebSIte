---
// Clients index — one card shape for every client, featured client first.
// Challenge / solution / full stack live on each client's case-study page.
import Page from '../layouts/Page.astro'
import Icon from '../components/icons/Icon.astro'
import { getClientsData } from '../lib/clients'
import { t } from '../lib/i18n'
import { localizeHref } from '../lib/localize-href'
import type { Lang } from '../types'

interface Props { lang: Lang }
const { lang } = Astro.props
const tt = (key: string, fallback: string): string => {
  const v = t(key, lang)
  return v && v !== key ? v : fallback
}
const clientsData = getClientsData(lang)
const description = t('clients_description', lang)
const all = (clientsData.clients ?? []) as any[]

const hasQuote = (c: any) => Boolean(c.testimonial?.quote?.trim())
const featured =
  all.find(hasQuote) ?? [...all].sort((a, b) => (b.results?.length ?? 0) - (a.results?.length ?? 0))[0]
const rest = all.filter((c) => c !== featured)

const audiences = (t('clients_who_audiences', lang) || '')
  .split('|')
  .map((s) => s.trim())
  .filter(Boolean)

function monogram(name: string): string {
  const words = name.replace(/[^\p{L}\p{N} ]/gu, '').split(/\s+/).filter(Boolean)
  return ((words[0]?.[0] ?? '') + (words[1]?.[0] ?? '')).toUpperCase() || '•'
}
const caseHref = (c: any) => localizeHref(lang, `/clients/${c.id}/`)
---

<Page title={t('clients_title', lang)} description={description} section="clients" lang={lang}>
  <div class="cl">
    <header class="cl__hero" data-animate="fade-up">
      <h1 class="cl__title">
        {t('clients_hero_title_line1', lang)}<br />
        <span class="type-accent cl__accent">{t('clients_hero_title_line2', lang)}</span>
      </h1>
      <p class="cl__lead">{tt('clients_hero_lead_short', 'Here is what we built, and what changed for the teams using it.')}</p>
      <ul class="cl__chips" role="list">
        <li class="cl__chip"><b>{t('clients_meta_active_value', lang)}</b>{t('clients_meta_active', lang)}</li>
        <li class="cl__chip"><b>{t('clients_meta_partnership_value', lang)}</b>{t('clients_meta_partnership', lang)}</li>
        <li class="cl__chip"><b>{all.length}</b>{tt('clients_meta_engagements', 'Engagements')}</li>
      </ul>
    </header>

    {featured && (
      <article class="feat" style={`--c:${featured.color || 'var(--color-primary)'};`} data-animate="fade-up">
        <div class="feat__main">
          <div class="feat__top">
            <span class="mono mono--lg">{monogram(featured.name)}</span>
            <div>
              {featured.industry && <span class="tag">{featured.industry}</span>}
              <h2 class="feat__name">{featured.name}</h2>
              {featured.tagline && <p class="feat__tagline">{featured.tagline}</p>}
            </div>
          </div>
          {featured.results?.length > 0 && (
            <ul class="feat__results" role="list">
              {featured.results.slice(0, 3).map((r: any) => (
                <li>
                  <span class="count" data-count={r.metric}>{r.metric}</span>
                  <span class="feat__label">{r.label}</span>
                </li>
              ))}
            </ul>
          )}
          <a href={caseHref(featured)} class="link-pill">
            {tt('clients_view_case', 'View case')}
            <Icon name="arrow-right" size={14} color="currentColor" class="icon-chevron" />
          </a>
        </div>
        {hasQuote(featured) && (
          <figure class="feat__quote">
            <span class="feat__mark" aria-hidden="true">&ldquo;</span>
            <blockquote>{featured.testimonial.quote}</blockquote>
            {(featured.testimonial.author || featured.testimonial.role) && (
              <figcaption>
                <span class="av">{monogram(featured.testimonial.author || featured.name)}</span>
                <span>
                  <b>{featured.testimonial.author}</b>
                  {featured.testimonial.role && <small>{featured.testimonial.role}</small>}
                </span>
              </figcaption>
            )}
          </figure>
        )}
      </article>
    )}

    <div class="grid">
      {rest.map((c) => {
        const r = c.results?.[0]
        return (
          <a href={caseHref(c)} class="card" style={`--c:${c.color || 'var(--color-primary)'};`} data-animate="fade-up">
            <span class="card__band">
              {c.industry && <span class="tag tag--band">{c.industry}</span>}
              <span class="mono">{monogram(c.name)}</span>
            </span>
            <span class="card__in">
              <span class="card__name">{c.name}</span>
              {c.tagline && <span class="card__tagline">{c.tagline}</span>}
              {r ? (
                <span class="card__result">
                  <span class="count" data-count={r.metric}>{r.metric}</span>
                  <span class="card__label">{r.label}</span>
                </span>
              ) : (
                <span class="card__result card__result--service">
                  <span class="card__service">{c.serviceType}</span>
                </span>
              )}
              {c.technologies?.length > 0 && (
                <span class="card__chips">
                  {c.technologies.slice(0, 3).map((tech: string) => <span class="chip">{tech}</span>)}
                  {c.technologies.length > 3 && <span class="chip chip--more">+{c.technologies.length - 3}</span>}
                </span>
              )}
              <span class="card__go">
                {tt('clients_view_case', 'View case')}
                <Icon name="arrow-right" size={14} color="currentColor" class="icon-chevron" />
              </span>
            </span>
          </a>
        )
      })}
    </div>

    {audiences.length > 0 && (
      <section class="who" data-animate="fade-up">
        <h2 class="who__title">{t('clients_who_title', lang)}</h2>
        <ul class="who__chips" role="list">
          {audiences.map((a) => <li>{a}</li>)}
        </ul>
      </section>
    )}

    <section class="cta-band" data-animate="fade-up">
      <h2 class="cta-band__title">{t('clients_cta_line', lang)}</h2>
      <a href={localizeHref(lang, '/contact/')} class="cta-band__btn">
        {t('clients_cta_link', lang)}
        <Icon name="arrow-right" size={16} color="currentColor" class="icon-chevron" />
      </a>
    </section>
  </div>
</Page>

<style>
  .cl { width: min(1100px, 100%); margin: 0 auto; padding-bottom: clamp(64px, 10vw, 120px); }
  .cl__hero { max-width: 760px; padding: 2vh 0 clamp(32px, 6vw, 56px); }
  .cl__title { margin: 0 0 18px; }
  .cl__accent { color: var(--color-primary); }
  .cl__lead { font-size: var(--type-lead); color: var(--muted-text); margin: 0 0 24px; max-width: 36ch; line-height: 1.45; }
  .cl__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .cl__chip { display: inline-flex; align-items: baseline; gap: 8px; padding: 9px 16px; border-radius: 999px; background: var(--card-window-bg); border: 1px solid var(--card-window-border); font-size: 13px; color: var(--muted-text); }
  .cl__chip b { font-family: var(--font-display); font-size: 16px; color: var(--heading-text); }

  .tag { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; color: var(--c); background: color-mix(in srgb, var(--c) 12%, transparent); }
  .mono { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 15px; background: #0f1726; color: #fff; font-weight: 800; font-size: 17px; box-shadow: 0 0 0 4px var(--card-window-bg); }
  .mono--lg { width: 64px; height: 64px; border-radius: 18px; font-size: 20px; background: linear-gradient(135deg, var(--c), color-mix(in srgb, var(--c) 55%, #0f1726)); flex-shrink: 0; }
  .count { font-family: var(--font-display); font-weight: 700; letter-spacing: -0.04em; line-height: 1; color: var(--c); font-variant-numeric: tabular-nums; }

  .feat { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 20px; padding: clamp(22px, 4vw, 36px); border-radius: var(--card-window-radius); background: var(--card-window-bg); border: 1px solid var(--card-window-border); box-shadow: var(--card-window-shadow); margin-bottom: 20px; position: relative; overflow: hidden; }
  .feat::before { content: ''; position: absolute; inset: -40% auto auto -10%; width: 60%; height: 120%; background: radial-gradient(circle, color-mix(in srgb, var(--c) 18%, transparent), transparent 65%); pointer-events: none; }
  .feat > * { position: relative; }
  .feat__top { display: flex; gap: 16px; align-items: flex-start; }
  .feat__name { font-size: clamp(26px, 3vw, 36px); margin: 8px 0 4px; }
  .feat__tagline { margin: 0; color: var(--muted-text); }
  .feat__results { list-style: none; margin: 28px 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .feat__results li { display: flex; flex-direction: column; gap: 6px; }
  .feat__results .count { font-size: clamp(32px, 4vw, 48px); }
  .feat__label { font-size: 13px; color: var(--muted-text); }
  .feat__quote { margin: 0; padding: 26px; border-radius: var(--card-window-radius-tight); background: color-mix(in srgb, var(--c) 7%, var(--card-window-bg)); display: flex; flex-direction: column; justify-content: space-between; gap: 18px; }
  .feat__mark { font-family: var(--font-accent); font-size: 72px; line-height: 0.5; color: var(--c); opacity: 0.35; }
  .feat__quote blockquote { margin: 0; font-family: var(--font-accent); font-size: 18px; line-height: 1.5; color: var(--heading-text); }
  .feat__quote figcaption { display: flex; align-items: center; gap: 12px; }
  .feat__quote figcaption b { display: block; font-size: 14px; color: var(--heading-text); }
  .feat__quote figcaption small { font-size: 12px; color: var(--muted-text); }
  .av { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, var(--c), color-mix(in srgb, var(--c) 50%, #0f1726)); color: #fff; font-weight: 700; font-size: 14px; flex-shrink: 0; }
  .link-pill { display: inline-flex; align-items: center; gap: 8px; padding: 11px 20px; border-radius: 999px; background: var(--c); color: #fff; font-weight: 600; font-size: 14px; text-decoration: none; }

  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .card { display: flex; flex-direction: column; border-radius: 22px; overflow: hidden; background: var(--card-window-bg); border: 1px solid var(--card-window-border); box-shadow: var(--card-window-shadow); text-decoration: none; color: inherit; transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease; }
  .card:hover { transform: translateY(-6px); box-shadow: var(--card-window-shadow-hover); }
  .card__band { position: relative; height: 84px; background: linear-gradient(120deg, var(--c), color-mix(in srgb, var(--c) 45%, #ffffff)); }
  .card__band .mono { position: absolute; inset-inline-start: 20px; bottom: -24px; }
  .tag--band { position: absolute; inset-inline-end: 14px; top: 14px; background: rgba(255, 255, 255, 0.88); }
  .card__in { display: flex; flex-direction: column; gap: 6px; padding: 38px 20px 20px; flex: 1; }
  .card__name { font-family: var(--font-display); font-size: 19px; font-weight: 700; color: var(--heading-text); }
  .card__tagline { font-size: 14px; color: var(--muted-text); }
  .card__result { display: flex; flex-direction: column; gap: 4px; margin: 14px 0 10px; }
  .card__result .count { font-size: 44px; }
  .card__label { font-size: 13px; color: var(--muted-text); }
  .card__service { font-family: var(--font-display); font-size: 22px; font-weight: 700; color: var(--c); line-height: 1.15; }
  .card__chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { font-size: 11px; padding: 4px 9px; border-radius: 999px; background: var(--chip-bg); color: var(--chip-text); border: 1px solid var(--chip-border); }
  .card__go { margin-top: auto; padding-top: 16px; display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: var(--c); }

  .who { margin-top: 64px; text-align: center; }
  .who__title { font-size: clamp(24px, 3vw, 32px); margin: 0 0 18px; }
  .who__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .who__chips li { padding: 9px 16px; border-radius: 999px; background: var(--card-window-bg); border: 1px solid var(--card-window-border); font-size: 14px; color: var(--heading-text); }

  .cta-band { margin-top: 64px; border-radius: var(--card-window-radius); padding: clamp(28px, 5vw, 44px); background: linear-gradient(120deg, #203566, var(--color-primary)); color: #fff; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .cta-band__title { color: #fff; margin: 0; font-size: clamp(24px, 3vw, 34px); max-width: 22ch; }
  .cta-band__btn { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: #203566; padding: 14px 26px; border-radius: 999px; font-weight: 600; text-decoration: none; }

  @media (max-width: 960px) {
    .feat { grid-template-columns: 1fr; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
    .feat__results { grid-template-columns: 1fr 1fr; }
  }
  :global([dir='rtl']) .icon-chevron :global(svg) { transform: scaleX(-1); }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card:hover { transform: none; } }
</style>

<script>
  // Count-up for numeric results ("30%", "2hrs", "< 2s"). Non-numeric stay as-is.
  let io: IntersectionObserver | undefined

  function animate(el: HTMLElement): void {
    const raw = el.dataset.count ?? ''
    const m = raw.match(/^(\D*?)(\d+(?:\.\d+)?)(.*)$/)
    if (!m) return
    const [, pre, num, suf] = m
    const to = parseFloat(num)
    const decimals = num.includes('.') ? num.split('.')[1].length : 0
    const start = performance.now()
    const step = (now: number) => {
      const k = Math.min(1, (now - start) / 1300)
      const e = 1 - Math.pow(1 - k, 3)
      el.textContent = pre + (to * e).toFixed(decimals) + suf
      if (k < 1) requestAnimationFrame(step)
      else el.textContent = raw
    }
    requestAnimationFrame(step)
  }

  function initCounts(): void {
    io?.disconnect()
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    const els = document.querySelectorAll<HTMLElement>('[data-count]')
    if (!els.length || !('IntersectionObserver' in window)) return
    io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return
          io?.unobserve(e.target)
          animate(e.target as HTMLElement)
        })
      },
      { threshold: 0.6 },
    )
    els.forEach((el) => io!.observe(el))
  }

  initCounts()
  document.addEventListener('astro:page-load', initCounts)
  document.addEventListener('astro:before-swap', () => io?.disconnect())
</script>
