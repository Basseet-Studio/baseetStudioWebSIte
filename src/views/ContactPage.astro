---
import Page from '../layouts/Page.astro'
import linksData from '../content/data/links.json'
import ContactForm from '../components/shared/ContactForm.astro'
import BookingWidget from '../components/shared/BookingWidget.astro'
import { t } from '../lib/i18n'
import type { Lang } from '../types'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<Page
  title={t('contact_title', lang)}
  description={t('contact_description', lang)}
  section="contact"
  lang={lang}
  footerCompact
>
  <section class="contact-hero" data-animate="fade-up">
    <h1 class="contact-hero__title">{t('contact_header_title', lang)}</h1>
    <p class="contact-hero__lead">{t('contact_header_lead', lang)}</p>
  </section>

  <section class="form-section" data-animate="fade-up">
    <ContactForm actionUrl={linksData.forms.contact_form_url} lang={lang} />
  </section>

  <section class="booking-section">
    <BookingWidget apiUrl={linksData.forms.booking_api_url} lang={lang} />
  </section>
</Page>

<style>
  .contact-hero {
    max-width: 760px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .contact-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--heading-text);
    margin: 0 0 16px;
    line-height: 1.1;
  }

  .contact-hero__lead {
    font-family: var(--font-body);
    font-size: var(--type-lead);
    font-weight: 400;
    color: var(--muted-text);
    line-height: 1.55;
    margin: 0;
  }

  .form-section {
    max-width: 1080px;
    margin: 0 auto 64px;
  }

  .booking-section {
    max-width: 1080px;
    margin: 0 auto 80px;
  }
</style>
