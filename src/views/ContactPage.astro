---
import Page from '../layouts/Page.astro'
import linksData from '../content/data/links.json'
import ContactForm from '../components/shared/ContactForm.astro'
import BookingWidget from '../components/shared/BookingWidget.astro'
import { t } from '../lib/i18n'
import type { Lang } from '../types'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<Page
  title={t('contact_title', lang)}
  description={t('contact_description', lang)}
  section="contact"
  lang={lang}
  footerCompact
>
  <h1 class="contact-sr-only">{t('contact_title', lang)}</h1>

  <nav class="contact-jumps" aria-label={t('contact_title', lang)}>
    <a class="contact-jump" href="#contact-message">{t('contact_jump_message', lang)}</a>
    <a class="contact-jump" href="#contact-meeting">{t('contact_jump_meeting', lang)}</a>
  </nav>

  <section id="contact-message" class="form-section" data-animate="fade-up">
    <ContactForm actionUrl={linksData.forms.contact_form_url} lang={lang} />
  </section>

  <section id="contact-meeting" class="booking-section">
    <BookingWidget apiUrl={linksData.forms.booking_api_url} lang={lang} />
  </section>
</Page>

<style>
  .contact-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .contact-jumps {
    --paper-cream: #fdfbf7;
    --paper-ink: #1c1a16;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 1080px;
    margin: 0 auto 28px;
  }

  .contact-jump {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    padding: 8px 18px;
    border: 1.5px solid var(--paper-ink);
    background: var(--paper-cream);
    color: var(--paper-ink);
    border-radius: 9999px;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    box-shadow: 0 8px 22px -14px rgba(28, 22, 14, 0.45);
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .contact-jump:hover {
    background: var(--paper-ink);
    color: var(--paper-cream);
  }

  .contact-jump:active {
    transform: scale(0.98);
  }

  .contact-jump:focus-visible {
    outline: 2px solid var(--paper-ink);
    outline-offset: 3px;
  }

  .form-section,
  .booking-section {
    max-width: 1080px;
    margin: 0 auto 64px;
    scroll-margin-top: 7.5rem;
  }

  .booking-section {
    margin-bottom: 80px;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-jump {
      transition: none;
    }

    .contact-jump:active {
      transform: none;
    }
  }
</style>
