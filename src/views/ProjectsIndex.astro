---
import Page from '../layouts/Page.astro'
import WorkGalleryTile from '../components/projects/WorkGalleryTile.astro'
import { getProjectsForIndex } from '../lib/projects'
import { t } from '../lib/i18n'
import { localizeHref } from '../lib/localize-href'
import type { Lang } from '../types'

interface Props { lang: Lang }
const { lang } = Astro.props
const description = t('projects_description', lang)
const projects = getProjectsForIndex(lang)

const anchor = projects.find((p) => p.indexTier === 'anchor')
const flagship = projects.filter((p) => p.indexTier === 'flagship')
const more = projects.filter((p) => p.indexTier === 'more')

const mobileSlugs = new Set(['moneybox', 'numu'])

function mosaicClass(slug: string): string {
  const aspect = mobileSlugs.has(slug) ? 'wg--mobile' : 'wg--desktop'
  const placement: Record<string, string> = {
    ordelo: 'wg--ordelo',
    moneybox: 'wg--moneybox',
    numu: 'wg--numu',
    zyrn: 'wg--zyrn',
    'photorestore-ai': 'wg--photorestore',
    invexo: 'wg--invexo',
  }
  return [placement[slug] ?? 'wg--default', aspect].join(' ')
}

const labClass: Record<string, string> = {
  geeb: 'wg--geeb',
  'medical-education-app': 'wg--mai',
}

---

<Page title={t("projects_title", lang)} description={description} section="projects" lang={lang}>
  <div class="work-wall" data-work-wall>
    <header class="work-wall__intro">
     
    </header>

    <div class="work-wall__canvas" aria-label="Project gallery">
      {(anchor || flagship.length > 0) && (
        <div class="work-wall__mosaic" aria-label="Core products">
          {anchor && (
            <WorkGalleryTile
              lang={lang}
              project={anchor}
              layoutClass="wg--matrix wg--desktop"
            />
          )}
          {flagship.map((project) => (
            <WorkGalleryTile
              lang={lang}
              project={project}
              layoutClass={mosaicClass(project.slug)}
            />
          ))}
        </div>
      )}

      {more.length > 0 && (
        <div class="work-wall__lab" aria-label="More in development">
          <p class="work-wall__lab-label" data-wall-intro>{t("projects_lab_label", lang)}</p>
          <div class="work-wall__lab-grid">
            {more.map((project) => (
              <WorkGalleryTile
                lang={lang}
                project={project}
                layoutClass={`${labClass[project.slug] ?? 'wg--lab'} wg--desktop`}
              />
            ))}
          </div>
        </div>
      )}
    </div>

    <footer class="work-wall__foot">
      <a href={localizeHref(lang, "/contact/")} class="work-wall__foot-link">{t("projects_foot_cta", lang)}</a>
    </footer>
  </div>
</Page>

<style>
  .work-wall {
    --wg-radius: var(--r-small, 12px);
    --r-small: 12px;
    --wall-gap: clamp(12px, 1.6vw, 18px);

    width: min(96vw, 1360px);
    margin: 0 auto;
    padding: 0 0 clamp(80px, 12vw, 120px);
  }

  .work-wall__intro {
    padding: 4px 0 clamp(24px, 4vw, 40px);
  }

  .work-wall__kicker {
    margin: 0 0 8px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .work-wall__canvas {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2.2vw, 28px);
    align-items: stretch;
    overflow: visible;
  }

  /*
   * Mosaic — mirrored 9-col bento:
   * TOP:    wide left (Matrix + Deshi)  |  narrow right (Numu)
   * BOTTOM: narrow left (MoneyBox)      |  wide right (Jemeti → IMS → PhotoRestore)
   */
  .work-wall__mosaic {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    grid-template-rows: repeat(17, minmax(0, 1fr));
    gap: var(--wall-gap);
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
    aspect-ratio: 9 / 17;
    overflow: visible;
  }

  .work-wall__mosaic :global(.wg) {
    width: 100%;
    min-height: 0;
    height: 100%;
    display: block;
  }

  .work-wall__mosaic :global(.wg__frame) {
    height: 100%;
    min-height: 0;
  }

  /* Matrix — left top, same 3-row height as Ordelo */
  .work-wall__mosaic :global(.wg--matrix) {
    grid-column: 1 / 7;
    grid-row: 1 / 4;
  }

  .work-wall__mosaic :global(.wg--matrix .wg__name) {
    font-size: clamp(1.5rem, 3.2vw, 2.3rem);
  }

  .work-wall__mosaic :global(.wg--matrix .wg__tagline) {
    font-size: clamp(0.75rem, 1.4vw, 0.9rem);
  }

  /* Numu — top-right beside Matrix, tall (6 rows) */
  .work-wall__mosaic :global(.wg--numu) {
    grid-column: 7 / 10;
    grid-row: 1 / 7;
  }

  /* Ordelo — under Matrix, same height as Matrix */
  .work-wall__mosaic :global(.wg--ordelo) {
    grid-column: 1 / 7;
    grid-row: 4 / 7;
  }

  .work-wall__mosaic :global(.wg--ordelo .wg__name) {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }

  /* MoneyBox — narrow left (mirror of Numu), same height as Numu */
  .work-wall__mosaic :global(.wg--moneybox) {
    grid-column: 1 / 4;
    grid-row: 7 / 13;
  }

  /* Zyrn — wide right, same height as MoneyBox */
  .work-wall__mosaic :global(.wg--zyrn) {
    grid-column: 4 / 10;
    grid-row: 7 / 13;
  }

  .work-wall__mosaic :global(.wg--zyrn .wg__name) {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }

  /* Invexo — under MoneyBox */
  .work-wall__mosaic :global(.wg--invexo) {
    grid-column: 1 / 4;
    grid-row: 13 / 18;
  }

  /* PhotoRestore — wide right, spills below */
  .work-wall__mosaic :global(.wg--photorestore) {
    grid-column: 4 / 10;
    grid-row: 13 / 18;
    align-self: stretch;
  }

  .work-wall__mosaic :global(.wg--moneybox .wg__frame),
  .work-wall__mosaic :global(.wg--numu .wg__frame) {
    background: color-mix(in srgb, var(--wg-accent) 6%, rgba(8, 12, 20, 0.2));
  }

  .work-wall__mosaic :global(.wg--jemeti .wg__visual) {
    object-fit: contain;
    object-position: center;
    padding: clamp(12px, 3vw, 24px);
    background: #1a1214;
  }

  :global([data-theme='night']) .work-wall__mosaic :global(.wg--jemeti .wg__visual) {
    background: #1f1416;
  }

  .work-wall__mosaic :global(.wg--moneybox .wg__name) {
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
  }

  .work-wall__mosaic :global(.wg--numu .wg__name) {
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
  }

  .work-wall__mosaic :global(.wg--jemeti .wg__name) {
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
  }

  .work-wall__mosaic :global(.wg--photorestore .wg__name),
  .work-wall__mosaic :global(.wg--invexo .wg__name) {
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
  }

  /* Lab — equal three-column grid, aligned heights */
  .work-wall__lab {
    margin-top: clamp(16px, 3vw, 28px);
  }

  .work-wall__lab-label {
    margin: 0 0 12px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted-text);
  }

  .work-wall__lab-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--wall-gap);
    align-items: start;
  }

  .work-wall__lab-grid :global(.wg) {
    width: 100%;
    min-height: 0;
    height: auto;
    display: block;
  }

  .work-wall__lab-grid :global(.wg__frame) {
    aspect-ratio: 16 / 9;
    height: auto;
  }

  .work-wall__lab-grid :global(.wg__name) {
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
  }

  .work-wall__foot {
    margin-top: clamp(40px, 6vw, 64px);
    text-align: center;
  }

  .work-wall__foot-link {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
    padding-bottom: 2px;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .work-wall__foot-link:hover,
  .work-wall__foot-link:focus-visible {
    border-color: var(--color-primary);
    color: var(--heading-text);
  }

  @media (max-width: 900px) {
    .work-wall__mosaic {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      aspect-ratio: auto;
      max-width: none;
    }

    .work-wall__mosaic :global(.wg) {
      grid-column: 1 !important;
      grid-row: auto !important;
      height: clamp(220px, 54vw, 340px);
    }

    .work-wall__mosaic :global(.wg--matrix) {
      height: clamp(200px, 50vw, 300px);
    }

    .work-wall__mosaic :global(.wg--moneybox),
    .work-wall__mosaic :global(.wg--numu),
    .work-wall__mosaic :global(.wg--photorestore) {
      height: clamp(320px, 88vw, 480px);
      max-width: min(300px, 72vw);
      margin-inline: auto;
    }

    .work-wall__mosaic :global(.wg--zyrn) {
      height: clamp(320px, 88vw, 480px);
    }

    .work-wall__lab-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-wall__foot-link {
      transition: none;
    }
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { initPreviewLoader } from '../scripts/previews/preview-loader'

  gsap.registerPlugin(ScrollTrigger)

  let triggers: ScrollTrigger[] = []
  let teardownPreviews: (() => void) | undefined

  function killWallMotion(): void {
    triggers.forEach((t) => t.kill())
    triggers = []
    teardownPreviews?.()
    teardownPreviews = undefined
  }

  function initZipBorders(root: HTMLElement): void {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const radius = getComputedStyle(root).getPropertyValue('--wg-radius').trim() || '12px'
    const closed = `inset(calc(100% - 2px) 0 0 0 round ${radius})`
    const open = `inset(0 round ${radius})`

    root.querySelectorAll<HTMLElement>('[data-wg-tile]').forEach((tile) => {
      if (tile.classList.contains('wg--interactive')) return

      const frame = tile.querySelector<HTMLElement>('[data-zip-frame]')
      if (!frame) return

      gsap.set(frame, { clipPath: closed })

      if (reduced) {
        const toggle = (on: boolean) => tile.classList.toggle('is-zipped', on)
        tile.addEventListener('mouseenter', () => toggle(true))
        tile.addEventListener('mouseleave', () => toggle(false))
        tile.addEventListener('focusin', () => toggle(true))
        tile.addEventListener('focusout', () => toggle(false))
        return
      }

      const tl = gsap.timeline({ paused: true, defaults: { ease: 'power2.inOut', duration: 0.5 } })
      tl.to(frame, { clipPath: open })

      tile.addEventListener('mouseenter', () => tl.play())
      tile.addEventListener('mouseleave', () => tl.reverse())
      tile.addEventListener('focusin', () => tl.play())
      tile.addEventListener('focusout', (e) => {
        if (!tile.contains(e.relatedTarget as Node)) tl.reverse()
      })
    })
  }

  function initWorkWall(): void {
    killWallMotion()

    const root = document.querySelector<HTMLElement>('[data-work-wall]')
    if (!root) return

    initZipBorders(root)
    teardownPreviews = initPreviewLoader(root)

    root.querySelectorAll<HTMLVideoElement>('video.wg__visual').forEach((video) => {
      const tile = video.closest('.wg')
      if (!tile) return

      const play = () => video.play().catch(() => {})
      const pause = () => {
        video.pause()
        video.currentTime = 0
      }

      tile.addEventListener('mouseenter', play)
      tile.addEventListener('mouseleave', pause)
      tile.addEventListener('focusin', play)
      tile.addEventListener('focusout', pause)
    })

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    gsap.from(root.querySelectorAll('[data-wall-intro]'), {
      y: 14,
      opacity: 0,
      duration: 0.55,
      stagger: 0.06,
      ease: 'power2.out',
    })

    const matrixTile = root.querySelector<HTMLElement>('.wg--matrix')
    const matrixVisual = matrixTile?.querySelector<HTMLElement>('.wg__visual:not(.wg__fallback)')
    if (matrixVisual && !matrixTile?.classList.contains('wg--interactive')) {
      const st = ScrollTrigger.create({
        trigger: matrixTile,
        start: 'top bottom',
        end: 'bottom top',
        scrub: 0.5,
        onUpdate: (self) => {
          gsap.set(matrixVisual, { y: (self.progress - 0.5) * 16 })
        },
      })
      triggers.push(st)
    }
  }

  initWorkWall()
  document.addEventListener('astro:page-load', initWorkWall)
  document.addEventListener('astro:before-swap', killWallMotion)
</script>
