---
// Work index — one calm list. Rows expand to play the project's built-in
// preview: hover on desktop, centred-row autoplay + tap on touch screens.
import Page from '../layouts/Page.astro'
import Icon from '../components/icons/Icon.astro'
import MatrixPreview from '../components/projects/previews/MatrixPreview.astro'
import MoneyBoxPreview from '../components/projects/previews/MoneyBoxPreview.astro'
import NumuPreview from '../components/projects/previews/NumuPreview.astro'
import BaseetIMSPreview from '../components/projects/previews/BaseetIMSPreview.astro'
import { getProjectsForIndex } from '../lib/projects'
import labExtra from '../content/data/work-lab-extra.json'
import { t } from '../lib/i18n'
import { localizeHref } from '../lib/localize-href'
import type { Lang } from '../types'

interface Props { lang: Lang }
const { lang } = Astro.props
const tt = (key: string, fallback: string): string => {
  const v = t(key, lang)
  return v && v !== key ? v : fallback
}
const description = t('projects_description', lang)
const projects = getProjectsForIndex(lang)

// Order comes straight from projects.json (edit the file order to reorder).
const core = projects.filter((p) => p.indexTier !== 'more')
const lab = projects.filter((p) => p.indexTier === 'more')
const labText: string[] = (labExtra.items ?? []).map((i: { name: string }) => i.name).filter(Boolean)

const previewBg: Record<string, [string, string]> = {
  matrix: ['#f3f4f6', '#151820'],
  moneybox: ['#faf8f5', '#1a2420'],
  numu: ['#f5f5fa', '#1e1a28'],
  invexo: ['#f4f6f8', '#080c10'],
}
const mobileSlugs = new Set(['moneybox', 'numu'])

function statusKey(status: string): string {
  return 'status_' + status.toLowerCase().replace(/\s+/g, '_')
}

const groups = [
  { label: '', items: core },
  { label: tt('projects_lab_label', 'Also in the lab'), items: lab },
].filter((g, i) => g.items.length || (i === 1 && labText.length))
let rowIndex = 0
---

<Page title={t('projects_title', lang)} description={description} section="projects" lang={lang}>
  <div class="work" data-work-list>
    <header class="work__hero" data-animate="fade-up">
      <p class="work__kicker">{tt('projects_hero_kicker', 'Selected work')}</p>
      <h1 class="work__title">
        {tt('projects_hero_line1', 'Built, shipped,')}<br />
        <span class="type-accent work__accent">{tt('projects_hero_line2', 'still running.')}</span>
      </h1>
      <p class="work__lead">{tt('projects_hero_lead', 'Products we design, build and keep running.')}</p>
    </header>

    {groups.map((group) => (
      <section class="work__group">
        {group.label && <p class="work__group-label">{group.label}</p>}
        <ol class="work__list" role="list">
          {group.items.map((p) => {
            rowIndex += 1
            const href = localizeHref(lang, `/projects/${p.slug}/`)
            const bg = p.previewInteractive ? previewBg[p.previewInteractive] : undefined
            const style = `--row-accent:${p.color};` + (bg ? `--row-preview-day:${bg[0]};--row-preview-night:${bg[1]};` : '')
            const status = p.status ? tt(statusKey(p.status), p.status) : ''
            return (
              <li class="row" data-row style={style}>
                <button class="row__head" type="button" aria-expanded="false" data-row-toggle>
                  <span class="row__num">{String(rowIndex).padStart(2, '0')}</span>
                  <span class="row__name">{p.name}</span>
                  <span class="row__tagline">{p.tagline}</span>
                  {status && <span class="row__status">{status}</span>}
                  <span class="row__plus" aria-hidden="true"></span>
                </button>
                <div class="row__body">
                  <div class="row__inner">
                    <div class:list={['row__media', { 'row__media--phone': mobileSlugs.has(p.slug), 'row__media--live': Boolean(p.previewInteractive) }]}>
                      {p.previewInteractive === 'matrix' && <MatrixPreview />}
                      {p.previewInteractive === 'moneybox' && <MoneyBoxPreview />}
                      {p.previewInteractive === 'numu' && <NumuPreview />}
                      {p.previewInteractive === 'invexo' && <BaseetIMSPreview />}
                      {!p.previewInteractive && p.previewVideo && (
                        <video class="row__visual" src={p.previewVideo} poster={p.previewImage} muted loop playsinline preload="none" aria-hidden="true" data-row-video />
                      )}
                      {!p.previewInteractive && !p.previewVideo && (
                        <img class="row__visual" src={p.previewImage} alt="" loading="lazy" decoding="async" />
                      )}
                    </div>
                    <div class="row__side">
                      <p class="row__side-tagline">{p.tagline}</p>
                      {p.platforms?.length > 0 && (
                        <ul class="row__chips" role="list">
                          {p.platforms.map((pl) => <li>{pl.name}</li>)}
                        </ul>
                      )}
                      <a class="row__cta" href={href}>
                        {tt('projects_view', 'View project')}
                        <Icon name="arrow-right" size={16} color="currentColor" class="icon-chevron" />
                      </a>
                    </div>
                  </div>
                </div>
              </li>
            )
          })}
          {group.label && labText.map((name) => {
            rowIndex += 1
            return (
              <li class="row row--static">
                <div class="row__head row__head--static">
                  <span class="row__num">{String(rowIndex).padStart(2, '0')}</span>
                  <span class="row__name">{name}</span>
                </div>
              </li>
            )
          })}
        </ol>
      </section>
    ))}

    <section class="cta-band" data-animate="fade-up">
      <h2 class="cta-band__title">{tt('projects_foot_cta', 'You have an app idea. We can build it.')}</h2>
      <a href={localizeHref(lang, '/contact/')} class="cta-band__btn">
        {tt('home_cta_button', 'Talk to us')}
        <Icon name="arrow-right" size={16} color="currentColor" class="icon-chevron" />
      </a>
    </section>
  </div>
</Page>

<style>
  .work { width: min(1100px, 100%); margin: 0 auto; padding-bottom: clamp(64px, 10vw, 120px); }
  .work__hero { padding: 2vh 0 clamp(32px, 6vw, 64px); max-width: 760px; }
  .work__kicker { font-size: var(--type-eyebrow); letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted-text); margin: 0 0 14px; }
  .work__title { margin: 0 0 18px; }
  .work__accent { color: var(--color-primary); }
  .work__lead { font-size: var(--type-lead); color: var(--muted-text); margin: 0; max-width: 34ch; line-height: 1.45; }

  .work__group + .work__group { margin-top: 56px; }
  .work__group-label { font-size: var(--type-eyebrow); letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted-text); margin: 0 0 12px; }
  .work__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--divider-color); }

  .row { border-bottom: 1px solid var(--divider-color); transition: background 0.35s ease; }
  .row.is-open { background: var(--card-window-bg); border-radius: var(--card-window-radius-tight); border-bottom-color: transparent; box-shadow: var(--card-window-shadow); }
  .row__head {
    width: 100%; display: grid; grid-template-columns: 56px minmax(0, 1.2fr) minmax(0, 1fr) auto 28px;
    align-items: center; gap: 16px; padding: 24px 12px; background: none; border: 0; cursor: pointer;
    text-align: start; color: inherit; font: inherit; transition: padding 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .row__num { font-size: 13px; font-weight: 600; color: var(--muted-text); font-variant-numeric: tabular-nums; }
  .row__name { font-family: var(--font-display); font-size: clamp(22px, 2.6vw, 30px); font-weight: 700; letter-spacing: -0.02em; color: var(--heading-text); transition: color 0.3s ease; }
  .row__tagline { font-size: 15px; color: var(--muted-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .row__status { font-size: 12px; font-weight: 600; padding: 5px 11px; border-radius: 999px; white-space: nowrap; color: var(--row-accent); background: color-mix(in srgb, var(--row-accent) 12%, transparent); }
  .row__plus { position: relative; width: 18px; height: 18px; justify-self: end; }
  .row__plus::before, .row__plus::after { content: ''; position: absolute; inset: 8px 0 auto; height: 2px; border-radius: 2px; background: var(--muted-text); transition: transform 0.35s ease, background 0.3s ease; }
  .row__plus::after { transform: rotate(90deg); }
  .row.is-open .row__plus::after { transform: rotate(0); }
  .row:hover .row__name, .row.is-open .row__name { color: var(--row-accent); }
  .row.is-open .row__plus::before, .row.is-open .row__plus::after { background: var(--row-accent); }
  @media (hover: hover) { .row:hover .row__head { padding-inline-start: 22px; } }

  .row__body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
  .row.is-open .row__body { grid-template-rows: 1fr; }
  .row__inner { overflow: hidden; min-height: 0; display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 24px; padding: 0 12px; opacity: 0; transition: opacity 0.35s ease, padding 0.5s ease; }
  .row.is-open .row__inner { opacity: 1; padding: 0 12px 24px; }

  .row__media { position: relative; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; background: color-mix(in srgb, var(--row-accent) 10%, var(--card-window-bg)); }
  .row__media--live { background: var(--row-preview-day); }
  :global([data-theme='night']) .row__media--live { background: var(--row-preview-night); }
  .row__media--phone { aspect-ratio: auto; height: min(420px, 60vh); max-width: 240px; justify-self: center; width: 100%; border-radius: 28px; }
  .row__media :global(.preview-stage) { position: absolute; inset: 0; }
  .row__visual { width: 100%; height: 100%; object-fit: cover; display: block; }

  .row__side { display: flex; flex-direction: column; gap: 14px; justify-content: flex-end; }
  .row__side-tagline { margin: 0; font-size: 17px; color: var(--heading-text); line-height: 1.45; }
  .row__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .row__chips li { font-size: 12px; padding: 4px 10px; border-radius: 999px; background: color-mix(in srgb, var(--row-accent) 12%, transparent); color: var(--row-accent); }
  .row__cta { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; border-radius: 999px; background: var(--row-accent); color: #fff; font-weight: 600; font-size: 14px; text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .row__cta:hover { transform: translateY(-2px); box-shadow: 0 10px 26px color-mix(in srgb, var(--row-accent) 40%, transparent); }

  .cta-band { margin-top: 72px; border-radius: var(--card-window-radius); padding: clamp(28px, 5vw, 44px); background: linear-gradient(120deg, #203566, var(--color-primary)); color: #fff; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .cta-band__title { color: #fff; margin: 0; font-size: clamp(24px, 3vw, 34px); max-width: 22ch; }
  .cta-band__btn { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: #203566; padding: 14px 26px; border-radius: 999px; font-weight: 600; text-decoration: none; }

  @media (max-width: 760px) {
    .row__head { grid-template-columns: 34px minmax(0, 1fr) 22px; gap: 10px; padding: 20px 6px; }
    .row__tagline, .row__status { display: none; }
    .row__inner { grid-template-columns: 1fr; gap: 16px; padding: 0 6px; }
    .row.is-open .row__inner { padding: 0 6px 18px; }
  }
  .row__head--static { cursor: default; grid-template-columns: 56px minmax(0, 1fr); }
  .row--static:hover .row__name { color: var(--heading-text); }
  @media (hover: hover) { .row--static:hover .row__head { padding-inline-start: 12px; } }

  /* Night: the list sits straight on bright clouds. Give rows a quiet dark
     backing and make the small text solid instead of tinted/translucent. */
  :global([data-theme='night']) .work__list .row:not(.is-open) { background: rgba(10, 16, 28, 0.42); }
  :global([data-theme='night']) .row__tagline { color: #dfe6f2; }
  :global([data-theme='night']) .row__num { color: #c9d3e6; }
  :global([data-theme='night']) .row__status {
    color: #f4f7fc;
    background: rgba(8, 12, 22, 0.78);
    border: 1px solid color-mix(in srgb, var(--row-accent) 65%, transparent);
    text-shadow: none;
  }
  :global([data-theme='night']) .row__chips li { color: #f4f7fc; background: rgba(8, 12, 22, 0.7); border: 1px solid color-mix(in srgb, var(--row-accent) 55%, transparent); }
  :global([data-theme='night']) .row__plus::before,
  :global([data-theme='night']) .row__plus::after { background: #dfe6f2; }
  @media (max-width: 760px) { .row__head--static { grid-template-columns: 34px minmax(0, 1fr); } }

  :global([dir='rtl']) .icon-chevron :global(svg) { transform: scaleX(-1); }
  @media (prefers-reduced-motion: reduce) {
    .row__body, .row__inner, .row__head, .row__plus::before, .row__plus::after { transition: none; }
  }
</style>

<script>
  import { initPreviewLoader } from '../scripts/previews/preview-loader'

  let cleanup: (() => void) | undefined

  function initWorkList(): void {
    cleanup?.()
    const root = document.querySelector<HTMLElement>('[data-work-list]')
    if (!root) return
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-row]'))  // text-only lab rows have no data-row
    const teardownPreviews = initPreviewLoader(root)
    const offs: Array<() => void> = []
    const on = (el: EventTarget, ev: string, fn: EventListener, opts?: AddEventListenerOptions) => {
      el.addEventListener(ev, fn, opts)
      offs.push(() => el.removeEventListener(ev, fn, opts))
    }

    function setOpen(row: HTMLElement, open: boolean): void {
      if (row.classList.contains('is-open') === open) return
      row.classList.toggle('is-open', open)
      row.querySelector('[data-row-toggle]')?.setAttribute('aria-expanded', String(open))
      const video = row.querySelector<HTMLVideoElement>('[data-row-video]')
      if (video) {
        if (open) {
          video.preload = 'auto'
          video.play().catch(() => {})
        } else {
          video.pause()
        }
      }
    }
    function openOnly(target: HTMLElement | null): void {
      rows.forEach((r) => setOpen(r, r === target))
    }

    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches
    let tapLocked: HTMLElement | null = null

    rows.forEach((row) => {
      const head = row.querySelector<HTMLElement>('[data-row-toggle]')!
      on(head, 'click', () => {
        const next = !row.classList.contains('is-open')
        tapLocked = next ? row : null
        openOnly(next ? row : null)
      })
      if (canHover) {
        on(row, 'mouseenter', () => { if (!tapLocked) openOnly(row) })
        on(row, 'mouseleave', () => { if (!tapLocked) setOpen(row, false) })
      }
    })

    // Touch: the row crossing the middle of the screen opens itself.
    let io: IntersectionObserver | undefined
    if (!canHover && 'IntersectionObserver' in window) {
      io = new IntersectionObserver(
        (entries) => {
          if (tapLocked) return
          const hit = entries.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement)
          if (hit.length) openOnly(hit[0])
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
      )
      rows.forEach((r) => io!.observe(r))
      on(window, 'scroll', () => {
        if (tapLocked && !isNearCentre(tapLocked)) tapLocked = null
      }, { passive: true })
    }

    cleanup = () => {
      offs.forEach((f) => f())
      io?.disconnect()
      teardownPreviews?.()
      cleanup = undefined
    }
  }

  function isNearCentre(el: HTMLElement): boolean {
    const r = el.getBoundingClientRect()
    const mid = window.innerHeight / 2
    return r.top < mid + window.innerHeight * 0.4 && r.bottom > mid - window.innerHeight * 0.4
  }

  initWorkList()
  document.addEventListener('astro:page-load', initWorkList)
  document.addEventListener('astro:before-swap', () => cleanup?.())
</script>
